// ============================================================
// GALEC PMSM Speed Controller
//
// The controller algorithm is written in GALEC.
//
// InvPark() and SVPWM() are external C functions.
// Their implementations are supplied by the target platform.
//
// ============================================================


block PMSMController


  // ----------------------------------------------------------
  // Inputs
  // ----------------------------------------------------------

  input Real speed
    (min = -3000.0, max = 3000.0);

  input Real speed_ref
    (min = -3000.0, max = 3000.0);

  input Real id
    (min = -50.0, max = 50.0);

  input Real iq
    (min = -50.0, max = 50.0);

  input Real theta
    (min = 0.0, max = 6.283185307);

  input Real Vdc
    (min = 0.0, max = 20.0);


  // ----------------------------------------------------------
  // Outputs
  // ----------------------------------------------------------

  output Real duty_a
    (min = 0.0, max = 1.0);

  output Real duty_b
    (min = 0.0, max = 1.0);

  output Real duty_c
    (min = 0.0, max = 1.0);


  // ----------------------------------------------------------
  // Parameters
  // ----------------------------------------------------------

  parameter Real Kp_speed;
  parameter Real Ki_speed;

  parameter Real Kp_current;
  parameter Real Ki_current;

  parameter Real Ts;

  parameter Real Imax;


  // ----------------------------------------------------------
  // Controller states
  // ----------------------------------------------------------

  state Real speed_integral;
  state Real id_integral;
  state Real iq_integral;


  // ----------------------------------------------------------
  // Internal signals
  // ----------------------------------------------------------

  Real speed_error;

  Real id_ref;
  Real iq_ref;

  Real id_error;
  Real iq_error;

  Real vd;
  Real vq;

  Real v_alpha;
  Real v_beta;


  // ==========================================================
  // External C functions
  //
  // These functions are NOT generated by GALEC.
  // Only the calls to them are generated.
  // ==========================================================


  function InvPark

    input Real vd;
    input Real vq;
    input Real theta;

    output Real v_alpha;
    output Real v_beta;

    external "C"
      InvPark(vd, vq, theta,
              v_alpha, v_beta);

  end InvPark;


  function SVPWM

    input Real v_alpha;
    input Real v_beta;
    input Real Vdc;

    output Real duty_a;
    output Real duty_b;
    output Real duty_c;

    external "C"
      SVPWM(v_alpha, v_beta, Vdc,
            duty_a, duty_b, duty_c);

  end SVPWM;


  // ==========================================================
  // Startup
  // ==========================================================

public

  method Startup

  algorithm

    speed_integral := 0.0;

    id_integral := 0.0;

    iq_integral := 0.0;

    id_ref := 0.0;

    iq_ref := 0.0;

  end Startup;


  // ==========================================================
  // Main control step
  // ==========================================================

  method DoStep

  algorithm


    // --------------------------------------------------------
    // Speed controller
    // --------------------------------------------------------

    speed_error :=
      speed_ref - speed;


    speed_integral :=
      speed_integral
      + Ki_speed * speed_error * Ts;


    iq_ref :=
      Kp_speed * speed_error
      + speed_integral;


    // --------------------------------------------------------
    // d-axis reference
    //
    // For the first PMSM controller we use:
    //
    //                 id_ref = 0
    //
    // --------------------------------------------------------

    id_ref := 0.0;


    // --------------------------------------------------------
    // d-axis current controller
    // --------------------------------------------------------

    id_error :=
      id_ref - id;


    id_integral :=
      id_integral
      + Ki_current * id_error * Ts;


    vd :=
      Kp_current * id_error
      + id_integral;


    // --------------------------------------------------------
    // q-axis current controller
    // --------------------------------------------------------

    iq_error :=
      iq_ref - iq;


    iq_integral :=
      iq_integral
      + Ki_current * iq_error * Ts;


    vq :=
      Kp_current * iq_error
      + iq_integral;


    // --------------------------------------------------------
    // Coordinate transformation
    //
    // Implemented externally in C.
    // --------------------------------------------------------

    (v_alpha, v_beta) :=
      InvPark(vd, vq, theta);


    // --------------------------------------------------------
    // Space Vector PWM
    //
    // Implemented externally in C.
    // --------------------------------------------------------

    (duty_a, duty_b, duty_c) :=
      SVPWM(v_alpha, v_beta, Vdc);


  end DoStep;


end PMSMController;