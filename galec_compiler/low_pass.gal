/* GALEC program: Simple Low-Pass Filter
 *
 * This block implements a discrete first-order low-pass filter:
 * y[k] = alpha * u[k] + (1 - alpha) * y[k-1]
 */
block LowPassFilter

  /* Block interface variables */
  input  Real u (min = -10.0, max = 10.0);   // Filter input
  output Real y (min = -10.0, max = 10.0);   // Filtered output
  parameter Real alpha (min = 0.0, max = 1.0); // Filter coefficient (tunable)

  /* Internal block variables */
  Real state;  // Internal state: holds the previous output value

  /* Block interface functions */
  public:

    /* Initialization: called once before the first sampling step */
    function initialize
      state = 0.0;  // Initialize the filter state to zero
    end initialize;

    /* Sampling step: called at each sampling instant */
    function doStep
      // Compute the new output using the filter equation
      y = alpha * u + (1.0 - alpha) * state;
      // Update the internal state for the next step
      state = y;
    end doStep;

end LowPassFilter;