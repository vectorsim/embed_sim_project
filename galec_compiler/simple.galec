block SimpleController
  input Real u;
  output Real y;

public
  method Startup
  algorithm
    y := 0.0;
  end Startup;

  method DoStep
  algorithm
    y := 2.0 * u + abs(u) - min(1.0, u);
    if u < 0.0 or not (u = 0.0) then
      y := -y;
    else
      y := y;
    end if;
    for i in 1 to 10 do
      y := y + i;
    end for;
    for i in 1 to 10 step 2 do
      y := y * 2.0;
    end for;
  end DoStep; // Test 

end SimpleController;