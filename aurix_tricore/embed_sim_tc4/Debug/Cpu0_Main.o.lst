 590:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * FALSE: Disable the performance counter.
 591:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 592:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \retval None
