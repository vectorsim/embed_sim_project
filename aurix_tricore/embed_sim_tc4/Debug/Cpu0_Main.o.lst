 107:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** #define IFXCPU_DISABLE_INTERRPUTS_OF_CPU(cpunum) \
 108:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     {                                            \
 109:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****         CPU##cpunum##_HRA_ICR.B.IE = 0;          \
