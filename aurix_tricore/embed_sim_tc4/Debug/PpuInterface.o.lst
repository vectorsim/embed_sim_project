 313:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucCore.h ****     return (IfxPpucCore_Status)(ppuc->STAT.B.RUN);
 314:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucCore.h **** }
