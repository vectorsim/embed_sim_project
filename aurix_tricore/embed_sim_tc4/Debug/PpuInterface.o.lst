 301:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucCore.h **** IFX_INLINE void IfxPpucCore_haltCore(Ifx_PPU *ppuc)
 302:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucCore.h **** {
 303:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucCore.h ****     ppuc->CTRL.B.REQH = 1U;
 304:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucCore.h **** 
 305:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucCore.h ****     /* Wait till the processor is put to halt */
 306:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucCore.h ****     while (ppuc->STAT.B.RUN != 2U)
 307:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucCore.h ****     {}
 308:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucCore.h **** }
