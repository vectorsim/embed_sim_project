 580:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_INLINE void IfxCpu_resetAndStartCounters(IfxCpu_CounterMode mode);
 581:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 582:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief API to Enable or disable the CPU performance counters based on the input parameter.
 583:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 584:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * This API can be used to enable or disable performance counter of only the caller CPU. It cannot 
 585:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * used for this activity towards other CPUs.
 586:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 587:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in] enable Specifies whether to enable or disable the performance counters.
 588:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 589:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * TRUE: Enable the performance counter.
 590:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * FALSE: Disable the performance counter.
 591:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 592:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \retval None
 593:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  */
 594:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_INLINE void IfxCpu_setPerformanceCountersEnableBit(uint32 enable);
 595:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 596:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief Stops instruction and clock counters, and return their values
 597:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 598:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * Stop CCNT, ICNT, M1CNT, M2CNT, M3CNT and return their values;
 599:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * Note: The CCTRL is reset to 0, for more accurate measurements and has to be initialized again be
 600:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 601:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \retval IfxCpu_Perf Performance counter result.
 602:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  */
 603:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_INLINE IfxCpu_Perf IfxCpu_stopCounters(void);
 604:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 605:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief API to Update the CPU clock counter with a specified value.
 606:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 607:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * This API can be used to update clock counter of only the caller CPU. It cannot be
 608:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * used for this activity towards other CPUs.
 609:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 610:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in] count The new value to be set for the clock counter. 0 to 0x7FFFFFFF.
 611:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 612:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \retval None
 613:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  */
 614:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_INLINE void IfxCpu_updateClockCounter(uint32 count);
 615:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 616:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief API to update the instruction counter with a specified value.
 617:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 618:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * This API can be used to update Instruction counter of only the caller CPU. It cannot be
 619:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * used for this activity towards other CPUs.
 620:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 621:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in] count The new value to be set for the instruction counter. 0 to 0x7FFFFFFF.
 622:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 623:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \retval None
 624:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  */
 625:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_INLINE void IfxCpu_updateInstructionCounter(uint32 count);
 626:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 627:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief API to the performance counter at the specified address with the given count value.
 628:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * This is generic function to update any of the performance counters.
 629:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 630:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in] address The memory address of the performance counter to be updated. Range: 0 to 0xFF
 631:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in] count   Count value to be written to the performance counter. Range: 0 to 0x7FFFFFFF.
 632:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 633:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \retval None
 634:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  */
 635:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_INLINE void IfxCpu_updatePerformanceCounter(uint32 address, uint32 count);
 636:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 637:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \} */
