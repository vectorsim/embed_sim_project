  52:../PpuInterface.h **** /* API to signal that PPU bootup is done.
  53:../PpuInterface.h ****  * This is done by triggering the PPUC Inter core communication interrupt up.
  54:../PpuInterface.h ****  * If one of the TriCores are configured to receive the interrupt (or poll),
  55:../PpuInterface.h ****  * then such communication is established.
  56:../PpuInterface.h ****  */
  57:../PpuInterface.h **** IFX_INLINE boolean PpuInterface_acknowledgePpuSignal(void)
  58:../PpuInterface.h **** {
  59:../PpuInterface.h ****     boolean requested= IfxSrc_isRequested(&MODULE_SRC.GPSR[0].SR0);
  60:../PpuInterface.h ****     if(requested)
  61:../PpuInterface.h ****     {
  62:../PpuInterface.h ****         IfxSrc_clearRequest(&MODULE_SRC.GPSR[0].SR0);
  63:../PpuInterface.h ****     }
  64:../PpuInterface.h ****     return requested;
  65:../PpuInterface.h **** }
  66:../PpuInterface.h **** 
