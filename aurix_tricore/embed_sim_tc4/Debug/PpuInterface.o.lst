 291:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucCore.h **** IFX_INLINE void IfxPpucCore_startCore(Ifx_PPU *ppuc)
 292:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucCore.h **** {
 293:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucCore.h ****     ppuc->CTRL.B.REQR = 1U;
