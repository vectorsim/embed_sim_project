 295:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucCore.h ****     /* Wait till the status is changed to RUN */
 296:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucCore.h ****     while (ppuc->STAT.B.RUN != 0U)
 297:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucCore.h ****     {}
 298:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucCore.h **** }
