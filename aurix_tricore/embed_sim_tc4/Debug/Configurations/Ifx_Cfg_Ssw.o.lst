 120:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** #define STRINGIFY(x)    #x
 121:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** 
 122:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** /* Assembly function to configure the Stack pointer and jump to core start */
 123:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** #define Ifx_Ssw_Start(stackPtr, funcPtr) __Ifx_Ssw_Start(stackPtr, funcPtr)
 124:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** 
 125:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** #define __Ifx_Ssw_Start(stackPtr, funcPtr) \
 126:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h ****     __asm("movh.a %a10, hi:("STRINGIFY(stackPtr)")\n" \
 127:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h ****           "\tlea %a10, [%a10]lo:("STRINGIFY(stackPtr)")\n " \
 128:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h ****           "\tdsync \n" \
 129:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** 		  "\tmovh.a %a15,  hi:("STRINGIFY(funcPtr)")\n" \
 130:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** 		  "\tlea %a15, [%a15]lo:("STRINGIFY(funcPtr)")\n" \
 131:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** 		  "\tji %a15");
 132:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** 
 133:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** #define Ifx_Ssw_Barrier() __asm__ volatile("":::"memory");
 134:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** 
 135:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** #if (__TRICORE_CORE__ == 0x162)
 136:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** #define Ifx_Ssw_HVCALL(hvcno) \
 137:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** switch (hvcno) \
 138:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** { \
 139:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** case 1: \
 140:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** {__asm volatile (".word 0x004010AD");}\
 141:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** break; \
 142:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** case 2: \
 143:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** {__asm volatile (".word 0x004020AD");}\
 144:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** break; \
 145:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** case 3: \
 146:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** {__asm volatile (".word 0x004030AD");}\
 147:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** break; \
 148:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** case 4: \
 149:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** {__asm volatile (".word 0x004040AD");}\
 150:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** break; \
 151:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** case 5: \
 152:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** {__asm volatile (".word 0x004050AD");}\
 153:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** break; \
 154:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** case 6: \
 155:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** {__asm volatile (".word 0x004060AD");}\
 156:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** break; \
 157:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** case 7: \
 158:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** {__asm volatile (".word 0x004070AD");}\
 159:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** break; \
 160:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** }
 161:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** #define Ifx_Ssw_RFH() \
 162:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** __asm volatile (".word 0x05C0000D");
 163:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** #else
 164:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** #define Ifx_Ssw_HVCALL(hvcno) __asm__ volatile ("hvcall "STRINGIFY(hvcno) : : : "memory")
 165:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** 
 166:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** #define Ifx_Ssw_RFH() __asm__ volatile ("rfh "STRINGIFY() : : : "memory")
 167:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** #endif
