  48:../Configurations/Ifx_Cfg_Ssw.c **** /* Hook API for FW_Check incl. SMU Alarm Flag check
  49:../Configurations/Ifx_Cfg_Ssw.c ****  * This hook is referenced in Startup sequence. This need to be configured by application to
  50:../Configurations/Ifx_Cfg_Ssw.c ****  * check FW and the SMU alarm flags. This hook is by default defined to empty call by startup imple
  51:../Configurations/Ifx_Cfg_Ssw.c ****  */
  52:../Configurations/Ifx_Cfg_Ssw.c **** #if (IFX_CFG_SSW_ENABLE_FW_CHECK == 1U)
  53:../Configurations/Ifx_Cfg_Ssw.c **** void Ifx_Ssw_FwCheck(void)
  54:../Configurations/Ifx_Cfg_Ssw.c **** {
  55:../Configurations/Ifx_Cfg_Ssw.c **** 	/* TODO: To be updated as per A3G spec */
  56:../Configurations/Ifx_Cfg_Ssw.c **** }
  57:../Configurations/Ifx_Cfg_Ssw.c **** #endif
  58:../Configurations/Ifx_Cfg_Ssw.c **** 
  59:../Configurations/Ifx_Cfg_Ssw.c **** /* Hook API for PMS Initialization
  60:../Configurations/Ifx_Cfg_Ssw.c ****  * This hook is referenced in Startup sequence. This need to be configured by application to
  61:../Configurations/Ifx_Cfg_Ssw.c ****  * initialize the PMS EVR module. This hook is by default defined to empty call by startup implemen
  62:../Configurations/Ifx_Cfg_Ssw.c ****  */
  63:../Configurations/Ifx_Cfg_Ssw.c **** #if (IFX_CFG_SSW_ENABLE_PMS_INIT == 1U)
  64:../Configurations/Ifx_Cfg_Ssw.c **** #include "IfxPmsEvr.h"
  65:../Configurations/Ifx_Cfg_Ssw.c **** 
  66:../Configurations/Ifx_Cfg_Ssw.c **** void Ifx_Ssw_Pms_Init(void)
  67:../Configurations/Ifx_Cfg_Ssw.c **** {
  68:../Configurations/Ifx_Cfg_Ssw.c ****     if (IfxPmsEvr_runInitSequence(&IfxPmsEvr_cfgSequenceDefault) == 0)
  69:../Configurations/Ifx_Cfg_Ssw.c ****     {
  70:../Configurations/Ifx_Cfg_Ssw.c ****         Ifx_Ssw_debug();
  71:../Configurations/Ifx_Cfg_Ssw.c ****     }
  72:../Configurations/Ifx_Cfg_Ssw.c **** 
  73:../Configurations/Ifx_Cfg_Ssw.c ****     Ifx_Ssw_jumpBackToLink();
  74:../Configurations/Ifx_Cfg_Ssw.c **** }
  75:../Configurations/Ifx_Cfg_Ssw.c **** 
  76:../Configurations/Ifx_Cfg_Ssw.c **** /* Hook API for PMS Initialization check
  77:../Configurations/Ifx_Cfg_Ssw.c ****  * This hook is referenced in Startup sequence. This need to be configured by application to
  78:../Configurations/Ifx_Cfg_Ssw.c ****  * cross verify the PMS configuration with the required values. This hook is by default defined to 
  79:../Configurations/Ifx_Cfg_Ssw.c ****  * call by startup implementation.
  80:../Configurations/Ifx_Cfg_Ssw.c ****  */
  81:../Configurations/Ifx_Cfg_Ssw.c **** #if (IFX_CFG_SSW_ENABLE_PMS_INIT_CHECK == 1U)
  82:../Configurations/Ifx_Cfg_Ssw.c **** void Ifx_Ssw_Pms_InitCheck(void)
  83:../Configurations/Ifx_Cfg_Ssw.c **** {
  84:../Configurations/Ifx_Cfg_Ssw.c ****     if (IfxPmsEvr_areInitValuesRight(&IfxPmsEvr_verifyRegCfgDefault) == 0)
  85:../Configurations/Ifx_Cfg_Ssw.c ****     {
  86:../Configurations/Ifx_Cfg_Ssw.c ****         Ifx_Ssw_debug();
  87:../Configurations/Ifx_Cfg_Ssw.c ****     }
  88:../Configurations/Ifx_Cfg_Ssw.c **** 
  89:../Configurations/Ifx_Cfg_Ssw.c ****     Ifx_Ssw_jumpBackToLink();
  90:../Configurations/Ifx_Cfg_Ssw.c **** }
  91:../Configurations/Ifx_Cfg_Ssw.c **** 
  92:../Configurations/Ifx_Cfg_Ssw.c **** #endif /* End of Ifx_Ssw_Pms_InitCheck() */
  93:../Configurations/Ifx_Cfg_Ssw.c **** #endif /* End of Ifx_Ssw_Pms_Init() */
  94:../Configurations/Ifx_Cfg_Ssw.c **** 
  95:../Configurations/Ifx_Cfg_Ssw.c **** /* Hook API for LBIST check
  96:../Configurations/Ifx_Cfg_Ssw.c ****  * This hook is referenced in Startup sequence. This need to be configured by application to
  97:../Configurations/Ifx_Cfg_Ssw.c ****  * do LBIST checks. This hook is by default defined to empty call by startup implementation.
  98:../Configurations/Ifx_Cfg_Ssw.c ****  */
  99:../Configurations/Ifx_Cfg_Ssw.c **** #if (IFX_CFG_SSW_ENABLE_LBIST == 1)
 100:../Configurations/Ifx_Cfg_Ssw.c **** void Ifx_Ssw_Lbist(void)
 101:../Configurations/Ifx_Cfg_Ssw.c **** {
 102:../Configurations/Ifx_Cfg_Ssw.c ****     uint16 result;
 103:../Configurations/Ifx_Cfg_Ssw.c **** 
 104:../Configurations/Ifx_Cfg_Ssw.c ****     IfxApProt_setState((Ifx_PROT_PROT *)&TRI_PROTSE, IfxApProt_State_config);
 105:../Configurations/Ifx_Cfg_Ssw.c ****     TRI_ACCEN_WRA.U = 0xFFFFFFFFU;
 106:../Configurations/Ifx_Cfg_Ssw.c ****     TRI_ACCEN_WRB.U = 0xFFFFFFFFU;
 107:../Configurations/Ifx_Cfg_Ssw.c ****     IfxApProt_setState((Ifx_PROT_PROT *)&TRI_PROTSE, IfxApProt_State_run);
 108:../Configurations/Ifx_Cfg_Ssw.c **** 
 109:../Configurations/Ifx_Cfg_Ssw.c ****     result = IfxTriLbist_evaluateResult(&IfxTriLbist_keyOnDefaultConfig.signature[0]);
 110:../Configurations/Ifx_Cfg_Ssw.c **** 
 111:../Configurations/Ifx_Cfg_Ssw.c ****     if (result) // Failure or Not executed.
 112:../Configurations/Ifx_Cfg_Ssw.c ****     {
 113:../Configurations/Ifx_Cfg_Ssw.c ****         if (IfxTriLbist_getFailCount() >= 2)
 114:../Configurations/Ifx_Cfg_Ssw.c ****         {
 115:../Configurations/Ifx_Cfg_Ssw.c ****             /* after 3 faulty LBIST execution
 116:../Configurations/Ifx_Cfg_Ssw.c ****              * signal a permanent fault */
 117:../Configurations/Ifx_Cfg_Ssw.c ****             Ifx_Ssw_debug();
 118:../Configurations/Ifx_Cfg_Ssw.c ****         }
 119:../Configurations/Ifx_Cfg_Ssw.c ****         else
 120:../Configurations/Ifx_Cfg_Ssw.c ****         {
 121:../Configurations/Ifx_Cfg_Ssw.c ****             /* increment Fail count */
 122:../Configurations/Ifx_Cfg_Ssw.c ****             IfxTriLbist_incrementFailCount();
 123:../Configurations/Ifx_Cfg_Ssw.c ****         }
 124:../Configurations/Ifx_Cfg_Ssw.c **** 
 125:../Configurations/Ifx_Cfg_Ssw.c ****         /* Clear LBIST Status registers */
 126:../Configurations/Ifx_Cfg_Ssw.c ****         IfxTriLbist_resetLbist();
 127:../Configurations/Ifx_Cfg_Ssw.c **** 
 128:../Configurations/Ifx_Cfg_Ssw.c ****         IfxTriLbist_triggerInline(&IfxTriLbist_keyOnDefaultConfig);
 129:../Configurations/Ifx_Cfg_Ssw.c ****     }
 130:../Configurations/Ifx_Cfg_Ssw.c ****     else
 131:../Configurations/Ifx_Cfg_Ssw.c ****     {
 132:../Configurations/Ifx_Cfg_Ssw.c ****         /* Success */
 133:../Configurations/Ifx_Cfg_Ssw.c ****     }
 134:../Configurations/Ifx_Cfg_Ssw.c **** }
 135:../Configurations/Ifx_Cfg_Ssw.c **** 
 136:../Configurations/Ifx_Cfg_Ssw.c **** #endif
 137:../Configurations/Ifx_Cfg_Ssw.c **** 
 138:../Configurations/Ifx_Cfg_Ssw.c **** /* Hook API for MONBIST check
 139:../Configurations/Ifx_Cfg_Ssw.c ****  * This hook is referenced in Startup sequence. This need to be configured by application to
 140:../Configurations/Ifx_Cfg_Ssw.c ****  * do MONBIST checks. This hook is by default defined to empty call by startup implementation.
 141:../Configurations/Ifx_Cfg_Ssw.c ****  */
 142:../Configurations/Ifx_Cfg_Ssw.c **** #if (IFX_CFG_SSW_ENABLE_MONBIST == 1)
