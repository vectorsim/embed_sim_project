EmbedSim_TC4_TC4.elf: ../Lcf_Gcc_Tricore_Tc.lsl $(OBJS) $(USER_OBJS) C:/Users/CSO212/ACS-v1.0.24-workspace/EmbedSim_TC4/EmbedSim_TC4_PPU/Debug/EmbedSim_TC4_PPU.elf makefile $(OPTIONAL_TOOL_DEPS) .EmbedSim_TC4_TC4.elf.opt
	@echo 'Building target: $@'
	@echo 'Invoking: TriCore GCC C Linker'
	tricore-elf-gcc @.EmbedSim_TC4_TC4.elf.opt
	@echo 'Finished building target: $@'
	@echo ' '

.EmbedSim_TC4_TC4.elf.opt:
	$(file >$@, -T"../Lcf_Gcc_Tricore_Tc.lsl" -nocrt0 -Xlinker --gc-sections -Xlinker --no-warn-rwx-segments -Wl,-Map,"EmbedSim_TC4_TC4.map" -mtc18 -o "EmbedSim_TC4_TC4.elf" $(OBJS) $(USER_OBJS) $(LIBS))

.PHONY: .EmbedSim_TC4_TC4.elf.opt

EmbedSim_TC4_TC4.hex: EmbedSim_TC4_TC4.elf makefile $(OPTIONAL_TOOL_DEPS)
	@echo 'Invoking: TriCore GCC Create Flash Image'
	tricore-elf-objcopy "EmbedSim_TC4_TC4.elf" -O ihex  "EmbedSim_TC4_TC4.hex"
	@echo 'Finished building: $@'
	@echo ' '

EmbedSim_TC4_TC4.siz: EmbedSim_TC4_TC4.elf makefile $(OPTIONAL_TOOL_DEPS)
	@echo 'Invoking: TriCore GCC Print Size'
	tricore-elf-size  --format=berkeley "EmbedSim_TC4_TC4.elf"
	@echo 'Finished building: $@'
	@echo ' '

