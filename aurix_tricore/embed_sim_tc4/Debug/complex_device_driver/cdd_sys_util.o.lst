  74:../complex_device_driver/cdd_sys_util.h **** /**
  75:../complex_device_driver/cdd_sys_util.h ****  * @brief Reads a TriCore Core Special Function Register (CSFR).
  76:../complex_device_driver/cdd_sys_util.h ****  *
  77:../complex_device_driver/cdd_sys_util.h ****  * Uses the TriCore MFCR (Move From Core Register) instruction to read
  78:../complex_device_driver/cdd_sys_util.h ****  * the specified CPU core register.
  79:../complex_device_driver/cdd_sys_util.h ****  *
  80:../complex_device_driver/cdd_sys_util.h ****  * @param[in] RegAddr
  81:../complex_device_driver/cdd_sys_util.h ****  *     Compile-time address of the Core Special Function Register.
  82:../complex_device_driver/cdd_sys_util.h ****  *
  83:../complex_device_driver/cdd_sys_util.h ****  * @return
  84:../complex_device_driver/cdd_sys_util.h ****  *     32-bit value read from the specified core register.
  85:../complex_device_driver/cdd_sys_util.h ****  *
  86:../complex_device_driver/cdd_sys_util.h ****  * @note
  87:../complex_device_driver/cdd_sys_util.h ****  *     RegAddr must be a compile-time constant because the inline assembly
  88:../complex_device_driver/cdd_sys_util.h ****  *     uses the "i" immediate operand constraint.
  89:../complex_device_driver/cdd_sys_util.h ****  *
  90:../complex_device_driver/cdd_sys_util.h ****  * @note
  91:../complex_device_driver/cdd_sys_util.h ****  *     The function is always inlined and therefore introduces no
  92:../complex_device_driver/cdd_sys_util.h ****  *     function-call overhead.
  93:../complex_device_driver/cdd_sys_util.h ****  */
  94:../complex_device_driver/cdd_sys_util.h **** static __inline__ __attribute__((__always_inline__))
