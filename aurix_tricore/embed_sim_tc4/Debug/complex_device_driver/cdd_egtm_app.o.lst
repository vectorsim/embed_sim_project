 143:../complex_device_driver/cdd_egtm_app.c **** /**************************************************************************************************
 144:../complex_device_driver/cdd_egtm_app.c **** /*---------------------------------------------Function Implementations----------------------------
 145:../complex_device_driver/cdd_egtm_app.c **** /**************************************************************************************************
 146:../complex_device_driver/cdd_egtm_app.c **** 
 147:../complex_device_driver/cdd_egtm_app.c **** /* Macro to define the Interrupt Service Routine of Control Loop (ATOM_CH0) */
 148:../complex_device_driver/cdd_egtm_app.c **** IFX_INTERRUPT(ControlLoop_ISR, 0, CTRL_ISR_PRIORITY);
 149:../complex_device_driver/cdd_egtm_app.c **** IFX_INTERRUPT(TIM0_CH4_ISR, 0, TIM0CH4_ISR_PRIORITY);
 150:../complex_device_driver/cdd_egtm_app.c **** 
 151:../complex_device_driver/cdd_egtm_app.c **** /**
 152:../complex_device_driver/cdd_egtm_app.c ****  * \brief   Fast shut-off ISR, triggered by TIM0 channel 4.
 153:../complex_device_driver/cdd_egtm_app.c ****  *
 154:../complex_device_driver/cdd_egtm_app.c ****  * \details Latches a shut-off request from the TIM input (P00.1, TIM_IN4).
 155:../complex_device_driver/cdd_egtm_app.c ****  *          Sets Inv_G.ShutOffState to request that the control loop
 156:../complex_device_driver/cdd_egtm_app.c ****  *          de-assert the CDTM shut-off via EGTM_CLS0_CDTM_DTM5_CTRL.
 157:../complex_device_driver/cdd_egtm_app.c ****  *          SHUT_OFF_RST on the next CCU0 event. Actual recovery is deferred
 158:../complex_device_driver/cdd_egtm_app.c ****  *          to ControlLoop_ISR so that register updates stay synchronous with
 159:../complex_device_driver/cdd_egtm_app.c ****  *          the PWM period.
 160:../complex_device_driver/cdd_egtm_app.c ****  *
 161:../complex_device_driver/cdd_egtm_app.c ****  * \return  void
 162:../complex_device_driver/cdd_egtm_app.c ****  *
 163:../complex_device_driver/cdd_egtm_app.c ****  * \note    Must remain short — it runs at the highest CDD priority
 164:../complex_device_driver/cdd_egtm_app.c ****  *          (TIM0CH4_ISR_PRIORITY) and only sets a flag.
 165:../complex_device_driver/cdd_egtm_app.c ****  *
 166:../complex_device_driver/cdd_egtm_app.c ****  * \see     ControlLoop_ISR
 167:../complex_device_driver/cdd_egtm_app.c ****  */
 168:../complex_device_driver/cdd_egtm_app.c **** void TIM0_CH4_ISR(void)
 169:../complex_device_driver/cdd_egtm_app.c **** {
 170:../complex_device_driver/cdd_egtm_app.c ****     Inv_G.ShutOffState = 0x1U;
 171:../complex_device_driver/cdd_egtm_app.c **** }
 172:../complex_device_driver/cdd_egtm_app.c **** 
 173:../complex_device_driver/cdd_egtm_app.c **** 
 174:../complex_device_driver/cdd_egtm_app.c **** /**
 175:../complex_device_driver/cdd_egtm_app.c ****  * \brief   Control-loop ISR for the inverter (ATOM channel 0, CCU0 and CCU1).
 176:../complex_device_driver/cdd_egtm_app.c ****  *
 177:../complex_device_driver/cdd_egtm_app.c ****  * \details Executes once per PWM period on the master channel's CCU0/CCU1
 178:../complex_device_driver/cdd_egtm_app.c ****  *          events. Responsibilities:
 179:../complex_device_driver/cdd_egtm_app.c ****  *            -# Increment the free-running cycle counter Inv_G.Counter.
 180:../complex_device_driver/cdd_egtm_app.c ****  *            -# Recompute Inv_G.PeriodTicks from the selected frequency mode.
 181:../complex_device_driver/cdd_egtm_app.c ****  *            -# On CCU0: if a shut-off is latched (ShutOffState == 1) and the
 182:../complex_device_driver/cdd_egtm_app.c ****  *               application has requested recovery (ShutOffRstRequest == 1),
 183:../complex_device_driver/cdd_egtm_app.c ****  *               release the dead-time module shut-off and clear the flags.
 184:../complex_device_driver/cdd_egtm_app.c ****  *            -# On CCU1: recompute the three phase compare values (SR0/SR1)
 185:../complex_device_driver/cdd_egtm_app.c ****  *               from Inv_G.PeriodTicks and the three duty cycles.
 186:../complex_device_driver/cdd_egtm_app.c ****  *            -# On CCU1, if FrequencyChangeRequest is set, reprogram the
 187:../complex_device_driver/cdd_egtm_app.c ****  *               master period, issue a host trigger to latch the shadow
 188:../complex_device_driver/cdd_egtm_app.c ****  *               registers, and clear the request.
 189:../complex_device_driver/cdd_egtm_app.c ****  *
 190:../complex_device_driver/cdd_egtm_app.c ****  * \return  void
 191:../complex_device_driver/cdd_egtm_app.c ****  *
 192:../complex_device_driver/cdd_egtm_app.c ****  * \note    Both IRQ notification flags are explicitly cleared so that the
 193:../complex_device_driver/cdd_egtm_app.c ****  *          service request is de-asserted before returning.
 194:../complex_device_driver/cdd_egtm_app.c ****  *
 195:../complex_device_driver/cdd_egtm_app.c ****  * \note    Runs at CTRL_ISR_PRIORITY on CTRL_ISR_TOS.
 196:../complex_device_driver/cdd_egtm_app.c ****  *
 197:../complex_device_driver/cdd_egtm_app.c ****  * \see     CddEgtm_SetInverterFrequency
 198:../complex_device_driver/cdd_egtm_app.c ****  * \see     TIM0_CH4_ISR
 199:../complex_device_driver/cdd_egtm_app.c ****  */
 200:../complex_device_driver/cdd_egtm_app.c **** void ControlLoop_ISR(void)
 201:../complex_device_driver/cdd_egtm_app.c **** {
 202:../complex_device_driver/cdd_egtm_app.c ****     Inv_G.Counter++;
 203:../complex_device_driver/cdd_egtm_app.c ****     CddEgtm_SetInverterFrequency();
 204:../complex_device_driver/cdd_egtm_app.c **** 
 205:../complex_device_driver/cdd_egtm_app.c ****     if(EGTM_CLS0_ATOM_CH0_IRQ_NOTIFY.B.CCU0TC != 0x0u)
 206:../complex_device_driver/cdd_egtm_app.c ****     {
 207:../complex_device_driver/cdd_egtm_app.c ****         if((Inv_G.ShutOffState ==  0x1U)  && (Inv_G.ShutOffRstRequest == 0x1U))
 208:../complex_device_driver/cdd_egtm_app.c ****         {
 209:../complex_device_driver/cdd_egtm_app.c ****             EGTM_CLS0_CDTM_DTM5_CTRL.B.SHUT_OFF_RST = 0x1u;
 210:../complex_device_driver/cdd_egtm_app.c ****             Inv_G.ShutOffRstRequest = 0x0U;
 211:../complex_device_driver/cdd_egtm_app.c ****             Inv_G.ShutOffState  = 0x0U;
 212:../complex_device_driver/cdd_egtm_app.c ****         }
 213:../complex_device_driver/cdd_egtm_app.c ****         EGTM_CLS0_ATOM_CH0_IRQ_NOTIFY.B.CCU0TC = 0x1u;   /* clear the notification flag */
 214:../complex_device_driver/cdd_egtm_app.c ****     }
 215:../complex_device_driver/cdd_egtm_app.c **** 
 216:../complex_device_driver/cdd_egtm_app.c ****     if(EGTM_CLS0_ATOM_CH0_IRQ_NOTIFY.B.CCU1TC != 0x0u)
 217:../complex_device_driver/cdd_egtm_app.c ****     {
 218:../complex_device_driver/cdd_egtm_app.c **** 
 219:../complex_device_driver/cdd_egtm_app.c ****         EGTM_CLS0_ATOM_CH5_SR0.B.SR0 = CAL_PHASE_PERIOD(Inv_G.PeriodTicks, Inv_G.DutyCycleU);
 220:../complex_device_driver/cdd_egtm_app.c ****         EGTM_CLS0_ATOM_CH5_SR1.B.SR1 = CAL_PHASE_DUTY_CYCLE(Inv_G.PeriodTicks, Inv_G.DutyCycleU);
 221:../complex_device_driver/cdd_egtm_app.c ****         EGTM_CLS0_ATOM_CH6_SR0.B.SR0 = CAL_PHASE_PERIOD(Inv_G.PeriodTicks, Inv_G.DutyCycleV);
 222:../complex_device_driver/cdd_egtm_app.c ****         EGTM_CLS0_ATOM_CH6_SR1.B.SR1 = CAL_PHASE_DUTY_CYCLE(Inv_G.PeriodTicks, Inv_G.DutyCycleV);
 223:../complex_device_driver/cdd_egtm_app.c ****         EGTM_CLS0_ATOM_CH7_SR0.B.SR0 = CAL_PHASE_PERIOD(Inv_G.PeriodTicks, Inv_G.DutyCycleW);
 224:../complex_device_driver/cdd_egtm_app.c ****         EGTM_CLS0_ATOM_CH7_SR1.B.SR1 = CAL_PHASE_DUTY_CYCLE(Inv_G.PeriodTicks, Inv_G.DutyCycleW);
 225:../complex_device_driver/cdd_egtm_app.c **** 
 226:../complex_device_driver/cdd_egtm_app.c ****         if(Inv_G.FrequencyChangeRequest==0x1U)
 227:../complex_device_driver/cdd_egtm_app.c ****         {
 228:../complex_device_driver/cdd_egtm_app.c ****             EGTM_CLS0_ATOM_CH0_SR0.B.SR0 = Inv_G.PeriodTicks;   /* note: Master is not connected to
 229:../complex_device_driver/cdd_egtm_app.c ****             EGTM_CLS0_ATOM_CH0_SR1.B.SR1 = Inv_G.PeriodTicks/2u;
 230:../complex_device_driver/cdd_egtm_app.c ****             EGTM_CLS0_ATOM_AGC_GLB_CTRL.B.HOST_TRIG = 0x1u;
 231:../complex_device_driver/cdd_egtm_app.c ****             Inv_G.FrequencyChangeRequest = 0x0U;
 232:../complex_device_driver/cdd_egtm_app.c ****         }
 233:../complex_device_driver/cdd_egtm_app.c **** 
 234:../complex_device_driver/cdd_egtm_app.c ****         EGTM_CLS0_ATOM_CH0_IRQ_NOTIFY.B.CCU1TC = 0x1u;   /* clear the notification flag */
 235:../complex_device_driver/cdd_egtm_app.c ****     }
 236:../complex_device_driver/cdd_egtm_app.c **** 
 237:../complex_device_driver/cdd_egtm_app.c **** }
 238:../complex_device_driver/cdd_egtm_app.c **** 
 239:../complex_device_driver/cdd_egtm_app.c **** 
 240:../complex_device_driver/cdd_egtm_app.c **** /**
 241:../complex_device_driver/cdd_egtm_app.c ****  * \brief   Initialises the eGTM module for three-phase inverter control.
 242:../complex_device_driver/cdd_egtm_app.c ****  *
 243:../complex_device_driver/cdd_egtm_app.c ****  * \details Performs the full eGTM bring-up for the inverter:
 244:../complex_device_driver/cdd_egtm_app.c ****  *            -# Enables the eGTM clock and CMU0 global clock, and programs the
 245:../complex_device_driver/cdd_egtm_app.c ****  *               CMU to the CMU0 target frequency derived from the cluster
 246:../complex_device_driver/cdd_egtm_app.c ****  *               clock.
 247:../complex_device_driver/cdd_egtm_app.c ****  *            -# Initialises the Inv_G global with default dead time, duty
 248:../complex_device_driver/cdd_egtm_app.c ****  *               cycles, shut-off state, frequency mode, and CMU0 frequency.
 249:../complex_device_driver/cdd_egtm_app.c ****  *            -# Computes Inv_G.PeriodTicks for the selected frequency mode.
 250:../complex_device_driver/cdd_egtm_app.c ****  *            -# Configures the TIM0 channel 4 fast shut-off path.
 251:../complex_device_driver/cdd_egtm_app.c ****  *            -# Configures the ATOM CLS0 master channel and the three
 252:../complex_device_driver/cdd_egtm_app.c ****  *               complementary PWM phases with dead time.
 253:../complex_device_driver/cdd_egtm_app.c ****  *
 254:../complex_device_driver/cdd_egtm_app.c ****  * \return  void
 255:../complex_device_driver/cdd_egtm_app.c ****  *
 256:../complex_device_driver/cdd_egtm_app.c ****  * \post    eGTM is configured but outputs remain inactive until the host
 257:../complex_device_driver/cdd_egtm_app.c ****  *          trigger is issued by CddEgtm_Start().
 258:../complex_device_driver/cdd_egtm_app.c ****  *
 259:../complex_device_driver/cdd_egtm_app.c ****  * \see     CddEgtm_InitTim0Ch4
 260:../complex_device_driver/cdd_egtm_app.c ****  * \see     CddEgtm_InitAtomCls0
 261:../complex_device_driver/cdd_egtm_app.c ****  * \see     CddEgtm_Start
 262:../complex_device_driver/cdd_egtm_app.c ****  */
 263:../complex_device_driver/cdd_egtm_app.c **** void CddEgtm_InitModule(void)
 264:../complex_device_driver/cdd_egtm_app.c **** {
 265:../complex_device_driver/cdd_egtm_app.c ****     real32_T frequency;
 266:../complex_device_driver/cdd_egtm_app.c **** 
 267:../complex_device_driver/cdd_egtm_app.c ****     frequency = 0.0F;
 268:../complex_device_driver/cdd_egtm_app.c **** 
 269:../complex_device_driver/cdd_egtm_app.c **** 
 270:../complex_device_driver/cdd_egtm_app.c ****     /* Enable EGTM  & Set CMU0 Clk Frequency */
 271:../complex_device_driver/cdd_egtm_app.c ****     CddSys_EnableEgtmClock();
 272:../complex_device_driver/cdd_egtm_app.c ****     frequency = CddSys_GetEgtmCmuFrequency();
 273:../complex_device_driver/cdd_egtm_app.c ****     CddSys_SetEgtmCmuFrequency(frequency);
 274:../complex_device_driver/cdd_egtm_app.c ****     CddSys_SetEgtmCmu0Frequency(frequency);
 275:../complex_device_driver/cdd_egtm_app.c ****     CddSys_EnableEgtmCmu0Clock();
 276:../complex_device_driver/cdd_egtm_app.c **** 
 277:../complex_device_driver/cdd_egtm_app.c ****     Inv_G.DeadTimeTicks    = 100;
 278:../complex_device_driver/cdd_egtm_app.c ****     Inv_G.DutyCycleU       = 0.8F;
 279:../complex_device_driver/cdd_egtm_app.c ****     Inv_G.DutyCycleV       = 0.6F;
 280:../complex_device_driver/cdd_egtm_app.c ****     Inv_G.DutyCycleW       = 0.7F;
 281:../complex_device_driver/cdd_egtm_app.c ****     Inv_G.ShutOffState     = 0x0U;
 282:../complex_device_driver/cdd_egtm_app.c ****     Inv_G.ShutOffRstRequest = 0x0U;
 283:../complex_device_driver/cdd_egtm_app.c ****     Inv_G.FrequencyChangeRequest = 0x0U;
 284:../complex_device_driver/cdd_egtm_app.c ****     Inv_G.FrequencyMode     = 0x3U;
 285:../complex_device_driver/cdd_egtm_app.c ****     Inv_G.CmuClk0Frequency  = CddSys_GetEgtmCmu0Frequency();
 286:../complex_device_driver/cdd_egtm_app.c ****     CddEgtm_SetInverterFrequency();
 287:../complex_device_driver/cdd_egtm_app.c **** 
 288:../complex_device_driver/cdd_egtm_app.c ****     /* Init ShutOff */
 289:../complex_device_driver/cdd_egtm_app.c ****     CddEgtm_InitTim0Ch4();
 290:../complex_device_driver/cdd_egtm_app.c ****     /* Init Atom for PWM */
 291:../complex_device_driver/cdd_egtm_app.c ****     CddEgtm_InitAtomCls0();
 292:../complex_device_driver/cdd_egtm_app.c **** 
 293:../complex_device_driver/cdd_egtm_app.c **** }
 294:../complex_device_driver/cdd_egtm_app.c **** 
 295:../complex_device_driver/cdd_egtm_app.c **** 
 296:../complex_device_driver/cdd_egtm_app.c **** /**
 297:../complex_device_driver/cdd_egtm_app.c ****  * \brief   Initialises eGTM TIM0 channel 4 as the fast shut-off input.
 298:../complex_device_driver/cdd_egtm_app.c ****  *
 299:../complex_device_driver/cdd_egtm_app.c ****  * \details Configures TIM channel 4 in TIEM mode with no adjacent-channel
 300:../complex_device_driver/cdd_egtm_app.c ****  *          pairing and no LUT, routing pin P00.1 (TIM_IN4) as the input.
 301:../complex_device_driver/cdd_egtm_app.c ****  *          NEWVAL events are enabled and routed to CPU0 at
 302:../complex_device_driver/cdd_egtm_app.c ****  *          TIM0CH4_ISR_PRIORITY with a pulse IRQ mode. The channel is
 303:../complex_device_driver/cdd_egtm_app.c ****  *          enabled at the end of the function.
 304:../complex_device_driver/cdd_egtm_app.c ****  *
 305:../complex_device_driver/cdd_egtm_app.c ****  *          Steps:
 306:../complex_device_driver/cdd_egtm_app.c ****  *            -# Read-modify-write the shared and per-channel registers.
 307:../complex_device_driver/cdd_egtm_app.c ****  *            -# Route P00.1 to TIM_IN4 via the pin map.
 308:../complex_device_driver/cdd_egtm_app.c ****  *            -# Set TIEM mode, no channel pairing, GPR/DSL/ISL selection.
 309:../complex_device_driver/cdd_egtm_app.c ****  *            -# Disable the LUT.
 310:../complex_device_driver/cdd_egtm_app.c ****  *            -# Enable NEWVAL IRQ with pulse mode.
 311:../complex_device_driver/cdd_egtm_app.c ****  *            -# Configure and enable the service request node.
 312:../complex_device_driver/cdd_egtm_app.c ****  *            -# Write back and enable the channel.
 313:../complex_device_driver/cdd_egtm_app.c ****  *
 314:../complex_device_driver/cdd_egtm_app.c ****  * \return  void
 315:../complex_device_driver/cdd_egtm_app.c ****  *
 316:../complex_device_driver/cdd_egtm_app.c ****  * \note    The TIM_IN_SRC register is shared across all eight TIM channels,
 317:../complex_device_driver/cdd_egtm_app.c ****  *          so the read-modify-write of MODE4/VAL4 preserves the settings of
 318:../complex_device_driver/cdd_egtm_app.c ****  *          the other channels.
 319:../complex_device_driver/cdd_egtm_app.c ****  *
 320:../complex_device_driver/cdd_egtm_app.c ****  * \see     TIM0_CH4_ISR
 321:../complex_device_driver/cdd_egtm_app.c ****  */
 322:../complex_device_driver/cdd_egtm_app.c **** /* This function initializes GTM TIM0_CH4
 323:../complex_device_driver/cdd_egtm_app.c ****  * - P00.1 (TIM_IN4) is used as the channel input
 324:../complex_device_driver/cdd_egtm_app.c ****  * - no LUT, no channel pairing (CICTRL = 0)
 325:../complex_device_driver/cdd_egtm_app.c ****  */
 326:../complex_device_driver/cdd_egtm_app.c **** void CddEgtm_InitTim0Ch4(void)
 327:../complex_device_driver/cdd_egtm_app.c **** {
 328:../complex_device_driver/cdd_egtm_app.c ****     Ifx_EGTM_CLS_TIM_CH_CTRL  timChCtrl;
 329:../complex_device_driver/cdd_egtm_app.c ****     Ifx_EGTM_CLS_TIM_CH_ECTRL timChExtCtrl;
 330:../complex_device_driver/cdd_egtm_app.c ****     Ifx_EGTM_CLS_TIM_IN_SRC   timInSrc;
 331:../complex_device_driver/cdd_egtm_app.c ****     Ifx_SRC_SRCR              srcCfg;
 332:../complex_device_driver/cdd_egtm_app.c **** 
 333:../complex_device_driver/cdd_egtm_app.c ****     /* 1. Read-modify-write the shared / per-channel registers */
 334:../complex_device_driver/cdd_egtm_app.c ****     timChCtrl.U    = EGTM_CLS0_TIM_CH4_CTRL.U;    /* UM P.8944 */
 335:../complex_device_driver/cdd_egtm_app.c ****     timChExtCtrl.U = EGTM_CLS0_TIM_CH4_ECTRL.U;   /* UM P.8957 */
 336:../complex_device_driver/cdd_egtm_app.c ****     timInSrc.U     = EGTM_CLS0_TIM_IN_SRC.U;      /* UM P.8975 (shared across all 8 TIM channels) *
 337:../complex_device_driver/cdd_egtm_app.c ****     srcCfg.U       =  SRC_EGTMTIM0SR4.U;
 338:../complex_device_driver/cdd_egtm_app.c **** 
 339:../complex_device_driver/cdd_egtm_app.c ****     /* 2. Route P00.1 to TIM_IN4 */
 340:../complex_device_driver/cdd_egtm_app.c ****     IfxEgtm_PinMap_setTimTin(&IfxEgtm_TIM0_4_P00_1_IN, IfxPort_InputMode_pullDown);
 341:../complex_device_driver/cdd_egtm_app.c **** 
 342:../complex_device_driver/cdd_egtm_app.c ****     /* 3. Channel control: TIEM mode, no pairing with adjacent channel */
 343:../complex_device_driver/cdd_egtm_app.c ****     timChCtrl.B.TIM_MODE   = 0x2u;   /* TIEM mode                              */
 344:../complex_device_driver/cdd_egtm_app.c ****     timChCtrl.B.CICTRL     = 0x0u;   /* do NOT combine with adjacent channel   */
 345:../complex_device_driver/cdd_egtm_app.c ****     timChCtrl.B.GPR0_SEL   = 0x3U;
 346:../complex_device_driver/cdd_egtm_app.c ****     timChCtrl.B.GPR1_SEL   = 0x3U;
 347:../complex_device_driver/cdd_egtm_app.c ****     timChCtrl.B.DSL   = 0x1U;
 348:../complex_device_driver/cdd_egtm_app.c ****     timChCtrl.B.ISL   = 0x1U;
 349:../complex_device_driver/cdd_egtm_app.c ****                                      /* -> uses TIM_IN(x) = TIM_IN4            */
 350:../complex_device_driver/cdd_egtm_app.c ****     timInSrc.B.MODE4       = 0x0u;   /* not forced to constant                 */
 351:../complex_device_driver/cdd_egtm_app.c ****     timInSrc.B.VAL4        = 0x0u;   /* not forced to constant                 */
 352:../complex_device_driver/cdd_egtm_app.c **** 
 353:../complex_device_driver/cdd_egtm_app.c ****     /* 4. Do not use the LUT */
 354:../complex_device_driver/cdd_egtm_app.c ****     timChExtCtrl.B.USE_LUT = 0x0u;
 355:../complex_device_driver/cdd_egtm_app.c **** 
 356:../complex_device_driver/cdd_egtm_app.c ****    // EGTM_CLS0_TIM_CH4_IRQ_NOTIFY.B.NEWVAL = 0x1U;
 357:../complex_device_driver/cdd_egtm_app.c ****     EGTM_CLS0_TIM_CH4_IRQ_EN.B.NEWVAL_IRQ_EN = 0x1U,
 358:../complex_device_driver/cdd_egtm_app.c ****     EGTM_CLS0_TIM_CH4_IRQ_MODE.B.IRQ_MODE = 0x2u;   /* pulse */
 359:../complex_device_driver/cdd_egtm_app.c **** 
 360:../complex_device_driver/cdd_egtm_app.c **** 
 361:../complex_device_driver/cdd_egtm_app.c ****     srcCfg.B.TOS  = TIM0CH4_ISR_TOS;
 362:../complex_device_driver/cdd_egtm_app.c ****     srcCfg.B.SRPN = TIM0CH4_ISR_PRIORITY;
 363:../complex_device_driver/cdd_egtm_app.c ****     SRC_EGTMTIM0SR4.U = srcCfg.U;
 364:../complex_device_driver/cdd_egtm_app.c ****     SRC_EGTMTIM0SR4.B.SRE = 0x1U;
 365:../complex_device_driver/cdd_egtm_app.c **** 
 366:../complex_device_driver/cdd_egtm_app.c ****     /* 6. Write back */
 367:../complex_device_driver/cdd_egtm_app.c ****     EGTM_CLS0_TIM_CH4_CTRL.U  = timChCtrl.U;
 368:../complex_device_driver/cdd_egtm_app.c ****     EGTM_CLS0_TIM_CH4_ECTRL.U = timChExtCtrl.U;
 369:../complex_device_driver/cdd_egtm_app.c ****     EGTM_CLS0_TIM_IN_SRC.U    = timInSrc.U;
 370:../complex_device_driver/cdd_egtm_app.c **** 
 371:../complex_device_driver/cdd_egtm_app.c ****     EGTM_CLS0_TIM_CH4_CTRL.B.TIM_EN = 0x1U;
 372:../complex_device_driver/cdd_egtm_app.c **** 
 373:../complex_device_driver/cdd_egtm_app.c **** }
 374:../complex_device_driver/cdd_egtm_app.c **** 
 375:../complex_device_driver/cdd_egtm_app.c **** /**
 376:../complex_device_driver/cdd_egtm_app.c ****  * \brief   Computes the ATOM master period from the selected frequency mode.
 377:../complex_device_driver/cdd_egtm_app.c ****  *
 378:../complex_device_driver/cdd_egtm_app.c ****  * \details Maps Inv_G.FrequencyMode to an ATOM period in ticks:
 379:../complex_device_driver/cdd_egtm_app.c ****  *            1U -> 10 kHz, 2U -> 20 kHz, 3U -> 30 kHz, default -> 10 kHz.
 380:../complex_device_driver/cdd_egtm_app.c ****  *          The period is derived as CmuClk0Frequency / target_frequency and
 381:../complex_device_driver/cdd_egtm_app.c ****  *          stored in Inv_G.PeriodTicks.
 382:../complex_device_driver/cdd_egtm_app.c ****  *
 383:../complex_device_driver/cdd_egtm_app.c ****  * \return  void
 384:../complex_device_driver/cdd_egtm_app.c ****  *
 385:../complex_device_driver/cdd_egtm_app.c ****  * \pre     Inv_G.CmuClk0Frequency has been set from
 386:../complex_device_driver/cdd_egtm_app.c ****  *          CddSys_GetEgtmCmu0Frequency().
 387:../complex_device_driver/cdd_egtm_app.c ****  *
 388:../complex_device_driver/cdd_egtm_app.c ****  * \note    Any frequency mode outside {1, 2, 3} silently falls back to
 389:../complex_device_driver/cdd_egtm_app.c ****  *          10 kHz; there is no error reporting.
 390:../complex_device_driver/cdd_egtm_app.c ****  */
 391:../complex_device_driver/cdd_egtm_app.c **** void CddEgtm_SetInverterFrequency(void)
 392:../complex_device_driver/cdd_egtm_app.c **** {
  60              	 .loc 1 392 1
