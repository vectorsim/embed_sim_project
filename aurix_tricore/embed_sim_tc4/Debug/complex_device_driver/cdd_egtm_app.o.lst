  86:../complex_device_driver/cdd_egtm_app.c **** 
  87:../complex_device_driver/cdd_egtm_app.c **** /**
  88:../complex_device_driver/cdd_egtm_app.c ****  * \brief   Phase W low-side gate drive output (ATOM CH7N, P00.6).
  89:../complex_device_driver/cdd_egtm_app.c ****  */
  90:../complex_device_driver/cdd_egtm_app.c **** #define W_L                       &IfxEgtm_ATOM0_7N_TOUT15_P00_6_OUT
  91:../complex_device_driver/cdd_egtm_app.c **** 
  92:../complex_device_driver/cdd_egtm_app.c **** /**
  93:../complex_device_driver/cdd_egtm_app.c ****  * \brief   Compute the shadow register SR0 compare value for a phase.
  94:../complex_device_driver/cdd_egtm_app.c ****  *
  95:../complex_device_driver/cdd_egtm_app.c ****  * \details Applies the signed-duty-cycle mapping used by the inverter:
  96:../complex_device_driver/cdd_egtm_app.c ****  *            SR0 = ((1 + DutyCycle) * PeriodTicks) / 2
  97:../complex_device_driver/cdd_egtm_app.c ****  *          The result is truncated to uint32.
  98:../complex_device_driver/cdd_egtm_app.c ****  *
  99:../complex_device_driver/cdd_egtm_app.c ****  * \param[in] PeriodTicks   PWM period in CMU_CLK0 ticks.
 100:../complex_device_driver/cdd_egtm_app.c ****  * \param[in] DutyCycle     Signed duty cycle in [-1.0, +1.0].
 101:../complex_device_driver/cdd_egtm_app.c ****  *
 102:../complex_device_driver/cdd_egtm_app.c ****  * \return  Compare value for the phase shadow register SR0.
 103:../complex_device_driver/cdd_egtm_app.c ****  *
 104:../complex_device_driver/cdd_egtm_app.c ****  * \note    The arguments are evaluated more than once.
 105:../complex_device_driver/cdd_egtm_app.c ****  */
 106:../complex_device_driver/cdd_egtm_app.c **** #define CAL_PHASE_PERIOD(PeriodTicks, DutyCycle)      (uint32)(((1.0F + DutyCycle) * PeriodTicks)/2
 107:../complex_device_driver/cdd_egtm_app.c **** 
 108:../complex_device_driver/cdd_egtm_app.c **** /**
 109:../complex_device_driver/cdd_egtm_app.c ****  * \brief   Compute the shadow register SR1 compare value for a phase.
 110:../complex_device_driver/cdd_egtm_app.c ****  *
 111:../complex_device_driver/cdd_egtm_app.c ****  * \details Applies the signed-duty-cycle mapping used by the inverter:
 112:../complex_device_driver/cdd_egtm_app.c ****  *            SR1 = ((1 - DutyCycle) * PeriodTicks) / 2
 113:../complex_device_driver/cdd_egtm_app.c ****  *          The result is truncated to uint32.
 114:../complex_device_driver/cdd_egtm_app.c ****  *
 115:../complex_device_driver/cdd_egtm_app.c ****  * \param[in] PeriodTicks   PWM period in CMU_CLK0 ticks.
 116:../complex_device_driver/cdd_egtm_app.c ****  * \param[in] DutyCycle     Signed duty cycle in [-1.0, +1.0].
 117:../complex_device_driver/cdd_egtm_app.c ****  *
 118:../complex_device_driver/cdd_egtm_app.c ****  * \return  Compare value for the phase shadow register SR1.
 119:../complex_device_driver/cdd_egtm_app.c ****  *
 120:../complex_device_driver/cdd_egtm_app.c ****  * \note    The arguments are evaluated more than once.
 121:../complex_device_driver/cdd_egtm_app.c ****  */
 122:../complex_device_driver/cdd_egtm_app.c **** #define CAL_PHASE_DUTY_CYCLE(PeriodTicks, DutyCycle)  (uint32)(((1.0F - DutyCycle) * PeriodTicks)/2
 123:../complex_device_driver/cdd_egtm_app.c **** 
 124:../complex_device_driver/cdd_egtm_app.c **** 
