 402:../complex_device_driver/cdd_egtm_app.c ****             Inv_G.PeriodTicks      = (uint32)(Inv_G.CmuClk0Frequency/  KHZ_30);
 403:../complex_device_driver/cdd_egtm_app.c ****             break;
 404:../complex_device_driver/cdd_egtm_app.c ****         default:
 405:../complex_device_driver/cdd_egtm_app.c ****             Inv_G.PeriodTicks      = (uint32)(Inv_G.CmuClk0Frequency/  KHZ_10);
