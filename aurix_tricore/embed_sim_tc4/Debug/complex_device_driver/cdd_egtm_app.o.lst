 409:../complex_device_driver/cdd_egtm_app.c **** 
 410:../complex_device_driver/cdd_egtm_app.c **** /**
 411:../complex_device_driver/cdd_egtm_app.c ****  * \brief   Configures ATOM cluster 0 for three-phase inverter PWM generation.
 412:../complex_device_driver/cdd_egtm_app.c ****  *
 413:../complex_device_driver/cdd_egtm_app.c ****  * \details Full ATOM channel setup:
 414:../complex_device_driver/cdd_egtm_app.c ****  *            -# DTM4/DTM5 clock select, update mode, and shadow-register
 415:../complex_device_driver/cdd_egtm_app.c ****  *               update enable.
 416:../complex_device_driver/cdd_egtm_app.c ****  *            -# PSU input select and TIM select for the shut-off path.
 417:../complex_device_driver/cdd_egtm_app.c ****  *            -# ATOM CH0 as master in SOMP mode: period and half-period in
 418:../complex_device_driver/cdd_egtm_app.c ****  *               the shadow registers, CCU0/CCU1 IRQ enabled and routed to
 419:../complex_device_driver/cdd_egtm_app.c ****  *               CPU0, output pin enabled.
 420:../complex_device_driver/cdd_egtm_app.c ****  *            -# ATOM CH5/CH6/CH7 as phases U/V/W in SOMP mode, each reset by
 421:../complex_device_driver/cdd_egtm_app.c ****  *               the master's CCU0 event, with per-phase dead time
 422:../complex_device_driver/cdd_egtm_app.c ****  *               (DTV1 / DTV2 / DTV3) and complementary high/low outputs.
 423:../complex_device_driver/cdd_egtm_app.c ****  *            -# Shut-off safe levels for each phase
 424:../complex_device_driver/cdd_egtm_app.c ****  *               (OC0_x_SR = 1, OC1_x_SR = 1, SL0_x_SR_SR = 0, SL1_x_SR_SR = 0).
 425:../complex_device_driver/cdd_egtm_app.c ****  *            -# Global AGC registers enabling shadow update, force update,
 426:../complex_device_driver/cdd_egtm_app.c ****  *               channel enable, and output enable for all used channels.
 427:../complex_device_driver/cdd_egtm_app.c ****  *
 428:../complex_device_driver/cdd_egtm_app.c ****  *          Channel map:
 429:../complex_device_driver/cdd_egtm_app.c ****  *            - ATOM CH0  : master timing reference (P02.0), not a gate drive.
 430:../complex_device_driver/cdd_egtm_app.c ****  *            - ATOM CH5  : phase U high side (P02.5).
 431:../complex_device_driver/cdd_egtm_app.c ****  *            - ATOM CH5N : phase U low  side (P00.2).
 432:../complex_device_driver/cdd_egtm_app.c ****  *            - ATOM CH6  : phase V high side (P02.6).
 433:../complex_device_driver/cdd_egtm_app.c ****  *            - ATOM CH6N : phase V low  side (P00.4).
 434:../complex_device_driver/cdd_egtm_app.c ****  *            - ATOM CH7  : phase W high side (P02.7).
 435:../complex_device_driver/cdd_egtm_app.c ****  *            - ATOM CH7N : phase W low  side (P00.6).
 436:../complex_device_driver/cdd_egtm_app.c ****  *
 437:../complex_device_driver/cdd_egtm_app.c ****  * \return  void
 438:../complex_device_driver/cdd_egtm_app.c ****  *
 439:../complex_device_driver/cdd_egtm_app.c ****  * \pre     CddSys_EnableEgtmClock(), CMU0 configuration and
 440:../complex_device_driver/cdd_egtm_app.c ****  *          Inv_G.PeriodTicks / Inv_G.DeadTimeTicks have been set by
 441:../complex_device_driver/cdd_egtm_app.c ****  *          CddEgtm_InitModule().
 442:../complex_device_driver/cdd_egtm_app.c ****  * \post    All channels are configured but not running; a host trigger is
 443:../complex_device_driver/cdd_egtm_app.c ****  *          required to start them (issued by CddEgtm_Start()).
 444:../complex_device_driver/cdd_egtm_app.c ****  *
 445:../complex_device_driver/cdd_egtm_app.c ****  * \note    The dead-time control word dtm5ChCtrl2 accumulates the DT0_x/DT1_x
 446:../complex_device_driver/cdd_egtm_app.c ****  *          enables for all three phases and is written back once. This
 447:../complex_device_driver/cdd_egtm_app.c ****  *          relies on the read at function entry having those bits clear;
 448:../complex_device_driver/cdd_egtm_app.c ****  *          call this function only on an unconfigured DTM5.
 449:../complex_device_driver/cdd_egtm_app.c ****  *
 450:../complex_device_driver/cdd_egtm_app.c ****  * \see     CddEgtm_Start
 451:../complex_device_driver/cdd_egtm_app.c ****  */
 452:../complex_device_driver/cdd_egtm_app.c ****  /* This function initializes the EGTM_CLS0_ATOM
 453:../complex_device_driver/cdd_egtm_app.c ****   * - configures CLS0_ATOM_CH0 (P02.00) as Master Channel and sets-up CCU0 & CCU1 interrupt event t
 454:../complex_device_driver/cdd_egtm_app.c ****   * - configures CLS0_ATOM_CH5     (P02.05) as Phase U_H
 455:../complex_device_driver/cdd_egtm_app.c ****   * - configures CLS0_ATOM_CH5_N   (P00_02) as Phase U_L
 456:../complex_device_driver/cdd_egtm_app.c ****   * - configures CLS0_ATOM_CH6     (P02.06) as Phase V_H
 457:../complex_device_driver/cdd_egtm_app.c ****   * - configures CLS0_ATOM_CH6_N   (P00_04) as Phase V_L
 458:../complex_device_driver/cdd_egtm_app.c ****   * - configures CLS0_ATOM_CH7     (P02.07) as Phase W_H
 459:../complex_device_driver/cdd_egtm_app.c ****   * - configures CLS0_ATOM_CH7_N   (P00_06) as Phase W_L
 460:../complex_device_driver/cdd_egtm_app.c **** */
 461:../complex_device_driver/cdd_egtm_app.c ****  void CddEgtm_InitAtomCls0(void)
