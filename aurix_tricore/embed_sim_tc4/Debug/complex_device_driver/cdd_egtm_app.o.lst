 136:../complex_device_driver/cdd_egtm_app.c **** /*------------------------------------------------Function Prototypes------------------------------
 137:../complex_device_driver/cdd_egtm_app.c **** /**************************************************************************************************
 138:../complex_device_driver/cdd_egtm_app.c **** static void CddEgtm_InitAtomCls0(void);
 139:../complex_device_driver/cdd_egtm_app.c **** static void CddEgtm_InitTim0Ch4(void);
