  75:../complex_device_driver/cdd_egtm_app.c **** #define V_H                       &IfxEgtm_ATOM0_6_TOUT6_P02_6_OUT
  76:../complex_device_driver/cdd_egtm_app.c **** 
  77:../complex_device_driver/cdd_egtm_app.c **** /**
  78:../complex_device_driver/cdd_egtm_app.c ****  * \brief   Phase V low-side gate drive output (ATOM CH6N, P00.4).
