  61:../complex_device_driver/cdd_gpio_app.c **** /**
  62:../complex_device_driver/cdd_gpio_app.c ****  * \brief   Configures P02.0 as the ATOM0 CH0 master PWM output.
  63:../complex_device_driver/cdd_gpio_app.c ****  *
  64:../complex_device_driver/cdd_gpio_app.c ****  * \details Performs both halves of the pin setup:
  65:../complex_device_driver/cdd_gpio_app.c ****  *            -# Configures the P02.0 pad as output (PCSR0 + DRVCFG).
  66:../complex_device_driver/cdd_gpio_app.c ****  *            -# Routes the eGTM TOUT0 signal to P02.0 via TOUTSEL0.SEL0,
  67:../complex_device_driver/cdd_gpio_app.c ****  *               selecting CDTM0_DTM4_0 (ATOM0 channel 0 dead-time output).
  68:../complex_device_driver/cdd_gpio_app.c ****  *
  69:../complex_device_driver/cdd_gpio_app.c ****  *          Without the TOUTSEL write the pad is enabled as an alternate
  70:../complex_device_driver/cdd_gpio_app.c ****  *          function but no eGTM signal is connected to it, so the pin
  71:../complex_device_driver/cdd_gpio_app.c ****  *          remains idle.
  72:../complex_device_driver/cdd_gpio_app.c ****  *
  73:../complex_device_driver/cdd_gpio_app.c ****  * \return  void
  74:../complex_device_driver/cdd_gpio_app.c ****  */
