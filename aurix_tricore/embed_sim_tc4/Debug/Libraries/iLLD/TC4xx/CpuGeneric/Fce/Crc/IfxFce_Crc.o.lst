 371:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *
 372:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * \retval None
 373:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *
 374:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * Get the peripheral service control register which request need to be serviced and assign this se
 375:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * \code
 376:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * //define the interrupt priority
 377:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * #define IFXASCLIN0_TX_INTPRIO 2
 378:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * //get the service request
 379:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * volatile Ifx_SRC_SRCR *src = IfxAsclin_getSrcPointerRx( &MODULE_ASCLIN0 );
 380:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * //initlaise the service request
 381:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * IfxSrc_init( src, IfxSrc_Tos_cpu0, IFXASCLIN0_TX_INTPRIO, IfxSrc_VmId_0);
 382:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * // enable the service
 383:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * IfxSrc_enable( src );
 384:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * //check for service request flags and clear if they occur
 385:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * if ( IfxSrc_isRequested( src ) == TRUE )
 386:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * {
 387:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *    IfxSrc_clearRequest( src );
 388:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * }
 389:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * if ( IfxSrc_isOverrun( src ) == TRUE )
 390:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * {
 391:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *      IfxSrc_clearOverrun( src );
 392:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * }
 393:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * // Atlast deinitialise the service control
 394:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * IfxSrc_deinit( src );
 395:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * \endcode
 396:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *
 397:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  */
 398:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** IFX_INLINE void IfxSrc_init(volatile Ifx_SRC_SRCR *src, IfxSrc_Tos typOfService, Ifx_Priority prior
 399:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
