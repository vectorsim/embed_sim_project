   4:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****  * \ingroup IfxLld_Dma
   5:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****  *
   6:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****  * \version iLLD-TC4-v2.7.0
