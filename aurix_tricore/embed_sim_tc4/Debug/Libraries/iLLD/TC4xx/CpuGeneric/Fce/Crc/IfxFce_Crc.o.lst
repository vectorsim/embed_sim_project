 214:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****  *                   IfxVadc_Adc_initChannel(&adcChannel, &adcChannelConfig);
 215:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****  *
 216:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****  *                   IfxVadc_Adc_configureWaitForReadMode(&adcChannel, TRUE);
 217:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****  *               }
 218:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****  *      }
 219:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****  *      adcGroup.group->RCR[0].B.SRGEN = 1; // interrupt when new result is available
