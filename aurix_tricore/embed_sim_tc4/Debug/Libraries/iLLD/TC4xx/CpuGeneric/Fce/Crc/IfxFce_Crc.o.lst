 459:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****     IfxDma_ChannelId channelId;       /**< \brief Specifies the DMA channel */
 460:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****     Ifx_DMA_CH      *channel;         /**< \brief Specifies the pointer to DMA channel registers */
 461:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h **** } IfxDma_Dma_Channel;
