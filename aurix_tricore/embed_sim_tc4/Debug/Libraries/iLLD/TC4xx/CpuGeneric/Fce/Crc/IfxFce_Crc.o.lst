 463:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h **** /** \brief Configuration data structure of the channel
 464:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****  */
 465:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h **** typedef struct
 466:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h **** {
 467:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****     IfxDma_Dma                      *module;                                       /**< \brief Spec
 468:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****     IfxDma_ChannelId                 channelId;                                    /**< \brief Spec
 469:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****     uint32                           sourceAddress;                                /**< \brief Sour
 470:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****     uint32                           destinationAddress;                           /**< \brief Dest
 471:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****     uint32                           shadowAddress;                                /**< \brief Init
 472:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****     uint32                           readDataCrc;                                  /**< \brief Chec
 473:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****     uint32                           sourceDestinationAddressCrc;                  /**< \brief Chec
 474:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****     uint16                           transferCount;                                /**< \brief Numb
 475:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****     IfxDma_ChannelMove               blockMode;                                    /**< \brief Numb
 476:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****     IfxDma_ChannelRequestMode        requestMode;                                  /**< \brief A se
 477:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****     IfxDma_ChannelOperationMode      operationMode;                                /**< \brief keep
