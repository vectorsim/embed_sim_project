 181:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****  *      // create group config
 182:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****  *      IfxVadc_Adc_GroupConfig adcGroupConfig;
 183:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****  *      IfxVadc_Adc_initGroupConfig(&adcGroupConfig, &vadc);
 184:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****  *
 185:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****  *      // initialize the group
 186:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****  *      //IfxVadc_Adc_Group adcGroup; // defined globally
 187:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****  *      adcGroupConfig.groupId = IfxVadc_GroupId_0;
 188:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****  *      adcGroupConfig.master = adcGroupConfig.groupId;
 189:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****  *
 190:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****  *      // enable all arbiter request sources
 191:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****  *      adcGroupConfig.arbiter.requestSlotQueueEnabled            = TRUE; // enable Queue mode
 192:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****  *      adcGroupConfig.arbiter.requestSlotScanEnabled             = TRUE; // enable Scan mode
 193:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****  *      adcGroupConfig.arbiter.requestSlotBackgroundScanEnabled   = TRUE; // enable Background scan
