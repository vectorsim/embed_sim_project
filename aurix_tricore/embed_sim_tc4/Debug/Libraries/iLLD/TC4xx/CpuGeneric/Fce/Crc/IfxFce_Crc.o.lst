 199:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****  *
 200:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****  *      IfxVadc_Adc_initGroup(&adcGroup, &adcGroupConfig);
 201:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****  *
 202:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****  *      {
 203:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Dma/IfxDma_Dma.h ****  *               // create channel config
