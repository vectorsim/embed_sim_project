 709:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      bool notFinished;
 710:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      do {
 711:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *              notFinished = false;
 712:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *                      if( IfxDma_getChannelTransferCount(chn[0].dma, chn[0].channelId) ) {
 713:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *                              notFinished = true;
 714:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *                              break;
 715:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *                      }
 716:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      } while( notFinished );
 717:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \endcode
 718:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 719:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  */
