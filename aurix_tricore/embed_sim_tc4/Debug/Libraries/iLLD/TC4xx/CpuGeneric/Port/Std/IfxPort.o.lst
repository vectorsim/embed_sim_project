 281:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.c ****     /*
 282:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.c ****      *
 283:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.c ****      * Note on the forming the variable value:
 284:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.c ****      *
 285:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.c ****      * PadDriver consists of 4 bit value where:
 286:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.c ****      *
 287:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.c ****      *  padDriver[2:0] is PD
 288:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.c ****      *  padDriver[5:3] is PL
 289:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.c ****      *
 290:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.c ****      * The SFR structure is as follows:
 291:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.c ****      *
 292:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.c ****      * DRVCFG[10:8] PD
 293:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.c ****      * DRVCFG[11:11] Reserved
 294:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.c ****      * DRVCFG[14:12] PL
 295:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.c ****      *
 296:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.c ****      * Due to the gap of 1 bit in between, the below bit manipulation circus is being done.
 297:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.c ****      *
 298:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.c ****      */
 299:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.c ****     uint32 value = ((((padDriver & 0x38U) << 1U) | (padDriver & 0x7U)) << IFX_P_PADCFG_DRVCFG_PD_OF
