 613:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** /** \brief Disable the emergency stop function.
 614:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * This function disables the emergency stop function. A check is done on port functionality.
 615:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 616:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[inout] port     Pointer to the port which should be accessed.
 617:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[in]    pinIndex Specifies the pin for which the emergency stop function should be disable
 618:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 619:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \retval TRUE If the emergency stop function has been disabled.
 620:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *         FALSE If the emergency stop function could not be disabled.
 621:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 622:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * Coding example:
 623:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * /code
 624:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *     if( !IfxPort_disableEmergencyStop(&MODULE_P33, 0) )
 625:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *     {
 626:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *         // failed to disable emergency stop for P33.0
 627:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *     }
 628:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * /endcode
 629:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 630:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \see IfxPort_disableEmergencyStop(), IfxPort_resetESR()
 631:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 632:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  */
