 246:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** /** \brief Trimming value for bandgap reference.
 247:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * 0H corresponds to a value of 1.199V
 248:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * 1H corresponds to a value of 1.184V
 249:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * 2H corresponds to a value of 1.168V
 250:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * 3H corresponds to a value of 1.153V
 251:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * 4H corresponds to a value of 1.139V
 252:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * 5H corresponds to a value of 1.125V
 253:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * 6H corresponds to a value of 1.112V
 254:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * 7H corresponds to a value of 1.098V
 255:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * 8H corresponds to a value of 1.340V
 256:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * 9H corresponds to a value of 1.321V
 257:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * AH corresponds to a value of 1.302V
 258:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * BH corresponds to a value of 1.283V
