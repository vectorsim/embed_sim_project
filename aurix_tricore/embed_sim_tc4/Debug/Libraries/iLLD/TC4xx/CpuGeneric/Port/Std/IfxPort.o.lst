 370:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu_IntrinsicsGcc.h **** IFX_INLINE uint16 Ifx__sfract_to_u16(sfract a)
 371:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu_IntrinsicsGcc.h **** {
 372:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu_IntrinsicsGcc.h ****     uint16 res;
 373:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu_IntrinsicsGcc.h ****     __asm__ volatile ("sh  %1,%1,16    \n\
 374:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu_IntrinsicsGcc.h ****                        sh  %0,%1,-16":"=d"(res):"d"(a):"memory");
 375:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu_IntrinsicsGcc.h ****     return res;
 376:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu_IntrinsicsGcc.h **** }
