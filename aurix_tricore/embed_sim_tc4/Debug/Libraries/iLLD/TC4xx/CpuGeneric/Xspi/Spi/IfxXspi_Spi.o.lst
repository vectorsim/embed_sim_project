1088:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_INLINE Ifx_CPU *IfxCpu_getAddress(IfxCpu_ResourceCpu cpu)
1089:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** {
1090:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     Ifx_CPU *module;
1091:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1092:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     if (cpu == IfxCpu_ResourceCpu_6)
