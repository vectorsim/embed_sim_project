 149:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****         if (xspiSFR->CTRLR2.B.PORTSEL == IfxXspi_SelectPort_16)
 150:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****         {
 151:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****             /* For PORT 16 highspeed mode Fxspi clock is multipled by 2 hence divider value need no
 152:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****             xspiSFR->BAUDR.B.SCKDV = (IfxClock_getXspiFrequency() / config->timing.baudrate);
 153:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****         }
 154:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****         else
 155:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****         {
 156:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****             /* Fsclk_out =	Fssi_clk/SCKDV where SCKDV is any even value between 2 and 65534 */
 157:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****             xspiSFR->BAUDR.B.SCKDV = ((IfxClock_getXspiFrequency() / config->timing.baudrate) >> 1)
 158:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****         }
 159:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****     }
