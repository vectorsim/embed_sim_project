 123:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****         spi_ctrlr0.B.CLK_STRETCH_EN   = config->enhancedControl.clockStretchEnable;         /* Cloc
 124:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****         spi_ctrlr0.B.SPI_RXDS_EN      = config->enhancedControl.spiRxdsEnable;              /* rxds
 125:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****         spi_ctrlr0.B.SPI_DM_EN        = config->enhancedControl.spiDataMaskEnable;          /* SPI 
 126:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****         spi_ctrlr0.B.SPI_RXDS_EN      = config->enhancedControl.spiRxdsEnable;              /* Read
 127:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****         spi_ctrlr0.B.INST_DDR_EN      = config->enhancedControl.instDdrEnable;              /* Inst
 128:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****         spi_ctrlr0.B.SPI_DDR_EN       = config->enhancedControl.spiDdrEnable;               /* SPI 
 129:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****         spi_ctrlr0.B.WAIT_CYCLES      = config->enhancedControl.waitCycles;                 /* Wait
 130:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****         spi_ctrlr0.B.INST_L           = config->enhancedControl.instLength;                 /* Leng
 131:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****         spi_ctrlr0.B.ADDR_L           = config->enhancedControl.addressLength;              /* Leng
 132:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****         spi_ctrlr0.B.TRANS_TYPE       = config->enhancedControl.transferFormat;             /* Addr
