 399:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c **** 
 400:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c **** void IfxXspi_Spi_fillTxBuffer(IfxXspi_Spi *xspi)
 401:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c **** {
 402:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****     Ifx_XSPI        *xspiSFR     = xspi->xspi;
 403:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****     IfxXspi_Spi_Job *job         = &xspi->job;
 404:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****     uint32           i;
 405:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****     uint32           prev_count  = 0;
 406:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****     uint32           prev_count1 = 0;
 407:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****     uint32           count;
 408:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c **** 
 409:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****     if (job->txpending)
 410:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****     {
 411:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****         if (job->txdata != NULL_PTR)
 412:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****         {
 413:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****             while ((job->txpending != 0) || ((xspiSFR->CTRLR0.B.TMOD == IfxXspi_TransferMode_TxRx) 
 414:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****             {
 415:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                 /* transmit section */
 416:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                 if ((xspiSFR->SR.B.TFNF == 1) && (job->txpending != 0))
 417:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                 {
 418:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                     count          = (uint32)(16 - xspiSFR->TXFLR.B.TXTFL);
 419:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                     count          = __min(job->txpending, count);
 420:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                     job->txpending = job->txpending - count;
 421:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c **** 
 422:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                     if (xspiSFR->CTRLR0.B.DFS <= 8)
 423:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                     {
 424:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                         IfxXspi_write8(xspiSFR, &(((uint8 *)job->txdata)[prev_count]), count);
 425:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                     }
 426:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                     else if (xspiSFR->CTRLR0.B.DFS <= 16)
 427:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                     {
 428:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                         IfxXspi_write16(xspiSFR, &(((uint16 *)job->txdata)[prev_count]), count);   
 429:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                     }
 430:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                     else
 431:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                     {
 432:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                         IfxXspi_write32(xspiSFR, &(((uint32 *)job->txdata)[prev_count]), count);   
 433:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                     }
 434:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c **** 
 435:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                     prev_count = prev_count + count;
 436:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                 }
 437:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c **** 
 438:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                 /* receive section */
 439:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                 if ((xspiSFR->CTRLR0.B.TMOD == IfxXspi_TransferMode_TxRx) && (job->rxpending != 0))
 440:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                 {
 441:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                     if (xspiSFR->SR.B.RFNE == 1)
 442:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                     {
 443:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                         uint32 count1 = (uint32)(xspiSFR->RXFLR.B.RXTFL); /* get the readable count
 444:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                         count1         = __min(job->rxpending, count1);
 445:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                         job->rxpending = job->rxpending - count1;
 446:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                         uint8 *rx = (uint8 *)(xspi->job.rxdata);
 447:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c **** 
 448:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                         while (count1 != 0)
 449:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                         {
 450:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                             rx[prev_count1] = (uint8)(xspiSFR->DR[0].U & 0xFF);
 451:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                             count1--;
 452:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                             prev_count1++;
 453:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                         }
 454:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                     }
 455:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                 }
 456:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****             }
 457:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****         }
 458:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****         else
 459:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****         {
 460:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****             count = job->txpending;
 461:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c **** 
 462:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****             for (i = 0; i < count; i++)
 463:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****             {
 464:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****                 xspiSFR->DR[0].U = (~0);
 465:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****             }
 466:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****         }
 467:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c **** 
 468:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****         while ((xspiSFR->SR.B.TFE == 0) || (xspiSFR->SR.B.BUSY == 1))
 469:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****         {}
 470:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c **** 
 471:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****         if (xspiSFR->CTRLR0.B.TMOD == IfxXspi_TransferMode_TxRx)
 472:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****         {
 473:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****             xspiSFR->SSIENR.B.SSIC_EN = IfxXspi_Dwc_Mode_Disable;       /* Disable DWC_SSI for Tx o
 474:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****         }
 475:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c **** 
 476:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****         if ((xspi->xspi->CTRLR0.B.TMOD == IfxXspi_TransferMode_Tx) && (job->txpending == 0))
 477:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****         {
 478:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****             xspiSFR->SSIENR.B.SSIC_EN = IfxXspi_Dwc_Mode_Disable;       /* Disable DWC_SSI for Tx o
 479:../Libraries/iLLD/TC4xx/CpuGeneric/Xspi/Spi/IfxXspi_Spi.c ****         }
