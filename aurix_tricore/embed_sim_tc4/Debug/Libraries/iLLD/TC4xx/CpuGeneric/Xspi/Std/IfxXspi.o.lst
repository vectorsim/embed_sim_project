 145:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *    IfxClock_sampleClockConfig.perPllConfig.k4Divider = IfxClock_K4divider_2 ;
 146:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *    IfxClock_sampleClockConfig.perPllConfig.k4PreDivider = IfxClock_K4PreDivider_divBy1_0 ;
