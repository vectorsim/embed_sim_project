1614:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  */
1615:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** IFX_INLINE uint32 IfxClock_checkSysPllLock(void);
1616:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
