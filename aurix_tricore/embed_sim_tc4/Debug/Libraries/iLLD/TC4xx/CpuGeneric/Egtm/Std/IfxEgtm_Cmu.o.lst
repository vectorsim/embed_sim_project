1821:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** /** \brief This API returns the PER PLL2 frequency based on the K3 divider value in PLLCON and the 
1822:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *  fPLL2 = (N * fIN) / (P * K3 * 1. 0) if K3PREDIV = 0
1823:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *  fPLL2 = (N * fIN) / (P * K3 * 1. 1) if K3PREDIV = 1
1824:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *  fPLL2 = (N * fIN) / (P * K3 * 1. 2) if K3PREDIV = 2
1825:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *  fPLL2 = (N * fIN) / (P * K3 * 1. 0) if K3PREDIV = 3
1826:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *  fPLL2 = (N * fIN) / (P * K3 * 1. 4) if K3PREDIV = 4
1827:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *  fPLL2 = (N * fIN) / (P * K3 * 1. 0) if K3PREDIV = 5
1828:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *  fPLL2 = (N * fIN) / (P * K3 * 1. 6) if K3PREDIV = 6
1829:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *  fPLL2 = (N * fIN) / (P * K3 * 1. 7) if K3PREDIV = 7
1830:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *  fPLL2 = (N * fIN) / (P * K3 * 1. 0) if K3PREDIV = 8
1831:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *  fPLL2 = (N * fIN) / (P * K3 * 1. 0) if K3PREDIV = 9
1832:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *  fPLL2 = (N * fIN) / (P * K3 * 2. 0) if K3PREDIV = 10
1833:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *  fPLL2 = (N * fIN) / (P * K3 * 1. 0) if K3PREDIV = 11
1834:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *  fPLL2 = (N * fIN) / (P * K3 * 1. 0) if K3PREDIV = 12
1835:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *  fPLL2 = (N * fIN) / (P * K3 * 1. 0) if K3PREDIV = 13
1836:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *  fPLL2 = (N * fIN) / (P * K3 * 1. 0) if K3PREDIV = 14
1837:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *  fPLL2 = (N * fIN) / (P * K3 * 1. 0) if K3PREDIV = 15
1838:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
1839:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \retval uint32 PER PLL2 (K3 Divider ) frequency in Hz. Range: 10000000 Hz to 500000000 Hz.
1840:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  */
1841:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** IFX_EXTERN uint32 IfxClock_getPerPllFrequency2(void);
1842:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
1843:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** /** \brief This API returns the PER PLL3 frequency based on the K4 divider value in PLLCON and the 
1844:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * fPLL3 = N * fIN / P * K4 * 1. 0 if K4PREDIV = 0
1845:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * fPLL3 = N * fIN / P * K4 * 2. 0 if K4PREDIV = 1
1846:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * fPLL3 = N * fIN / P * K4 * 1. 2 if K4PREDIV = 2
1847:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * fPLL3 = N * fIN / P * K4 * 1. 6 if K4PREDIV = 3
