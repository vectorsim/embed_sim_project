 239:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm_Tim.h ****                         * 11- State is 1 (ignore write access) */
 240:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm_Tim.h ****     uint8 value;
