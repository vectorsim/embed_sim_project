 445:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** #endif
 446:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****     egtm->CLC.B.DISR = 1u;
