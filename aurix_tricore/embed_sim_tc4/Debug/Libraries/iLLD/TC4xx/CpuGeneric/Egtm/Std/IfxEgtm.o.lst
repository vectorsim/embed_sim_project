 448:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** #if (IFX_PROT_ENABLED == 1U)
 449:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****     IfxApProt_setState((Ifx_PROT_PROT *)&egtm->CTRL.PROTE, IfxApProt_State_run);
 450:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** #endif
 451:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** #endif
