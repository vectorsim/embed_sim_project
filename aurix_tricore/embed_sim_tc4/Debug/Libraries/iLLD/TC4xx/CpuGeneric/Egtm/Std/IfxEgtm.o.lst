 491:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** IFX_INLINE void IfxEgtm_setSuspendMode(Ifx_EGTM *egtm, IfxEgtm_SuspendMode mode)
 492:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** {
 493:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****     Ifx_EGTM_OCS ocs;
 494:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** 
 495:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****     /* Remove protection and configure the suspend mode. */
 496:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****     ocs.B.SUS_P = 1u;
 497:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****     ocs.B.SUS   = (uint8)mode;
 498:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** 
 499:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****     egtm->OCS.U = ocs.U;
 500:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** }
