1067:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1068:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     cpu_pmaVal = enable ? (cpu_pmaVal | segmentNumberMask) : (cpu_pmaVal & ~segmentNumberMask); /* 
1069:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1070:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     /*The CPU_PMA registers are ENDINIT protected*/
