 302:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  * \defgroup IfxLld_Egtm_Pwm_Init_APIs Initialization APIs
 303:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  * \ingroup IfxLld_Egtm_Pwm
 304:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  * \defgroup IfxLld_Egtm_Pwm_Runtime_APIs Runtime APIs
 305:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  * \ingroup IfxLld_Egtm_Pwm
 306:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  */
