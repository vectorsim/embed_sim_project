 475:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c **** IFX_INLINE void IfxEgtm_Pwm_updateBaseChannelFrequency(IfxEgtm_Pwm *pwm, float32 requestFrequency)
 476:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c **** {
 477:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****     IfxEgtm_Pwm_Channel *channel = &pwm->channels[0];
 478:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c **** 
 479:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****     /* Calculates period ticks (round to nearest integer) */
 480:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****     uint32               periodTicks = (uint32)((float32)((pwm->sourceFrequency / requestFrequency)
 481:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c **** 
 482:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****     /* Divide by 2 for center aligned and add 1 (to reach desired value) */
 483:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****     if (pwm->alignment != IfxEgtm_Pwm_Alignment_edge)
 484:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****     {
 485:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****         periodTicks = (periodTicks >> 1) + 1;
 486:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****     }
 487:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c **** 
 488:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****     /* Copy to handle */
 489:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****     pwm->periodTicks = periodTicks;
 490:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****     pwm->frequency   = requestFrequency;
 491:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c **** 
 492:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****     /* Update shadow register */
 493:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****     *channel->registers.SR0 = periodTicks;
 494:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c **** }
 495:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c **** 
 496:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c **** 
 497:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c **** IFX_INLINE void IfxEgtm_Pwm_updateBaseChannelFrequencyImmediate(IfxEgtm_Pwm *pwm, float32 requestFr
 498:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c **** {
 499:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****     IfxEgtm_Pwm_Channel *channel = &pwm->channels[0];
 500:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c **** 
 501:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****     /* Calculates period ticks (round to nearest integer) */
 502:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****     uint32               periodTicks = (uint32)((float32)((pwm->sourceFrequency / requestFrequency)
 503:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c **** 
 504:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****     /* Divide by 2 for center aligned and add 1 (to reach desired value) */
 505:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****     if (pwm->alignment != IfxEgtm_Pwm_Alignment_edge)
 506:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****     {
 507:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****         periodTicks = (periodTicks >> 1) + 1;
 508:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****     }
 509:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c **** 
 510:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****     /* Copy to handle */
 511:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****     pwm->periodTicks = periodTicks;
 512:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****     pwm->frequency   = requestFrequency;
 513:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c **** 
 514:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****     /* Updates compare register */
 515:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****     *channel->registers.SR0 = periodTicks;
 516:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****     *channel->registers.CM0 = periodTicks;
 517:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c **** }
