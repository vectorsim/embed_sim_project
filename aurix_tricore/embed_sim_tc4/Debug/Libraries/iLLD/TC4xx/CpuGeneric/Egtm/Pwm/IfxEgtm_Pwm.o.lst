  28:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  29:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \defgroup IfxLld_Clock CLOCK
  30:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \addtogroup IfxLld_Clock
  31:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \{
  32:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \defgroup IfxLld_Clock How to use the Clock driver?
  33:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \addtogroup IfxLld_Clock
  34:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \{
  35:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  36:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * The  Clock control unit driver provides a default configuration for pll and Clock initialisation
  37:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  38:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * In the following sections it will be described, how to integrate the driver into the application
  39:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  40:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \section IfxLld_Clock_Std_Preparation Preparation
  41:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \subsection IfxLld_Clock_Std_Include Include Files
  42:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  43:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * Include following header file into your C code:
  44:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \code
  45:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * #include <Clock/Std/IfxClock.h>
  46:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \endcode
  47:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  48:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \subsection IfxLld_Clock_Std_Variables Variables
  49:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  50:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * Declare the Clock Configuration variables in your C code:
  51:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  52:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \code
  53:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * // used globally
  54:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  55:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * static const IfxClock_FlashWaitstateConfig IfxClock_defaultFlashWaitstateConfig = IFXCLOCK_CFG_F
  56:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * // Default configuration for the Clock Configuration
  57:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * IfxClock_Config                      IfxClock_testClockConfig = {
  58:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     IFX_CFG_CLOCK_XTAL_FREQUENCY,
  59:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     IFXCLOCK_CFG_SYS_PLL_INITIAL_STEP,
  60:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     IFXCLOCK_CFG_PER_PLL_INITIAL_STEP,
  61:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *  #if !defined(IFX_CLOCK_DISABLE_RAMPCON)
  62:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     {IfxClock_RampWaitTime_8us, 500},
  63:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * #endif
  64:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     IFXCLOCK_CFG_CLK_DISTRIBUTION,
  65:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     &IfxClock_defaultFlashWaitstateConfig,
  66:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     &IfxClock_defaultModConfig,
  67:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     IfxClock_PllInputClockSelection_fOsc0,
  68:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     IfxClock_SysClockSourceSelect_pll,
  69:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     IfxClock_PerClockSourceSelect_pll
  70:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * };
  71:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  72:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \endcode
  73:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  74:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \subsection IfxLld_Clock_Std_Init Module Initialisation
  75:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  76:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * The module initialisation can be done in the same function. Here an example:
  77:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \code
  78:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  79:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *        // standard PLL & clock initialisation
  80:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *         IfxClock_init(&IfxClock_testClockConfig);
  81:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \endcode
  82:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  83:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *    The SYS PLL, PER PLL1, PLL2, PLL3 and clocks are now initialised based on the XTAL and PLL va
  84:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  85:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * Alternately the PLL and clocks can be initialised using below method which provides greater cont
  86:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  87:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \code
  88:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  89:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     IfxClock_Config        IfxClock_sampleClockConfig;
  90:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  91:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     IfxClock_initConfig(&IfxClock_sampleClockConfig);
  92:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  93:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  94:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  95:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   // To change xtal frequency dynamically during run time:
  96:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   // current xtal frequency is stored in global variable IfxClock_xtalFrequency.
  97:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   // In Ifx_cfg.h file, use below define
  98:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   #define IFX_CFG_CLOCK_XTAL_FREQUENCY (IfxClock_xtalFrequency)
  99:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     // IfxClock_sampleClockConfig.xtalFrequency = IFX_CFG_CLOCK_XTAL_FREQUENCY ;
 100:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
 101:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *       //select the clock source that is used for the clock generation of fsource1/ 2/3
 102:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *       IfxClock_sampleClockConfig.PerClockSourceSelect = IfxClock_PerClockSourceSelect_pll; //Ifx
 103:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
 104:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *      //selects the clock source that is used for the clock generation of fsource0
 105:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *       IfxClock_sampleClockConfig.SysClockSourceSelect = IfxClock_SysClockSourceSelect_pll; //Ifx
 106:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
 107:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *       //select the primary clock source for the System PLL
 108:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *       IfxClock_sampleClockConfig.pllInputClockSelection = IfxClock_PllInputClockSelection_fOsc0;
 109:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
 110:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *       // Configure PER PLL1,2,3
 111:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *       // fPLL1 = N * fIN / P * K2 * 1. 0 -> K2PREDIV = 0
