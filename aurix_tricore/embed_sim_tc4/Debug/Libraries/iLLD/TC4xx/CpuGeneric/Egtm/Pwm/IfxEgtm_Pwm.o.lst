1089:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****     /* Subtract old phase value and add new value */
1090:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****     uint32               dutyTicks = (channel->dutyTicks - channel->phaseTicks) + phaseTicks;
1091:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h **** 
1092:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****     /* Copy to handle */
1093:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****     channel->phaseTicks = phaseTicks;
1094:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****     channel->dutyTicks  = dutyTicks;
1095:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h **** 
1096:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****     dutyTicks           = (dutyTicks <= pwm->periodTicks) ? dutyTicks : dutyTicks - pwm->periodTick
1097:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h **** 
1098:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****     /* Update compare register */
1099:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****     *channel->registers.SR0 = phaseTicks;
1100:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****     *channel->registers.SR1 = dutyTicks;
1101:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****     *channel->registers.CM0 = phaseTicks;
1102:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****     *channel->registers.CM1 = dutyTicks;
