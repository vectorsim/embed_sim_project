 303:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****         /* TOM 0..15 connects to DTM 0..3 */
 304:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****         dtmSFR = &clusterSFR->CDTM.DTM[(uint8)((uint8)channel >> (uint8)2u)];
