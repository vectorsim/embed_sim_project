 245:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     \endcode
 246:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  * \subsection IfxLld_Egtm_Pwm_Sync Synchronised Groups
 247:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  * There is a possibility of having two PWM groups synchronised to each other. E.g. One may be used
 248:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  * The procedure to configure PWM remians same apart from one difference. User shall disable the bo
 249:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     \code
 250:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     config.syncStart = FALSE;    // Don't Start all channels after init
 251:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     \endcode
 252:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  * Then, follow the Step 3 for both PWM groups.\n
 253:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  * Now, the two groups are ready to be started. They will be started by calling a special API which
 254:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     \code
 255:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     // Pass two PWM handles
 256:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     IfxEgtm_Pwm_startSyncedGroups(&pwm1, &pwm2);
 257:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     \endcode
 258:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  * Now, the PWM is being generated correspoding to both groups.\n\n
 259:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  * One more special API exists for updating frequency of two synchronised groups at once since ther
 260:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     \code
 261:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     // Pass two handles and requested frequency
 262:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     IfxEgtm_Pwm_updateSyncedGroupsFrequency(&pwm1, &pwm2, 50000.0f);
 263:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     \endcode
 264:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  * For updating phase and duty, there is no special API and user can use the earlier discussed APIs
 265:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  * \subsection IfxLld_Egtm_Pwm_Trigger Trigger ADC from PWM channels
 266:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  * The PWM driver doesn't provide any way to configure a PWM channel to trigger ADC. Instead, users
 267:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     \code
 268:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     //=====================================
 269:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     // 1. Include the Trigger interface
 270:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     //=====================================
 271:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     #include "Egtm/Trigger/IfxEgtm_Trigger.h"
 272:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     //=====================================
 273:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     // 2. Initialize and start PWM as normal
 274:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     //=====================================
 275:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     //=====================================
 276:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     // 3. Connect to ADC
 277:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     //=====================================
 278:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     // Pass the cluster, submodule, trigger channel (Atom/Tom channel number) to be used and tri
 279:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     result = IfxEgtm_Trigger_trigToAdc(IfxEgtm_Cluster_0, IfxEgtm_TrigSource_atom, IfxEgtm_TrigC
 280:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     \endcode
 281:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  * For more information, users are requested to refer to UM and Trigger driver interface.
 282:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  * \subsection IfxLld_Egtm_Pwm_HighRes High Res capability in eGTM
 283:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  * This section will describe how to use High Res capability (capability exists exclusively for eGT
 284:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  * While doing step 2, do the following:
 285:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     \code
 286:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     // Attach hrpwm pin instead of atom pin
 287:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     output[0].pin = (IfxEgtm_Pwm_ToutMap*)&IfxEgtm_HRPWM0_CH0_F_P02_0_OUT;     // Output pin con
 288:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     // Either enable atom high res or dtm high res or disable both
 289:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     config.highResEnable        = TRUE;         // Enable Atom high res mode
 290:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     config.dtmHighResEnable;    = FALSE;        // Disable high res in DTM module
 291:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *     \endcode
 292:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  * Rest everything remains same as discussed earlier.
 293:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  *
 294:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  * \defgroup IfxLld_Egtm_Pwm PWM Driver
 295:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  * \ingroup IfxLld_Egtm
 296:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****  * \defgroup IfxLld_Egtm_Pwm_Enumerations Enumerations
