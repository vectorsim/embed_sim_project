 448:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** #if (IFX_PROT_ENABLED == 1U)
 449:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****     IfxApProt_setState((Ifx_PROT_PROT *)&egtm->CTRL.PROTE, IfxApProt_State_run);
 450:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** #endif
 451:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** #endif
 452:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** }
 453:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** 
 454:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** 
 455:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** IFX_INLINE void IfxEgtm_enable(Ifx_EGTM *egtm)
 456:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** {
 457:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** #if defined(IFX_PROT_ENABLED)
 458:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** #if (IFX_PROT_ENABLED == 1U)
 459:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****     IfxApProt_setState((Ifx_PROT_PROT *)&egtm->CTRL.PROTE, IfxApProt_State_config);
 460:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** #endif
 461:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** #endif
 462:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****     egtm->CLC.B.DISR = 0u;
 463:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** #if defined(IFX_PROT_ENABLED)
 464:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** #if (IFX_PROT_ENABLED == 1U)
 465:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****     IfxApProt_setState((Ifx_PROT_PROT *)&egtm->CTRL.PROTE, IfxApProt_State_run);
 466:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** #endif
 467:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** #endif
 468:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** }
 469:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** 
 470:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** 
 471:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** IFX_INLINE boolean IfxEgtm_isEnabled(Ifx_EGTM *egtm)
 472:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** {
 473:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****     boolean enabled;
 474:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****     enabled = (egtm->CLC.B.DISS == (uint8)0u) ? TRUE : FALSE;
 475:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****     return enabled;
 476:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** }
 477:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** 
 478:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** 
 479:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** IFX_INLINE boolean IfxEgtm_isModuleSuspended(Ifx_EGTM *egtm)
 480:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** {
 481:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****     Ifx_EGTM_OCS ocs;
 482:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** 
 483:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****     /* Read the status */
 484:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****     ocs.U = egtm->OCS.U;
 485:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** 
 486:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****     /* Return the status */
 487:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****     return ocs.B.SUSSTA;
 488:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** }
 489:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** 
