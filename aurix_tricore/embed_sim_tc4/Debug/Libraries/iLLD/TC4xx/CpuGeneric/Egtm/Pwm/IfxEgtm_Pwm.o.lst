1085:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h **** 
1086:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****     /* Phase in ticks = period * (phase in radian / (2 * pi)) */
1087:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.h ****     uint32               phaseTicks = (uint32)((float32)(((float32)pwm->periodTicks * requestPhase 
