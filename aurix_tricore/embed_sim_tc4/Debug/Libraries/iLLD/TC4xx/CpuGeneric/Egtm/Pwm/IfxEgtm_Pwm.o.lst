 293:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c **** {
 294:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****     Ifx_EGTM_CLS_CDTM_DTM *dtmSFR;
 295:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c **** 
 296:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****     if (subModule == IfxEgtm_Pwm_SubModule_atom)
 297:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****     {
 298:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****         /* ATOM 0..7 connects to DTM 4..5 */
 299:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****         dtmSFR = &clusterSFR->CDTM.DTM[(uint8)((uint8)channel >> (uint8)2u) + 4u];
 300:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****     }
 301:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Pwm/IfxEgtm_Pwm.c ****     else    /* TOM */
