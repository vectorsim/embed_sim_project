 509:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** IFX_INLINE uint32 IfxEgtm_getClusterFrequency(Ifx_EGTM *egtm, IfxEgtm_Cluster cluster)
 510:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** {
 511:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****     uint32 Freq;
 512:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****     uint8  clsDiv = 0u;
 513:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****     clsDiv = (uint8)(((egtm->CLS->ARCH.CLK_CFG.U) >> ((uint8)cluster << 1u)) & 0x3U);
 514:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** 
 515:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****     if (clsDiv == 0u)
 516:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****     {
 517:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****         Freq = (uint32)0u; /* cluster is disabled - return 0 */
 518:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****     }
 519:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****     else
 520:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****     {
 521:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****         Freq = IfxEgtm_getSysClkFrequency() / clsDiv;
 522:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****     }
 523:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** 
 524:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h ****     return Freq;
 525:../Libraries/iLLD/TC4xx/CpuGeneric/Egtm/Std/IfxEgtm.h **** }
