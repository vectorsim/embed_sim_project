 144:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     IfxSrc_TrigSet_spa  = 2,  /**< \brief TriggerSet 2 : TS16_SPA Service Provider Activity selecte
