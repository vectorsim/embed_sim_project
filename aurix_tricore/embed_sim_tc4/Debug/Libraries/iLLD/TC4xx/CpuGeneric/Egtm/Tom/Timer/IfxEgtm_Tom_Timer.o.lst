  87:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *     dmaChConfig.destinationAddress = IFXCPU_GLB_ADDR_DSPR(IfxCpu_getCoreId(), &destinationBuffer
