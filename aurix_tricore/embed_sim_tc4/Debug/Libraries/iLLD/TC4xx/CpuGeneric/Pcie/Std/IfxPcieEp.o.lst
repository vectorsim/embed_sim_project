1010:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****     while (pcie->CLC.B.DISS != 0u)
1011:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****     {
1012:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****         /* wait here until the module is enabled */
1013:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****         /* TODO: disable warning : this is needed */
