 451:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Rc/IfxPcie_Rc.c ****     }
 452:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Rc/IfxPcie_Rc.c **** 
 453:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Rc/IfxPcie_Rc.c ****     if (epIndex == 0u)
 454:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Rc/IfxPcie_Rc.c ****     {
 455:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Rc/IfxPcie_Rc.c ****         status = IfxPcie_Status_failure;                                                        /* 
 456:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Rc/IfxPcie_Rc.c ****     }
 457:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Rc/IfxPcie_Rc.c **** 
 458:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Rc/IfxPcie_Rc.c ****     return status;
 459:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Rc/IfxPcie_Rc.c **** }
