 280:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Rc/IfxPcie_Rc.c ****             /* 6.2 Write the device ID, vendor ID */
 281:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Rc/IfxPcie_Rc.c ****             IfxPcieDevice_setDeviceId((IfxPcieDevice_CfgHdr *)rcDevice->cfgHeader, rcCfg->deviceId)
 282:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Rc/IfxPcie_Rc.c ****             IfxPcieDevice_setVendorId((IfxPcieDevice_CfgHdr *)rcDevice->cfgHeader, rcCfg->vendorId)
 283:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Rc/IfxPcie_Rc.c ****             rcDevice->deviceId = rcCfg->deviceId;
 284:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Rc/IfxPcie_Rc.c ****             rcDevice->vendorId = rcCfg->vendorId;
 285:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Rc/IfxPcie_Rc.c **** 
 286:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Rc/IfxPcie_Rc.c ****             /* 6.3 Write the Command Header registers */
 287:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Rc/IfxPcie_Rc.c ****             IfxPcieDevice_CfgHdrCommand cmdReg;
 288:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Rc/IfxPcie_Rc.c ****             cmdReg.U          = cfgHdr->command.U;
 289:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Rc/IfxPcie_Rc.c ****             cmdReg.B.ioEnable = FALSE;   /* IO space is disabled by default */
 290:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Rc/IfxPcie_Rc.c ****             cfgHdr->command.U = cmdReg.U;
 291:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Rc/IfxPcie_Rc.c ****         }
