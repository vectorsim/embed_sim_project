 434:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Rc/IfxPcie_Rc.c ****         }
 435:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Rc/IfxPcie_Rc.c ****         else if (bridgeDiscovered == TRUE)                                                      /* 
 436:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Rc/IfxPcie_Rc.c ****         {
 437:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Rc/IfxPcie_Rc.c ****             busNum           = tempSubBus + 1;
