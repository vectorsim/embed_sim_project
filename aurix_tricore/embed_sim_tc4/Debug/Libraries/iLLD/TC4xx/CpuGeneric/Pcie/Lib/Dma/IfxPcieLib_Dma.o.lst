1004:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** IFX_INLINE void IfxPcie_enableModule(IfxPcie *pcieSFR)
1005:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** {
1006:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****     Ifx_PCIE_DSP *pcie = (Ifx_PCIE_DSP *)pcieSFR;
1007:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** 
1008:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****     pcie->CLC.B.DISR = 0u;
1009:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** 
1010:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****     while (pcie->CLC.B.DISS != 0u)
1011:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****     {
1012:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****         /* wait here until the module is enabled */
1013:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****         /* TODO: disable warning : this is needed */
1014:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****     }
1015:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** }
1016:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** 
1017:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** 
1018:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** IFX_INLINE void IfxPcie_resetModule(IfxPcie *pcieSFR)
1019:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** {
1020:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****     Ifx_PCIE_DSP_RST *pcieRst = &(pcieSFR->DSP.RST);
1021:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** 
1022:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****     /* Request a new Reset */
1023:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****     pcieRst->CTRLA.B.KRST = 1u;
1024:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****     pcieRst->CTRLB.B.KRST = 1u;
1025:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** 
1026:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****     /* Ensure Reset occurred */
1027:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****     while (pcieRst->STAT.B.KRST == 0u)
1028:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****     {
1029:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****         /* Wait here until Reset happens */
1030:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****     }
1031:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** 
1032:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****     /* Clear the Reset Status */
1033:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****     pcieRst->CTRLB.B.STATCLR = 1u;
1034:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** 
1035:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****     /* Wait until KRST is cleared, only after this reset sequence is completed */
1036:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****     while (pcieRst->STAT.B.KRST == 1u)
1037:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****     {}
1038:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** }
1039:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** 
