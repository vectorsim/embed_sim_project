 213:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** /** \brief ATU Region Lock Status
 214:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****  */
 215:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** typedef enum
 216:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** {
 217:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****     IfxPcie_AtuLock_unlocked = 0xAA,  /**< \brief ATU Region is unlocked */
 218:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****     IfxPcie_AtuLock_locked   = 0x55   /**< \brief ATU Region is locked */
 219:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** } IfxPcie_AtuLock;
