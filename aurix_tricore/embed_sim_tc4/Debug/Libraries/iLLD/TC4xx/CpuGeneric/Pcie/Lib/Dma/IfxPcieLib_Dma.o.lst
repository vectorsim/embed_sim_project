 209:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****     IfxPcie_AtuDirection_inBound,  /**< \brief Inbound ATU Region */
 210:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****     IfxPcie_AtuDirection_outBound  /**< \brief Outbound ATU Region */
 211:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** } IfxPcie_AtuDirection;
