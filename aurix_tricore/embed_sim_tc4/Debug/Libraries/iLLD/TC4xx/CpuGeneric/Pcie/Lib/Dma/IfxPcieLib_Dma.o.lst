 223:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** typedef enum
 224:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** {
 225:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****     IfxPcie_AtuOutBoundRegion_none = -1,  /**< \brief no ATU outbound */
 226:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****     IfxPcie_AtuOutBoundRegion_0,          /**< \brief iATU Region 0 */
