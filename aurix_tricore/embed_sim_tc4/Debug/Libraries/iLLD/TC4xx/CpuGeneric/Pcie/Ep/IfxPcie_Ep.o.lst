 765:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 766:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief API to get random value.
 767:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 768:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[inout] seed Pointer to seed value.
