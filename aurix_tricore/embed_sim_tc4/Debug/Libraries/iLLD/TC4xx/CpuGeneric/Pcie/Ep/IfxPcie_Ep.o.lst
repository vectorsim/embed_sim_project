 127:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** /** \brief Interrupt Request Trigger Offset
 128:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****  */
 129:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** #define IFXPCIE_INTREQTRIG_BAR0_WORD_OFFSET   ((uint32)(0x0u))
 130:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** 
 131:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** /** \brief Interrupt Request Trigger Status
 132:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****  */
 133:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** #define IFXPCIE_INTREQSTATUS_BAR0_WORD_OFFSET ((uint32)(0x1u))
 134:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** 
 135:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** /** \brief PCI Capability list offset for Bridges, EP and RC
 136:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****  */
 137:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** #define IFXPCIE_PCI_CAPABILITY_LIST_OFFSET    (0x34)
 138:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** 
 139:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** /** \brief Get word size from size in bytes
 140:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****  */
 141:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** #define IFXPCIE_GET_WORDSIZE(x)                               (uint32)(x >> 2u)
 142:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** 
 143:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** /** \brief Get BAR mem size from BAR registers
 144:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****  */
 145:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** #define IFXPCIE_GET_BAR_MEMSIZE(x)                            (uint64)(x >> 4u)
 146:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** 
 147:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** /** \brief Get new wire memory from BAR memory size
 148:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****  */
 149:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** #define IFXPCIE_GET_WIREADDR_FROMBAR(wireMemBase, barMemSize) (((uint64)(wireMemBase % barMemSize) 
 150:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** 
 151:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** /** \brief Get number of MSI interrupts from enum
 152:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****  */
 153:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** #define IFXPCIE_GET_NUM_MSI_INTERRUPTS(msiInt)                ((uint16)(0x1u << (uint16)msiInt))
 154:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** 
 155:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** /** \brief Get the next 1 MB boundary
 156:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****  */
 157:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** #define IFXPCIE_GET_NEXT_1MB_BOUNDARY(x)                      ((((x) & 0x000FFFFFu) == 0u) ? (x) : 
 158:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** 
 159:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** /** \brief Get the next 4KB boundary
 160:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****  */
 161:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** #define IFXPCIE_GET_NEXT_4KB_BOUNDARY(x)                      ((((x) & 0x00000FFFu) == 0u) ? (x) : 
 162:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** 
 163:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** /** \brief Get PHY Index for selected PCIE module index
 164:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****  * TC49x: PCIE0 is connected to PHY0
 165:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****  * TC4Dx: PCIE0 is connected to PHY0 and PCIE1 is connected to PHY2
 166:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****  */
 167:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** #if (IFXPCIE_CFG_NUM_MODULES >1)
 168:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** #define IFXPCIE_GET_PHY_INDEX(pcieIndex)                      ((IfxHsphy_PhyIndex)((IfxPcie_Index)(
 169:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** #else
 170:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** #define IFXPCIE_GET_PHY_INDEX(pcieIndex)                      (IfxHsphy_PhyIndex_2)
 171:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** #endif /* #if (IFXPCIE_CFG_NUM_MODULES >1) */
 172:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** 
 173:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** /** \brief In TC49x, CFG Write is posted and CFG Read is non-posted. Sometimes, the Read can overta
 174:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****  * Hence, we need to wait for write to complete to avoid reading old values from same register.
 175:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****  */
 176:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** #define IFXPCIE_CONFIGWRITE_DELAY(loopCount)       \
 177:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****     {                                              \
 178:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****         volatile uint32 idx;                       \
 179:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****         for (idx = 0; idx < loopCount; idx++) {; } \
 180:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h ****     }                                              \
 181:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Std/IfxPcie.h **** 
