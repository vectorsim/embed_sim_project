 316:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     Ifx_PCIE_USP               *pcie       = config->pcieSFR;
 317:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     IfxPcieDevice_Type0CfgHdr  *cfgHdr     = (IfxPcieDevice_Type0CfgHdr *)&(pcie->TYPE0HDR);
 318:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     epHandle->state       = IfxPcie_Ep_State_unknown;
 319:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     epHandle->pcieSFR     = config->pcieSFR;
 320:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     epHandle->index       = config->index;
 321:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     epFunction->cfgHeader = cfgHdr;
 322:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** 
 323:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     /* STEP 1: Enable the Module */
 324:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     IfxPcie_enableModule((IfxPcie *)pcie);
 325:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** 
 326:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     /* STEP 2: Set device type to EP */
 327:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     IfxPcie_setDeviceMode((IfxPcie *)pcie, IfxPcie_DeviceMode_ep);
 328:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     epHandle->pcieSFR = config->pcieSFR;
 329:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** 
 330:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     /* STEP 3: Reset the Module */
 331:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     IfxPcie_resetModule((IfxPcie *)pcie);
 332:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** 
 333:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     /* STEP 4: Wait for HSPHY */
 334:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     if (config->hsphySFR != NULL_PTR)
 335:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     {
 336:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         epHandle->hsphySFR = config->hsphySFR;
 337:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** 
 338:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         /* Wait for HSPHY to give the clock */
 339:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** #if IFXPCIE_CFG_ENABLE_PHY == 1
 340:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         IfxHsphy_PhyIndex phyIndex = IFXPCIE_GET_PHY_INDEX(epHandle->index);
 341:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         IfxPcie_waitForHsphy(epHandle->hsphySFR, phyIndex);
 342:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** #endif
 343:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** 
 344:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         /* Enable Link Training */
 345:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** #if IFXPCIE_CFG_RTL_VIP == (1)
 346:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         IfxPcie_enableLtssm((IfxPcie *)pcie);
 347:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** 
 348:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         while (IfxPcie_isLinkUp((IfxPcie *)pcie) == FALSE)          /* check if Link is up */
 349:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         {
 350:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****             /* TODO: Disable warning, this is needed */
 351:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         }
 352:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** 
 353:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** #endif
 354:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         initStatus = IfxPcie_Status_success;
 355:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     }
 356:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** 
 357:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     if (initStatus == IfxPcie_Status_success)
 358:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     {
 359:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         /* STEP 5: Enable DBI access */
 360:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         IfxPcie_setDbiRoAccess((IfxPcie *)pcie, TRUE);
 361:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** #if IFXPCIE_CFG_RTL_VIP == (0)
 362:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         /* STEP 6: Do not allow Link Training - setting up Device now */
 363:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         IfxPcieEp_resetLinkTraining(pcie);
 364:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** #endif
 365:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         /* STEP 7: Initialize the EP Device for protocol */
 366:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         {
 367:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****             /* 7.1 Write the device ID, vendor ID */
 368:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****             IfxPcieDevice_setDeviceId((IfxPcieDevice_CfgHdr *)epFunction->cfgHeader, config->epFunc
 369:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****             IfxPcieDevice_setVendorId((IfxPcieDevice_CfgHdr *)epFunction->cfgHeader, config->epFunc
 370:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** 
 371:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****             /* 7.2: PCIE Configure BAR */
 372:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****             initStatus = IfxPcie_Ep_allocateBarMemories(epHandle, &(config->barRegion[0]));
 373:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** 
 374:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****             /* 7.3: Probe Capabilities */
 375:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****             IfxPcieLib_Cap_probeCapabilities(&(epFunction->capabilities), (IfxPcieDevice_CfgHdr *)e
 376:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         }
 377:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** 
 378:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         if (initStatus == IfxPcie_Status_success)
 379:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         {
 380:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****             /* STEP 8: Interrupt Reception Initialization */
 381:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****             initStatus = IfxPcie_Ep_initInterrupts(epHandle, config);
 382:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** 
 383:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****             /* STEP 9: Update Handle with Memory Accesses (Before Enumeration) */
 384:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****             if ((config->outBoundRegion != NULL_PTR)
 385:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****                 && (initStatus == IfxPcie_Status_success))
 386:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****             {
 387:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****                 epHandle->numOutBoundMemRegions = config->numOutBoundRegions;
 388:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****                 uint8 memIndex;
 389:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** 
 390:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****                 for (memIndex = 0; memIndex < config->numOutBoundRegions; memIndex++)
 391:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****                 {
 392:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****                     IfxPcie_Ep_Mem    *memHandlePtr = &(epHandle->outBoundMemRegion[memIndex]);
 393:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****                     IfxPcie_Ep_MemCfg *memCfgPtr    = &(config->outBoundRegion[memIndex]);
 394:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****                     memHandlePtr->wireMemBase  = memCfgPtr->wireMemBase;
 395:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****                     memHandlePtr->localMemBase = memCfgPtr->localMemBase;
 396:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****                     memHandlePtr->size         = memCfgPtr->size;
 397:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****                     memHandlePtr->atuRegion    = memCfgPtr->atuRegion;
 398:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****                     memHandlePtr->enabled      = FALSE;                         /* Disable now, ena
 399:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****                 }
 400:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****             }
 401:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****             else
 402:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****             {
 403:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****                 epHandle->numOutBoundMemRegions = 0x0u;                         /* No outbound regi
 404:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****             }
 405:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         }
 406:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     }
 407:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** 
 408:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     /* STEP 10: Disable DBI access */
 409:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     IfxPcie_setDbiRoAccess((IfxPcie *)pcie, FALSE);
 410:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** 
 411:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     return initStatus;
 412:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** }
