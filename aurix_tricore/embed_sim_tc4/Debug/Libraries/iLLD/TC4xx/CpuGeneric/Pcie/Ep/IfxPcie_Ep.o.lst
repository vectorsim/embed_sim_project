 279:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     if (status == IfxPcie_Status_success)
 280:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     {
 281:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         epHandle->state = IfxPcie_Ep_State_initialized;
 282:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** #if IFXPCIE_CFG_RTL_VIP == (0)
 283:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         IfxPcie_Ep_initLink(epHandle);                                  /* Initialize the link */
 284:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** 
 285:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         while (IfxPcie_isLinkUp((IfxPcie *)epHandle->pcieSFR) == FALSE) /* check if Link is up */
 286:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         {}
 287:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** 
 288:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** #endif
 289:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     }
 290:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** 
 291:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     if (status == IfxPcie_Status_success)
 292:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     {
 293:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         if (config->pollForEnumeration == TRUE)
 294:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         {
 295:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****             status = IfxPcie_Ep_initPostEnumeration(epHandle);
 296:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         }
 297:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         else
 298:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         {
 299:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****             epHandle->busMasterAccess = FALSE;
 300:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         }
 301:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     }
 302:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** 
 303:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     if (status == IfxPcie_Status_failure)
 304:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     {
 305:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****         epHandle->state = IfxPcie_Ep_State_configError;
 306:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     }
 307:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** 
 308:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c ****     return status;
 309:../Libraries/iLLD/TC4xx/CpuGeneric/Pcie/Ep/IfxPcie_Ep.c **** }
