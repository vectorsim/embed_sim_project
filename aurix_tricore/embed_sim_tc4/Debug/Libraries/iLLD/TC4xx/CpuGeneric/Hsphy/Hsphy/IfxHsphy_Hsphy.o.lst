 141:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c ****         if ((hsphy->hsphyData[index]->hsphyCfg.padInterface == IfxHsphy_PadNativeInterface_xspiPads
 142:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c ****         {
