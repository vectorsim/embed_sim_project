 144:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c ****             xspiConfig  = (IfxHsphy_Xspi_XspiCfg *)hsphy->hsphyData[index]->hsphyCfg.cfgData;
 145:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c ****             retvalCheck = IfxHsphy_Xspi_xspiInit(hsphy->hsphySFR, xspiConfig);
