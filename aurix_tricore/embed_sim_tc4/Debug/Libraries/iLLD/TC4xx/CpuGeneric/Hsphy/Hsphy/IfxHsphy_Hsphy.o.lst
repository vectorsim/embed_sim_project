  91:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c ****     uint32                     timeoutCycleCount = IFXHSPHY_MAX_TIMEOUT;
  92:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c ****     uint8                      timeOutError      = 0U;
  93:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c **** 
  94:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c ****     Ifx_HSPHY                 *hsphySFR          = config->hsphySFR;
  95:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c ****     hsphy->hsphySFR = hsphySFR;
  96:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c ****     boolean                    retvalCheck       = FALSE;
  97:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c **** 
  98:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c ****     /* Check the validity of connection for module. Lookup if it is a valid config for chipset */
  99:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c **** #if defined(DEVICE_TC49XN) || defined(DEVICE_TC49XNAA) || defined(DEVICE_TC46X) || defined(DEVICE_T
 100:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c ****     for (index = IFXHSPHY_START_INDEX; index <= IFXHSPHY_END_INDEX; index++)
 101:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c **** #elif defined(DEVICE_TC4DX)
 102:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c ****     for (index = 0; index < IFXHSPHY_NUM_OF_PHY; index++)
 103:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c **** #elif defined(DEVICE_TC4ZX)
 104:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c ****     for (index = 0; index < IFXHSPHY_ACTUAL_NUM_OF_PHY; index++)
 105:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c **** #else	
 106:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c ****     for (index = IFXHSPHY_START_INDEX; index < IFXHSPHY_END_INDEX; index++)
 107:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c **** #endif /* #if defined(DEVICE_TC49XN) || defined(DEVICE_TC49XNAA) || defined(DEVICE_TC46X) || define
