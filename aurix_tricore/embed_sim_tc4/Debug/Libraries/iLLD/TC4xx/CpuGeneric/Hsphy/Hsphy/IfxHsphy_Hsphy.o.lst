 131:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c **** 
 132:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c **** #if defined(DEVICE_TC4DX) || defined(DEVICE_TC48XAA) || defined(DEVICE_TC48X) || defined(DEVICE_TC4
 133:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c **** #if defined(DEVICE_TC4DX)
 134:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c ****     for (index = 0; index < IFXHSPHY_NUM_OF_PHY; index++)
 135:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c **** #elif defined(DEVICE_TC48XAA) || defined(DEVICE_TC48X) || defined(DEVICE_TC44X)
 136:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c ****     for (index = IFXHSPHY_START_INDEX; index < IFXHSPHY_END_INDEX; index++)
