  80:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c ****     IfxHsphy_status            retval            = IfxHsphy_status_success;
  81:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c ****     uint8                      index             = 0;
  82:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c **** #if IFXHSPHY_IS_GETH_AVAILABLE	
  83:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c ****     const IfxHsphy_GethXpcsParams *xpcsConfig;
  84:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c ****     IfxHsphy_Geth_RgmiiCfg        *rgmiiConfig;
  85:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c ****     IfxHsphy_Geth_MiiCfg          *miiConfig;
  86:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c ****     IfxHsphy_Geth_RmiiCfg         *rmiiConfig;
  87:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Hsphy/IfxHsphy_Hsphy.c ****     IfxHsphy_Xspi_XspiCfg         *xspiConfig;
