 105:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** /** \brief Ifx_P output modification modes definition.
 106:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  */
