  61:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Std/IfxHsphy.h **** /** \brief Sets the value given for respective bit field
  62:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Std/IfxHsphy.h ****  */
  63:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Std/IfxHsphy.h **** #define IFXHSPHY_SET_FIELD_VALUE(Reg, bitfield, value) (((value) & (IFX_HSPHY_##Reg##_##bitfield##_
  64:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Std/IfxHsphy.h **** 
  65:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Std/IfxHsphy.h **** /** \brief defines the Max time out for the wait
  66:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Std/IfxHsphy.h ****  */
  67:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Std/IfxHsphy.h **** #ifndef IFXHSPHY_MAX_TIMEOUT
  68:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Std/IfxHsphy.h **** #define IFXHSPHY_MAX_TIMEOUT ((uint32)(1000000u))
  69:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Std/IfxHsphy.h **** #endif
  70:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Std/IfxHsphy.h **** 
  71:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Std/IfxHsphy.h **** /** \brief time out logic for the wait / delay
  72:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Std/IfxHsphy.h ****  * param timeOutValue time out value for wait
  73:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Std/IfxHsphy.h ****  * param timeOutStatus return status for time out error
  74:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Std/IfxHsphy.h ****  */
  75:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Std/IfxHsphy.h **** #define IFXHSPHY_LOOP_TIMEOUT_CHECK(timeOutValue, timeOutStatus) \
  76:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Std/IfxHsphy.h ****     {                                                            \
  77:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Std/IfxHsphy.h ****         if (((uint32)--timeOutValue) <= 0)                       \
  78:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Std/IfxHsphy.h ****         {                                                        \
  79:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Std/IfxHsphy.h ****             timeOutStatus = (uint8)1;                            \
  80:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Std/IfxHsphy.h ****             break;                                               \
  81:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Std/IfxHsphy.h ****         }                                                        \
  82:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Std/IfxHsphy.h ****         else                                                     \
  83:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Std/IfxHsphy.h ****         {                                                        \
  84:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Std/IfxHsphy.h ****         }                                                        \
  85:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Std/IfxHsphy.h ****     }
  86:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Std/IfxHsphy.h **** 
  87:../Libraries/iLLD/TC4xx/CpuGeneric/Hsphy/Std/IfxHsphy.h **** /******************************************************************************/
