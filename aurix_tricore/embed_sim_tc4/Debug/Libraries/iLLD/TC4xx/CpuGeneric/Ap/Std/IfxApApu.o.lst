 267:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h **** 
 268:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h **** /** \brief Initializes the APU
 269:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h ****  * Configures the APU with the config value passed.
 270:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h ****  * It is possible to provide multiple masters the access
 271:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h ****  * In case of VM and PRS by default all VMs/PRS sets have access,
 272:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h ****  * The init API will clear this and provide access to only the VMs/PRS sets configured
 273:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h ****  * This API needs the respective PROT to be in the init or in the config state
 274:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h ****  * \param accen pointer to the APU registers
 275:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h ****  * \param config config pointer to the default APU configuration structure.
 276:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h ****  * \return None
 277:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h ****  */
 278:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h **** IFX_EXTERN void IfxApApu_init(volatile Ifx_ACCEN_ACCEN *accen, IfxApApu_ApuConfig *config);
 279:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h **** 
 280:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h **** /** \brief Initializes the default configuration for the APU
 281:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h ****  * \param config config pointer to the default APU configuration structure.
 282:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h ****  * \return None
 283:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h ****  */
 284:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h **** IFX_EXTERN void IfxApApu_initConfig(IfxApApu_ApuConfig *config);
 285:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h **** 
 286:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h **** /** \brief Initializes the APU and the memory registers
 287:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h ****  * Configures the APU with the config value passed.
 288:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h ****  * This API needs to be used to configure the APU which has shadow registers
 289:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h ****  * It is possible to provide multiple masters the access
 290:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h ****  * In case of VM and PRS by default all VMs/PRS sets have access,
 291:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h ****  * The init API will clear this and provide access to only the VMs/PRS sets configured
 292:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h ****  * This API needs the respective PROT to be in the init or in the config state
 293:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h ****  * \param accen pointer to the APU registers
 294:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h ****  * \param config config pointer to the default APU configuration structure.
 295:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h ****  * \param protReg PROT Register address pointer
 296:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h ****  * \param accenIndex The accen index which needs to be configured
 297:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h ****  * \return None
 298:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h ****  */
 299:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h **** IFX_EXTERN void IfxApApu_configMemoryAccess(volatile Ifx_ACCEN_ACCEN *accen, IfxApApu_ApuMemoryConf
 300:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h **** 
