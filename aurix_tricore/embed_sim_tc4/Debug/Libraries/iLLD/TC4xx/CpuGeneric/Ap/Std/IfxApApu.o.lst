 309:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h ****  * \return None
 310:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h ****  */
 311:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h **** IFX_EXTERN void IfxApApu_configureAccessToDlmus(IfxApApu_ApuMemoryConfig *memConfig);
 312:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h **** 
 313:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h **** /** \brief API to configure access to all masters to all DSPRs
 314:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h ****  * \return None
 315:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h ****  */
 316:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h **** IFX_EXTERN void IfxApApu_configureAccessToDsprs(IfxApApu_ApuMemoryConfig *memConfig);
 317:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h **** 
 318:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h **** /** \brief API to configure access to all masters to all PSPRs
 319:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h ****  * \return None
 320:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h ****  */
 321:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h **** IFX_EXTERN void IfxApApu_configureAccessToPsprs(IfxApApu_ApuMemoryConfig *memConfig);
