 305:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h **** IFX_EXTERN void IfxApApu_configureAccessToLmus(IfxApApu_ApuMemoryConfig *memConfig);
 306:../Libraries/iLLD/TC4xx/CpuGeneric/Ap/Std/IfxApApu.h **** #endif /* #ifdef IFXAP_NUM_LMU */
