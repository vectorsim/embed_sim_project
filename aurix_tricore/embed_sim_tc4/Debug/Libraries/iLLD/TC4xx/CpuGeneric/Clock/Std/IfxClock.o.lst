 794:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** uint32 IfxClock_getAsclinSFrequency(void)
 795:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** {
 796:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****     uint32 freq             = 0;
 797:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****     uint32 source           = 0;
 798:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** 
 799:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****     uint8  asclinclkdiv[16] = {1, 1, 2, 3, 4, 5, 6, 6, 8, 8, 10, 10, 12, 12, 12, 15};
 800:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****     uint8  actualDiv        = CLOCK_PERCCUCON1.B.ASCLINSDIV;
 801:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** 
 802:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****     switch (CLOCK_PERCCUCON1.B.CLKSELASCLINS)
 803:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****     {
 804:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****     case 1:
 805:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****     {
 806:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****         source = IfxClock_getPerSourceFrequency(IfxClock_Fsource_1); /* fPLL1 */
 807:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** 
 808:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****         if (actualDiv)
 809:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****         {
 810:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****             freq = source / asclinclkdiv[actualDiv];
 811:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****         }
 812:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****     }
 813:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****     break;
 814:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****     case 2:
 815:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****     {
 816:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****         freq = IfxClock_getOsc0Frequency(); /* fXTAL1 */
 817:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****     }
 818:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****     break;
 819:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****     default:
 820:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****         freq = 0U;
 821:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****         break;
 822:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****     }
 823:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** 
 824:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****     return freq;
 825:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** }
 826:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** 
