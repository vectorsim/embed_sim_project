 829:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** uint32 IfxClock_getCpbFrequency(void)
 830:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** {
 831:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****     uint32 cpbFrequency    = 0;
 832:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****     uint32 sourceFrequency = 0;
 833:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****     uint8  clkdiv[16]      = {4, 1, 2, 3, 4, 5, 6, 6, 8, 8, 10, 10, 12, 12, 12, 15};
 834:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****     uint8  actualDiv       = CLOCK_SYSCCUCON0.B.CPBDIV;
 835:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** 
 836:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****     if (actualDiv != 0)
 837:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****     {
 838:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****         sourceFrequency = IfxClock_getSysSourceFrequency();
 839:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** 
 840:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****         if (CLOCK_SYSCCUCON0.B.LPDIV == 0)
 841:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****         {
 842:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****             cpbFrequency = sourceFrequency / clkdiv[actualDiv];
 843:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****         }
 844:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****         else
 845:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****         {
 846:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****             cpbFrequency = sourceFrequency / 120;
 847:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****         }
 848:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****     }
 849:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** 
 850:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****     return cpbFrequency;
 851:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** }
