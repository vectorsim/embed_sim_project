3040:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****     nInt = nTotal - nFrac;
3041:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** 
