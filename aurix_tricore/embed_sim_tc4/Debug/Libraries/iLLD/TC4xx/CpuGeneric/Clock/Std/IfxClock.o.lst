3044:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****     nFrac = IFXCLOCK_TWO_POWER_TWELVE_CONSTANT * nFrac;
3045:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** 
3046:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****     /* Now get the CLOCK_APLLCON2 value */
