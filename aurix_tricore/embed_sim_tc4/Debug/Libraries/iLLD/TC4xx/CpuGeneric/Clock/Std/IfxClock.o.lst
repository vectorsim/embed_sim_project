3112:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** float32 IfxClock_computeApllFreqFromNDivRegVal(uint32 nDivRegValue)
3113:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** {
3114:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** 	Ifx_CLOCK *clock = &MODULE_CLOCK;
3115:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** 	float32 apllFreq;
3116:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** 	uint32 nInt;
3117:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** 	float32 nTotal, nFrac;
3118:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** 	uint64     oscFreq;
3119:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** 
3120:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** 	nInt = (nDivRegValue>>IFX_CLOCK_APLLCON2_NDIV_OFF)+1;
3121:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** 	nFrac = (float32)(nDivRegValue & IFX_CLOCK_APLLCON2_NDIV_FRAC_MSK)/IFXCLOCK_TWO_POWER_TWELVE_CONST
3122:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** 
3123:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** 	nTotal = nInt+nFrac;
3124:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** 
3125:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** 	oscFreq = IfxClock_getOscFrequency();
3126:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** 	
3127:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** 	apllFreq = (float32)((nTotal*oscFreq)/((clock->APLLCON1.B.KDIV+1)*(clock->APLLCON0.B.PDIV + 1)));
3128:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** 
3129:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c ****     return apllFreq;
3130:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** 	
3131:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.c **** }
