  81:../Libraries/iLLD/TC4xx/CpuGeneric/Leth/Std/IfxLeth.h **** /** \brief MTL Tx Queue AV algorithm
  82:../Libraries/iLLD/TC4xx/CpuGeneric/Leth/Std/IfxLeth.h ****  * Definition in MTL_TXQi_ETS_CONTROL.B.AVALG, i >= 1
