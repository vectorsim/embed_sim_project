1063:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** IFX_INLINE uint32 IfxPort_getGroupState(Ifx_P *port, uint8 pinIndex, uint16 mask)
1064:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** {
1065:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****     return (uint32)((port->IN.U) >> (pinIndex)) & mask;
1066:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** }
1067:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** 
1068:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** 
1069:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** IFX_INLINE boolean IfxPort_getPinState(Ifx_P *port, uint8 pinIndex)
1070:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** {
1071:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** #if defined(IFX_ILLD_TC_USAGE)
1072:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****     return __getbit(&port->IN.U, pinIndex);
1073:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** #else
1074:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****     return (boolean)((port->IN.U >> pinIndex) & 1U);
1075:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** #endif /* defined(IFX_ILLD_TC_USAGE) */
1076:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** }
1077:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** 
1078:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** 
1079:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** IFX_INLINE void IfxPort_setGroupState(Ifx_P *port, uint8 pinIndex, uint16 mask, uint16 data)
1080:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** {
1081:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****     port->OUT.U = (port->OUT.U & ~((uint32)(mask)) << pinIndex) | (data << pinIndex);
1082:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** }
