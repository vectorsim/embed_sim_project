  86:../Libraries/iLLD/TC4xx/CpuGeneric/Leth/Std/IfxLeth.h ****     IfxLeth_AvAlgorithm_strict = 0,  /**< \brief Strict Priority */
  87:../Libraries/iLLD/TC4xx/CpuGeneric/Leth/Std/IfxLeth.h ****     IfxLeth_AvAlgorithm_cbs    = 1   /**< \brief Credit Based Shaper */
