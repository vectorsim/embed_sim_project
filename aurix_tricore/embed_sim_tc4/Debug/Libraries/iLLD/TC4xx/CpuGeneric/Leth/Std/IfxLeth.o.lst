  92:../Libraries/iLLD/TC4xx/CpuGeneric/Leth/Std/IfxLeth.h ****  * Definition in bits PORT_SEL and Q_CH_MAPPING_EN of Ifx_LETH_BRIDGE_ETHBR_FWD_CTRL_REG
  93:../Libraries/iLLD/TC4xx/CpuGeneric/Leth/Std/IfxLeth.h ****  */
  94:../Libraries/iLLD/TC4xx/CpuGeneric/Leth/Std/IfxLeth.h **** typedef enum
