  68:../Libraries/iLLD/TC4xx/CpuGeneric/Geth/Std/IfxGeth.h **** /** \brief MDIO Wait Completion logic
  69:../Libraries/iLLD/TC4xx/CpuGeneric/Geth/Std/IfxGeth.h ****  */
  70:../Libraries/iLLD/TC4xx/CpuGeneric/Geth/Std/IfxGeth.h **** #define IFXGETH_MDIO_LOOP_TIMEOUT_CHECK(timeOutValue, timeOutStatus) \
  71:../Libraries/iLLD/TC4xx/CpuGeneric/Geth/Std/IfxGeth.h ****     {                                                                \
  72:../Libraries/iLLD/TC4xx/CpuGeneric/Geth/Std/IfxGeth.h ****         if (((uint32)--timeOutValue) <= 0)                           \
  73:../Libraries/iLLD/TC4xx/CpuGeneric/Geth/Std/IfxGeth.h ****         {                                                            \
  74:../Libraries/iLLD/TC4xx/CpuGeneric/Geth/Std/IfxGeth.h ****             timeOutStatus = TRUE;                                    \
  75:../Libraries/iLLD/TC4xx/CpuGeneric/Geth/Std/IfxGeth.h ****             break;                                                   \
  76:../Libraries/iLLD/TC4xx/CpuGeneric/Geth/Std/IfxGeth.h ****         }                                                            \
  77:../Libraries/iLLD/TC4xx/CpuGeneric/Geth/Std/IfxGeth.h ****     }
  78:../Libraries/iLLD/TC4xx/CpuGeneric/Geth/Std/IfxGeth.h **** 
