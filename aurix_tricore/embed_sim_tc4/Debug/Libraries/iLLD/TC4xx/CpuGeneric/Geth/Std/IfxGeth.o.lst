  85:../Libraries/iLLD/TC4xx/CpuGeneric/Geth/Std/IfxGeth.h **** #define IFXGETH_LPIMODE_LOOP_TIMEOUT_CHECK(timeOutValue, timeOutStatus)    IFXGETH_MDIO_LOOP_TIMEOU
  86:../Libraries/iLLD/TC4xx/CpuGeneric/Geth/Std/IfxGeth.h **** 
  87:../Libraries/iLLD/TC4xx/CpuGeneric/Geth/Std/IfxGeth.h **** /** \brief Wait time for remote wake-up filter i.e bit RWKPTR to increment
  88:../Libraries/iLLD/TC4xx/CpuGeneric/Geth/Std/IfxGeth.h ****  */
  89:../Libraries/iLLD/TC4xx/CpuGeneric/Geth/Std/IfxGeth.h **** #define IFXGETH_RWKFILTPTR_LOOP_TIMEOUT_CHECK(timeOutValue, timeOutStatus) IFXGETH_MDIO_LOOP_TIMEOU
