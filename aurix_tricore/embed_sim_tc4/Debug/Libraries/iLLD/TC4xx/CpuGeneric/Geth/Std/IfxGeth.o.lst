 141:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** {
 142:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     IfxSrc_TrigSet_none = 0,  /**< \brief No TriggerSet Selected */
 143:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     IfxSrc_TrigSet_is   = 1,  /**< \brief TriggerSet 1 : TS16_IS Interrupt Selection selected */
 144:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     IfxSrc_TrigSet_spa  = 2,  /**< \brief TriggerSet 2 : TS16_SPA Service Provider Activity selecte
