  81:../Libraries/iLLD/TC4xx/CpuGeneric/Geth/Std/IfxGeth.h **** #define IFXGETH_L3L4FILTER_LOOP_TIMEOUT_CHECK(timeOutValue, timeOutStatus) IFXGETH_MDIO_LOOP_TIMEOU
  82:../Libraries/iLLD/TC4xx/CpuGeneric/Geth/Std/IfxGeth.h **** 
  83:../Libraries/iLLD/TC4xx/CpuGeneric/Geth/Std/IfxGeth.h **** /** \brief EEE LPI Mode entry/exit wait logic
