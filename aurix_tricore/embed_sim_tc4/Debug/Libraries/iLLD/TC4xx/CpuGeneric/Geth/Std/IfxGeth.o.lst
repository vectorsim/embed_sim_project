1072:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     /*When changing the value of the CPU_PMAx registers both the instruction and data caches should
1073:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     /*Write to PMA1 register for selecting the cacheability for data cache*/
1074:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     __dsync();      /* DSYNC instruction should be executed immediately prior to the MTCR */
