 129:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** /** \brief MACRO to set the trigger configuration in the register
 130:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****  */
 131:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** #define IFXADC_WRITETRIGCFG(reg, delayCount, mode, trigSel) \
 132:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****     (reg.U = (uint32)((uint32)(delayCount << 16u) |         \
 133:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****                       (uint32)(mode << 6u) |                \
 134:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****                       (uint32)(trigSel)))
 135:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** 
