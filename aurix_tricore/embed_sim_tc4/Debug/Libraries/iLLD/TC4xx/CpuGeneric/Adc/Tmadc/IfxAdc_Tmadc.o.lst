 479:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Tmadc/IfxAdc_Tmadc.c ****     /* Enable EMUX */
 480:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Tmadc/IfxAdc_Tmadc.c ****     chCfgReg.B.EMUXEN = config->enableEmux;
