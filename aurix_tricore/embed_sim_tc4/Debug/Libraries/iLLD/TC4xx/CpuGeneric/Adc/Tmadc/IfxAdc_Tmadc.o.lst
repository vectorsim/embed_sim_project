1593:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** /** \brief API to wait for requested duration along with watchdog service to avoid any reset case d
1594:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
1595:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \param[in] timeSec Time interval to wait in seconds.
1596:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
1597:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \retval None
1598:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  */
1599:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** IFX_INLINE void IfxClock_waitWithWdtService(float32 timeSec);
1600:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** #endif
