3714:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** 
3715:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** IFX_INLINE void IfxAdc_haltCdspCore(Ifx_ADC_CDSP *cdsp, IfxAdc_CdspCore coreId)
3716:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** {
3717:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****     Ifx__imaskldmst((void *)&cdsp->GLOBHCD.U, 1u, coreId, 1u);
3718:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** 
3719:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****     /* Wait for core to go in halt state */
3720:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****     while (!(cdsp->GLOBHSTD.U & (1u << coreId)))
3721:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****     {}
3722:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** }
3723:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** 
3724:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** 
3725:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** IFX_INLINE void IfxAdc_loadCdspMemory(void *srcAddr, void *destAddr, uint16 size)
3726:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** {
3727:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****     if ((srcAddr != NULL_PTR) && (destAddr != NULL_PTR))
3728:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****     {
3729:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****         uint32 *src_long  = (uint32 *)srcAddr;
3730:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****         uint32 *dest_long = (uint32 *)destAddr;
3731:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** 
3732:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****         /* To check if address is 4 byte aligned */
3733:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****         if (!((uint32)src_long & 0x03U) && !((uint32)dest_long & 0x03U))
3734:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****         {
3735:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****             /* Transfer 4 bytes */
3736:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****             while (size >= 4u)
3737:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****             {
3738:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****                 *dest_long++ = *src_long++;
3739:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****                 size        -= 4u;
3740:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****             }
3741:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** 
3742:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****             /* 8 bit access not allowed in ICCM and DCCM.
3743:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****              * hence clearing and Writing valid data in word.
3744:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****              */
3745:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****             if (size != 0u)
3746:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****             {
3747:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****                 uint32 src_data = *src_long;
3748:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** 
3749:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****                 /* Reading 32 bit data from source address
3750:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****                  * Extract only required data and clear remaining bytes.
3751:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****                  */
3752:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****                 src_data   = src_data & ~(0xFFFFFFU << (size * 8));
3753:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****                 *dest_long = src_data;
3754:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****             }
3755:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****         }
3756:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****     }
3757:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** }
3758:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** 
3759:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** 
