 461:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Tmadc/IfxAdc_Tmadc.c ****                 IFX_ASSERT(IFX_VERBOSE_LEVEL_ERROR, (errorNode != bndryNode));
 462:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Tmadc/IfxAdc_Tmadc.c ****                 IfxAdc_Tmadc_enableChannelEvent(channel, bndryNode, IfxAdc_TmadcEventSel_boundary);
 463:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Tmadc/IfxAdc_Tmadc.c ****             }
