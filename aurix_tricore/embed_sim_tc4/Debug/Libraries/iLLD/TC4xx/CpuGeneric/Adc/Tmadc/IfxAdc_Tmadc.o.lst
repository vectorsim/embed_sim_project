 125:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Tmadc/IfxAdc_Tmadc.c ****     tmadc->modSFR     = modptr;
 126:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Tmadc/IfxAdc_Tmadc.c ****     tmadc->state      = IfxAdc_Tmadc_moduleState_unknown;
