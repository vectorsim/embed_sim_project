 720:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Tmadc/IfxAdc_Tmadc.c **** 	result.result    = channel->rsltSFR->B.RESULT;
 721:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Tmadc/IfxAdc_Tmadc.c ****     result.timeStamp = channel->tmstmpSFR->B.TIMESTAMP;
