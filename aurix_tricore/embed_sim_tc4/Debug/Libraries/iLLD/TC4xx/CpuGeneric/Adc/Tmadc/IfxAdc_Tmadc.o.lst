3709:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** IFX_INLINE void IfxAdc_resetCdspCore(Ifx_ADC_CDSP *cdsp, IfxAdc_CdspCore coreId)
3710:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** {
3711:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****     Ifx__imaskldmst((void *)&cdsp->GLOBRD.U, 1u, coreId, 1u);
3712:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** }
