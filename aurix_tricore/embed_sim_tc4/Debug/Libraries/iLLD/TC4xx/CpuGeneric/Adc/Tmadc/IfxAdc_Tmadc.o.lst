1161:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** /** \brief Return and clear a channel transfer interrupt flag.
1162:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * The flag is automatically cleared with the call to this function.
1163:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
1164:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[inout] dma       Pointer to DMA module.
1165:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[in]    channelId DMA channel number. Range: \ref IfxDma_ChannelId.
1166:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
1167:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \retval TRUE If the interrupt flag is set.
1168:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *         FALSE If the interrupt flag is not set.
1169:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
1170:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \code
1171:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      // wait for the end of transaction for intended channel by checking the channel interrupt f
1172:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      // and clear it once it is set and checked
1173:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
1174:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      // Wait till end of the transaction
1175:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      while(!(IfxDma_getAndClearChannelInterrupt(chn[2].dma, chn[2].channelId)));
1176:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \endcode
1177:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
