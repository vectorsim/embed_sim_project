 119:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Tmadc/IfxAdc_Tmadc.c ****     Ifx_ADC                              *adcmodptr      = config->adcSFR;
 120:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Tmadc/IfxAdc_Tmadc.c ****     Ifx_ADC_TMADC                        *modptr         = &(adcmodptr->TMADC[moduleId]);
 121:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Tmadc/IfxAdc_Tmadc.c ****     volatile Ifx_SRC_SRCR                *src            = NULL_PTR;
 122:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Tmadc/IfxAdc_Tmadc.c ****     IfxAdc_TmadcServReq                   reqNode        = IfxAdc_TmadcServReq_none;
