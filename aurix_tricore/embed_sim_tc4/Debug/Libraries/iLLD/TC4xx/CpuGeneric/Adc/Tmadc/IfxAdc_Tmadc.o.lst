 484:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Tmadc/IfxAdc_Tmadc.c ****         modptr->RSLT[rsltReg].CFG.U = resCfgReg.U;
 485:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Tmadc/IfxAdc_Tmadc.c ****         chptr->STC.U                = chStcReg.U;
