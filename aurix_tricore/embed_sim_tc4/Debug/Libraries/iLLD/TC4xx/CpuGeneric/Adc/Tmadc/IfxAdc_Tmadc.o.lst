 916:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     IfxClock_PerClockSourceSelect_pll  = 0, /**< \brief Peripheral Clock Source select : pll */
 917:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     IfxClock_PerClockSourceSelect_back = 1  /**< \brief Peripheral Clock Source select : Backup clo
 918:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** } IfxClock_PerClockSourceSelect;
 919:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
 920:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** /** \brief selects the primary clock source for the System PLL
 921:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * Register : CCUCON.B.INSEL ;
 922:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * 0: BACK / back-up clock is used as clock source
 923:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * 1: OSC0 / fOSC0 is used as clock source
 924:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * 2: SYSCLK / SYSCLK pin is used as clock source
 925:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * 3: fOSC_F is used as clock source
 926:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  */
 927:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** typedef enum
 928:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** {
 929:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     IfxClock_PllInputClockSelection_back    = 0,  /**< \brief PLL Clock Source select : Backup cloc
 930:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     IfxClock_PllInputClockSelection_fOsc0   = 1,  /**< \brief PLL Clock Source select : XTAL / fosc
 931:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     IfxClock_PllInputClockSelection_fSysclk = 2,  /**< \brief PLL Clock Source select : SYS clock (
 932:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     IfxClock_PllInputClockSelection_fOsc_f  = 3   /**< \brief PLL Clock Source select : XTAL / fosc
 933:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** } IfxClock_PllInputClockSelection;
 934:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
 935:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** /** \brief reflect the ramping frequency status of the ramping oscillator. They automatically chang
 936:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * Register : RAMPSTAT.B.FSTAT ;
 937:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * 00B InBet / The ramping oscillator's output frequency is between the base frequency and the uppe
 938:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * 01B AtBase / The ramping oscillator's output frequency equals the base frequency which is 100 MH
 939:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * 10B AtTop / The ramping oscillator's output frequency equals the upper frequency limit.
