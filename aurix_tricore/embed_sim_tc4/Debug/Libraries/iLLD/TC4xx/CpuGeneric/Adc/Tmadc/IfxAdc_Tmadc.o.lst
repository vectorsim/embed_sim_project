 135:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Tmadc/IfxAdc_Tmadc.c ****     /* Read registers */
 136:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Tmadc/IfxAdc_Tmadc.c ****     modCfg.U         = modptr->MODCFG.U;
 137:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Tmadc/IfxAdc_Tmadc.c **** 
 138:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Tmadc/IfxAdc_Tmadc.c ****     modCfg.B.BND0UPD = config->shadowBnd0Update;
 139:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Tmadc/IfxAdc_Tmadc.c ****     modCfg.B.BND1UPD = config->shadowBnd1Update;
 140:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Tmadc/IfxAdc_Tmadc.c **** 
 141:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Tmadc/IfxAdc_Tmadc.c ****     /* Output supervisor signal selection */
 142:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Tmadc/IfxAdc_Tmadc.c ****     modCfg.B.OSSEL = config->outputSignalSel;
