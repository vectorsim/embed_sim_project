1485:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \retval IfxClock_RampFreqStatus Ramp frequency  status. Range: \ref IfxClock_RampFreqStatus.
1486:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
1487:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *  00B InBet / The ramping oscillator's output frequency is between the base frequency and the upp
1488:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *  01B AtBase / The ramping oscillator's output frequency equals the base frequency which is 100 M
1489:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *  10B AtTop / The ramping oscillator's output frequency equals the upper frequency limit.
1490:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  */
1491:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** IFX_INLINE IfxClock_RampFreqStatus IfxClock_getRampFreqStatus(void);
1492:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
1493:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** /** \brief API to get current Ramp sequence status.
1494:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
1495:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \retval IfxClock_RampSeqStatus Ramp sequence status. Range: \ref IfxClock_RampSeqStatus.
1496:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
1497:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *  00B Idle / Frequency constant, not changing
1498:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *  01B RampUp / Frequency increasing
1499:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *  10B RampDown / Frequency decreasing
1500:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  */
1501:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** IFX_INLINE IfxClock_RampSeqStatus IfxClock_getRampSeqStatus(void);
