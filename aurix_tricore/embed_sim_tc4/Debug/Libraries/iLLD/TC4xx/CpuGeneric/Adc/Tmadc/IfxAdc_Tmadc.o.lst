3761:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** {
3762:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****     cdsp->RESEVCLR[reg].B.RESEVCLR = (1u << coreId);
3763:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** }
3764:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** 
3765:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** 
3766:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** IFX_INLINE boolean IfxAdc_getCdspCoreHaltStatus(Ifx_ADC_CDSP *cdsp, IfxAdc_CdspCore coreId)
3767:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** {
3768:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****     boolean event = FALSE;
3769:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** 
3770:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****     if ((cdsp->GLOBHSTD.U & (1u << coreId)) != 0u)
3771:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****     {
3772:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****         event = TRUE;
3773:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****     }
3774:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** 
3775:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****     return event;
3776:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** }
3777:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** #endif /* #if IFXADC_IS_CDSP_AVAILABLE */
