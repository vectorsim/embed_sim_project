 781:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     if (!localBufferFull)
 782:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     {
 783:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         dsp->queue.validResult += readIndex;
