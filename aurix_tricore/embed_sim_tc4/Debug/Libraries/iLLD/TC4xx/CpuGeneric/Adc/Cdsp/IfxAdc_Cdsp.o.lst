 747:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****                 while (readIndex < fillLevel)
 748:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****                 {
