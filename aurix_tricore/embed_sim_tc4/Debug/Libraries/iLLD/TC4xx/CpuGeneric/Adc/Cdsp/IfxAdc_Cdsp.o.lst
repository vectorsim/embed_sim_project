 129:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** /** \brief MACRO to set the trigger configuration in the register
 130:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****  */
 131:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** #define IFXADC_WRITETRIGCFG(reg, delayCount, mode, trigSel) \
 132:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****     (reg.U = (uint32)((uint32)(delayCount << 16u) |         \
 133:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****                       (uint32)(mode << 6u) |                \
 134:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****                       (uint32)(trigSel)))
 135:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** 
 136:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** /** \brief MACRO to set the APU assignment in the resource allocation register
 137:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****  */
 138:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** #define IFXADC_SETRESALLOCCFG(reg, resourceId, apuId)                                    \
 139:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****     (reg.U = (uint32)((reg.U & ~(IFX_ADC_RESALLOC_GLOB_GLOB_MSK << (resourceId * 4u))) | \
 140:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****                       (uint32)(apuId << (resourceId * 4u))))
 141:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** 
 142:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** /** \brief Macro for monitor channel offset
 143:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****  */
 144:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** #define IFXADC_TMADC_MCH_OFFSET (16U)
 145:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** 
