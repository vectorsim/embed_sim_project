 786:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     {
 787:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         /* valid result should not access buffer size */
