 847:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****             localReadIndex = ((localReadIndex + 1u) >= bufferSize) ? 0u : (localReadIndex + 1u);
 848:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         }
