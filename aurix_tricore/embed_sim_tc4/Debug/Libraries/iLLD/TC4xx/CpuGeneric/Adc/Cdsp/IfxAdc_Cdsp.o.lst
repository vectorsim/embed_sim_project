 830:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     IfxAdc_Status status           = IfxAdc_Status_success;
 831:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     uint16        localReadIndex   = dsp->queue.readIndex;
 832:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     uint16        localValidResult = dsp->queue.validResult;
 833:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     uint16       *resultbufferPtr  = (uint16 *)(dsp->queue.bufferPtr);
