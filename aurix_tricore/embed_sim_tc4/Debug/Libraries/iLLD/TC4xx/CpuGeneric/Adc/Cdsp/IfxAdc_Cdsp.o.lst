 132:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c **** {
 133:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     uint16 bufferSize = 1u;
