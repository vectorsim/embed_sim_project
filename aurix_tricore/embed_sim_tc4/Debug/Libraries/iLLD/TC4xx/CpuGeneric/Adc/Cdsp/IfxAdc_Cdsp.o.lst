 644:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h **** /** \brief Enumeration describing BufferSize
 645:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****  * Note: Enum matches the DMA circular buffer size limitations.
 646:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****  * Possible buffer sizes of the circular buffer can be (1,2,4,8..64K)
 647:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****  */
 648:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h **** typedef enum
 649:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h **** {
 650:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****     IfxAdc_Cdsp_BufferSize_none  = 0,   /**< \brief Buffer not configured */
 651:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****     IfxAdc_Cdsp_BufferSize_2     = 1,   /**< \brief Buffer Size is 2 byte */
 652:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****     IfxAdc_Cdsp_BufferSize_4     = 2,   /**< \brief Buffer size is 4 byte */
 653:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****     IfxAdc_Cdsp_BufferSize_8     = 3,   /**< \brief Buffer size is 8 byte */
 654:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****     IfxAdc_Cdsp_BufferSize_16    = 4,   /**< \brief Buffer size is 16 byte */
 655:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****     IfxAdc_Cdsp_BufferSize_32    = 5,   /**< \brief Buffer size is 32 byte */
 656:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****     IfxAdc_Cdsp_BufferSize_64    = 6,   /**< \brief Buffer size is 64 byte */
 657:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****     IfxAdc_Cdsp_BufferSize_128   = 7,   /**< \brief Buffer size is 128 byte */
 658:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****     IfxAdc_Cdsp_BufferSize_256   = 8,   /**< \brief Buffer size is 256 byte */
 659:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****     IfxAdc_Cdsp_BufferSize_512   = 9,   /**< \brief Buffer size is 512 byte */
