 778:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     dsp->queue.writeIndex = localWriteIndex;
 779:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     dsp->queue.bufferFull = localBufferFull;
