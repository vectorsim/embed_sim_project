 814:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         /* Read immediate result from buffer based on read index */
 815:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         result                  = resultbufferPtr[localReadIndex];
 816:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         localReadIndex          = ((localReadIndex + 1u) >= bufferSize) ? 0u : (localReadIndex + 1u
 817:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         dsp->queue.readIndex    = localReadIndex;                                                  
