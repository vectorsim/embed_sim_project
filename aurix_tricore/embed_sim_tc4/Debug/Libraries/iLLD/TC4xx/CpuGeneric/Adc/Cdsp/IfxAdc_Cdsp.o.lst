 750:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****                     tempResVal                       = dspSfrPtr->RES[IfxAdc_CdspResultReg_0].U;
 751:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****                     resultbufferPtr[localWriteIndex] = (uint16)tempResVal;                         
 752:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****                     localWriteIndex                  = ((localWriteIndex + 1u) >= bufferSize) ? 0u 
 753:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****                     readIndex++;
 754:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c **** 
 755:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****                     resultbufferPtr[localWriteIndex] = (uint16)(tempResVal >> IFX_ADC_CDSP_DSP_RES_
 756:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****                     localWriteIndex                  = ((localWriteIndex + 1u) >= bufferSize) ? 0u 
 757:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****                     readIndex++;
 758:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****                 }
 759:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****             }
 760:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****             else /*DRM = 1: 16 bit read access. Upper part of the result register contains sign bit
 761:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****             {
 762:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****                 while (readIndex < fillLevel)
