 123:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** /** \brief macro to determine if startup calibration for TMADC is required or not.
 124:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****  */
 125:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** #ifndef IFXADC_TMADC_ENABLE_STARTUPCAL
