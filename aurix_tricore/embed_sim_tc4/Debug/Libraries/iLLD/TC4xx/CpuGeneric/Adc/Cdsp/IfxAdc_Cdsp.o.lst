 278:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     dspCfg.B.HSIMON = config->inputMonitor;
 279:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c **** 
 280:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     //3. Integrator configuration
 281:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     if (config->integratorCfg != NULL_PTR)
 282:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     {
 283:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         IfxAdc_Cdsp_setupIntegrator(dspSfrPtr, config->integratorCfg);
 284:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     }
 285:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c **** 
 286:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     //4. Result configuration (clear fifo)
 287:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     /* Clear errors (Read, Write, Service Request, Timestamp, Integrator and boundary)*/
 288:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     {
 289:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         dspSfrPtr->CHERRCL.U = 0u;
 290:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     }
 291:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     /* Configure data read, fifo fill level and flush fifo */
 292:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     {
 293:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         dspCfg.B.DRM   = (resultCfg->disableFifo) ? (uint32)(0x01U) : (uint32)(resultCfg->dataReadW
 294:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         dspCfg.B.TSM   = resultCfg->enableTimeStamp;
 295:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         dspCfg.B.SRLVL = resultCfg->fifoSrvLevel;
 296:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         dspCfg.B.RDM   = resultCfg->readAsUnsigned;
 297:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         dspCfg.B.FIFL  = 1u;
 298:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     }
 299:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c **** 
 300:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     //5. Boundary configuration
 301:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     IfxAdc_Cdsp_configureBoundary(dspSfrPtr, config->bndCfg);
 302:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c **** 
 303:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     //6. Timestamp configuration if needed
 304:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     if (config->timestampCfg != NULL_PTR)
 305:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     {
 306:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         dspCfg.B.TSCLK  = config->timestampCfg->clk;
 307:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         dspCfg.B.TSCRUN = config->timestampCfg->startCounter;
 308:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     }
 309:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c **** 
 310:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     //Queue Configuration
 311:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     if (queueCfgPtr != NULL_PTR)
 312:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     {
 313:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         dmaCfgPtr = (queueCfgPtr->dmaCfg);
 314:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c **** 
 315:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         /* Initialize and update the handle with buffer address and size*/
 316:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         IfxAdc_Cdsp_setupBuffer(queueCfgPtr, dsp);
 317:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c **** 
 318:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         /* DMA configuration */
 319:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         if (dmaCfgPtr != NULL_PTR)
 320:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         {
 321:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****             IfxAdc_Cdsp_configureDma(queueCfgPtr, dsp);
 322:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         }
 323:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         else
 324:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         {
 325:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****             /* If DMA not configured update handle with FALSE*/
 326:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****             dsp->queue.dma.useDma = FALSE;
 327:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         }
 328:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     }
 329:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c **** 
 330:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     //7. Service Request configuration
 331:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     if (resultServReqPtr != NULL_PTR)
 332:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     {
 333:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         /*update Handle for result handler */
 334:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         dsp->resHandler = resultServReqPtr->resHandler;
 335:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c **** 
 336:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         srcfg.B.SR0E    = resultServReqPtr->sr0Enable;
 337:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         src             = IfxAdc_getCdspSrcPointer(coreId, IfxAdc_CdspServiceReq_result);
 338:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         IfxSrc_init(src, resultServReqPtr->typeOfService, resultServReqPtr->priority, resultServReq
 339:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         IfxSrc_enable(src);
 340:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     }
 341:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c **** 
 342:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     /* Timestamp, wakeup event service request configuration */
 343:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     if (eventServReqPtr != NULL_PTR)
 344:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     {
 345:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         srcfg.B.SR1E = eventServReqPtr->sr1Mode;
 346:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         src          = IfxAdc_getCdspSrcPointer(coreId, IfxAdc_CdspServiceReq_event);
 347:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         IfxSrc_init(src, eventServReqPtr->typeOfService, eventServReqPtr->priority, eventServReqPtr
 348:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         IfxSrc_enable(src);
 349:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     }
 350:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c **** 
 351:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     if (alarmServReqPtr != NULL_PTR)
 352:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     {
 353:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         srcfg.B.SR2E = alarmServReqPtr->sr2Enable;
 354:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         src          = IfxAdc_getCdspSrcPointer(coreId, IfxAdc_CdspServiceReq_alarm);
 355:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         IfxSrc_init(src, alarmServReqPtr->typeOfService, alarmServReqPtr->priority, alarmServReqPtr
 356:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         IfxSrc_enable(src);
 357:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     }
 358:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c **** 
 359:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     //8. Trigger Configuration
 360:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****     IfxAdc_Cdsp_setupTriggers(dspSfrPtr, config->triggerCfg);
 361:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c **** 
