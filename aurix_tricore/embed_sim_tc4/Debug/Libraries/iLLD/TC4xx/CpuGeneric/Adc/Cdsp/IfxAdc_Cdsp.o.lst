 850:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         dsp->queue.readIndex   = localReadIndex;   //Update read index in handle
 851:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.c ****         localValidResult      -= size;             // Decrement valid result
