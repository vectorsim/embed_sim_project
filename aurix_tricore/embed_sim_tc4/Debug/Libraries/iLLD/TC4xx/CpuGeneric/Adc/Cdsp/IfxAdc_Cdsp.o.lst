  72:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****  * \subsection IfxLld_Adc_Cdsp_Interrupt Interrupt Handler Installation (without dma use)
  73:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****  *
  74:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****  * See also \ref IfxLld_Cpu_Irq_Usage
  75:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****  *
  76:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****  * Define priorities for the Interrupt handlers. This is normally done in the Ifx_IntPrioDef.h file
  77:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****  * \code
  78:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****  * // priorities are normally defined in Ifx_IntPrioDef.h
  79:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****  * #define IFX_INTPRIO_CDSP_SR0  1
  80:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****  * #define IFX_INTPRIO_CDSP_SR1  2
  81:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****  * #define IFX_INTPRIO_CDSP_SR2  3
  82:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****  * \endcode
  83:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****  *
  84:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****  * Add the interrupt service routines to your C code:
  85:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****  * \code
  86:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****  * IFX_INTERRUPT(resultIsr, 0, IFX_INTPRIO_CDSP_SR0);
  87:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****  * IFX_INTERRUPT(eventIsr,  0, IFX_INTPRIO_CDSP_SR1);
  88:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****  * IFX_INTERRUPT(alarmIsr,  0, IFX_INTPRIO_CDSP_SR2);
  89:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Cdsp/IfxAdc_Cdsp.h ****  * IfxCpu_enableInterrupts();
