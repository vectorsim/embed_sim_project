3282:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** 
3283:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****     for (stVal = 0; stVal < 0xFFFF; stVal++)
3284:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****     {
3285:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****         if ((uint32)(125 * (stVal + 1)) >= reqSampleTime)
3286:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****         {
3287:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****             break; /* break out. stVal value has matched sampling time */
3288:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****         }
3289:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****     }
3290:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** 
3291:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****     if (stVal < 3U)
3292:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****     {
3293:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****         stVal = 3U;
3294:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****     }
3295:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** 
3296:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h ****     return stVal;
3297:../Libraries/iLLD/TC4xx/CpuGeneric/Adc/Std/IfxAdc.h **** }
