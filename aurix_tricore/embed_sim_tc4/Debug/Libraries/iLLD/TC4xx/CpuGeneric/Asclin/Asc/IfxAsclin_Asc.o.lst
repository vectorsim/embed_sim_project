 209:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** 
 210:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** /** \brief Return system timer value (critical section).
 211:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****  *
 212:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****  * The function IfxStm_get() is called in a critical section, disabling
 213:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****  * the interrupts. The system timer value is limited to TIME_INFINITE.
 214:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****  *
 215:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****  * \return Returns system timer value.
 216:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****  */
 217:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** IFX_INLINE Ifx_TickTime Ifx_now(void)
 218:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** {
 219:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****     Ifx_TickTime stmNow;
 220:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** #if !defined(IFX_ILLD_PPU_USAGE)
 221:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****     boolean      interruptState;
 222:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** 
 223:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****     interruptState = Ifx_disableInterrupts();
 224:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****     stmNow         = (Ifx_TickTime)IfxStm_get(BSP_DEFAULT_TIMER) & TIME_INFINITE;
 225:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** #else
 226:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****     stmNow         = (Ifx_TickTime)IfxPpu_Timer_readTimer0() & TIME_INFINITE;
 227:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** #endif
 228:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** 
 229:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** #if !defined(IFX_ILLD_PPU_USAGE)
 230:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****     Ifx_restoreInterrupts(interruptState);
 231:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** #endif
 232:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****     return stmNow;
 233:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** }
 234:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** 
 235:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** #if !defined(IFX_ILLD_PPU_USAGE)
 236:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** /** \brief Return system timer value (without critical section).
 237:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****  *
 238:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****  * The function IfxStm_get() is called. The system timer value is limited to TIME_INFINITE.
 239:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****  *
 240:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****  * \return Returns system timer value.
 241:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****  */
 242:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** IFX_INLINE Ifx_TickTime Ifx_nowWithoutCriticalSection(void)
 243:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** {
 244:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****     Ifx_TickTime stmNow;
 245:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** 
 246:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****     stmNow = (Ifx_TickTime)IfxStm_get(BSP_DEFAULT_TIMER) & TIME_INFINITE;
 247:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** 
 248:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****     return stmNow;
 249:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** }
 250:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** #endif
 251:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** 
 252:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** /** \brief Add 2 Ifx_TickTime values and return the result
 253:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****  *
 254:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****  * \param a parameter a
 255:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****  * \param b parameter b
 256:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****  *
 257:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****  * \return a + b. If either a or b is TIME_INFINITE, the result is TIME_INFINITE
 258:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****  */
 259:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** IFX_INLINE Ifx_TickTime Ifx_addTTime(Ifx_TickTime a, Ifx_TickTime b)
 260:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** {
 261:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****     Ifx_TickTime result;
 262:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** 
 263:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****     if ((a == TIME_INFINITE) || (b == TIME_INFINITE))
 264:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****     {
 265:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****         result = TIME_INFINITE;
 266:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****     }
 267:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****     else
 268:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****     {
 269:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****         result = a + b;         /* FIXME check for overflow */
 270:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****     }
 271:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** 
 272:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****     return result;
 273:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** }
 274:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** 
 275:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** 
 276:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** /** \brief Return the elapsed time in ticks.
 277:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****  *
 278:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****  * Return the elapsed time between the current time and the time passed as parameter
 279:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****  *
 280:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****  * \return Returns the elapsed time.
 281:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****  */
 282:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** IFX_INLINE Ifx_TickTime Ifx_elapsed(Ifx_TickTime since)
 283:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** {
 284:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****     return Ifx_now() - since;
 285:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** }
 286:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** 
 287:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** 
 288:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** /** \brief Return the time dead line.
 289:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****  *
 290:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****  * \param timeout Specifies the dead line from now: Deadline = Now + Timeout
 291:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****  *
 292:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****  * \return Return the time dead line.
 293:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****  */
 294:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** IFX_INLINE Ifx_TickTime Ifx_getDeadLine(Ifx_TickTime timeout)
 295:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h **** {
 296:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/Timer/Ifx_Timer.h ****     Ifx_TickTime deadLine;
 174              	 .loc 3 296 5
