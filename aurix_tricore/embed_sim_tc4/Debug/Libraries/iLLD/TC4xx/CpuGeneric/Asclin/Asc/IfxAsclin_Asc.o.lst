 375:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****     IfxPort_PadDriver_ttl3v3Speed2         = (3 << 3) | (1 << 0),  /**< \brief ttl3v3Speed2. */
