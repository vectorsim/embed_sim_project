  34:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu_IntrinsicsGcc.h **** /* old style intrinsics handling for AGENtiX environment */
  35:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu_IntrinsicsGcc.h **** #if defined(SCTB_EMBEDDED)
  36:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu_IntrinsicsGcc.h **** # define IFXCPU_INTRINSICSGNUC_USE_MACHINE_INTRINSICS 0
  37:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu_IntrinsicsGcc.h **** #else
  38:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu_IntrinsicsGcc.h **** # define IFXCPU_INTRINSICSGNUC_USE_MACHINE_INTRINSICS 1
