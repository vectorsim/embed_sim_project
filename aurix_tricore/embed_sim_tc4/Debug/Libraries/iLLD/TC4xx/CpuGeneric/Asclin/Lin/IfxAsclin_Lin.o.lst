 564:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c **** void IfxAsclin_Lin_sendHeader(IfxAsclin_Lin *asclin, uint8 *id)
 565:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c **** {
 566:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     boolean     result    = 0;
 567:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c **** 
 568:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     /* getting the pointer to ASCLIN registers from module handler */
 569:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     Ifx_ASCLIN *asclinSFR = asclin->asclin;
 570:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     /* clearing all flags */
 571:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     IfxAsclin_clearAllFlags(asclinSFR);
 572:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c **** 
 573:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     if (asclin->receiveIdEnable)                       /* if receiving the sent id byte into its ow
 574:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     {
 575:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     	/* flushing Rx FIFO */
 576:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****         IfxAsclin_flushRxFifo(asclinSFR);
 577:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****         /* enabling Rx FIFO */
 578:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****         IfxAsclin_enableRxFifoInlet(asclinSFR, TRUE);
 579:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     }
 580:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     else
 581:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     {
 582:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     	/* disabling Rx FIFO */
 583:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****         IfxAsclin_enableRxFifoInlet(asclinSFR, FALSE);
 584:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     }
 585:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c **** 
 586:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     /* flushing Tx FIFO */
 587:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     IfxAsclin_flushTxFifo(asclinSFR);
 588:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     /* enabling Tx FIFO for transmitting */
 589:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     IfxAsclin_enableTxFifoOutlet(asclinSFR, TRUE);
 590:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     /* writing the ID byte */
 591:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     IfxAsclin_write8(asclinSFR, id, 1U);
 592:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     /* setting THRQS flag */
 593:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     IfxAsclin_setTransmitHeaderRequestFlag(asclinSFR);
 594:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c **** 
 595:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     if (asclin->isInterruptMode == FALSE)                         /* only for Polling Mode */
 596:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     {
 597:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     	/* waiting until transmit header end acknowledgement */
 598:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****         result |= IfxAsclin_Lin_waitForTransmittedHeader(asclin);
 599:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c **** 
 600:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****         if (result == 1)
 601:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****         {
 602:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****             IFX_ASSERT(IFX_VERBOSE_LEVEL_ERROR, FALSE);
 603:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****         }
 604:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     }
 605:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     else
 606:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     {
 607:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****         IfxAsclin_Lin_clearFlagsStatus(asclin);
 608:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****         asclin->linFrameData.flags.txHeaderInProgress    = TRUE;
 609:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****         asclin->linFrameData.flags.txHeaderErrorOccurred = FALSE;
 610:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     }
 611:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c **** }
