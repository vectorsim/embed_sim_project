 625:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     /* flushing Tx FIFO */
 626:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     IfxAsclin_flushTxFifo(asclinSFR);
 627:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     /* disable Rx FIFO */
 628:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     IfxAsclin_enableRxFifoInlet(asclinSFR, FALSE);
 629:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     /* enable Tx FIFO for transmitting */
 630:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     IfxAsclin_enableTxFifoOutlet(asclinSFR, TRUE);
 631:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     /* write the data bytes; */
 632:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     IfxAsclin_write8(asclinSFR, data, length);
 633:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     /* set TRRQS flag */
 634:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     IfxAsclin_setTransmitResponseRequestFlag(asclinSFR);
 635:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     /* wait until transmit response end acknowledgement */
 636:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     result |= IfxAsclin_Lin_waitForTransmittedResponse(asclin);
