 528:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     /* wait until receive header end acknowledgement */
 529:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     result |= IfxAsclin_Lin_waitForReceivedHeader(asclin);
 530:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c **** 
 531:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     if (result == 1)
 532:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     {
 533:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****         IFX_ASSERT(IFX_VERBOSE_LEVEL_ERROR, FALSE);
 534:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     }
 535:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     else
 536:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     {
 537:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     	/* read the ID byte */
 538:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****         IfxAsclin_Lin_readHeader(asclin, id);
 539:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c ****     }
 540:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c **** }
