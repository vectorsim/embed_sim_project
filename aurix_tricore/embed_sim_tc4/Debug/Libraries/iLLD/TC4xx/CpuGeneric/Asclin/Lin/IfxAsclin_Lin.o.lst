  26:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
  27:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
  28:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * \defgroup IfxLld_Asclin_Lin_Usage How to use the ASCLIN LIN Interface driver?
  29:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * \ingroup IfxLld_Asclin
  30:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
  31:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * The LIN interface driver provides a default ASCLIN configuration for asynchronous serial communi
  32:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * It supports all four elementary LIN transactions in polling mode.
  33:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * TxH - Transmission of Header
  34:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * TxR - Transmission of Response
  35:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * RxH - Reception of Header
  36:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * RxR - Reception of Response
  37:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
  38:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * The driver also provides a LIN Master to be configured in Interrupt mode. In interrupt mode, fol
  39:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * 1.Transmit Header only.
  40:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * 2.Transmit both Header and Response.
  41:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * 3.Transmit Header and Receive Response.
  42:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
  43:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * In the following sections it will be described, how to integrate the driver into the application
  44:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
  45:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * \section IfxLld_Asclin_Lin_Preparation Preparation
  46:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * \subsection IfxLld_Asclin_Lin_Include Include Files
  47:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
  48:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * Include following header file into your C code:
  49:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * \code
  50:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * #include <Asclin/Lin/IfxAsclin_Lin.h>
  51:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * \endcode
  52:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
  53:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * \subsection IfxLld_Asclin_Lin_Variables Variables
  54:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
  55:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * Declare the LIN handle as global variable in your C code:
  56:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
  57:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * \code
  58:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * // used globally
  59:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * static IfxAsclin_Lin linMaster;
  60:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * static IfxAsclin_Lin linSlave;
  61:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * \endcode
  62:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
  63:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * \subsection IfxLld_Asclin_Lin_Interrupt Interrupt Handler Installation
  64:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
  65:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * Define priorities for the Interrrupt handlers.
  66:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * \code
  67:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
  68:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * #define IFX_INTPRIO_ASCLIN1_RX   4         // Define the LIN1 receive interrupt priority.
  69:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * #define IFX_INTPRIO_ASCLIN1_TX   8         // Define the LIN1 transmit interrupt priority.
  70:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * #define IFX_INTPRIO_ASCLIN1_EX   12        // Define the LIN1 error interrupt priority.
  71:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
  72:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * \endcode
  73:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
  74:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * Add the interrupt service routines to your C code. They have to call the LIN interrupt handlers 
  75:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * \code
  76:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * IFX_INTERRUPT(ISR_Lin1_rx, 0, IFX_INTPRIO_ASCLIN1_RX);
  77:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * IFX_INTERRUPT(ISR_Lin1_tx, 0, IFX_INTPRIO_ASCLIN1_TX);
  78:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * IFX_INTERRUPT(ISR_Lin1_ex, 0, IFX_INTPRIO_ASCLIN1_EX);
  79:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
  80:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * void ISR_Lin1_rx(void)
  81:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * {
  82:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *     IfxAsclin_Lin_isrReceive(&linMaster);
  83:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * }
  84:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * void ISR_Lin1_tx(void)
  85:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * {
  86:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *     IfxAsclin_Lin_isrTransmit(&linMaster);
  87:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * }
  88:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * void ISR_Lin1_ex(void)
  89:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * {
  90:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *     IfxAsclin_Lin_isrError(&linMaster);
  91:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * }
  92:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * \endcode
  93:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
  94:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * \subsection IfxLld_Asclin_Lin_Init Module Initialisation
  95:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
  96:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * The module can be initialised as either Master or Slave. Here an example:
  97:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
  98:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * \subsection IfxLld_Asclin_Lin_Init_Master Module Initialisation as Master
  99:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 100:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * \code
 101:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * // create module config
 102:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * IfxAsclin_Lin_Config linMasterConfig;
 103:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * IfxAsclin_Lin_initModuleConfig(&linMasterConfig, &MODULE_ASCLIN1);
 104:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 105:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * // set the lin mode of operation
 106:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * linMasterConfig.linMode = IfxAsclin_LinMode_master;
 107:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 108:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * // set the desired baudrate
 109:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * linMasterConfig.btc.prescaler = 4;
 110:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * linMasterConfig.brg.baudrate = 19200; // FDR values will be calculated in initModule
 111:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 112:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * // pin configuration
 113:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * const IfxAsclin_Lin_Pins pins = {
 114:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *           &IfxAsclin1_RXB_P15_5_IN,   IfxPort_InputMode_pullUp,    // Rx pin
 115:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *           &IfxAsclin1_TX_P15_4_OUT,   IfxPort_OutputMode_pushPull, // Tx pin
 116:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *           IfxPort_PadDriver_cmosAutomotiveSpeed1
 117:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * };
 118:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * linMasterConfig.pins = &pins;
 119:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 120:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * //Lin Master Interrupt Config. Only needed for interrupt mode.
 121:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * linConfig.isInterruptMode			= TRUE;
 122:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * linConfig.interrupt.rxPriority  = ISR_PRIORITY(INTERRUPT_LIN1_RX);
 123:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * linConfig.interrupt.txPriority  = ISR_PRIORITY(INTERRUPT_LIN1_TX);
 124:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * linConfig.interrupt.exPriority  = ISR_PRIORITY(INTERRUPT_LIN1_EX);
 125:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * linConfig.interrupt.typeOfService = IfxCpu_Irq_getTos(IfxCpu_getCoreIndex());
 126:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * linConfig.interrupt.vmId = IfxSrc_VmId_0;
 127:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 128:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * //Optionally, if any interrupt has to be enabled during initialisation it can be done as follows
 129:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * //Otherwise the driver will enable required interrupts during run time.
 130:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 131:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * linConfig.interrupt.enabledInterrupt.exCollisionDetectionError = TRUE; //This is optional exampl
 132:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 133:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * linConfig.lin.csi = FALSE;//checksum injection not written into RxFIFO
 134:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 135:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * // initialize module
 136:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * IfxAsclin_Lin_initModule(&linMaster, &linMasterConfig);
 137:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * \endcode
 138:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 139:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * \subsection IfxLld_Asclin_Lin_Init_Slave Module Initialisation as Slave
 140:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 141:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * \code
 142:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * // create module config
 143:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * IfxAsclin_Lin_Config linSlaveConfig;
 144:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * IfxAsclin_Lin_initModuleConfig(&linSlaveConfig, &MODULE_ASCLIN1);
 145:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 146:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * // set the lin mode of operation
 147:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * linSlaveConfig.linMode = IfxAsclin_LinMode_slave;
 148:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 149:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * // set the desired baudrate
 150:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * linSlaveConfig.btc.prescaler = 4;
 151:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * linSlaveConfig.brg.baudrate = 19200; // FDR values will be calculated in initModule
 152:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 153:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * // choose the auto baudrate detection configuration
 154:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * linSlaveConfig.brd.abd = FALSE;
 155:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * linSlaveConfig.brd.lowerLimit = 0x4;
 156:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * linSlaveConfig.brd.upperLimit = 0xF0;
 157:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 158:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * // pin configuration
 159:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * const IfxAsclin_Lin_Pins pins = {
 160:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *           &IfxAsclin1_RXB_P15_5_IN,   IfxPort_InputMode_pullUp,    // Rx pin
 161:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *           &IfxAsclin1_TX_P15_4_OUT,   IfxPort_OutputMode_pushPull, // Tx pin
 162:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *           IfxPort_PadDriver_cmosAutomotiveSpeed1
 163:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * };
 164:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * linSlaveConfig.pins = &pins;
 165:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 166:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 167:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 168:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * // initialize module
 169:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * //IfxAsclin_Lin linSlave; // defined globally
 170:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * IfxAsclin_Lin_initModule(&linSlave, &linSlaveConfig);
 171:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * \endcode
 172:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 173:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * The LIN is ready for use now!
 174:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 175:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * \section IfxLld_Asclin_Lin_DataTransfers Data Transfers
 176:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 177:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * \subsection IfxLld_Asclin_Lin_DataMaster Master Transfers
 178:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 179:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * The LIN driver provides all three master elementary transfers.
 180:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 181:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * This means: you can send a header and based on the id byte, after transmission of header
 182:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * you can send or receive response and also can ignore the header based on the id:
 183:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * \code
 184:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * // set the id bytes
 185:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * uint8 txId = 0x80; // for sending respose after header
 186:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * uint8 rxId = 0xC1; // for receiving respose after header
 187:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 188:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * // prepare transmit bytes incase of sending response
 189:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * uint8 txData[8] = { 1, 2, 3, 4, 5, 6, 7, 8 };
 190:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 191:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * // prepare receive buffer incase of receiving response
 192:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * uint8 rxData[8] = { 0, 0, 0, 0, 0, 0, 0, 0 };
 193:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 194:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * uint32 size = 8;
 195:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 196:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * //Polling mode APIs
 197:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * //send response case
 198:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * IfxAsclin_Lin_sendHeader(&linMaster, &txId);
 199:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 200:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * if (lin.acknowledgmentFlags.txHeaderEnd == 1) // if the header is been transmitted successfully
 201:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * {
 202:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *  IfxAsclin_Lin_sendResponse(&linMaster, txData, size);
 203:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * }
 204:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 205:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * //receive response case
 206:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * IfxAsclin_Lin_sendHeader(&linMaster, &rxId);
 207:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 208:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * if (lin.acknowledgmentFlags.txHeaderEnd == 1) // if the header is been transmitted successfully
 209:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * {
 210:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *  IfxAsclin_Lin_receiveResponse(&linMaster, rxData, size);
 211:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * }
 212:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 213:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * //Interrupt mode APIs
 214:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * IfxAsclin_Lin_PduType pdu;
 215:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * pdu.pid = 0x42;
 216:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * pdu.checksumMode = IfxAsclin_Checksum_enhanced;
 217:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * pdu.dataLength = 8;
 218:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * pdu.direction = IfxAsclin_Lin_Direction_TransmitHeaderAndResponse; //Transmits both Header and R
 219:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * pdu.dataPtr = &txData[0];
 220:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * IfxAsclin_Lin_sendFrame(&linMaster,&pdu);
 221:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * //Here Poll for linMaster.acknowledgmentFlags.txResponseEnd to detect end of transmission of fra
 222:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 223:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * pdu.pid = 0xC4;
 224:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * pdu.direction = IfxAsclin_Lin_Direction_TransmitHeaderAndReceiveResponse; //Transmits Header and
 225:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * IfxAsclin_Lin_sendFrame(&linMaster,&pdu);
 226:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * //Here Poll for linMaster.acknowledgmentFlags.rxResponseEnd
 227:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * //linMaster.linFrameData.rxResponseData[8] will have received response data if slave replies.
 228:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 229:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * \endcode
 230:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 231:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 232:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * \subsection IfxLld_Asclin_Lin_DataSlave Slave Transfers
 233:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 234:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * Same as master the LIN driver provides all three slave elemnatry tranfers.
 235:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 236:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * This means: you can receive a header and based on the id byte received,
 237:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * you can send or receive response and can also ignore the header based on the id:
 238:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * \code
 239:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * uint8 id;	// for storing received id byte
 240:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 241:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * // prepare transmit bytes incase of sending response
 242:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * uint8 txData[8] = { 1, 2, 3, 4, 5, 6, 7, 8 };
 243:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 244:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * // prepare receive buffer incase of receiving response
 245:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * uint8 rxData[8] = { 0, 0, 0, 0, 0, 0, 0, 0 };
 246:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 247:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * uint32 size = 8;
 248:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 249:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * // receive header
 250:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * IfxAsclin_Lin_receiveHeader(&linSlave, &id);
 251:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 252:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * // if data is requsted by master
 253:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * if(id == txId)
 254:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * {
 255:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *  IfxAsclin_Lin_sendResponse(&linSlave, txData, size); // send response
 256:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * }
 257:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 258:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * // if header is follwed by response
 259:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * else if(id == rxId)
 260:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * {
 261:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *  IfxAsclin_Lin_receiveResponse(&linSlave, rxData, size); // receive response
 262:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * }
 263:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
 264:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * // if header is not for this slave
 265:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * else
 266:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * {
 267:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *  IfxAsclin_Lin_ignoreHeader(&linSlave);
 268:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * }
 269:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  * \endcode
 270:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.h ****  *
