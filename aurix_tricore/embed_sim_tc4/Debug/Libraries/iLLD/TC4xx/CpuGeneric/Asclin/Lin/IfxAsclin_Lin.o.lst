 543:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c **** void IfxAsclin_Lin_receiveResponse(IfxAsclin_Lin *asclin, uint8 *data, uint32 length)
 544:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Lin/IfxAsclin_Lin.c **** {
