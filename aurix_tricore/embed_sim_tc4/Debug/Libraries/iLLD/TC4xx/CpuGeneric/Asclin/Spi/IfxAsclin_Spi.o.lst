  56:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** 
  57:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** void IfxAsclin_Spi_disableModule(IfxAsclin_Spi *asclin)
  58:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** {
  59:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** 	/* getting the pointer to ASCLIN registers from module handler */
  60:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****     Ifx_ASCLIN *asclinSFR = asclin->asclin;
  61:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** 
  62:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****     /* disabling the module */
  63:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****     IfxAsclin_setDisableModuleRequest(asclinSFR);
  64:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** }
  65:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** 
  66:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** 
  67:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** IfxAsclin_Spi_Status IfxAsclin_Spi_exchange(IfxAsclin_Spi *asclin, void *src, void *dest, uint32 co
  68:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** {
  69:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** 	/* lock the driver until the communication is done */
  70:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****     IfxAsclin_Spi_Status status     = IfxAsclin_Spi_lock(asclin);
  71:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** 
  72:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****     uint32               count_8_16 = ((count / asclin->dataWidth) + (count % asclin->dataWidth));
  73:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** #if IFXASCLIN_SPI_IS_DATAWIDTH32_AVAILABLE	
  74:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****     uint32               count_32   = ((count / (asclin->dataWidth + 1)) + (count % (asclin->dataWi
  75:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** #endif	/* #if IFXASCLIN_SPI_IS_DATAWIDTH32_AVAILABLE */
  76:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** 
  77:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****     if (status == IfxAsclin_Spi_Status_ok)
  78:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****     {
  79:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****         asclin->transferInProgress = 1;                /* setting transfer in progress status */
  80:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****         asclin->txJob.data         = src;              /* data to be transmitted */
  81:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****         asclin->rxJob.data         = dest;             /* empty buffer to receive data */
  82:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** 
  83:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****         if ((asclin->dataWidth == 1) || (asclin->dataWidth == 2))
  84:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****         {
  85:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****             asclin->txJob.pending = count_8_16;      /* count of Tx data */
  86:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****             asclin->rxJob.pending = count_8_16;      /* count of Rx data */
  87:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****         }
  88:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** #if IFXASCLIN_SPI_IS_DATAWIDTH32_AVAILABLE			
  89:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****         else
  90:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****         {
  91:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****             asclin->txJob.pending = count_32; /* count of Tx data */
  92:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****             asclin->rxJob.pending = count_32; /* count of Rx data */
  93:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****         }
  94:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** #endif	/* #if IFXASCLIN_SPI_IS_DATAWIDTH32_AVAILABLE */
  95:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** 
  96:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****         /* write data into Tx fifo */
  97:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****         IfxAsclin_Spi_write(asclin);
  98:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****     }
  99:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** 
 100:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****     return status;
 101:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** }
