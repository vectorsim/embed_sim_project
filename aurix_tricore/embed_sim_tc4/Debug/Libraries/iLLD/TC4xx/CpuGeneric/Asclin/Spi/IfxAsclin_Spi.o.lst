 362:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** void IfxAsclin_Spi_isrError(IfxAsclin_Spi *asclin)
 363:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** {
 364:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** 	/* getting the pointer to ASCLIN registers from module handler */
 365:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****     Ifx_ASCLIN *asclinSFR = asclin->asclin;
 366:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** 
 367:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****     /* store all the flags in the variable */
 368:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****     if (IfxAsclin_getFrameErrorFlagStatus(asclinSFR))
 369:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****     {
 370:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****         IfxAsclin_clearFrameErrorFlag(asclinSFR);
 371:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****         asclin->errorFlags.frameError = 1;
 372:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****     }
 373:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** 
 374:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****     if (IfxAsclin_getRxFifoOverflowFlagStatus(asclinSFR))
 375:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****     {
 376:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****         IfxAsclin_clearRxFifoOverflowFlag(asclinSFR);
 377:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****         asclin->errorFlags.rxFifoOverflow = 1;
 378:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****     }
 379:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** 
 380:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****     if (IfxAsclin_getRxFifoUnderflowFlagStatus(asclinSFR))
 381:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****     {
 382:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****         IfxAsclin_clearRxFifoUnderflowFlag(asclinSFR);
 383:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****         asclin->errorFlags.rxFifoUnderflow = 1;
 384:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****     }
 385:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** 
 386:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****     if (IfxAsclin_getTxFifoOverflowFlagStatus(asclinSFR))
 387:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****     {
 388:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****         IfxAsclin_clearTxFifoOverflowFlag(asclinSFR);
 389:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****         asclin->errorFlags.txFifoOverflow = 1;
 390:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****     }
 391:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** }
