  96:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** /** \brief The LVDS RX_DIS control function can be selected from the Port (default) or
  97:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * HSCT module.declared in MODULE_PORTx.LPCRx
  98:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  */
  99:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** typedef enum
 100:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** {
 101:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****     IfxPort_ControlledBy_port = 0,  /**< \brief port controlled by PORT Module */
 102:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****     IfxPort_ControlledBy_hsct = 1   /**< \brief Port controlled by HSCT Module */
 103:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** } IfxPort_ControlledBy;
 104:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** 
 105:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** /** \brief Ifx_P output modification modes definition.
 106:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  */
 107:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** typedef enum
 108:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** {
 109:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****     IfxPort_InputMode_undefined    = -1,
 110:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****     IfxPort_InputMode_noPullDevice = ((0U << 4U) | (0U << 1U) | 0U),
 111:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****     IfxPort_InputMode_pullDown     = ((1U << 4U) | (0U << 1U) | 0U),
 112:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****     IfxPort_InputMode_pullUp       = ((2U << 4U) | (0U << 1U) | 0U)
 113:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** } IfxPort_InputMode;
 114:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** 
 115:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** #if !defined(DEVICE_TC4PX) && !defined(DEVICE_TC4EX) && !defined(DEVICE_TC46X)
