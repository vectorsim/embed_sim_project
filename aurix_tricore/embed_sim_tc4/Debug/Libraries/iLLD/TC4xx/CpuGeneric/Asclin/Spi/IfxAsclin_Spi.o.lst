 334:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****             .outWidth             = IfxAsclin_RxFifoOutletWidth_1,        /* 8-bit wide read */
 335:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****             .inWidth              = IfxAsclin_TxFifoInletWidth_1,         /*8-bit wide write */
 336:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****             .buffMode             = IfxAsclin_ReceiveBufferMode_rxFifo,   /* RxFIFO */
 337:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****             .txFifoInterruptLevel = IfxAsclin_TxFifoInterruptLevel_15,    /* Tx FIFO interrupt leve
 338:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****             .rxFifoInterruptLevel = IfxAsclin_RxFifoInterruptLevel_1,     /* Rx FIFO interrupt leve
 339:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****             .txFifoInterruptMode  = IfxAsclin_FifoInterruptMode_combined, /* Tx FIFO interrupt gene
 340:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****             .rxFifoInterruptMode  = IfxAsclin_FifoInterruptMode_combined, /* Rx FIFO interrupt gene
 341:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****         },
 342:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** 
 343:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****         /* default Values for Interrupt Config */
 344:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****         .interrupt                = {
 345:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****             .rxPriority    = 0,               /* receive interrupt priority 0 */
 346:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****             .txPriority    = 0,               /* transmit interrupt priority 0 */
 347:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****             .erPriority    = 0,               /* error interrupt priority 0 */
 348:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****             .typeOfService = IfxSrc_Tos_cpu0, /* type of service CPU0 */
 349:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****             .vmId          = IfxSrc_VmId_0,   /* Virtual Machine Number VM0 */
