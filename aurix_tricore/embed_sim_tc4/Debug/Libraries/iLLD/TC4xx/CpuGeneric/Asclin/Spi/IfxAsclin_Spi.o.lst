 205:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****     if ((config->interrupt.rxPriority > 0) || (tos == IfxSrc_Tos_dma0) || (tos == IfxSrc_Tos_dma1))
 206:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c **** #else
