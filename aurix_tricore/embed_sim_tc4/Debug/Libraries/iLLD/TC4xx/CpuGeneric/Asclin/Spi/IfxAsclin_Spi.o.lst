 130:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****     /* spi mode initialisation */
 131:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****     IfxAsclin_setClockSource(asclinSFR, IfxAsclin_ClockSource_noClock);                            
 132:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****     IfxAsclin_setFrameMode(asclinSFR, config->frameMode);                                          
 133:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****     IfxAsclin_setPrescaler(asclinSFR, config->baudrate.prescaler);                                 
 134:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Spi/IfxAsclin_Spi.c ****     IfxAsclin_setClockSource(asclinSFR, config->clockSource);                                      
