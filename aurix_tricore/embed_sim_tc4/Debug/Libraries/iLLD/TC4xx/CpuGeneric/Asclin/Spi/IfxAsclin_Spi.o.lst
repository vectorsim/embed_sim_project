 360:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_EXTERN IfxCpu_ResetStatus IfxCpu_getCpuResetStatus(IfxCpu_ResourceCpu coreIndex);
