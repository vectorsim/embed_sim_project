 978:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * 00B Idle / Frequency constant, not changing
 979:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * 01B RampUp / Frequency increasing
 980:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * 10B RampDown / Frequency decreasing
 981:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  */
 982:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** typedef enum
 983:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** {
