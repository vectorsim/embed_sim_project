 257:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     float32               relError   = fOvs;
 258:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     float32               limit;                                         /* save the error limit */
 259:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     boolean               terminated = FALSE;
 260:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     float32               newRelError;
