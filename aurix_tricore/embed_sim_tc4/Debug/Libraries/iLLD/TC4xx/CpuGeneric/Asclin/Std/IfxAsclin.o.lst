 334:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** #define IFXCLOCK_GET_XCORR_NOM(FOsc, RGain, XGain) ((1184.0f / FOsc) * RGain * XGain)
 335:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
 336:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** /** \brief Get XCorr hex value from XCORR nominal
