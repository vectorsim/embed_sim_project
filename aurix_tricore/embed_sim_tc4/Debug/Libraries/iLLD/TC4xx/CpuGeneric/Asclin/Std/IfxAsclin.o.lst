 120:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *       // fPLL2 = N * fIN / P * K3 * 1. 4 -> K3PREDIV = 4
 121:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *       // fPLL2 = N * fIN / P * K3 * 1. 0 -> K3PREDIV = 5
 122:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *       // fPLL2 = N * fIN / P * K3 * 1. 6 -> K3PREDIV = 6
 123:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *       // fPLL2 = N * fIN / P * K3 * 1. 7 -> K3PREDIV = 7
 124:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *       // fPLL2 = N * fIN / P * K3 * 1. 0 -> K3PREDIV = 8
 125:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *       // fPLL2 = N * fIN / P * K3 * 1. 0 -> K3PREDIV = 9
