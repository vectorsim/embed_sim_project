 266:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****         limit = 0.01f * fOvs;
 267:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     }
 268:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     else if (baudrate < 100000)
 269:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     {
 270:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****         limit = 0.001f * fOvs;
 271:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     }
 272:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     else if (baudrate < 1000000)
 273:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     {
 274:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****         limit = 0.0001f * fOvs;
 275:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     }
 276:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     else if (baudrate < 8330000)
 277:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     {
 278:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****         limit = 0.00001f * fOvs;
 279:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     }
 280:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     else
 281:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     {
 282:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****         limit = 0.000001f * fOvs;
 283:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     }
 284:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
 285:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     /* calculate the possible denominator "d" */
 286:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     d = (uint32)(fpd / fOvs);
 287:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     /* initialize "numerator" n with 1 */
 288:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     n = 1;
 289:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
 290:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     if (d == 0)
 291:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     {
 292:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****         while (d < 1)
 293:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****         {
 294:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****             /* decrement l_oversampling until "d" becomes >= 1; (l_oversampling + 1) should not be 
 295:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****             if (l_oversampling >= 5)
 296:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****             {
 297:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                 l_oversampling--;
 298:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                 fOvs = baudrate * l_oversampling;
 299:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                 d    = (uint32)(fpd / fOvs);
 300:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****             }
 301:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****             else
 302:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****             {
 303:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                 /* fall back to default values as desired baud rate cannot be achieved with the pre
 304:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                 prescaler      = 1;
 305:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                 l_oversampling = (uint32)(IfxAsclin_OversamplingFactor_16 + 1);
 306:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                 fpd            = (float32)IfxAsclin_getFaFrequency(asclin) / prescaler;
 307:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                 fOvs           = baudrate * l_oversampling;
 308:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                 d              = (uint32)(fpd / fOvs);
 309:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****             }
 310:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****         }
 311:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     }
 312:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
 313:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     /* if d is possibly greater than 4095 or 0xFFF (12-bit resolution) */
 314:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     if (d >> 12)
 315:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     {
 316:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****         /* check if the current baud rate fits in for the 12-bit  "d", for max. l_oversampling valu
 317:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****         if (((uint32)(fpd / (baudrate * 16))) >> 12)
 318:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****         {
 319:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****             /* increase the value of the prescaler to generate the required baudrate */
 320:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****             while (d >> 12)
 321:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****             {
 322:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                 prescaler++;
 323:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
 324:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                 if (prescaler >> 12)
 325:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                 {
 326:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                     prescaler = 0xFFF;
 327:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                     break;
 328:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                 }
 329:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
 330:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                 fpd = (float32)IfxAsclin_getFaFrequency(asclin) / prescaler;
 331:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                 d   = (uint32)(fpd / fOvs);
 332:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****             }
 333:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****         }
 334:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****         else
 335:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****         {
 336:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****             /* increase the value of the oversampling to generate the required baudrate */
 337:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****             while (d >> 12)
 338:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****             {
 339:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                 l_oversampling++;
 340:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
 341:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                 if (l_oversampling > 16)
 342:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                 {
 343:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                     l_oversampling = (uint32)(IfxAsclin_OversamplingFactor_16 + 1);
 344:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                     break;
 345:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                 }
 346:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
 347:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                 fOvs = baudrate * l_oversampling;
 348:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                 d    = (uint32)(fpd / fOvs);
 349:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****             }
 350:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****         }
 351:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     }
 352:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
 353:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     dBest          = d;
 354:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     nBest          = n;
 355:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     adder_facL_min = 0;
 356:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     f              = (fpd * n) / d;
 357:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     relError       = __absf(fOvs - f);
 358:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
 359:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     if (relError <= limit)
 360:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     {
 361:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****         terminated = TRUE;
 362:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     }
 363:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
 364:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     for (n = 2; ((!terminated) && (n <= 0xFFF)); n++)
 365:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     {
 366:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****         if (n == 2)
 367:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****         {
 368:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****             adder_facL = 1;
 369:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****             adder_facH = 1;
 370:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****         }
 371:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****         else
 372:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****         {
 373:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****             adder_facL = (adder_facL_min * n) / nBest;
 374:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****             adder_facH = adder_facL + 1;
 375:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****         }
 376:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
 377:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****         for (count = adder_facL; ((count <= adder_facH) && (nBest <= dBest)); count++)
 378:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****         {
 379:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****             f           = (fpd * n) / (n * d + count); //why n in denominator?
 380:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****             newRelError = __absf(fOvs - f);
 381:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
 382:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****             if (relError > newRelError)
 383:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****             {
 384:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                 relError = newRelError;
 385:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                 nBest    = n;
 386:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                 dBest    = (n * d + count);
 387:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
 388:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                 if (dBest > 4095)
 389:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                 {
 390:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                     dBest = 4095;
 391:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                 }
 392:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
 393:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                 adder_facL_min = count;
 394:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****             }
 395:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
 396:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****             if (relError <= limit)
 397:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****             {
 398:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                 terminated = TRUE;
 399:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****                 break;
 400:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****             }
 401:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****         }
 402:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     }
 403:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
 404:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     IfxAsclin_setClockSource(asclin, IfxAsclin_ClockSource_noClock);
 405:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     asclin->BRG.B.DENOMINATOR = dBest;
 406:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     asclin->BRG.B.NUMERATOR   = nBest;
 407:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
 408:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     /* set the clock divider value */
 409:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     asclin->BITCON.B.PRESCALER = prescaler - 1;
 410:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
 411:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     /* set the SHIFT frequency */
 412:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     asclin->BITCON.B.OVERSAMPLING = l_oversampling - 1;
 413:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
 414:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     /* set the sampling point */
 415:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     asclin->BITCON.B.SAMPLEPOINT = samplepoint;
 416:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
 417:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     /* set the median filter */
 418:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     asclin->BITCON.B.SM = medianFilter ? 1 : 0;
 419:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
 420:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     IfxAsclin_setClockSource(asclin, source);
 421:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
 422:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     return TRUE;
 423:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** }
 424:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
 425:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
 426:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** void IfxAsclin_setBitTimingValues(Ifx_ASCLIN *asclin, IfxAsclin_BitTimingConfig *config)
 427:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** {
 428:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     IfxAsclin_ClockSource source = (IfxAsclin_ClockSource)IfxAsclin_getClockSource(asclin);
 429:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
 430:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     IfxAsclin_setClockSource(asclin, IfxAsclin_ClockSource_noClock);
 431:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     asclin->BRG.B.DENOMINATOR = config->denominator;
 432:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     asclin->BRG.B.NUMERATOR   = config->numerator;
 433:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
 434:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     /* set the SHIFT frequency */
 435:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     asclin->BITCON.B.OVERSAMPLING = (config->oversampling - 1);
 436:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
 437:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     /* set the sampling point */
 438:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     asclin->BITCON.B.SAMPLEPOINT = config->samplepoint;
 439:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
 440:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     /* set the median filter */
 441:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     asclin->BITCON.B.SM = (config->sm) ? 1 : 0;
 442:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
 443:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     IfxAsclin_setClockSource(asclin, source);
 444:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** }
 445:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
