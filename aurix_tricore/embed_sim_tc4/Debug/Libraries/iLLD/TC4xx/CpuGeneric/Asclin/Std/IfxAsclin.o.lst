 109:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
 110:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *       // Configure PER PLL1,2,3
 111:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *       // fPLL1 = N * fIN / P * K2 * 1. 0 -> K2PREDIV = 0
