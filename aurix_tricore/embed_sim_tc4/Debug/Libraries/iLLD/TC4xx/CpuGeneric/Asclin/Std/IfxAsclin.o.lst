 959:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** /** \brief These will direct a ramping sequence according to its control parameters (UFL, SZ, WAIT)
 960:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * Register : RAMPCON.B.CMD ;
 961:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * 000B Idle / Idle, do nothing, actual frequency is kept constant.
 962:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * 001B RampUp / Ramp-up until the upper frequency limit has been reached.
 963:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * 010B RampDown / Ramp-down until the base frequency has been reached.
 964:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * 011B Stop / Stop/pause ramping, actual frequency is kept constant.
 965:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * 100B Reset / Reset, stop ramping (if in progress) and set the oscillator to its base frequency (
 966:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  */
 967:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** typedef enum
 968:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** {
 969:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     IfxClock_RampSeqCmd_idle     = 0,  /**< \brief Idle, actual frequency is kept constant. */
 970:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     IfxClock_RampSeqCmd_rampUp   = 1,  /**< \brief Ramp-up until the upper frequency limit has been
