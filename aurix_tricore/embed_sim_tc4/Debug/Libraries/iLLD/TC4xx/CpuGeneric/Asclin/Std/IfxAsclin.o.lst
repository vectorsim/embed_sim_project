 985:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     IfxClock_RampSeqStatus_rampUp   = 1,  /**< \brief Frequency increasing */
 986:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     IfxClock_RampSeqStatus_rampDown = 2,  /**< \brief Frequency decreasing */
