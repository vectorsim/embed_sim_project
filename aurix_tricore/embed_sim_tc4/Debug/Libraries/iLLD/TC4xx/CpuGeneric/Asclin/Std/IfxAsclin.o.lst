 241:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** boolean IfxAsclin_setBitTiming(Ifx_ASCLIN *asclin, float32 baudrate, IfxAsclin_OversamplingFactor o
 242:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** {
