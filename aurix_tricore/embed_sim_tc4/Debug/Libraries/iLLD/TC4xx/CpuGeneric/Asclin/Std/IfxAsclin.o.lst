 972:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     IfxClock_RampSeqCmd_stop     = 3,  /**< \brief Stop/pause ramping, actual frequency is kept con
 973:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     IfxClock_RampSeqCmd_train    = 4   /**< \brief Execute training sequence */
 974:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** } IfxClock_RampSeqCmd;
 975:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
 976:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** /** \brief Status bits to reflect the current state of the ramping sequencer
