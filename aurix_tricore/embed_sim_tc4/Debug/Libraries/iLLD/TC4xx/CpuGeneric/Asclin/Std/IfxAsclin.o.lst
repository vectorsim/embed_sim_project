 314:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** #define IFXCLOCK_MODCFG_DEFAULT_VAL               ((uint32)0x1D)
 315:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
 316:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** /** \brief get Rgain from MA and FDco
 317:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  */
 318:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** #define IFXCLOCK_GET_RGAIN_NOM(MA, FDco)           ((2 * (MA / 100) * (FDco / IFXCLOCK_MODULATION_F
 319:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
 320:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** /** \brief Get RGAin HEX from RGain Nominal value
 321:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  */
