 116:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *       // fPLL2 = N * fIN / P * K3 * 1. 0 -> K3PREDIV = 0
 117:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *       // fPLL2 = N * fIN / P * K3 * 1. 1 -> K3PREDIV = 1
