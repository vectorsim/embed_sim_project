 252:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     /* min. value of (l_oversampling + 1) is 4 */
 253:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     uint32                l_oversampling = (IfxAsclin_OversamplingFactor)__maxu((oversampling + 1),
