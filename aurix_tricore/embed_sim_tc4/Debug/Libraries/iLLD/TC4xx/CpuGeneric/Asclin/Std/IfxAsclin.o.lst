 454:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     {
 455:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****         while (IfxAsclin_getClockStatus(asclin) != 0U)
