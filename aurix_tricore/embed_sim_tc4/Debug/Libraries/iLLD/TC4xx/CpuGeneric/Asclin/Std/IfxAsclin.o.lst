 246:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     float32               f;
 247:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c **** 
 248:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     /* get the prescaler value */
 249:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     uint32                prescaler      = asclin->BITCON.B.PRESCALER + 1;
 250:../Libraries/iLLD/TC4xx/CpuGeneric/Asclin/Std/IfxAsclin.c ****     /* get the PD frequency */
