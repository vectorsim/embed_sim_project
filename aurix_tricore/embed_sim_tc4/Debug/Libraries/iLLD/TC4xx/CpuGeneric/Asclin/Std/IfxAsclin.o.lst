  89:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     IfxClock_Config        IfxClock_sampleClockConfig;
  90:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  91:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     IfxClock_initConfig(&IfxClock_sampleClockConfig);
  92:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  93:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  94:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  95:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   // To change xtal frequency dynamically during run time:
