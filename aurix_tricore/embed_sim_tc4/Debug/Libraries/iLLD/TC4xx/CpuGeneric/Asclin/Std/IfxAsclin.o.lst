  34:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \{
  35:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  36:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * The  Clock control unit driver provides a default configuration for pll and Clock initialisation
  37:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  38:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * In the following sections it will be described, how to integrate the driver into the application
  39:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  40:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \section IfxLld_Clock_Std_Preparation Preparation
  41:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \subsection IfxLld_Clock_Std_Include Include Files
  42:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  43:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * Include following header file into your C code:
  44:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \code
  45:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * #include <Clock/Std/IfxClock.h>
  46:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \endcode
  47:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  48:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \subsection IfxLld_Clock_Std_Variables Variables
  49:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  50:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * Declare the Clock Configuration variables in your C code:
  51:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  52:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \code
  53:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * // used globally
  54:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
  55:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * static const IfxClock_FlashWaitstateConfig IfxClock_defaultFlashWaitstateConfig = IFXCLOCK_CFG_F
  56:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * // Default configuration for the Clock Configuration
  57:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * IfxClock_Config                      IfxClock_testClockConfig = {
  58:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     IFX_CFG_CLOCK_XTAL_FREQUENCY,
  59:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     IFXCLOCK_CFG_SYS_PLL_INITIAL_STEP,
  60:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     IFXCLOCK_CFG_PER_PLL_INITIAL_STEP,
  61:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *  #if !defined(IFX_CLOCK_DISABLE_RAMPCON)
  62:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     {IfxClock_RampWaitTime_8us, 500},
  63:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * #endif
  64:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     IFXCLOCK_CFG_CLK_DISTRIBUTION,
  65:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     &IfxClock_defaultFlashWaitstateConfig,
  66:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     &IfxClock_defaultModConfig,
  67:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     IfxClock_PllInputClockSelection_fOsc0,
  68:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     IfxClock_SysClockSourceSelect_pll,
  69:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     IfxClock_PerClockSourceSelect_pll
  70:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * };
