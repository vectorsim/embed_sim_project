 635:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu_IntrinsicsGcc.h ****     __asm__ volatile("rsub %2,%2,0 \n\
 636:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu_IntrinsicsGcc.h ****                     dextr  %0,%1,%1,%2"
 637:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu_IntrinsicsGcc.h ****                      :"=d"(res):"d"(operand), "d"(count):"memory");
