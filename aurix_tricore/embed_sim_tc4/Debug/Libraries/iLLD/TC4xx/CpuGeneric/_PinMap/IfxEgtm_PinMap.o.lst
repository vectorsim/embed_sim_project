1078:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** 
1079:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** IFX_INLINE void IfxPort_setGroupState(Ifx_P *port, uint8 pinIndex, uint16 mask, uint16 data)
1080:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** {
1081:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****     port->OUT.U = (port->OUT.U & ~((uint32)(mask)) << pinIndex) | (data << pinIndex);
1082:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** }
