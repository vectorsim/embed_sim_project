 151:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
 152:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** /** \brief SRN index Values corresponding to each SRN index
 153:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  */
 154:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** typedef struct
 155:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** {
 156:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     uint16 srnIndexVal0;       /**< \brief SRN index value for interrupt trigger-0. Range: 0 to 0x7
