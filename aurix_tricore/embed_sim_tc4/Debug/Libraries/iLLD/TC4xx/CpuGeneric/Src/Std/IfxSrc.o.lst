 485:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** /*---------------------Inline Function Implementations------------------------*/
 486:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** /******************************************************************************/
 487:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
 488:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** IFX_INLINE void IfxSrc_clearOverrun(volatile Ifx_SRC_SRCR *src)
 489:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** {
 490:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     src->B.IOVCLR = 1;
 491:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** }
 492:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
 493:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
 494:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** IFX_INLINE void IfxSrc_clearRequest(volatile Ifx_SRC_SRCR *src)
 495:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** {
 496:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     src->B.CLRR = 1;
 497:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** }
 498:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
 499:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
 500:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** IFX_INLINE void IfxSrc_deinit(volatile Ifx_SRC_SRCR *src)
 501:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** {
 502:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     Ifx_SRC_SRCR srcTmp;
 503:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
 504:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     srcTmp.U     = 0U;
 505:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     srcTmp.B.TOS = 0xFU;
 506:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
 507:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     src->U       = srcTmp.U;
 508:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** }
 509:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
 510:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
 511:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** IFX_INLINE void IfxSrc_disable(volatile Ifx_SRC_SRCR *src)
 512:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** {
 513:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     src->B.SRE = 0;
 514:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** }
 515:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
 516:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
 517:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** IFX_INLINE void IfxSrc_enable(volatile Ifx_SRC_SRCR *src)
 518:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** {
 519:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     src->B.SRE = 1;
 520:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** }
 521:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
 522:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
 523:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** IFX_INLINE void IfxSrc_init(volatile Ifx_SRC_SRCR *src, IfxSrc_Tos typOfService, Ifx_Priority prior
 524:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** {
 525:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     Ifx_SRC_SRCR srcTmp;
 526:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
 527:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     srcTmp.U = src->U;
 528:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
 529:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     /* For TOS other than CPU0-5 write VM bitfield with 0 */
 530:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     if (typOfService > 5U)
 531:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     {
 532:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****         vmNumber = IfxSrc_VmId_0;
 533:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     }
 534:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
 535:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** #if !defined(IFX_ILLD_PPU_USAGE)
 536:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
 537:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     if (IfxCpu_getCoreIndex() == IfxCpu_ResourceCpu_6)
 538:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     {
 539:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****         srcTmp.B.CS = 1U;
 540:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     }
 541:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
 542:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** #endif
 543:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** #if (IFX_CFG_VIRTUALIZATION_DISABLED == 1)
 544:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     /* If Virtualization is disabled then always write VM bitfield with 0 */
 545:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     srcTmp.B.SRPN = priority;
 546:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     srcTmp.B.TOS  = typOfService;
 547:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     srcTmp.B.VM   = 0U;
 548:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** #else
 549:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     srcTmp.B.SRPN = priority;
 550:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     srcTmp.B.TOS  = typOfService;
 551:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     srcTmp.B.VM   = vmNumber;
 552:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** #endif
 553:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
 554:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     src->U = srcTmp.U;
 555:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     IfxSrc_clearRequest(src);
 556:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** }
 557:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
 558:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
 559:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** IFX_INLINE boolean IfxSrc_isOverrun(volatile Ifx_SRC_SRCR *src)
 560:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** {
 561:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     return src->B.IOV ? TRUE : FALSE;
 562:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** }
 563:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
 564:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
 565:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** IFX_INLINE boolean IfxSrc_isRequested(volatile Ifx_SRC_SRCR *src)
 566:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** {
 567:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     return src->B.SRR ? TRUE : FALSE;
 568:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** }
 569:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
 570:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
 571:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** IFX_INLINE void IfxSrc_setRequest(volatile Ifx_SRC_SRCR *src)
 572:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** {
 573:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     src->B.SETR = 1;
