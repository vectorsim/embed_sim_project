 158:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     uint16 srnIndexVal2;       /**< \brief SRN index Value for interrupt trigger-2. Range: 0 to 0x7
 159:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     uint16 srnIndexVal3;       /**< \brief SRN index Value for interrupt trigger-3. Range: 0 to 0x7
 160:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** } IfxSrc_OtgbSrnIndexVal;
 161:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
 162:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** /** \brief Configuration for Service Provider trigger Set
 163:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  */
 164:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** typedef struct
