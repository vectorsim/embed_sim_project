  65:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** /** \name Interrupt APIs
  66:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \{ */
  67:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** IFX_INLINE boolean areInterruptsEnabled(void);
  68:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** IFX_INLINE boolean disableInterrupts(void);
