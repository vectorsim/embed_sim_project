 291:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 292:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \return Return the time dead line.
 293:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  */
 294:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** IFX_INLINE Ifx_TickTime getDeadLine(Ifx_TickTime timeout)
