 131:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****     IFX_ASSERT(IFX_VERBOSE_LEVEL_ERROR, fifo != NULL_PTR);
 132:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c **** 
 133:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****     if ((count < fifo->elementSize) || (count > fifo->size))
 134:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****     {                           /* Only complete elements can be read from the buffer */
 135:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****         result = FALSE;
 136:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****     }
 137:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****     else
 138:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****     {
 139:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c **** 
 140:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****         sint32  waitCount;
 141:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c **** #if !defined(IFX_ILLD_PPU_USAGE)
 142:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****         boolean interruptState;
 143:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****         interruptState = IfxCpu_disableInterrupts();
 144:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c **** #endif
 145:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****         waitCount      = count - Ifx_Fifo_readCount(fifo);
 146:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c **** 
 147:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****         if (waitCount <= 0)
 148:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****         {
 149:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****             fifo->shared.readerWaitx = 0;
 150:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****             fifo->eventReader        = TRUE;
 151:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c **** 		#if !defined(IFX_ILLD_PPU_USAGE)
 152:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****             IfxCpu_restoreInterrupts(interruptState);
 153:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c **** 		#endif
 154:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****             result                   = TRUE;
 155:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****         }
 156:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****         else
 157:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****         {
 158:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****             Ifx_TickTime DeadLine = getDeadLine(timeout);
 159:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****             fifo->eventReader        = FALSE;
 160:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****             fifo->shared.readerWaitx = waitCount;
 161:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c **** #if !defined(IFX_ILLD_PPU_USAGE)
 162:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****             IfxCpu_restoreInterrupts(interruptState);
 163:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c **** #endif
 164:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c **** 
 165:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****             while ((fifo->eventReader == FALSE) && (isDeadLine(DeadLine) == FALSE))
 166:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****             {}
 167:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****             /* After the timeout, the reader is not waiting for any data */
 168:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****             fifo->shared.readerWaitx = 0;
 169:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****             result = fifo->eventReader == TRUE;
 170:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****         }
 171:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****     }
