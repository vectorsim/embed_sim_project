 209:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 210:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** /** \brief Return system timer value (critical section).
 211:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 212:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * The function IfxStm_get() is called in a critical section, disabling
 213:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * the interrupts. The system timer value is limited to TIME_INFINITE.
 214:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 215:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \return Returns system timer value.
 216:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  */
 217:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** IFX_INLINE Ifx_TickTime now(void)
 218:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** {
 219:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     Ifx_TickTime stmNow;
 220:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** #if !defined(IFX_ILLD_PPU_USAGE)
 221:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     boolean      interruptState;
 222:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 223:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     interruptState = disableInterrupts();
 224:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     stmNow         = (Ifx_TickTime)IfxStm_get(BSP_DEFAULT_TIMER) & TIME_INFINITE;
 225:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** #else
 226:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     stmNow         = (Ifx_TickTime)IfxPpu_Timer_readTimer0() & TIME_INFINITE;
 227:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** #endif
 228:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 229:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** #if !defined(IFX_ILLD_PPU_USAGE)
 230:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     restoreInterrupts(interruptState);
 231:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** #endif
 232:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     return stmNow;
 233:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** }
 234:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 235:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** #if !defined(IFX_ILLD_PPU_USAGE)
 236:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** /** \brief Return system timer value (without critical section).
 237:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 238:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * The function IfxStm_get() is called. The system timer value is limited to TIME_INFINITE.
 239:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 240:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \return Returns system timer value.
 241:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  */
 242:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** IFX_INLINE Ifx_TickTime nowWithoutCriticalSection(void)
 243:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** {
 244:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     Ifx_TickTime stmNow;
 245:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 246:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     stmNow = (Ifx_TickTime)IfxStm_get(BSP_DEFAULT_TIMER) & TIME_INFINITE;
 247:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 248:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     return stmNow;
 249:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** }
 250:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** #endif
 251:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 252:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** /** \brief Add 2 Ifx_TickTime values and return the result
 253:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 254:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \param a parameter a
 255:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \param b parameter b
 256:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 257:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \return a + b. If either a or b is TIME_INFINITE, the result is TIME_INFINITE
 258:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  */
 259:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** IFX_INLINE Ifx_TickTime addTTime(Ifx_TickTime a, Ifx_TickTime b)
 260:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** {
 261:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     Ifx_TickTime result;
 262:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 263:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     if ((a == TIME_INFINITE) || (b == TIME_INFINITE))
 264:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     {
 265:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****         result = TIME_INFINITE;
 266:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     }
 267:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     else
 268:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     {
 269:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****         result = a + b;         /* FIXME check for overflow */
 270:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     }
 271:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 272:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     return result;
 273:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** }
 274:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 275:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 276:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** /** \brief Return the elapsed time in ticks.
 277:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 278:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * Return the elapsed time between the current time and the time passed as parameter
 279:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 280:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \return Returns the elapsed time.
 281:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  */
 282:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** IFX_INLINE Ifx_TickTime elapsed(Ifx_TickTime since)
 283:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** {
 284:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     return now() - since;
 285:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** }
 286:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 287:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
