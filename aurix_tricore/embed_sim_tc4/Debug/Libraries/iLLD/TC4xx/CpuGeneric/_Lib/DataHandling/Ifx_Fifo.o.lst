 311:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** /** \brief Return the time until the dead line.
 312:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 313:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \param deadline Specifies the dead line from now: Deadline = Now + Timeout
 314:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 315:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \return Return the time until the dead line.
 316:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  */
 317:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** IFX_INLINE Ifx_TickTime getTimeout(Ifx_TickTime deadline)
 318:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** {
 319:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     Ifx_TickTime timeout;
 320:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 321:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     if (deadline == TIME_INFINITE)
 322:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     {
 323:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****         timeout = TIME_INFINITE;
 324:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     }
 325:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     else
 326:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     {
 327:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****         timeout = deadline - now();
 328:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     }
 329:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 330:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     return timeout;
 331:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** }
