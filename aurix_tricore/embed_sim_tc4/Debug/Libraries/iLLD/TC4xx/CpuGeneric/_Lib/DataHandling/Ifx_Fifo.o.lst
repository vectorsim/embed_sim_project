1050:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_INLINE void IfxCpu_enableSegmentSpecificInstructionAccessCacheability(uint16 segmentNumberMask,
1051:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** {
1052:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     uint32 cpu_pmaVal;
1053:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     uint16 checkRestrictionMask;
1054:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     uint32 coreIndex = IfxCpu_getCoreIndex();
1055:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     //uint16 wdtPassword = IfxScuWdt_getCpuWatchdogPasswordInline(&MODULE_SCU.WDTCPU[coreIndex]);
1056:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1057:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     /*resolve the restrictions*/
1058:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     /*In PMA1 Segment-D and Segment[7-CoreID] must have the same value */
1059:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     checkRestrictionMask = ((uint16)1 << (7 - coreIndex)) | ((uint16)1 << 0xD);
1060:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1061:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     if ((segmentNumberMask & checkRestrictionMask) != 0)
1062:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     {
1063:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****         segmentNumberMask |= checkRestrictionMask;
1064:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     }
1065:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1066:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     cpu_pmaVal = __mfcr(CPU_PMA1);                                                              /* 
1067:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1068:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     cpu_pmaVal = enable ? (cpu_pmaVal | segmentNumberMask) : (cpu_pmaVal & ~segmentNumberMask); /* 
1069:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1070:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     /*The CPU_PMA registers are ENDINIT protected*/
1071:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     //IfxScuWdt_clearCpuEndinitInline(&MODULE_SCU.WDTCPU[coreIndex], wdtPassword);
1072:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     /*When changing the value of the CPU_PMAx registers both the instruction and data caches should
1073:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     /*Write to PMA1 register for selecting the cacheability for data cache*/
1074:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     __dsync();      /* DSYNC instruction should be executed immediately prior to the MTCR */
1075:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     __mtcr(CPU_PMA1, cpu_pmaVal);
1076:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     __isync();      /* ISYNC instruction executed immediately following MTCR */
1077:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     //IfxScuWdt_setCpuEndinitInline(&MODULE_SCU.WDTCPU[coreIndex], wdtPassword);
1078:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** }
