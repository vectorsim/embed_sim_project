 109:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * \ingroup IfxLld_Stm_Std
 110:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * \defgroup IfxLld_Stm_Std_Timer Timer Functions
