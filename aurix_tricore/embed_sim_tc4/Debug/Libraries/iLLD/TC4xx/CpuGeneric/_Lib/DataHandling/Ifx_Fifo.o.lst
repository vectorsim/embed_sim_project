 221:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****         buffer.index  = (uint16)fifo->startIndex;   /* startIndex always fit into size */
 222:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.c ****         DeadLine      = getDeadLine(timeout);
