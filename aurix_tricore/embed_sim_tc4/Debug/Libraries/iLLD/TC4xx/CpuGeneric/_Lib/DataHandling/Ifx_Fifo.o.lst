  71:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.h **** 
  72:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.h **** /** \brief Indicates if the required number of bytes are available in the buffer
  73:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.h ****  *
  74:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.h ****  * Should not be called from an interrupt as this function may wait forever
  75:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.h ****  * \param fifo Pointer on the Fifo object
  76:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.h ****  * \param count in bytes
  77:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.h ****  * \param timeout in system timer ticks
  78:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.h ****  *
  79:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.h ****  * \return TRUE if at least count bytes can be read from the buffer, else
  80:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.h ****  * the Event is armed to be set when the buffer count is bigger or equal to the requested count
  81:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.h ****  */
  82:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.h **** IFX_EXTERN boolean Ifx_Fifo_canReadCount(Ifx_Fifo *fifo, Ifx_SizeT count, Ifx_TickTime timeout);
  83:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.h **** /** \brief  Indicates if there is enough free space to write the data in the buffer
  84:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.h ****  *
  85:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.h ****  * Should not be called from an interrupt as this function may wait forever
  86:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.h ****  *
  87:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.h ****  * \param fifo Pointer on the Fifo object
  88:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.h ****  * \param count in bytes
  89:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.h ****  * \param timeout in system timer ticks
  90:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.h ****  *
  91:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.h ****  * \return TRUE if at least count bytes can be written to the buffer,
  92:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.h ****  * if not the Event is armed to be set when the buffer free count is bigger or equal to the request
  93:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.h ****  */
  94:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.h **** IFX_EXTERN boolean Ifx_Fifo_canWriteCount(Ifx_Fifo *fifo, Ifx_SizeT count, Ifx_TickTime timeout);
  95:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.h **** 
  96:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.h **** /** \brief Clear fifo contents.
