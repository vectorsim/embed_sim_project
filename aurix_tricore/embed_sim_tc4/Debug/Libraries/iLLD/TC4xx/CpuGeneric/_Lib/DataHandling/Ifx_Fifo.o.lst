 102:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.h **** IFX_EXTERN void Ifx_Fifo_clear(Ifx_Fifo *fifo);
 103:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.h **** 
 104:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.h **** /** \brief Create a Fifo object
 105:../Libraries/iLLD/TC4xx/CpuGeneric/_Lib/DataHandling/Ifx_Fifo.h ****  *
