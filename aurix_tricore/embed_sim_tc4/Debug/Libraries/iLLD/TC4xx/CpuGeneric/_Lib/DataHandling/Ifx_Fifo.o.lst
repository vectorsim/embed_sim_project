  78:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
  79:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** /** \brief Return the status of the global interrupts
  80:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
  81:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \retval TRUE if the global interrupts are enabled.
  82:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \retval FALSE if the global interrupts are disabled.
  83:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
  84:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \see restoreInterrupts(), disableInterrupts()
  85:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  */
  86:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** IFX_INLINE boolean areInterruptsEnabled(void)
  87:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** {
  88:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     return IfxCpu_areInterruptsEnabled();
  89:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** }
  90:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
  91:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
  92:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** /** \brief Disable the global interrupts
  93:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
  94:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \retval TRUE if the global interrupts were enabled before the call to the function.
  95:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \retval FALSE if the global interrupts are disabled before the call to the function.
  96:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
  97:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \see areInterruptsEnabled(), restoreInterrupts()
  98:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  */
  99:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** IFX_INLINE boolean disableInterrupts(void)
 100:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** {
 101:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     return IfxCpu_disableInterrupts();
 102:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** }
 103:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 104:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 105:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** /** \brief Disable the global interrupts forcefully
 106:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 107:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 108:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \see areInterruptsEnabled(), restoreInterrupts()
 109:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  */
 110:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** IFX_INLINE void forceDisableInterrupts(void)
 111:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** {
 112:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     IfxCpu_forceDisableInterrupts();
 113:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** }
 114:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 115:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 116:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** /** \brief enable the global interrupts
 117:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 118:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  */
 119:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** IFX_INLINE void enableInterrupts(void)
 120:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** {
 121:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     IfxCpu_enableInterrupts();
 122:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** }
 123:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 124:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 125:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** /** \brief Restore the state of the global interrupts.
 126:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 127:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \param enabled if TRUE, re-enable the global interrupts, else do nothing.
 128:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 129:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \return None.
 130:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 131:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \see areInterruptsEnabled(), disableInterrupts()
 132:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  */
 133:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** IFX_INLINE void restoreInterrupts(boolean enabled)
 134:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** {
 135:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     IfxCpu_restoreInterrupts(enabled);
 136:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** }
 137:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** #endif
