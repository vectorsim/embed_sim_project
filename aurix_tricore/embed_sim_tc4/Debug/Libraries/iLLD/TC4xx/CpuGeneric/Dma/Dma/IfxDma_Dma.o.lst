 457:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** 
 458:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** /** \brief Converts DMA circular range to circular code.
 459:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 460:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[in] range DMA circular range. Range: 0 to 0xFFFF.
 461:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 462:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \retval IfxDma_ChannelIncrementCircular DMA circular code. Range: \ref IfxDma_ChannelIncrementCi
 463:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  */
 464:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** IFX_INLINE IfxDma_ChannelIncrementCircular IfxDma_getCircularRangeCode(uint16 range);
 465:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** 
 466:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** /** \brief Return the hardware transaction request status of a DMA channel.
 467:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 468:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[in] dma       Pointer to DMA module.
 469:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[in] channelId DMA channel number. Range: \ref IfxDma_ChannelId.
 470:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 471:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \retval TRUE  The hardware transaction request is enabled for the specified channel.
 472:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *         FALSE The hardware transaction request is disabled for the specified channel.
 473:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 474:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * A coding example can be found in \ref IfxDma_isChannelReset
 475:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 476:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  */
 477:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** IFX_INLINE boolean IfxDma_isChannelTransactionEnabled(Ifx_DMA *dma, IfxDma_ChannelId channelId);
 478:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** 
 479:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** /** \brief Return the status of a DMA channel (transaction pending).
 480:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 481:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[in] dma       Pointer to DMA module.
 482:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[in] channelId DMA channel number. Range: \ref IfxDma_ChannelId.
 483:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 484:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \retval TRUE If a transaction request for the specified channel is pending.
 485:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *         FALSE If no transaction request for the specified channel is pending.
 486:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 487:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \code
 488:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      // check for the channel request pending with the channel
 489:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      if (IfxDma_isChannelTransactionPending(chn[0].dma, chn[0].channelId) == TRUE) {
 490:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *              // There is channel request pending for channel 0
 491:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *              result |= 0;
 492:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      }
 493:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \endcode
 494:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 495:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  */
 496:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** IFX_INLINE boolean IfxDma_isChannelTransactionPending(Ifx_DMA *dma, IfxDma_ChannelId channelId);
 497:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** 
