 699:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** /** \brief Return remaining DMA transfer count.
 700:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 701:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[in] dma       Pointer to DMA module.
 702:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[in] channelId DMA channel number. Range: \ref IfxDma_ChannelId.
 703:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 704:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \retval uint32 Remaining DMA transfer count. Range: 0 to 0x3FFF.
 705:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 706:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \code
 707:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      // Wait till transfer count (TCOUNT) becomes 0
 708:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 709:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      bool notFinished;
 710:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      do {
 711:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *              notFinished = false;
 712:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *                      if( IfxDma_getChannelTransferCount(chn[0].dma, chn[0].channelId) ) {
 713:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *                              notFinished = true;
 714:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *                              break;
 715:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *                      }
 716:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      } while( notFinished );
 717:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \endcode
 718:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 719:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  */
