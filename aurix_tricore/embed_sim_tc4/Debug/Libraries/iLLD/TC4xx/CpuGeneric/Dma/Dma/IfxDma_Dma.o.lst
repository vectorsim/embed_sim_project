 528:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** /** \brief Clear the DMA error status flags.
 529:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 530:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[inout] dma                       Pointer to DMA module.
 531:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[in]    hardwareResourcePartition DMA hardware resource partition. Range: \ref IfxDma_Hard
 532:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[in]    mask                      Value holds the bits to clear or mask. Range: 0 to 0x500
 533:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 534:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \retval None
 535:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 536:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \code
 537:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      // Clear the status of the error flags (as defined in _Impl/IfxDma_cfg.h)
 538:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      IfxDma_clearErrorFlags(chn[0].dma,IfxDma_MoveEngine_1,
 539:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *                                                  IFXDMA_ERROR_S |    // move engine source error
 540:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *                                                  IFXDMA_ERROR_D |    // move engine destination 
 541:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *                                                  IFXDMA_ERROR_SPB |  // bus error on SPB
