 294:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** 
 295:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** /** \brief Return the status of a DMA channel (reset / not reset).
 296:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 297:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[in] dma       Pointer to DMA module.
 298:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[in] channelId DMA channel number. Range: \ref IfxDma_ChannelId.
 299:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 300:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \retval TRUE The DMA channel is in the reset state.
 301:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *         FALSE The DMA channel is not in the reset state.
 302:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 303:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \code
 304:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      // check whether the channel is reset or not and also the hardware trigger disabled
 305:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 306:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      if (IfxDma_isChannelReset(chn[0].dma, chn[0].channelId) &&
 307:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *              (!IfxDma_isChannelTransactionEnabled(chn[0].dma, chn[0].channelId))) {
 308:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *              // Dma is out of RESET and there is no hardware request enabled
 309:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *              IfxDma_Dma_startChannelTransaction(&chn[0]);
 310:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      }
 311:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \endcode
 312:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 313:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  */
 314:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** IFX_INLINE boolean IfxDma_isChannelReset(Ifx_DMA *dma, IfxDma_ChannelId channelId);
 315:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** 
 316:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** /** \brief Reset the channel.
 317:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 318:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[inout] dma       Pointer to DMA module.
 319:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[in]    channelId DMA channel number. Range: \ref IfxDma_ChannelId.
 320:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 321:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \retval None
