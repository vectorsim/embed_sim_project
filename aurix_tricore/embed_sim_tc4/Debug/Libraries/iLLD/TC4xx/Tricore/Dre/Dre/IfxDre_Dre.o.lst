1017:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1018:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1019:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_INLINE void IfxCpu_enableSegmentSpecificDataAccessCacheability(uint16 segmentNumberMask, boolea
1020:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** {
1021:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     uint32 cpu_pmaVal;
1022:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     uint16 checkRestrictionMask;
1023:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     uint32 coreIndex = IfxCpu_getCoreIndex();
1024:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     //uint16 wdtPassword = IfxScuWdt_getCpuWatchdogPasswordInline(&MODULE_SCU.WDTCPU[coreIndex]);
1025:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1026:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     /*resolve the restrictions*/
1027:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     /*In PMA0 Segment-C and Segment[7-CoreID] must have the same value */
1028:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     checkRestrictionMask = ((uint16)1 << (7 - coreIndex)) | ((uint16)1 << 0xC);
1029:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1030:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     if ((segmentNumberMask & checkRestrictionMask) != 0)
1031:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     {
1032:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****         segmentNumberMask |= checkRestrictionMask;
1033:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     }
1034:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1035:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     cpu_pmaVal = __mfcr(CPU_PMA0);                                                              /* 
1036:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1037:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     cpu_pmaVal = enable ? (cpu_pmaVal | segmentNumberMask) : (cpu_pmaVal & ~segmentNumberMask); /* 
1038:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1039:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     /*The CPU_PMA registers are ENDINIT protected*/
1040:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     //IfxScuWdt_clearCpuEndinitInline(&MODULE_SCU.WDTCPU[coreIndex], wdtPassword);
1041:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     /*When changing the value of the CPU_PMAx registers both the instruction and data caches should
1042:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     /*Write to PMA0 register for selecting the cacheability for data cache*/
1043:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     __dsync();      /* DSYNC instruction should be executed immediately prior to the MTCR*/
1044:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     __mtcr(CPU_PMA0, cpu_pmaVal);
1045:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     __isync();      /* ISYNC instruction executed immediately following MTCR */
1046:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     //IfxScuWdt_setCpuEndinitInline(&MODULE_SCU.WDTCPU[coreIndex], wdtPassword);
1047:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** }
1048:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1049:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1050:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_INLINE void IfxCpu_enableSegmentSpecificInstructionAccessCacheability(uint16 segmentNumberMask,
1051:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** {
1052:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     uint32 cpu_pmaVal;
1053:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     uint16 checkRestrictionMask;
1054:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     uint32 coreIndex = IfxCpu_getCoreIndex();
1055:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     //uint16 wdtPassword = IfxScuWdt_getCpuWatchdogPasswordInline(&MODULE_SCU.WDTCPU[coreIndex]);
1056:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1057:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     /*resolve the restrictions*/
1058:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     /*In PMA1 Segment-D and Segment[7-CoreID] must have the same value */
1059:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     checkRestrictionMask = ((uint16)1 << (7 - coreIndex)) | ((uint16)1 << 0xD);
1060:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1061:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     if ((segmentNumberMask & checkRestrictionMask) != 0)
1062:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     {
1063:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****         segmentNumberMask |= checkRestrictionMask;
