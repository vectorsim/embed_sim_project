 631:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.h **** /** \brief Retrieves the error flags indicating the current error status of the QSPI module.
 632:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.h ****  *
 633:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.h ****  * \param[in] qspi Pointer to QSPI module registers.
 634:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.h ****  *
 635:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.h ****  * \retval uint16 A 16-bit value representing the current error flags.
 636:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.h ****  *                 Range:
 637:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.h ****  *                - 0x001 Parity Error,
 638:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.h ****  *                - 0x002 Unexpected Configuration Error,
 639:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.h ****  *                - 0x004 Baud Rate Error (slave mode),
 640:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.h ****  *                - 0x008 TXFIFO overflow (software error),
 641:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.h ****  *                - 0x010 TXFIFO underflow (slave mode),
 642:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.h ****  *                - 0x020 RXFIFO overflow,
 643:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.h ****  *                - 0x040 RXFIFO underflow (software error),
 644:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.h ****  *                - 0x080 EXPECT time out error,
 645:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.h ****  *                - 0x100 SLSI misplaced inactivation (slave mode).
 646:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.h ****  */
 647:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.h **** IFX_INLINE uint16 IfxQspi_getErrorFlags(Ifx_QSPI *qspi);
 648:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.h **** 
 649:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.h **** /** \brief Returns the transmit request status.
