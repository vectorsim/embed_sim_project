  59:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.c ****     bacon.U = 0;
  60:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.c **** 
  61:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.c ****     IfxQspi_calculateDelayConstants(qspi, channelId, chMode, delayConst);
  62:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.c ****     /* 1-bits Last Word in a Frame, will be set via recalcBasicConfiguration before transfer */
  63:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.c ****     bacon.B.LAST   = 0;
  64:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.c **** 
  65:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.c ****     /* 3-bits Prescaler for the Idle Delay */
  66:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.c ****     bacon.B.IPRE   = delayConst[0].pre;
  67:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.c ****     /* 3-bits Idle Delay Length */
  68:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.c ****     bacon.B.IDLE   = delayConst[0].delay;
  69:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.c ****     /* 3-bits Prescaler for the Leading Delay */
  70:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.c ****     bacon.B.LPRE   = delayConst[1].pre;
  71:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.c ****     /* 3-bits Leading Delay Length */
  72:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.c ****     bacon.B.LEAD   = delayConst[1].delay;
  73:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.c ****     /* 3-bits Prescaler for the Trailing Delay */
  74:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.c ****     bacon.B.TPRE   = delayConst[2].pre;
  75:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.c ****     /* 2-bits Trailing Delay Length */
  76:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.c ****     bacon.B.TRAIL  = delayConst[2].delay;
  77:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.c ****     bacon.B.PARTYP = (chMode->parityMode == Ifx_ParityMode_even) ? 0 : 1;
  78:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.c ****     /* 1-bits User Interrupt at the PT1 Event in the Subsequent Frames */
  79:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.c ****     bacon.B.UINT   = 0;
  80:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.c ****     bacon.B.MSB    = (chMode->dataHeading == IfxQspi_DataHeading_lsbFirst) ? 0 : 1;
  81:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.c ****     /* Only support bitwise selection in B.DL */
  82:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.c ****     bacon.B.BYTE   = 0;
  83:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.c ****     bacon.B.DL     = chMode->dataWidth - 1;
  84:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.c ****     bacon.B.CS     = channelId;
  85:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.c **** 
  86:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.c ****     return bacon.U;
  87:../Libraries/iLLD/TC4xx/Tricore/Qspi/Std/IfxQspi.c **** }
