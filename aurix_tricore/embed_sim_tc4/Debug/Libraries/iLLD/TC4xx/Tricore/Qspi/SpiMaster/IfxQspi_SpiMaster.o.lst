 367:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** /** \brief Disable the generation of a channel transaction lost error interrupt.
 368:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 369:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[inout] dma       Pointer to DMA module.
 370:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[in]    channelId DMA channel number. Range: \ref IfxDma_ChannelId.
 371:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 372:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \retval None
 373:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 374:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \code
 375:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      // Disable the transaction request lost interrupt for given channel
 376:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      IfxDma_disableChannelTransactionLostError(chn[0].dma, chn[0].channelId);
 377:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \endcode
 378:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
