 821:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c **** 
 822:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c **** void IfxQspi_SpiMaster_packLongModeBuffer(IfxQspi_SpiMaster_Channel *chHandle, void *data, uint32 *
 823:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c **** {
 824:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****     boolean isFirst = 0;
 825:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****     uint8  *src     = (uint8 *)data;
 826:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****     uint32  i, baconDL;
 827:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c **** 
 828:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****     baconDL = 16;
 829:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c **** 
 830:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****     /* Configure the BACON register based on the channel mode */
 831:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****     if (chHandle->mode == IfxQspi_SpiMaster_Mode_longContinuous)
 832:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****     {
 833:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****         chHandle->bacon.B.BYTE = 1;
 834:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****         chHandle->bacon.B.LAST = 0;
 835:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****     }
 836:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****     else if (chHandle->mode == IfxQspi_SpiMaster_Mode_long)
 837:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****     {
 838:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****         chHandle->bacon.B.BYTE = 1;
 839:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****         chHandle->bacon.B.LAST = 1;
 840:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****     }
 841:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****     else
 842:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****     {
 843:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****         IFX_ASSERT(IFX_VERBOSE_LEVEL_ERROR, IFX_ASSERT_FEATURE_NOT_IMPLEMENTED);
 844:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****     }
 845:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c **** 
 846:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****     /* Wait until all data is packed into the FIFO buffer */
 847:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****     while (dataLength > 0)
 848:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****     {
 849:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****         if (dataLength <= 16)
 850:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****         {
 851:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****             baconDL                = dataLength;
 852:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****             chHandle->bacon.B.LAST = 1;
 853:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****         }
 854:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c **** 
 855:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****         dataLength -= (Ifx_SizeT)baconDL;
 856:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c **** 
 857:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****         /* FILL BACON */
 858:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****         if (isFirst == 0)
 859:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****         {
 860:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****             isFirst = 1;
 861:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****         }
 862:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****         else
 863:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****         {
 864:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****             chHandle->bacon.B.DL = baconDL - 1;
 865:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****             *longFifoBuffer      = chHandle->bacon.U;
 866:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****             longFifoBuffer++;
 867:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****         }
 868:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c **** 
 869:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****         for (i = 0; i < baconDL / 4; i++)
 870:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****         {
 871:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****             *longFifoBuffer = *((uint32 *)src);
 872:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****             longFifoBuffer++;
 873:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****             src            += 4;
 874:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****         }
 875:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c **** 
 876:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****         /* Copy Last bytes */
 877:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****         switch (baconDL % 4)
 878:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****         {
 879:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****         case 1:
 880:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****             *longFifoBuffer = *src;
 881:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****             break;
 882:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****         case 2:
 883:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****             *longFifoBuffer = *src | (*(src + 1) << 8);
 884:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****             break;
 885:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****         case 3:
 886:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****             *longFifoBuffer = *src | (*(src + 1) << 8) | (*(src + 2) << 16);
 887:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****             break;
 888:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****         }
 889:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c ****     }
 890:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiMaster/IfxQspi_SpiMaster.c **** }
