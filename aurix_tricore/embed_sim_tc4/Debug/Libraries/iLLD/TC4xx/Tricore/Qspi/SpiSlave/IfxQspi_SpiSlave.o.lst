  98:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c **** IfxQspi_Status IfxQspi_SpiSlave_getStatus(IfxQspi_SpiSlave *handle)
  99:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c **** {
 100:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     IfxQspi_Status status = IfxQspi_Status_ok;
 101:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c **** 
 102:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     /* Check if the SPI slave is currently transferring data */
 103:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     if (handle->onTransfer != 0)
 104:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     {
 105:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     	/* Update the status to busy if a transfer is active */
 106:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         status = IfxQspi_Status_busy;
 107:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     }
 108:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c **** 
 109:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     return status;
 110:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c **** }
 111:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c **** 
