 380:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** IFX_INLINE void IfxDma_disableChannelTransactionLostError(Ifx_DMA *dma, IfxDma_ChannelId channelId)
 381:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** 
 382:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** /** \brief Enable a DMA channel hardware transaction request.
 383:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 384:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[inout] dma       Pointer to DMA module.
 385:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[in]    channelId DMA channel number. Range: \ref IfxDma_ChannelId.
 386:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 387:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \retval None
 388:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 389:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \code
 390:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      unsigned *src = (unsigned *)((unsigned)&SRC_DMACH0.U + 4*NUM_CHANNELS);
 391:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      for(int chn=0; chn<NUM_CHANNELS; ++chn, ++src) {
 392:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *              IfxSrc_setRequest(src);
 393:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      }
 394:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 395:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      // Do not restrict the hardware triggering to only one transaction
 396:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 397:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      IfxDma_setChannelContinuousMode(chn[0].dma, chn[0].channelId);
 398:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      IfxDma_setChannelContinuousMode(chn[1].dma, chn[1].channelId);
 399:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      IfxDma_setChannelContinuousMode(chn[2].dma, chn[2].channelId);
 400:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 401:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      // Check for end of transaction
 402:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 403:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      while(!(IfxDma_getAndClearChannelInterrupt(chn[0].dma, chn[0].channelId)));
 404:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 405:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      // Enable the hardware trigger for channel 3
 406:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      IfxDma_enableChannelTransaction(chn[3].dma, chn[3].channelId);
 407:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 408:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      // Disable the hardware trigger for channel 2
 409:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      IfxDma_disableChannelTransaction(chn[2].dma, chn[2].channelId);
 410:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      // Hardware triggers for second time
 411:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 412:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      unsigned *SRc = (unsigned *)((unsigned)&SRC_DMACH0.U + 4*NUM_CHANNELS);
 413:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      for(int chn=0; chn<NUM_CHANNELS; ++chn, ++src) {
 414:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *              IfxSrc_setRequest(src);
 415:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      }
 416:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 417:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      // Restrict the hardware triggering to only one transaction
 418:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      IfxDma_setChannelSingleMode(chn[0].dma, chn[0].channelId);
 419:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      IfxDma_setChannelSingleMode(chn[1].dma, chn[1].channelId);
 420:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \endcode
 421:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 422:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  */
 423:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** IFX_INLINE void IfxDma_enableChannelTransaction(Ifx_DMA *dma, IfxDma_ChannelId channelId);
 424:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** 
 425:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** /** \brief Enable the generation of a channel transaction lost error interrupt.
 426:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 427:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[inout] dma       Pointer to DMA module.
 428:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[in]    channelId DMA channel number. Range: \ref IfxDma_ChannelId.
 429:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 430:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \retval None
 431:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 432:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \code
 433:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      // Enable the transaction request lost interrupt for given channel
 434:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      IfxDma_enableChannelTransactionLostError(chn[0].dma, chn[0].channelId);
 435:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \endcode
 436:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 437:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  */
 438:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** IFX_INLINE void IfxDma_enableChannelTransactionLostError(Ifx_DMA *dma, IfxDma_ChannelId channelId);
 439:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** 
 440:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** /** \brief Check the channel transaction request lost flag status.
 441:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 442:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[in] dma       Pointer to DMA module.
 443:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[in] channelId DMA channel number. Range: \ref IfxDma_ChannelId.
 444:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 445:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \retval TRUE The TRL flag is set, indicating a lost transaction request.
 446:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *         FALSE The TRL flag is not set, indicating no lost transaction request.
 447:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 448:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \code
 449:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      boolean trlFlag;
 450:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 451:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      // Check whether the channel transaction request lost flag is set or not
 452:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      trlFlag = IfxDma_getChannelTransactionRequestLost(chn[0].dma, chn[0].channelId));
 453:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \endcode
 454:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 455:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  */
 456:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** IFX_INLINE boolean IfxDma_getChannelTransactionRequestLost(Ifx_DMA *dma, IfxDma_ChannelId channelId
 457:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** 
 458:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** /** \brief Converts DMA circular range to circular code.
 459:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 460:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[in] range DMA circular range. Range: 0 to 0xFFFF.
 461:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 462:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \retval IfxDma_ChannelIncrementCircular DMA circular code. Range: \ref IfxDma_ChannelIncrementCi
 463:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  */
 464:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** IFX_INLINE IfxDma_ChannelIncrementCircular IfxDma_getCircularRangeCode(uint16 range);
 465:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** 
 466:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** /** \brief Return the hardware transaction request status of a DMA channel.
 467:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 468:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[in] dma       Pointer to DMA module.
 469:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[in] channelId DMA channel number. Range: \ref IfxDma_ChannelId.
 470:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 471:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \retval TRUE  The hardware transaction request is enabled for the specified channel.
 472:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *         FALSE The hardware transaction request is disabled for the specified channel.
 473:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 474:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * A coding example can be found in \ref IfxDma_isChannelReset
 475:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 476:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  */
 477:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** IFX_INLINE boolean IfxDma_isChannelTransactionEnabled(Ifx_DMA *dma, IfxDma_ChannelId channelId);
 478:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** 
 479:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** /** \brief Return the status of a DMA channel (transaction pending).
 480:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 481:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[in] dma       Pointer to DMA module.
 482:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[in] channelId DMA channel number. Range: \ref IfxDma_ChannelId.
 483:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 484:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \retval TRUE If a transaction request for the specified channel is pending.
 485:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *         FALSE If no transaction request for the specified channel is pending.
 486:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 487:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \code
 488:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      // check for the channel request pending with the channel
 489:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      if (IfxDma_isChannelTransactionPending(chn[0].dma, chn[0].channelId) == TRUE) {
 490:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *              // There is channel request pending for channel 0
 491:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *              result |= 0;
 492:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *      }
 493:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \endcode
 494:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 495:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  */
 496:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** IFX_INLINE boolean IfxDma_isChannelTransactionPending(Ifx_DMA *dma, IfxDma_ChannelId channelId);
 497:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** 
 498:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** /** \brief Sets the sensitivity of the module to sleep signal.
 499:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 500:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[inout] dma  Pointer to DMA registers.
 501:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \param[in]    mode Mode selection (enable/disable). Range: \ref IfxDma_SleepMode.
 502:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 503:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \retval None
 504:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  */
 505:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** IFX_INLINE void IfxDma_setSleepMode(Ifx_DMA *dma, IfxDma_SleepMode mode);
 506:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** 
 507:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h **** /** \brief Request a DMA channel transaction.
 508:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
