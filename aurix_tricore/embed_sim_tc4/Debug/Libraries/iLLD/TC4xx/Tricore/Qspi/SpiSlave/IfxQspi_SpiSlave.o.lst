 113:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c **** void IfxQspi_SpiSlave_initModule(IfxQspi_SpiSlave *handle, const IfxQspi_SpiSlave_Config *config)
 114:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c **** {
 115:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     Ifx_QSPI *qspiSFR = config->qspi;
 116:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     Ifx_DMA  *dmaSFR  = NULL_PTR;
 117:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c **** 
 118:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     if ((config->dma.dmaIndex >= IfxDma_Index_0) && (config->dma.dmaIndex < IFXDMA_NUM_MODULES))
 119:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     {
 120:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         dmaSFR = (Ifx_DMA *)IfxDma_cfg_indexMap[config->dma.dmaIndex].module;
 121:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     }
 122:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c **** 
 123:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     /* Handle.base must be at offset 0 to be compatible with the standard interface SscIf */
 124:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     {
 125:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         IfxQspi_setEnableModuleRequest(qspiSFR);
 126:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         IfxQspi_setSleepMode(qspiSFR, (config->allowSleepMode != FALSE) ? IfxQspi_SleepMode_enable 
 127:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     }
 128:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c **** 
 129:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     {
 130:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     	/* Configure GLOBAL, Note: at the moment default values for GLOBAL */
 131:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         Ifx_QSPI_GLOBALCON globalcon;
 132:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         globalcon.U          = 0;
 133:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         globalcon.B.TQ       = IfxQspi_calculateTimeQuantumLength(qspiSFR, config->maximumBaudrate)
 134:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         /* 2^(EXPECT+6) : timeout for expect phase in Tqspi */
 135:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         globalcon.B.EXPECT   = IfxQspi_ExpectTimeout_2097152;
 136:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         /* Select master mode during configuration - we will switch to slave mode at the end of thi
 137:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         globalcon.B.MS       = IfxQspi_Mode_master;
 138:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         globalcon.B.AREN     = (config->pauseOnBaudrateSpikeErrors != FALSE) ? 1U : 0U;
 139:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         /* Reset SM and FIFOs */
 140:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         globalcon.B.RESETS   = 1;
 141:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         globalcon.B.CLKSEL   = 1;
 142:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         qspiSFR->GLOBALCON.U = globalcon.U;
 143:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     }
 144:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c **** 
 145:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     {   /* Configure interrupt requests */
 146:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         Ifx_QSPI_GLOBALCON1 globalcon1;
 147:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         globalcon1.U           = 0;
 148:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         globalcon1.B.ERRORENS  = (config->erPriority > 0) ? IFXQSPI_ERRORENABLEMASK : 0;
 149:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         globalcon1.B.TXEN      = (config->txPriority > 0) || (config->dma.useDma);
 150:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         globalcon1.B.RXEN      = (config->rxPriority > 0) || (config->dma.useDma);
 151:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         globalcon1.B.TXFIFOINT = config->txFifoThreshold;
 152:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         globalcon1.B.RXFIFOINT = config->rxFifoThreshold;
 153:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         globalcon1.B.TXFM      = config->txFifoMode;
 154:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         globalcon1.B.RXFM      = config->rxFifoMode;
 155:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c **** 
 156:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         qspiSFR->GLOBALCON1.U  = globalcon1.U;
 157:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     }
