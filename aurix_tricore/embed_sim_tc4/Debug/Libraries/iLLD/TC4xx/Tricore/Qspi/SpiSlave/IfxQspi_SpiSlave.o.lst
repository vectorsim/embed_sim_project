 449:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c **** boolean IfxQspi_SpiSlave_isError(IfxQspi_SpiSlave *handle, IfxQspi_Error error)
 450:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c **** {
 451:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c **** 	IfxQspi_SpiSlave *chHandle = handle;
 452:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     boolean errorFlag = 0;
 453:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c **** 
 454:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     switch (error)
 455:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     {
 456:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     case IfxQspi_Error_parity:
 457:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     	 errorFlag = chHandle->errorFlags.parityError;
 458:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     	 break;
 459:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     case IfxQspi_Error_configuration:
 460:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     	 errorFlag = chHandle->errorFlags.configurationError;
 461:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     	 break;
 462:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     case IfxQspi_Error_baudrate:
 463:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     	errorFlag = chHandle->errorFlags.baudrateError;
 464:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     	break;
 465:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     case IfxQspi_Error_expectTimeout:
 466:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     	errorFlag = chHandle->errorFlags.expectTimeoutError;
 467:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     	break;
 468:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     case IfxQspi_Error_txfifoOverflow:
 469:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     	errorFlag = chHandle->errorFlags.txFifoOverflowError;
 470:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     	break;
 471:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     case IfxQspi_Error_txfifoUnderflow:
 472:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     	errorFlag = chHandle->errorFlags.txFifoUnderflowError;
