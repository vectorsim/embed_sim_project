 784:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * Coding example:
 785:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \code
 786:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * // configure P33.[7:0] as GPIO outputs
 787:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * IfxPort_setGroupModeOutput(&MODULE_P33, 0, 0xff, IfxPort_OutputMode_pushPull, IfxPort_OutputIdx_
 788:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 789:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * // set initial value
 790:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * IfxPort_setGroupState(&MODULE_P33, 0, 0xff, 0x42);
 791:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \endcode
 792:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 793:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  */
