 512:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * \retval None
 513:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 514:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  * A coding example can be found in \ref IfxDma_Dma_startChannelTransaction
 515:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  *
 516:../Libraries/iLLD/TC4xx/CpuGeneric/Dma/Std/IfxDma.h ****  */
