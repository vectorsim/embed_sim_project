  77:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c **** IfxQspi_Status IfxQspi_SpiSlave_exchange(IfxQspi_SpiSlave *handle, const void *src, void *dest, Ifx
  78:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c **** {
  79:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     IfxQspi_Status status = IfxQspi_Status_busy;
  80:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c **** 
  81:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     /* Initiate transfer when resource is free */
  82:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     if (handle->onTransfer == FALSE)
  83:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     {
  84:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         status                  = IfxQspi_Status_ok;
  85:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c **** 
  86:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         handle->onTransfer      = TRUE;
  87:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         handle->txJob.data      = (void *)src;
  88:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         handle->txJob.remaining = count;
  89:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         handle->rxJob.data      = dest;
  90:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         handle->rxJob.remaining = count;
  91:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****         IfxQspi_SpiSlave_write(handle);
  92:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     }
  93:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c **** 
  94:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c ****     return status;
  95:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c **** }
  96:../Libraries/iLLD/TC4xx/Tricore/Qspi/SpiSlave/IfxQspi_SpiSlave.c **** 
