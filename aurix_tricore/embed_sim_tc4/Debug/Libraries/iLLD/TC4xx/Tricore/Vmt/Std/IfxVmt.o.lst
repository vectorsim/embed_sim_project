 463:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** /** \brief Disables the MBIST Shell of the given SRAM
 464:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * Note: The function should be called with adequate PROT and APU handling (PROTE/PROTCSE).
 465:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \param mbistSel Memory Selection
 466:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \return None
 467:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 468:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * Usage Example
 469:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \code
 470:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 471:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     IfxVmt_disableMbistShell(IfxVmt_MbistSel_cpu0Dtag);
 472:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 473:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     // Note: Wait for Auto-initilisation to be completed for auto-init memories like cpu-Dtag, c
 474:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     while (IfxVmt_isAutoInitRunning(IfxVmt_MbistSel_cpu0Dtag))
 475:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     {}
 476:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \endcode
 477:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 478:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  */
 479:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** IFX_INLINE void IfxVmt_disableMbistShell(IfxVmt_MbistSel mbistSel);
 480:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
 481:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** /** \brief Enables the MBIST Shell of the given SRAM.
 482:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * Note: The function should be called with adequate PROT and APU handling (PROTE/PROTCSE).
 483:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \param mbistSel Memory Selection
 484:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \return None
 485:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 486:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * Usage Example
 487:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \code
 488:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     // Enable VMT clock
 489:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     {
 490:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *         IfxVmt_enableModule();
 491:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     }
 492:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 493:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     {
 494:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *       IfxVmt_enableMbistShell(IfxVmt_MbistSel_cpu0Dtag);
 495:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 496:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *       // Note: Wait for Auto-initilisation to be completed for auto-init memories like cpu-Dtag,
 497:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *       while (IfxVmt_isAutoInitRunning(IfxVmt_MbistSel_cpu0Dtag))
 498:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *       {}
 499:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     }
 500:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \endcode
 501:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 502:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  */
 503:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** IFX_INLINE void IfxVmt_enableMbistShell(IfxVmt_MbistSel mbistSel);
 504:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
 505:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** /** \brief Enables the VMT module
 506:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * Note: The function should be called with adequate PROT and APU handling (PROTE/PROTCSE).
 507:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \param dmtuInstance this will point to the DMTU instance passed by th user(0 to 6)
 508:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \return None
 509:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  */
