 962:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     mc->ALMSRCS.B.MISCE = 1;
 963:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     mc->ALMSRCS.B.OPENE = 1;
 964:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** }
 965:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
