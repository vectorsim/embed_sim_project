 158:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * // for auto-init memories: wait for the end of the clear operation
 159:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * while (IfxVmt_isAutoInitRunning(mbistSel))
 160:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * {}
 161:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * IfxVmt_enableErrorTracking(mbistSel, TRUE);
 162:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * uint32 numEtrr = 5;
 163:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * // print tracked error address
 164:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * {
 165:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *  Ifx_MC_ETRR trackedSramAddresses[IFXVMT_MAX_TRACKED_ADDRESSES];
 166:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *  uint8  numTrackedAddresses = IfxVmt_getTrackedSramAddresses(mbistSel, trackedSramAddresses);
 167:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *  for(uint32 i=0; i<numEtrr; ++i) {
 168:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *                         printf("%d: Error Address:0x%04x, Error System Address:0x%04x \n",
 169:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *                                    i,
 170:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *                                    trackedSramAddresses[i].B.ADDR,
 171:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *                                    IfxVmt_getSystemAddress(mbistSel, trackedSramAddresses[i]));
 172:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *                       }
 173:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *        }
 174:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * }
