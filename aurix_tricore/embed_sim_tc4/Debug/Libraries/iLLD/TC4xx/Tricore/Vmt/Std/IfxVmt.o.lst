  27:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
  28:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
  29:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \defgroup IfxLld_Vmt_Usage How to use the VMT driver?
  30:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \ingroup IfxLld_Vmt
  31:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
  32:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * The Volatile Memory Test (VMT)  controls and monitors the test, initialization and data integrit
  33:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
  34:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * The VMT driver provides set of routines for various Mbist operations
  35:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
  36:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * In the following sections it will be described, how to integrate the Vmt driver into the applica
  37:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
  38:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \section IfxLld_Vmt_SramInit Sram Initialisation
  39:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \subsection IfxLld_Vmt_Include Include Files
  40:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
  41:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * Include following header file into your C code:
  42:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \code
  43:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * #include <Vmt/IfxVmt.h>
  44:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * // include below file only if interrupt mode is used.
  45:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * #include "Src/Std/IfxSrc.h"
  46:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \endcode
  47:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
  48:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \subsection IfxLld_Vmt_Variables Variables
  49:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
  50:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \code
  51:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * // used only if interrupt mode is used.
  52:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * static IfxVmt_MbistSel mbistSel;
  53:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \endcode
  54:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
  55:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \subsection IfxLld_Vmt_Interrupt Interrupt Handler Installation
  56:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
  57:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * See also \ref IfxLld_Cpu_Irq_Usage
  58:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
  59:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * Define priorities for the Interrrupt handlers. This is normally done in the Ifx_IntPrioDef.h fil
  60:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \code
  61:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * // priorities are normally defined in Ifx_IntPrioDef.h
  62:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * #define IFX_INTPRIO_VMT  10
  63:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
  64:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \endcode
  65:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
  66:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * Add the interrupt service routines to your C code. They have to call the Vmt interrupt handlers:
  67:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \code
  68:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * IFX_INTERRUPT(vmtDoneISR, 0, IFX_INTPRIO_VMT)
  69:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * {
  70:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     IfxVmt_isrDone();
  71:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * }
  72:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \endcode
  73:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
  74:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * Finally install the interrupt handlers in your initialisation function:
  75:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \code
  76:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *         volatile Ifx_SRC_SRCR *src;
  77:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *         src = &MODULE_SRC.VMT[0].MBDONE ;
  78:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *         IfxSrc_init(src, IfxCpu_Irq_getTos(IfxCpu_getCoreIndex()) , IFX_INTPRIO_VMT );
  79:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *         IfxSrc_enable(src);
  80:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
  81:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     // install interrupt handlers
  82:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     IfxCpu_Irq_installInterruptHandler(&vmtDoneISR, IFX_INTPRIO_VMT);
  83:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     IfxCpu_enableInterrupts();
  84:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \endcode
  85:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
  86:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \subsection IfxLld_Vmt_ClearSram_SyncPolling Clear Sram (Synchronous polling mode)
  87:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
  88:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * The Sram initialisation in synchronous polling mode (i.e wait till the complete operation is don
  89:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
  90:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \code
  91:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     clearSram(IfxVmt_MbistSel_cpu0Dspr);
  92:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \endcode
  93:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
  94:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \subsection IfxLld_Vmt_ClearSram_ASyncPolling Clear Sram (Asynchronous polling mode)
  95:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
  96:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * The Sram initialisation can be triggered by calling IfxVmt_clearSramStart() function, then can b
  97:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * called.
  98:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * Note: The function should be called with adequate PROT and APU handling (PROTE/PROTCSE) for the 
  99:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 100:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * Following code triggers Sram initilisation.
 101:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \code
 102:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 103:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     IfxVmt_clearSramStart(IfxVmt_MbistSel_cpu0Dspr);
 104:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 105:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \endcode
 106:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 107:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * Sram initialisation status can be queried in a task and once done complete the operation using:
 108:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \code
 109:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     if (IfxVmt_isMbistDone(IfxVmt_MbistSel_cpu0Dspr))
 110:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     {
 111:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *         // Sram Clear operation done
 112:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 113:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 114:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *         IfxVmt_clearSramContinue(IfxVmt_MbistSel_cpu0Dspr);
 115:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 116:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     }
 117:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     else
 118:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     {
 119:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *         // Sram operation is still in progress
 120:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     }
 121:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \endcode
 122:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 123:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \subsection IfxLld_Vmt_ClearSram_ASyncInterrupt Clear Sram (Asynchronous interrupt mode)
 124:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * Do the interrupt configuration and initialisation as specified in \ref IfxLld_Vmt_Interrupt
 125:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * The Sram initialisation can be triggered by calling IfxVmt_clearSramStart() function. Once the o
 126:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * Note: The function should be called with adequate PROT and APU handling (PROTE/PROTCSE) for the 
 127:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 128:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * Following code triggers Sram initialisation.
 129:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \code
 130:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 131:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     mbistSel = IfxVmt_MbistSel_cpu0Dspr; // mbistSel is a static / global variable.
 132:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     IfxVmt_clearSramStart(mbistSel);
 133:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 134:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \endcode
 135:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * In the Vmt done isr, the following code can be used.
 136:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 137:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \code
