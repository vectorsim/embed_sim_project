 139:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     {
 140:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *         // Sram Clear operation done
 141:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 142:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *         IfxVmt_clearSramContinue(mbistSel);
 143:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 144:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     }
