1036:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****         vmtMemstat = (volatile uint32 *)((uint32)&VMT0_MEMSTAT + index);
1037:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     }
1038:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
1039:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     return (*vmtMemstat & mask) != 0;
