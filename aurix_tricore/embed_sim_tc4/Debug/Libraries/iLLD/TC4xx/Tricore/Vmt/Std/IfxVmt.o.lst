 149:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * Example usage of Sram Error tracking
 150:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \code
 151:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * Note: The function should be called with adequate PROT and APU handling (PROTE/PROTCSE)
 152:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 153:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * IfxVmt_MbistSel mbistSel = IfxVmt_MbistSel_cpu1Dspr;
 154:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * Ifx_MC *mc = (Ifx_MC *)(IFXVMT_MC_ADDRESS_BASE + 0x100 * mbistSel);
 155:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 156:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * IfxVmt_enableMbistShell(mbistSel);
