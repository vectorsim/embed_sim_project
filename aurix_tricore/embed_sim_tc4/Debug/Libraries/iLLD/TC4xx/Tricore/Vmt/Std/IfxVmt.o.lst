 958:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** IFX_INLINE void IfxVmt_enableErrorReporting(IfxVmt_MbistSel mbistSel)
 959:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** {
