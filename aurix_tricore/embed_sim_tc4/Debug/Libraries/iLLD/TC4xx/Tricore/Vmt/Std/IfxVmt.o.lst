 821:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** IFX_INLINE void IfxVmt_getFailPostion(uint16 *rdbfl, uint8 towerNum, uint8 towerWidth, uint32 *fail
