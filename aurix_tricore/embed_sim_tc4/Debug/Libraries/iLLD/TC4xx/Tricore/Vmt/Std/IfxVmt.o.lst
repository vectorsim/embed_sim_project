1011:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** IFX_INLINE boolean IfxVmt_isAutoInitRunning(IfxVmt_MbistSel mbistSel)
1012:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** {
