 900:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
 901:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** /******************************************************************************/
 902:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** /*---------------------Inline Function Implementations------------------------*/
 903:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** /******************************************************************************/
 904:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
 905:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** IFX_INLINE void IfxVmt_disableErrorReporting(IfxVmt_MbistSel mbistSel)
 906:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** {
 907:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     Ifx_VMT_MC *mc;
 908:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     mc                  = IfxVmt_getDmtuMcInstancePtr(mbistSel);
 909:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     mc->ALMSRCS.B.MISCE = 0;
 910:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     mc->ALMSRCS.B.OPENE = 0;
 911:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** }
 912:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
 913:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
 914:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** IFX_INLINE void IfxVmt_disableMbistShell(IfxVmt_MbistSel mbistSel)
 915:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** {
 916:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     uint32           tempSel;
 917:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     uint32           sshSel;
 918:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     uint32           index;
 919:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     volatile uint32 *dmtuMemtest;
 920:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     uint32           mask;
 921:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     Ifx_VMT_MC      *mc;
 922:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
 923:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     tempSel = mbistSel;
 924:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
 925:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     if (((mbistSel & 0x100U) >> 8U) != 0U)
 926:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     {
 927:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****         tempSel = (uint32)(mbistSel & 0xFFFFFEFFU);
 928:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     }
 929:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
 930:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     sshSel = IfxVmt_getSshInstance((IfxVmt_MbistSel)tempSel);
 931:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     index  = (uint32)(sizeof(Ifx_VMT)) * (tempSel >> 5);
 932:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     mask   = 1 << (sshSel & 0x1F);
 933:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
 934:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     if (((mbistSel & 0x100U) >> 8U) != 0U)
 935:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     {
 936:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****         dmtuMemtest = (volatile uint32 *)((uint32)&VMT0_MEMTESTCS + index);
 937:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     }
 938:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     else
 939:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     {
 940:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****         dmtuMemtest = (volatile uint32 *)((uint32)&VMT0_MEMTEST + index);
 941:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     }
 942:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
 943:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     *dmtuMemtest &= ~mask;
 944:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
 945:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     while (IfxVmt_isAutoInitRunning(mbistSel))
 946:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     {
 947:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****         __nop();
 948:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     }
 949:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
 950:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     /*Enable Error Reporting  */
 951:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
 952:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     mc                  = IfxVmt_getDmtuMcInstancePtr(mbistSel);
 953:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     mc->ALMSRCS.B.MISCE = 1;
 954:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     mc->ALMSRCS.B.OPENE = 1;
 955:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** }
 956:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
