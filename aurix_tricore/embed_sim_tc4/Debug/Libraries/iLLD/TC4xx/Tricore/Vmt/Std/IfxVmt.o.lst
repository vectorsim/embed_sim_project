1052:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** IFX_INLINE boolean IfxVmt_isMbistDone(IfxVmt_MbistSel mbistSel)
1053:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** {
1054:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     uint32           tempSel;
1055:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     uint32           sshSel;
1056:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     uint32           index;
1057:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     volatile uint32 *memdone;
1058:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     uint32           mask;
