1017:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     uint32           mask;
1018:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
1019:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     tempSel = mbistSel;
1020:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
1021:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     if (((mbistSel & 0x100U) >> 8U) != 0U)
1022:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     {
1023:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****         tempSel = (uint32)(mbistSel & 0xFFFFFEFFU);
1024:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     }
1025:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
1026:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     sshSel = IfxVmt_getSshInstance((IfxVmt_MbistSel)tempSel);
1027:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     index  = (uint32)(sizeof(Ifx_VMT)) * (tempSel >> 5);
1028:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     mask   = 1 << (sshSel & 0x1f);
1029:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
1030:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     if (((mbistSel & 0x100U) >> 8U) != 0U)
1031:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     {
1032:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****         vmtMemstat = (volatile uint32 *)((uint32)&VMT0_MEMSTATCS + index);
1033:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     }
1034:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     else
