 967:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** IFX_INLINE void IfxVmt_enableMbistShell(IfxVmt_MbistSel mbistSel)
 968:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** {
 969:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     uint32           tempSel;
 970:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     uint32           sshSel;
 971:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     uint32           index;
 972:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     volatile uint32 *dmtuMemtest;
 973:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     uint32           mask;
 974:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     Ifx_VMT_MC      *mc;
 975:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
 976:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     tempSel = mbistSel;
 977:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
 978:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     if (((mbistSel & 0x100U) >> 8U) != 0U)
 979:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     {
 980:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****         tempSel = (uint32)(mbistSel & 0xFFFFFEFFU);
 981:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     }
 982:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
 983:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     sshSel              = IfxVmt_getSshInstance((IfxVmt_MbistSel)tempSel);
 984:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     index               = (uint32)(sizeof(Ifx_VMT)) * (tempSel >> 5);
 985:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
 986:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     mc                  = IfxVmt_getDmtuMcInstancePtr(mbistSel);
 987:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     mc->ALMSRCS.B.MISCE = 0;
 988:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     mc->ALMSRCS.B.OPENE = 0;
 989:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     mask                = 1 << (sshSel & 0x1F);
 990:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
 991:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     if (((mbistSel & 0x100U) >> 8U) != 0U)
 992:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     {
 993:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****         dmtuMemtest = (volatile uint32 *)((uint32)&VMT0_MEMTESTCS + index);
 994:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     }
 995:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     else
 996:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     {
 997:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****         dmtuMemtest = (volatile uint32 *)((uint32)&VMT0_MEMTEST + index);
 998:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     }
 999:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
1000:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****     *dmtuMemtest |= mask;
1001:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** }
1002:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
