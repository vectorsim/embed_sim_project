  90:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *  IfxCpu_disableInterruptsAllExceptMaster(masterCpu);\
  91:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *  IfxSmmSysMode_setAllIdleExceptMasterCpu(masterCpu);\
  92:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *  })
