  61:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *   //Application could bring CPU1 to run mode using IfxSmmSysMode_setCoreRun API.
  62:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *   IfxSmmSysMode_setCoreRun(IfxCpu_ResourceCpu_1);
  63:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *
  64:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *   //Exit from idle mode can also happen via interrupt request etc
  65:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * }
