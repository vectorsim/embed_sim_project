 819:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h **** 
 820:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h **** /**
 821:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****  * \brief set frequency spread threshold.
 822:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****  *
 823:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****  * \param[inout] pms 		   Pointer to PMS module.
 824:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****  * \param[in]	 freqSprdValue Maximum frequency spreading value.
 825:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****  *							   Range: 0x0 no frequency spreading activated
 826:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****  * 							           0x1 SDSWPRDNOM - (SDSWPRDNOM+2) switching period spread
 827:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****  * 							           0x2 (SDSWPRDNOM-2) - (SDSWPRDNOM+2) switching period spread
 828:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****  * 							           0x3 (SDSWPRDNOM-2) - (SDSWPRDNOM+4) switching period spread
 829:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****  * 							           0x4 (SDSWPRDNOM-4) - (SDSWPRDNOM+4) switching period spread
 830:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****  * 							           0x5 (SDSWPRDNOM-4) - (SDSWPRDNOM+6) switching period spread
 831:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****  * 							           0x6 (SDSWPRDNOM-6) - (SDSWPRDNOM+6) switching period spread
 832:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****  * 							           0x7 (SDSWPRDNOM-6) - (SDSWPRDNOM+8) switching period spread
 833:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****  * 							           0x8 (SDSWPRDNOM-8) - (SDSWPRDNOM+8) switching period spread
 834:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****  * 							           0x9 (SDSWPRDNOM-8) - (SDSWPRDNOM+10) switching period spread
 835:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****  *
 836:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****  * \retval None
 837:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****  *
 838:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****  * Coding example:
 839:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****  * \code
 840:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****  *   IfxPmsEvr_setFrequencySpread(&MODULE_PMS, usr_value);
 841:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****  * \endcode
 842:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****  *
 843:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****  */
 844:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h **** IFX_INLINE void IfxPmsEvr_setFrequencySpread(Ifx_PMS *pms, uint8 freqSprdValue);
 845:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h **** 
 846:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h **** /**
 847:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****  * \brief Sets the switching frequency during closed-loop PWM phase.
 848:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****  *
