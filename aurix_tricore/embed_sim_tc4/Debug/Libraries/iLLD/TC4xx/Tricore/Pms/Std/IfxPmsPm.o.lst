1066:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     cpu_pmaVal = __mfcr(CPU_PMA1);                                                              /* 
1067:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1068:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     cpu_pmaVal = enable ? (cpu_pmaVal | segmentNumberMask) : (cpu_pmaVal & ~segmentNumberMask); /* 
1069:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1070:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     /*The CPU_PMA registers are ENDINIT protected*/
1071:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     //IfxScuWdt_clearCpuEndinitInline(&MODULE_SCU.WDTCPU[coreIndex], wdtPassword);
1072:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     /*When changing the value of the CPU_PMAx registers both the instruction and data caches should
1073:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     /*Write to PMA1 register for selecting the cacheability for data cache*/
1074:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     __dsync();      /* DSYNC instruction should be executed immediately prior to the MTCR */
1075:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     __mtcr(CPU_PMA1, cpu_pmaVal);
1076:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     __isync();      /* ISYNC instruction executed immediately following MTCR */
