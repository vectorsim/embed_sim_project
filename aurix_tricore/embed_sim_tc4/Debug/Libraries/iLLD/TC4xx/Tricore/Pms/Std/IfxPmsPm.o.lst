  61:../Libraries/iLLD/TC4xx/Tricore/Smu/Std/IfxSmuStdby.h ****  * 1B SMU_stdby alarm status bits in AGi can be cleared
  62:../Libraries/iLLD/TC4xx/Tricore/Smu/Std/IfxSmuStdby.h ****  */
