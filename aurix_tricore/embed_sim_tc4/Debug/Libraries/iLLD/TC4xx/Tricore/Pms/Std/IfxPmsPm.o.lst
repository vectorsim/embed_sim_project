 226:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h **** 
 227:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h **** /** \brief Api to configure the bit-fields "CPUIDLSEL" and "CPUSEL" of register SMM_PMSWCR1. Used f
 228:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * \param powerMode Mode configuration
 229:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * \param reqMode CPUIDLSEL[CPU selection for Idle mode]:
 230:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * Note: All other CPUIDLSEL bit combinations are reserved.
 231:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * 000B Entry to the respective Idle mode is decided by each individual
 232:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * CPU.
 233:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * 001B CPU0 Idle request will send all CPUs in Idle.
 234:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * 010B CPU1 Idle request will send all CPUs in Idle.
 235:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * 011B CPU2 Idle request will send all CPUs in Idle.
 236:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * 100B CPU3 Idle request will send all CPUs in Idle.
 237:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * 101B CPU4 Idle request will send all CPUs in Idle.
 238:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * 110B CPU5 Idle request will send all CPUs in Idle.
 239:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *
 240:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * CPUSEL[CPU selection for Sleep and Standby mode]:
 241:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * Note: All other CPUSEL bit combinations are reserved.
 242:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * 001B Only CPU0 can trigger power down modes.
 243:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * 010B Only CPU1 can trigger power down modes.
 244:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * 011B Only CPU2 can trigger power down modes.
 245:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * 100B Only CPU3 can trigger power down modes.
 246:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * 101B Only CPU4 can trigger power down modes.
 247:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * 110B Only CPU5 can trigger power down modes.
 248:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * 111B Entry to power down modes is unanimously decided by all the
 249:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * CPUs.
 250:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * \return None
 251:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  */
 252:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h **** IFX_INLINE void IfxSmmSysMode_sysModeConfig(const IfxSmmSysMode_RqPwMd powerMode, const uint8 reqMo
 253:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h **** 
