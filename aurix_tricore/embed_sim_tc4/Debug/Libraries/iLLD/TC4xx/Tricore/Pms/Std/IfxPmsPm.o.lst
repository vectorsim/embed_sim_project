 326:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsPm.c ****     else if ((standbyConfig->scrCfg.enableScr == TRUE) && (pms->SCR.CON0.B.SCREN == 1u)) /* Configu
 327:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsPm.c ****     {
 328:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsPm.c ****         /* Standby clock source selection */
 329:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsPm.c ****         scrCon0.B.SCRCLKSEL  = standbyConfig->scrCfg.scrClockSupply;
 330:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsPm.c ****         scrCon0.B.PORSTREQ_P = 1;
 331:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsPm.c ****         scrCon0.B.PORSTREQ   = 0;  //To avoid SCR reset during standby entry.
 332:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsPm.c ****     }
 333:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsPm.c ****     else /* Disable SCR */
