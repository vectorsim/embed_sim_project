 858:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****  *   IfxPmsEvr_setRegulatorSwitchingFrequency(&MODULE_PMS, usr_value);
 859:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****  * \endcode
 860:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****  *
 861:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****  */
 862:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h **** IFX_INLINE void IfxPmsEvr_setRegulatorSwitchingFrequency(Ifx_PMS *pms, uint16 samplingFactor);
 863:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h **** 
 864:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h **** /**
