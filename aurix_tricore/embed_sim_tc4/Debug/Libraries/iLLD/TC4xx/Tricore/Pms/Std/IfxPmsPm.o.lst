 300:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsPm.c ****         stdbyCon0.B.SCRSTBY0EN    = standbyConfig->scrCfg.scrTriggerTransition;
 301:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsPm.c ****         /* Enable/Disable Vddextdc power down during standby mode */
 302:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsPm.c ****         stdbyCon0.B.VDDEXTDCPWRDN = standbyConfig->standbyCfg.enableVddextdcPowerDown;
 303:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsPm.c ****         /* Enable/Disable Esr2 digital filter usage for standby entry */
 304:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsPm.c ****         stdbyCon0.B.ESR2DFEN      = standbyConfig->standbyCfg.esr2DigitalFilterUsage;
