  50:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *   //IDLE mode is selected by each individual CPU
  51:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *   IfxSmmSysMode_sysModeConfig(IfxSmmSysMode_RqPwMd_idle, 0x00); //Entry to the respective Idle m
