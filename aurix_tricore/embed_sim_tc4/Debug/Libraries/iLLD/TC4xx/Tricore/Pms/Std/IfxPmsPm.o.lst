 645:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 646:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief API to acquire the mutex (binary semaphore).
 647:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 648:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * This API can be used to acquire/get the mutex.
 649:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 650:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in] lock Lock pointer.
 651:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 652:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \retval TRUE : lock acquired successfully. FALSE: Failed to acquire the lock.
 653:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 654:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \code
 655:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *    IfxCpu_mutexLock resourceLock;
 656:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *    boolean flag = IfxCpu_acquireMutex(&resourceLock);
 657:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *    if (flag){
 658:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *      // critical section
 659:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *      IfxCpu_releaseMutex(&resourceLock);
 660:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *    }
 661:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \endcode
 662:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 663:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  */
 664:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_EXTERN boolean IfxCpu_acquireMutex(IfxCpu_mutexLock *lock);
 665:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 666:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief API to unlock the mutex.
 667:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 668:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * This API can be used to unlock the previously acquired mutex.
 669:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 670:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[inout] lock Lock pointer.
 671:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 672:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \retval None
 673:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 674:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \code
 675:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *    IfxCpu_mutexLock resourceLock;
 676:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *    boolean flag = IfxCpu_acquireMutex(&resourceLock);
 677:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *    if (flag){
 678:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *      // critical section
 679:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *      IfxCpu_releaseMutex(&resourceLock);
 680:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *    }
 681:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \endcode
 682:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 683:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  */
 684:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_EXTERN void IfxCpu_releaseMutex(IfxCpu_mutexLock *lock);
 685:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 686:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief API to unlock the resource.
 687:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 688:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * This API can be used to unlock the previously acquired lock.
 689:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 690:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[inout] lock Lock pointer.
 691:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 692:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \retval None
 693:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  */
 694:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_EXTERN void IfxCpu_resetSpinLock(IfxCpu_spinLock *lock);
 695:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 696:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief Attempt to acquire a spinlock with a specified timeout.
 697:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 698:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * This API can be used to spin lock for the lock for the given timeout period.
 699:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 700:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in] lock         Pointer to the spinlock object to be acquired.
 701:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in] timeoutCount Maximum number of retry attempts before timing out. Range: 0 to 0xFFFFFF
 702:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 703:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \retval TRUE : Lock acquired successfully. FALSE: Failed to acquire the lock.
 704:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 705:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \code
 706:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *    IfxCpu_spinLock resourceLock;
 707:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *    boolean flag = IfxCpu_setSpinLock(&resourceLock, 0xFFFF);
 708:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *    if (flag){
 709:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *      // critical section
 710:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *      IfxCpu_resetSpinLock(&resourceLock);
 711:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *    }
 712:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \endcode
 713:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 714:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  */
 715:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_EXTERN boolean IfxCpu_setSpinLock(IfxCpu_spinLock *lock, uint32 timeoutCount);
 716:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 717:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \} */
 718:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 719:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \addtogroup IfxLld_Cpu_Std_Utility
 720:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \{ */
 721:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 722:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /******************************************************************************/
 723:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /*-------------------------Global Function Prototypes-------------------------*/
 724:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /******************************************************************************/
 725:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 726:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /* CPU Overlay is not supported for all TC4XX derivatives.*/
 727:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** #if defined(CPU_OVERLAY_SUPPORTED) 
 728:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief Disables a specific overlay block on the given CPU resource.
 729:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 730:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in] cpu          Core no of the CPU. Range: 0 to max number of CPU's supported for the va
 731:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in] overlayBlock The identifier of the overlay block to be disabled. Range: 0 to 31.
 732:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 733:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \retval uint32 Range: Enable successful, 0xdeadbeef: Enable un-successful.
 734:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  */
 735:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_EXTERN uint32 IfxCpu_disableOverlayBlock(uint32 cpu, uint32 ovcBlock);
 736:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 737:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief This function configures and enables the overlay memory.
 738:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * Note:
 739:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * The data overlay provides the capability to redirect selected data accesses to the Overlay memor
 740:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 741:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * How the overlay Memory works?
 742:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * Any data access to segment 8 or segment A is checked against all the activated overlay blocks. F
 743:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * The address for redirection is constructed as follows:
 744:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * 1. Address bits 31..22 are set according to the overlay memory selection and the cache-ability o
 745:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * 2. For address bits 21..5:
 746:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * - If the corresponding address mask bit is set, the address bit value is taken from overlay base
 747:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * - If the corresponding address mask bit is cleared, the address bit value is taken from the orig
 748:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * 3. Address bits 4..0 are always taken directly from the original address.
 749:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * If there is no redirection, the original address is used to perform the access.
 750:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * Target address ranges for activated overlay blocks should not overlap or an exception may occur.
 751:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 752:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in] cpu                 Core no of the CPU. Range: 0 to max number of CPU's supported for
 753:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in] overlayBlock        Overlay Block. Range: 0 to 31.
 754:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in] overlayMemorySelect Overlay Memory Select. Range. 0 to 0xFFFFFFFF.
 755:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in] overlayAddressMask  Overlay Address Mask. Range: \ref IfxCpu_OverlayAddressMask.
 756:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in] targetBaseAddress   Target Base address (i.e Source address to be re-directed). Range
