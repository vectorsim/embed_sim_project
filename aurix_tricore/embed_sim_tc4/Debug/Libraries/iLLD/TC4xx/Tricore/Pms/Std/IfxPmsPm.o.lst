1055:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     //uint16 wdtPassword = IfxScuWdt_getCpuWatchdogPasswordInline(&MODULE_SCU.WDTCPU[coreIndex]);
1056:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1057:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     /*resolve the restrictions*/
1058:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     /*In PMA1 Segment-D and Segment[7-CoreID] must have the same value */
1059:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     checkRestrictionMask = ((uint16)1 << (7 - coreIndex)) | ((uint16)1 << 0xD);
