  89:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  */
  90:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** #define IFXCPU_GLB_ADDR_DSPR(cpu, address) ((((((unsigned)(address) & 0xF0000000) == 0xD0000000) ? 
  91:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
  92:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief Convert local PSPR address to global PSPR address which can be accessed from the SRI bus
  93:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * Use this macro to convert a local PSPR address (in segment 0xc......) to
  94:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * a global PSPR address (in segment 0x701....., 0x601....., 0x501..... downwards) depending on
  95:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * the CPU number.
  96:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
  97:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *   Example usage:
  98:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *   \code
  99:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *     dmaChConfig.sourceAddress      = IFXCPU_GLB_ADDR_PSPR(IfxCpu_getCoreId(), &sourceBufferInPsp
