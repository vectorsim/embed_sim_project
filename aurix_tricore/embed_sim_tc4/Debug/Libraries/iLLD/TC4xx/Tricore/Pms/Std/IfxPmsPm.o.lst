 210:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsPm.c ****         IFXPMS_DISABLE_FLASH;
 211:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsPm.c **** 
 212:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsPm.c ****         uint32 datacache    = (uint32)__mfcr(CPU_PMA0);
 213:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsPm.c ****         uint8 *cpucacheptr  = NULL_PTR;
 214:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsPm.c ****         uint8  cachesegment = 0;
 215:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsPm.c ****         uint16 index;
