 311:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsPm.c ****         padCon.B.SBTRIST    = standbyConfig->padCfg.standbyPads;
 312:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsPm.c ****         padCon.B.ESR0PD     = standbyConfig->padCfg.esr0PinStateRequest;
 313:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsPm.c ****     }
 314:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsPm.c **** 
 315:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsPm.c ****     /* SCR Configuration. Enable and configure SCR if not enabled */
 316:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsPm.c ****     if ((standbyConfig->scrCfg.enableScr == TRUE) && (pms->SCR.CON0.B.SCREN != 1u))
 317:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsPm.c ****     {
