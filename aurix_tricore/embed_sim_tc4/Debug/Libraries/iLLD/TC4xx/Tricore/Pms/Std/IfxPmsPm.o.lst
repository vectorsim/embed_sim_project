 238:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsPm.c ****             cachesegment = IFXPMS_CPU3_DCACHE_SEGMENT;
 239:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsPm.c ****             break;
 240:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsPm.c **** #endif
 241:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsPm.c **** #if IFXCPU_NUM_MODULES > 5
