 178:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** /*--------------------------------Enumerations--------------------------------*/
 179:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** /******************************************************************************/
 180:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 181:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** /** \addtogroup IfxLld_Stm_Std_Enumerations
 182:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * \{ */
 183:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** /** \brief Comparator Id defined in MODULE_CPUx.ISCR.B.CMP0IRR(x = 0, 1, 2), MODULE_CPUx.ICR.B.CMP0
 184:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  */
 185:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** typedef enum
 186:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** {
 187:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     IfxStm_Comparator_0 = 0,      /**< \brief Comparator Id 0  */
 188:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     IfxStm_Comparator_1           /**< \brief Comparator Id 1  */
 189:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** } IfxStm_Comparator;
 190:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 191:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** /** \brief Compare with relative or Absolute Timer
 192:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  */
 193:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** typedef enum
 194:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** {
 195:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     IfxStm_ComparatorComparison_absolute = 0,  /**< \brief Compare with Absolute timer */
 196:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     IfxStm_ComparatorComparison_relative = 1   /**< \brief Compare with relative timer */
 197:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** } IfxStm_ComparatorComparison;
 198:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 199:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** /** \brief Comparator Interrupt request source defined in MODULE_SRC.STM.STMCPU[index].SRx (x =0, 1
 200:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  */
 201:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** typedef enum
 202:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** {
 203:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     IfxStm_ComparatorInterrupt_ir0 = 0,  /**< \brief Select STMIR0 */
 204:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     IfxStm_ComparatorInterrupt_ir1 = 1   /**< \brief Select STMIR1 */
 205:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** } IfxStm_ComparatorInterrupt;
 206:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 207:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** /** \brief Comparator start bit position defined in MODULE_CPUx.CMCON.B.MSTART0(x = 0,1,2)
 208:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  */
 209:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** typedef enum
