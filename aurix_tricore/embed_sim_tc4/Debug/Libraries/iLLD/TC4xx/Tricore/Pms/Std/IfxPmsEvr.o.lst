1872:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h **** IFX_INLINE void IfxPmsEvr_disableInterrupt(Ifx_PMS *pms, IfxPmsEvr_Interrupt interruptType)
1873:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h **** {
1874:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****     uint32 mask;
1875:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h **** #if (IFX_PROT_ENABLED == 1U)
1876:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****     IfxApProt_setState((Ifx_PROT_PROT *)&(pms->PROTE), IfxApProt_State_config);
1877:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h **** #endif
1878:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h **** 
1879:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****     if (interruptType < 32)
1880:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****     {
1881:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****         mask             = (1U << interruptType);
1882:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****         pms->INT.CON0.U &= (~mask);
1883:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****     }
1884:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****     else if (interruptType < 64)
1885:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****     {
1886:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****         mask             = (1U << (interruptType - 32));
1887:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****         pms->INT.CON1.U &= (~mask);
1888:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****     }
1889:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****     else
1890:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****     {
1891:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****         mask             = (1U << (interruptType - 64));
1892:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****         pms->INT.CON2.U &= (~mask);
1893:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****     }
1894:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h **** 
1895:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h **** #if (IFX_PROT_ENABLED == 1U)
1896:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****     IfxApProt_setState((Ifx_PROT_PROT *)&(pms->PROTE), IfxApProt_State_run);
1897:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h **** #endif
1898:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h **** }
