1907:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****     switch (sync)
1908:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****     {
1909:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****     case IfxPmsEvr_DcdcSynchronization_input:
