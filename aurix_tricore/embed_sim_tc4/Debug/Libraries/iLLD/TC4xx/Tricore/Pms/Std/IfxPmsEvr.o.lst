1914:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****         break;
1915:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****     default:
1916:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****         /* Invalid sync selected */
1917:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****         break;
1918:../Libraries/iLLD/TC4xx/Tricore/Pms/Std/IfxPmsEvr.h ****     }
