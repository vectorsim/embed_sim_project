 594:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_INLINE void IfxCpu_setPerformanceCountersEnableBit(uint32 enable);
 595:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
