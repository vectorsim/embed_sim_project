1453:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu_IntrinsicsGcc.h **** /** Insert DEBUG instruction
1454:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu_IntrinsicsGcc.h ****  */
