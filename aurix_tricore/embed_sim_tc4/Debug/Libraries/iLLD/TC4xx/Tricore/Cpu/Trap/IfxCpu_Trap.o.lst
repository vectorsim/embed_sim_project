 101:../Libraries/iLLD/TC4xx/Tricore/Cpu/Trap/IfxCpu_Trap.c **** IFX_INLINE IfxCpu_Trap IfxCpu_Trap_extractTrapInfo(uint8 trapClass, uint32 tin)
 102:../Libraries/iLLD/TC4xx/Tricore/Cpu/Trap/IfxCpu_Trap.c **** {
 103:../Libraries/iLLD/TC4xx/Tricore/Cpu/Trap/IfxCpu_Trap.c **** 	/* Extracts trap information for a given trap class and ID */
 104:../Libraries/iLLD/TC4xx/Tricore/Cpu/Trap/IfxCpu_Trap.c **** 
 105:../Libraries/iLLD/TC4xx/Tricore/Cpu/Trap/IfxCpu_Trap.c ****     IfxCpu_Trap trapInfo;
 106:../Libraries/iLLD/TC4xx/Tricore/Cpu/Trap/IfxCpu_Trap.c ****     trapInfo.tAddr  = (unsigned int)__getA11();
 107:../Libraries/iLLD/TC4xx/Tricore/Cpu/Trap/IfxCpu_Trap.c ****     trapInfo.tClass = trapClass;
 108:../Libraries/iLLD/TC4xx/Tricore/Cpu/Trap/IfxCpu_Trap.c ****     trapInfo.tId    = tin;
 109:../Libraries/iLLD/TC4xx/Tricore/Cpu/Trap/IfxCpu_Trap.c ****     trapInfo.tCpu   = IfxCpu_getCoreId();
 110:../Libraries/iLLD/TC4xx/Tricore/Cpu/Trap/IfxCpu_Trap.c ****     return trapInfo;
 111:../Libraries/iLLD/TC4xx/Tricore/Cpu/Trap/IfxCpu_Trap.c **** }
