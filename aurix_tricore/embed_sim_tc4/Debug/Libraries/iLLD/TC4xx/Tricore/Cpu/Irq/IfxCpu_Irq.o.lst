  90:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c **** /** \brief API to install the interrupt service routine for Software Managed Interrupts.
  91:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****  *
  92:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****  */
  93:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c **** void IfxCpu_Irq_installInterruptHandler(void *isrFuncPointer, uint32 serviceReqPrioNumber)
  94:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c **** {
  95:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****     switch (IfxCpu_Irq_getTos(IfxCpu_getCoreIndex()))
  96:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****     {
  97:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****     case IfxSrc_Tos_cpu0:
  98:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****         IfxCpu_Irq_swIntVector0[serviceReqPrioNumber] = (Ifx_Isr)isrFuncPointer;
  99:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****         break;
 100:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c **** #if IFXCPU_NUM_SAFE_MODULES >= 2
 101:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****     case IfxSrc_Tos_cpu1:
 102:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****         IfxCpu_Irq_swIntVector1[serviceReqPrioNumber] = (Ifx_Isr)isrFuncPointer;
 103:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****         break;
 104:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c **** #endif
 105:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c **** #if IFXCPU_NUM_SAFE_MODULES >= 3
 106:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****     case IfxSrc_Tos_cpu2:
 107:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****         IfxCpu_Irq_swIntVector2[serviceReqPrioNumber] = (Ifx_Isr)isrFuncPointer;
 108:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****         break;
 109:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c **** #endif
 110:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c **** #if IFXCPU_NUM_SAFE_MODULES >= 4
 111:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****     case IfxSrc_Tos_cpu3:
 112:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****         IfxCpu_Irq_swIntVector3[serviceReqPrioNumber] = (Ifx_Isr)isrFuncPointer;
 113:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****         break;
 114:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c **** #endif
 115:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c **** #if IFXCPU_NUM_SAFE_MODULES >= 5
 116:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****     case IfxSrc_Tos_cpu4:
 117:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****         IfxCpu_Irq_swIntVector4[serviceReqPrioNumber] = (Ifx_Isr)isrFuncPointer;
 118:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****         break;
 119:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c **** #endif
 120:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c **** #if IFXCPU_NUM_SAFE_MODULES >= 6
 121:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****     case IfxSrc_Tos_cpu5:
 122:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****         IfxCpu_Irq_swIntVector5[serviceReqPrioNumber] = (Ifx_Isr)isrFuncPointer;
 123:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****         break;
 124:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c **** #endif
 125:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****     case IfxSrc_Tos_dma0:
 126:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****         break;
 127:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c **** #if IFXDMA_NUM_MODULES == 2
 128:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****     case IfxSrc_Tos_dma1:
 129:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****         break;
 130:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c **** #endif
 131:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****     default:
 132:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****         break;
 133:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****     }
 134:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c **** }
 135:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c **** 
 136:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c **** 
 137:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c **** /** SW managed Interrupt vector tables
 138:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****  *
 139:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****  * These are vector tables with single entry for Software Managed Interrupts defined for each core.
 140:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****  * This function need to be located at boundary 0xXFE0 where (X=1,3,5 and so on). For the software 
 141:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****  * interrupts to work correctly, the BIV must be set to address of this function.
 142:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****  *
 143:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****  */
 144:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c **** IFX_INTERRUPT_INTERNAL(IfxCpu_Irq_intVecTable0, 0, 255)
 145:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c **** {
 146:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****     Ifx_CPU_ICR icr;
 147:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c **** 
 148:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****     icr.U = __mfcr(CPU_ICR);    /*Fetch the ICR value */
 149:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c **** 
 150:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****     /*Call the ISR */
 151:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****     if (IfxCpu_Irq_swIntVector0[icr.B.CCPN])
 152:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****     {
 153:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****         IfxCpu_Irq_swIntVector0[icr.B.CCPN]();
 154:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****     }
 155:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****     else
 156:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****     {
 157:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****         IFX_CFG_CPU_IRQ_DEBUG;
 158:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****     }
 159:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c **** }
 160:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c **** 
 161:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c **** #if IFXCPU_NUM_SAFE_MODULES >= 2
 162:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c **** IFX_INTERRUPT_INTERNAL(IfxCpu_Irq_intVecTable1, 1, 255)
 163:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c **** {
 164:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****     Ifx_CPU_ICR icr;
 165:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c **** 
 166:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****     icr.U = __mfcr(CPU_ICR);    /*Fetch the ICR value */
 167:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c **** 
 168:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****     /*Call the ISR */
 169:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****     if (IfxCpu_Irq_swIntVector1[icr.B.CCPN])
 170:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****     {
 171:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****         IfxCpu_Irq_swIntVector1[icr.B.CCPN]();
 172:../Libraries/iLLD/TC4xx/Tricore/Cpu/Irq/IfxCpu_Irq.c ****     }
