 217:../Libraries/iLLD/TC4xx/Tricore/Smu/Std/IfxSmu.c **** 
 218:../Libraries/iLLD/TC4xx/Tricore/Smu/Std/IfxSmu.c ****     /* Port Emergency Stop: enables control of the Port Emergency Stop (PES) feature
 219:../Libraries/iLLD/TC4xx/Tricore/Smu/Std/IfxSmu.c ****      * independently for each internal action. When an action is triggered and if the
 220:../Libraries/iLLD/TC4xx/Tricore/Smu/Std/IfxSmu.c ****      * corresponding bit (as defined below) is set, the hardware triggers
 221:../Libraries/iLLD/TC4xx/Tricore/Smu/Std/IfxSmu.c ****      * automatically a port emergency stop request. Each bit of PES is allocated to
 222:../Libraries/iLLD/TC4xx/Tricore/Smu/Std/IfxSmu.c ****      * an action as follows:
 223:../Libraries/iLLD/TC4xx/Tricore/Smu/Std/IfxSmu.c ****      * 1H SMU_IGCS0 activates PES
 224:../Libraries/iLLD/TC4xx/Tricore/Smu/Std/IfxSmu.c ****      * 2H SMU_IGCS1 activates PES
 225:../Libraries/iLLD/TC4xx/Tricore/Smu/Std/IfxSmu.c ****      * 4H SMU_IGCS2 activates PES
 226:../Libraries/iLLD/TC4xx/Tricore/Smu/Std/IfxSmu.c ****      * 8H SMU_NMI activates PES
 227:../Libraries/iLLD/TC4xx/Tricore/Smu/Std/IfxSmu.c ****      * 10H SMU_CPU_RESET activates PES */
 228:../Libraries/iLLD/TC4xx/Tricore/Smu/Std/IfxSmu.c **** 
 229:../Libraries/iLLD/TC4xx/Tricore/Smu/Std/IfxSmu.c ****     MODULE_SMU.SAFE[smuSafeIndex].PES.U = pesAction;
