  47:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** 
  48:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** IfxSdmmc_Status IfxSdmmc_Emmc_initCard(IfxSdmmc_Emmc *emmc, IfxSdmmc_Emmc_CardConfig *cardConfig)
  49:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** {
  50:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****     IfxSdmmc_Status   status = IfxSdmmc_Status_success;
  51:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****     IfxSdmmc_Response response;
  52:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** 
  53:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****     /* set up the SD card interface, power up the card */
  54:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****     /* power on bus */
  55:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****     IfxSdmmc_setBusPowerOn(emmc->sdmmcSFR);
  56:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** 
  57:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****     /* Enable the SD clock */
  58:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****     IfxSdmmc_enableCardClock(emmc->sdmmcSFR);
  59:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** 
  60:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****     /* according to SD Card spec we've to wait for 74 cycles with CMD and DAT high */
  61:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****     {
  62:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****         uint32 loopCount = (IFXSDMMC_DELAY_74CYCLE_US * 1000) / IFXSDMMC_1KLOOPDELAY_US;
  63:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****         uint32 index;
  64:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** 
  65:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****         for (index = 0; index < loopCount; ++index)
  66:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****         {
  67:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****             //do nothing
  68:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****             __nop();
  69:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****         }
  70:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****     }
  71:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** 
  72:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****     /* Initilaise and identify the eMMC card */
  73:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** 
  74:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****     /* Reset the card (CMD0) */
  75:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****     status = IfxSdmmc_sendCommand(emmc->sdmmcSFR, IfxSdmmc_Command_goIdleState, IFXSDMMC_ARG_NONE, 
  76:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** 
  77:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****     if (status == IfxSdmmc_Status_success)  // Blessen
  78:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****     {
  79:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****         /* validate Access Mode (MMC_CMD1) */
  80:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****         status = IfxSdmmc_Emmc_validateAccessMode(emmc);
  81:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****     }
  82:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** 
  83:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****     if (status == IfxSdmmc_Status_success)
  84:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****     {
  85:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****         /* Read CID, CMD2 */
  86:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****         status = IfxSdmmc_Emmc_readCid(emmc);
  87:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** 
  88:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****         if (status == IfxSdmmc_Status_success)
  89:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****         {
  90:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****             /* Set RCA, CMD3 */
  91:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****             status = IfxSdmmc_Emmc_setRca(emmc, 0x2);
  92:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** 
  93:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****             if (status == IfxSdmmc_Status_success)
  94:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****             {
  95:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****                 /* Read CSD, CMD9 */
  96:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****                 status = IfxSdmmc_Emmc_readCsd(emmc);
  97:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****             }
  98:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****         }
  99:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****     }
 100:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** 
 101:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****     /* switch speed and bus width */
 102:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****     if (status == IfxSdmmc_Status_success)
 103:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****     {
 104:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****         /* Switch to transfer state (CMD7) */
 105:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****         status = IfxSdmmc_Emmc_switchToTransferState(emmc);
 106:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** 
 107:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****         if (status == IfxSdmmc_Status_success)
 108:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****         {
 109:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****             /* switch Bus Width if selected */
 110:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****             if (cardConfig->dataWidth > IfxSdmmc_EmmcDataTransferWidth_1Bit)
 111:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****             {
 112:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****                 status = IfxSdmmc_Emmc_switchBusWidth(emmc, cardConfig->dataWidth);
 113:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****             }
 114:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** 
 115:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****             /* Switch Speed if selected */
 116:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****             if (cardConfig->speedMode == IfxSdmmc_EmmcSpeedMode_highSpeedSdr)
 117:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****             {
 118:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****                 status = IfxSdmmc_Emmc_switchToHighSpeed(emmc);
 119:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** 
 120:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****                 if (status == IfxSdmmc_Status_success)
 121:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****                 {
 122:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****                     uint32 timeCount = (IFXSDMMC_MMC_DELAY_HIGHSPEED_SHIFT_US * 1000) / IFXSDMMC_1K
 123:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** 
 124:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****                     while ((IfxSdmmc_isDataLineBusy(emmc->sdmmcSFR) ||
 125:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****                             IfxSdmmc_isCommandLineBusy(emmc->sdmmcSFR))
 126:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****                            && timeCount > 0)
 127:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****                     {
 128:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****                         timeCount--;
 129:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****                     }
 130:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** 
 131:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****                     if (timeCount == 0)
 132:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****                     {
 133:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****                         status = IfxSdmmc_Status_failure;
 134:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****                     }
 135:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****                 }
 136:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** 
 137:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****                 if (status == IfxSdmmc_Status_success)
 138:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****                 {
 139:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****                     /* Configure clock paramenters to 50 Mhz*/
 140:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****                     IfxSdmmc_configureClock(emmc->sdmmcSFR, 50000000);
 141:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****                 }
 142:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****             }
 143:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****             else
 144:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****             {
 145:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****                 /* Configure clock paramenters to 26 Mhz*/
 146:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****                 IfxSdmmc_configureClock(emmc->sdmmcSFR, emmc->userFrequency);
 147:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****             }
 148:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****         }
 149:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****     }
 150:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** 
 151:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****     if (status == IfxSdmmc_Status_success)
 152:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****     {
 153:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****         /* Explicitly set block size as 512 */
 154:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****         status = IfxSdmmc_sendCommand(emmc->sdmmcSFR, IfxSdmmc_Command_setBlockLength, 512, IfxSdmm
 155:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****     }
 156:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** 
 157:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****     return status;
 158:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** }
 159:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** 
 160:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** 
 161:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** IfxSdmmc_Status IfxSdmmc_Emmc_initHostController(IfxSdmmc_Emmc *emmc, IfxSdmmc_Emmc_HostConfig *hos
 162:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** {
  13              	 .loc 1 162 1
  14              	.LVL0:
  15 0000 40AE     	 mov.aa %a14,%SP
  16              	.LCFI0:
  17 0002 404C     	 mov.aa %a12,%a4
  18 0004 405D     	 mov.aa %a13,%a5
 163:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c ****     IfxSdmmc_Status status = IfxSdmmc_Status_success;
  19              	 .loc 1 163 5
  20              	.LVL1:
 164:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** 
