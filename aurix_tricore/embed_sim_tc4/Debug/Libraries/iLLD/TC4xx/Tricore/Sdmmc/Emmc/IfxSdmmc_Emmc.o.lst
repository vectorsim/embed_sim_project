 856:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_EXTERN void IfxCpu_configureAccessToCpus(IfxApApu_ApuConfig *apuConfig);
 857:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
