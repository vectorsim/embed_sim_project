  42:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** #include "IfxSdmmc_Emmc.h"
  43:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** 
  44:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** /******************************************************************************/
  45:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Emmc/IfxSdmmc_Emmc.c **** /*-------------------------Function Implementations---------------------------*/
