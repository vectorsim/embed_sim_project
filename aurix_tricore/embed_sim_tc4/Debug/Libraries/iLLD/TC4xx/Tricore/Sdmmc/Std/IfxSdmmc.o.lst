  78:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
  79:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_CMD6_SWITCH_FUNC                  (0x06)
  80:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** 
  81:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** /** \brief CMD7, Response: R1b (only from the slected card)\n
  82:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * Command toggles a card between the stand-by and transfer states or\n
  83:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * between the programming and disconnect states. In both cases, the card is selected by \n
  84:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * its own relative address and gets deselected by any other address; address 0 deselects all\n
  85:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * In the case that the RCA equals 0, then the host may do one of the following:\n
  86:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * - Use other RCA number to perform card de-selection.\n
  87:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * - Re-send CMD3 to change its RCA number to other than 0 and then use CMD7 with RCA=0 for card de
  88:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
  89:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_CMD7_SELECT_DESELECT_CARD         (0x07)
  90:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** 
  91:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** /** \brief CMD8, Response: R8\n
  92:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * Sends SD Memory Card interface condition, which includes host supply voltage information\n
  93:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * and asks the card whether card supports voltage. Reserved bits shall be set to '0'.
  94:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
  95:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_CMD8_SEND_IF_COND                 (0x08)
  96:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** 
  97:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** /** \brief CMD9, Response: R2\n
  98:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * Addressed card sends its card-specific data (CSD) on the CMD line.
  99:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
 100:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_CMD9_SEND_CSD                     (0x09)
 101:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** 
 102:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** /** \brief CMD10, Response: R2\n
 103:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * Addressed card sends its card identification (CID) on CMD the line.
 104:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
 105:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_CMD10_SEND_CID                    (0x0A)
 106:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** 
 107:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** /** \brief CMD11, Response: R1\n
 108:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * Switch to 1.8V bus signaling level.
 109:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
 110:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_CMD11_VOLTAGE_SWITCH              (0x0B)
 111:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** 
 112:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** /** \brief CMD12, Response: R1b\n
 113:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * Forces the card to stop transmission
 114:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
 115:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_CMD12_STOP_TRANSMISSION           (0x0C)
 116:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** 
 117:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** /** \brief CMD13, Response: R1\n
 118:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * Addressed card sends its status register.
 119:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
 120:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_CMD13_SEND_STATUS                 (0x0D)
 121:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** 
 122:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** /** \brief CMD15, Response: none\n
 123:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * Sends an addressed card into the Inactive State. This command is used \n
 124:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * when the host explicitly wants to deactivate a card. Reserved bits shall be set to '0'.
 125:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
 126:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_CMD15_GO_INACTIVE_STATE           (0x0F)
 127:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** 
 128:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** /** \brief CMD16, Response: R1\n
 129:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * In the case of a Standard Capacity SD Memory Card, this command sets the block length (in bytes)
 130:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * for all following block commands (read, write, lock). Default block length is fixed to 512 Bytes
 131:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * Set length is valid for memory access commands only if partial block read operation are allowed 
 132:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * In the case of SDHC and SDXC Cards, block length set by CMD16 command does not affect \n
 133:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * memory read and write commands. Always 512 Bytes fixed block length is used. \n
 134:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * This command is effective for LOCK_UNLOCK command. In both cases, if block length is set larger 
 135:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * the card sets the BLOCK_LEN_ERROR bit. In DDR50 mode, data is sampled on both edges of the clock
 136:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * Therefore, block length shall always be even.\n
 137:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
 138:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_CMD16_SET_BLOCKLEN                (0x10)
 139:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** 
 140:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** /** \brief CMD17, Response: R1\n
 141:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * In the case of a Standard Capacity SD Memory Card, this command, this command reads a block \n
 142:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * of the size selected by the SET_BLOCKLEN command. \n
 143:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * In case of SDHC and SDXC Cards, block length is fixed 512 Bytes regardless of the SET_BLOCKLEN c
 144:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
 145:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_CMD17_READ_SINGLE_BLOCK           (0x11)
 146:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** 
 147:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** /** \brief CMD18, Response: R1\n
 148:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * Continuously transfers data blocks from card to host until interrupted by a STOP_TRANSMISSION co
 149:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * Block length is specified the same as READ_SINGLE_BLOCK command.
 150:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
 151:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_CMD18_READ_MULTIPLE_BLOCK         (0x12)
 152:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** 
 153:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** /** \brief CMD19, Response: R1\n
 154:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * 64 bytes tuning pattern is sent for SDR50 and SDR104.
 155:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
 156:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_CMD19_SEND_TUNING_BLOCK           (0x13)
 157:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** 
 158:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** /** \brief CMD20, Response: R1b\n
 159:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * Speed Class control command.
 160:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
 161:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_CMD20_SPEED_CLASS_CONTROL         (0x14)
 162:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** 
 163:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** /** \brief CMD23, Response: R1\n
 164:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * Specify block count for CMD18 and CMD25.
 165:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
 166:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_CMD23_SET_BLOCK_COUNT             (0x17)
 167:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** 
 168:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** /** \brief CMD24, Response: R1\n
 169:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * In case of SDSC Card, block length is set by the SET_BLOCKLEN command\n
 170:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * In case of SDHC and SDXC Cards, block length is fixed 512 Bytes regardless of the SET_BLOCKLEN c
 171:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
 172:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_CMD24_WRITE_BLOCK                 (0x18)
 173:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** 
 174:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** /** \brief CMD25, Response: R1\n
 175:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * Continuously writes blocks of data until a STOP_TRANSMISSION follows.\n
 176:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * Block length is specified the same as WRITE_BLOCK command.
 177:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
 178:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_CMD25_WRITE_MULTIPLE_BLOCK        (0x19)
 179:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** 
 180:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** /** \brief CMD27, Response: R1\n
 181:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * Programming of the programmable bits of the CSD.
 182:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
 183:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_CMD27_PROGRAM_CSD                 (0x1B)
 184:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** 
 185:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** /** \brief CMD28, Response: R1b\n
 186:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * If the card has write protection features, this command sets the write protection bit of the add
 187:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * The properties of write protection are coded in the card specific data (WP_GRP_SIZE)\n
 188:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * SDHC and SDXC Cards do not support this command.
 189:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
 190:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_CMD28_SET_WRITE_PROT              (0x1C)
 191:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** 
 192:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** /** \brief CMD29, Response: R1b\n
 193:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * If the card provides write protection features, this command clears the write protection bit of 
 194:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * SDHC and SDXC Cards do not support this command.
 195:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
 196:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_CMD29_CLR_WRITE_PROT              (0x1D)
 197:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** 
 198:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** /** \brief CMD30, Response: R1\n
 199:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * If the card provides write protection features, this command asks the card to send the status of
 200:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * SDHC and SDXC Cards do not support this command.
 201:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
 202:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_CMD30_SEND_WRITE_PROT             (0x1E)
 203:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** 
 204:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** /** \brief CMD32, Response: R1\n
 205:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * Sets the address of the first write block to be erased.
 206:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
 207:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_CMD32_ERASE_WR_BLK_START          (0x20)
 208:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** 
 209:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** /** \brief CMD33, Response: R1\n
 210:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * Sets the address of the last write block of the continuous range to be erased.
 211:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
 212:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_CMD33_ERASE_WR_BLK_END            (0x21)
 213:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** 
 214:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** /** \brief CMD38, Response: R1b\n
 215:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * Erases all previously selected write blocks.
 216:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
 217:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_CMD38_ERASE                       (0x26)
 218:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** 
 219:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** /** \brief CMD42, Response: R1\n
 220:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * Used to set/reset the password or lock/unlock the card. The size of the data block is set by the
 221:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * Reserved bits in the argument and in Lock Card Data Structure shall be set to 0.
 222:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
 223:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_CMD42_LOCK_UNLOCK                 (0x2A)
 224:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** 
 225:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** /** \brief CMD55, Response: R1\n
 226:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * Indicates to the card that the next command is an application specific command rather than a sta
 227:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
 228:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_CMD55_APP_CMD                     (0x37)
 229:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** 
 230:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** /** \brief CMD56, Response: R1\n
 231:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * Used either to transfer a data block to the card or to get a data block from the card for genera
 232:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * In case of a SDSC Card, block length is set by the SET_BLOCK_LEN command. \n
 233:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * In case of SDHC and SDXC Cards, block length is fixed to 512 bytes.\n
 234:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * The host sets RD/WR=1 for reading data from thecard and sets to 0 for writing data to the card.\
 235:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
 236:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_CMD56_GEN_CMD                     (0x38)
 237:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** 
 238:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** /** \brief ACMD6, should be followed by CMD55, Response: R1\n
 239:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * Defines the data bus width ('00'=1bit or '10'=4 bits bus) to be used for data transfer. \n
 240:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * The allowed data bus widths are given in SCR register.
 241:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
 242:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_ACMD6_SET_BUS_WIDTH               (0x06)
 243:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** 
 244:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** /** \brief ACMD13, should be followed by CMD55, Response: R1\n
 245:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * Send the SD Status.
 246:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
 247:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_ACMD13_SD_STATUS                  (0x0D)
 248:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** 
 249:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** /** \brief ACMD22, should be followed by CMD55, Response: R1\n
 250:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * Send the number of the written (without errors) write blocks. Responds with 32bit+CRC data block
 251:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * If WRITE_BL_PARTIAL='0', the unit of ACMD22 is always 512 byte.\n
 252:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  * If WRITE_BL_PARTIAL='1', the unit of ACMD22 is a block length which was used when the write comm
 253:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
 254:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_ACMD22_SEND_NUM_WR_BLOCKS         (0x16)
