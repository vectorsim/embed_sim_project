  66:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     &IfxClock_defaultModConfig,
  67:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     IfxClock_PllInputClockSelection_fOsc0,
