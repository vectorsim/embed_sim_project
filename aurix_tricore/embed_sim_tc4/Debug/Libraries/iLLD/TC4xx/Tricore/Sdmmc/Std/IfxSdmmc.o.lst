2888:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     {
2889:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****         return 0U;
2890:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     }
2891:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** }
