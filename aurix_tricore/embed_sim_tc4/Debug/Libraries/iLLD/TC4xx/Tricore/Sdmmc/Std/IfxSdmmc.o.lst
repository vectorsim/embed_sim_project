2937:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     CLOCK_RAMPCON0.B.PWR = 1U;
2938:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
