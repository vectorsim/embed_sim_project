2910:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     uint8            initError         = 0;
2911:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     uint32           timeoutCycleCount = IFXCLOCK_CCUCON_LCK_BIT_TIMEOUT_COUNT;
2912:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
