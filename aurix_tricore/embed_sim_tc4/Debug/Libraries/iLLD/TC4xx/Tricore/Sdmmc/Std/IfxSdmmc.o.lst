 161:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c **** 
 162:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c **** IfxSdmmc_Status IfxSdmmc_readResponse(Ifx_SDMMC *sdmmcSFR, IfxSdmmc_Command command, IfxSdmmc_Respo
 163:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c **** {
 164:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****     IfxSdmmc_Status status = IfxSdmmc_Status_success;
 165:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c **** 
 166:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****     /* Check for no-response type commands */
 167:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****     if ((command == IfxSdmmc_Command_goIdleState) || (command == IfxSdmmc_Command_goInactiveState))
 168:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****     {
 169:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****         status = IfxSdmmc_Status_success;
 170:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****     }
 171:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****     else
 172:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****     {
 173:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****         /* clear the structure for new response */
 174:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****         response->resp01       = 0;
 175:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****         response->resp23       = 0;
 176:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****         response->resp45       = 0;
 177:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****         response->resp67       = 0;
 178:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****         response->cardStatus.U = 0;
 179:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c **** 
 180:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****         /* read first 32 bits of the response, excluding end bit and crc7 */
 181:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****         response->resp01 = IfxSdmmc_readResponseReg01(sdmmcSFR);
 182:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c **** 
 183:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****         /* Check response type */
 184:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****         switch (responseType)
 185:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****         {
 186:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****         /* Response R1 */
 187:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****         case IfxSdmmc_ResponseType_r1:
 188:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****             response->cardStatus.U = response->resp01;
 189:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****             /* check the error bits in the response */
 190:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****             status                 = IfxSdmmc_checkErrorInResponseR1(response->cardStatus.U);
 191:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****             break;
 192:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c **** 
 193:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****         /* Response R1b */
 194:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****         case IfxSdmmc_ResponseType_r1b:
 195:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****             response->cardStatus.U = response->resp01;
 196:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****             /* check the error bits in the response */
 197:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****             status                 = IfxSdmmc_checkErrorInResponseR1(response->cardStatus.U);
 198:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c **** 
 199:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****             if (status != IfxSdmmc_Status_success)
 200:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****             {
 201:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****                 /* Wait for transfer complete interrupt */
 202:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****                 //status = IfxSdmmc_transferDelay(sd->sdmmcSFR);
 203:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****             }
 204:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c **** 
 205:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****             break;
 206:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c **** 
 207:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****         /* Response R2: response register R0-R7 */
 208:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****         case IfxSdmmc_ResponseType_r2:
 209:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****             response->resp01 = IfxSdmmc_readResponseReg01(sdmmcSFR);
 210:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****             response->resp23 = IfxSdmmc_readResponseReg23(sdmmcSFR);
 211:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****             response->resp45 = IfxSdmmc_readResponseReg45(sdmmcSFR);
 212:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****             response->resp67 = IfxSdmmc_readResponseReg67(sdmmcSFR);
 213:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****             break;
 214:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c **** 
 215:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****         /* Responses R3 and R7 */
 216:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****         case IfxSdmmc_ResponseType_r3:
 217:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****         case IfxSdmmc_ResponseType_r7:
 218:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c **** 
 219:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****             break;
 220:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c **** 
 221:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****         /* IO response: response r4,r5 : SDIO */
 222:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****         case IfxSdmmc_ResponseType_r4:
 223:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****             break;
 224:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c **** 
 225:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****         case IfxSdmmc_ResponseType_r5:
 226:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****             status = IfxSdmmc_checkerrorInReponseR5(response->resp01);
 227:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****             break;
 228:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c **** 
 229:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****         /* Response R6 */
 230:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****         case IfxSdmmc_ResponseType_r6:
 231:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****             response->cardStatus.U = response->resp01;
 232:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****             /* check the error bits in the response */
 233:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****             status                 = IfxSdmmc_checkErrorInResponseR6(response->cardStatus.U);
 234:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****             break;
 235:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c **** 
 236:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****         /* No response */
 237:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****         case IfxSdmmc_ResponseType_none:
 238:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****             status = IfxSdmmc_Status_success;
 239:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****             break;
 240:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c **** 
 241:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****         default:
 242:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****             status = IfxSdmmc_Status_success;
 243:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****             break;
 244:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****         }
 245:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****     }
 246:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c **** 
 247:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c ****     return status;
 248:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.c **** }
