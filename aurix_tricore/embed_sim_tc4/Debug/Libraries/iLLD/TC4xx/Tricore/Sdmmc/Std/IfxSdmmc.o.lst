2757:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** #if (IFX_PROT_ENABLED == 1U)
2758:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     IfxApProt_setState((Ifx_PROT_PROT *)&CLOCK_PROTE, IfxApProt_State_config);
2759:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** #endif
2760:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
2761:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     /* Intermediate step : SPBDIV = 12 and SRIDIV = 3
2762:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****      *  NOTE: This intermediate step in division ratio is done to avoid a sudden jump in clock freq
2763:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****      *  while jumping back from Low Power to Normal mode. The division ratios used in this step is 
2764:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****      *  coded into this function after proving on HW.
2765:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****      */
2766:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     Ifx_CLOCK_SYSCCUCON0 scu_ccucon0;
2767:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     scu_ccucon0.U        = CLOCK_SYSCCUCON0.U; /* read ccucon0*/
2768:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     scu_ccucon0.B.SRIDIV = 3;                  /* SRIDIV = 1:3*/
2769:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     scu_ccucon0.B.SPBDIV = 12;                 /* SPBDIV = 1:12 */
2770:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     scu_ccucon0.B.LPDIV  = 0;                  /* Exit Low Power Mode */
2771:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     scu_ccucon0.B.UP     = 1;
2772:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     CLOCK_SYSCCUCON0.U   = scu_ccucon0.U;      /* write back */
2773:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
2774:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     /* Now back to original settings for normal mode */
2775:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     /* wait for unlock status - safety watchdog ensures timeout */
2776:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     while (CLOCK_CCUSTAT.B.LCK != 0U)
2777:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     {} /*Wait till ccucon0 lock is set, No "timeout" required, ENDINIT watch-dog is active! */
2778:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
2779:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     scu_ccucon0.U      = CLOCK_SYSCCUCON0.U;   /* read ccucon0*/
2780:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     scu_ccucon0.U      = ccucon0;    /* original setting */
2781:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     scu_ccucon0.B.UP   = 1;             /* update */
2782:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     CLOCK_SYSCCUCON0.U = scu_ccucon0.U; /* write back */
2783:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
2784:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     while (CLOCK_CCUSTAT.B.LCK != 0U)
2785:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     {}
2786:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
2787:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** #if (IFX_PROT_ENABLED == 1U)
2788:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     IfxApProt_setState((Ifx_PROT_PROT *)&CLOCK_PROTE, IfxApProt_State_run);
2789:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** #endif
2790:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** }
2791:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
2792:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
2793:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** #if defined(IFX_CLOCK_DISABLE_RAMPCON)
2794:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** IFX_INLINE void IfxClock_throttleSysPllClockInline(const IfxClock_PllThrottleConfig *pllThrottleCon
2795:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** {
2796:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     uint8  pllStepsCount;
2797:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     uint32 timeoutCycleCount;
2798:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
2799:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** #if (IFX_PROT_ENABLED == 1U)
2800:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     IfxApProt_setState((Ifx_PROT_PROT *)&CLOCK_PROTE, IfxApProt_State_config);
2801:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** #endif
2802:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
2803:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     /*Start Pll ramp up sequence */
2804:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     for (pllStepsCount = 0; pllStepsCount < pllThrottleConfig->numOfSteps; pllStepsCount++)
2805:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     {                       /*iterate through number of pll steps */
2806:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****         timeoutCycleCount = IFXCLOCK_PLL_K2DIV_COUNT << 5;
2807:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
2808:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****         while ((CLOCK_CCUSTAT.B.LCK != 0U) && timeoutCycleCount--)
2809:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****         {}
2810:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
2811:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****         /*Now set the K2 divider value for the step corresponding to step count */
2812:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****         CLOCK_SYSPLLCON1.B.K2DIV = pllThrottleConfig->pllSteps[pllStepsCount];
2813:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
2814:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****         IfxClock_waitWithWdtService(IFXCLOCK_SYSPLL_K2STEP_WAITTIME);
2815:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     }
2816:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
2817:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** #if (IFX_PROT_ENABLED == 1U)
2818:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     IfxApProt_setState((Ifx_PROT_PROT *)&CLOCK_PROTE, IfxApProt_State_run);
2819:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** #endif
2820:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** }
2821:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
2822:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
2823:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** #endif
2824:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
2825:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** #if !defined(IFX_ILLD_PPU_USAGE)
2826:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** IFX_INLINE void IfxClock_waitWithWdtService(float32 timeSec)
2827:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** {
2828:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     uint32 stmCount          = (uint32)(IfxClock_getStmFrequency() * timeSec);
2829:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     uint64 stmCountBegin     = (uint64)CPU0_STM_ABS.U;
2830:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     uint16 cpuWdtPassword    = IfxWtu_getCpuWatchdogPassword();
2831:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     uint16 systemWdtPassword = IfxWtu_getSystemWatchdogPassword();
2832:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
2833:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     while ((uint64)(CPU0_STM_ABS.U - stmCountBegin) < stmCount)
2834:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     {
2835:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****         /* There is no need to check overflow of the STM timer.
2836:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****          * When counter after overflow subtracted with counter before overflow,
2837:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****          * the subtraction result will be as expected, as long as both are unsigned 32 bits
2838:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****          * eg: stmCountBegin= 0xFFFFFFFE (before overflow)
2839:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****          *     stmCountNow = 0x00000002 (before overflow)
2840:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****          *     diff= stmCountNow - stmCountBegin = 4 as expected.*/
2841:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****         IfxWtu_serviceCpuWatchdog(cpuWdtPassword);
2842:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****         IfxWtu_serviceSystemWatchdog(systemWdtPassword);
2843:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     }
2844:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** }
