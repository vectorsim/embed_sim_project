2849:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** IFX_INLINE uint32 IfxClock_getRampFrequency(void)
2850:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** {
2851:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     uint32 freq = 0U;
2852:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
2853:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     /* Check if ramp is locked at top and return or if at base return 100Mhz */
2854:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     if (CLOCK_RAMPSTAT.B.SSTAT == IfxClock_RampSeqStatus_idle)
2855:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     {
2856:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****         if (CLOCK_RAMPSTAT.B.FSTAT == IfxClock_RampFreqStatus_atTop)
2857:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****         {
2858:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****             /* Convert to Mhz and return */
2859:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****             freq = (uint32)(((uint32)CLOCK_RAMPCON0.B.UFL) * (1000000U));
2860:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****         }
2861:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****         else if (CLOCK_RAMPSTAT.B.FSTAT == IfxClock_RampFreqStatus_atBase)
2862:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****         {
2863:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****             freq = (uint32)(100000000U);
2864:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****         }
2865:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****         else
2866:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****         {
2867:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****             /* Return 0 if freq is in between the base and UFL */
2868:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****             freq = 0U;
2869:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****         }
2870:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     }
2871:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     else
2872:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     {
2873:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****         /* Return 0 if status is not idle */
2874:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****         freq = 0U;
2875:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     }
2876:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
2877:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     return freq;
2878:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** }
