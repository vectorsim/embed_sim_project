 980:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * 10B RampDown / Frequency decreasing
 981:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  */
 982:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** typedef enum
