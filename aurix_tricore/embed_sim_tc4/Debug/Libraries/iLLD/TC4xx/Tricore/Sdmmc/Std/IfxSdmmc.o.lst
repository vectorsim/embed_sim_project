1165:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** /** \brief Configuration structure type for the Per Pll config
1166:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   This structure must be used to configure the P, N, K2, K3, K4 divider dividers.
1167:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   fPLL1 = N * fIN / P * K2 * 1. 0 -> K2PREDIV = 0
1168:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   fPLL1 = N * fIN / P * K2 * 2. 0 -> K2PREDIV = 1
1169:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   fPLL1 = N * fIN / P * K2 * 1. 2 -> K2PREDIV = 2
1170:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   fPLL1 = N * fIN / P * K2 * 1. 6 -> K2PREDIV = 3
1171:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
1172:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   fPLL2 = N * fIN / P * K3 * 1. 0 -> K3PREDIV = 0
1173:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   fPLL2 = N * fIN / P * K3 * 1. 1 -> K3PREDIV = 1
1174:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   fPLL2 = N * fIN / P * K3 * 1. 2 -> K3PREDIV = 2
1175:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   fPLL2 = N * fIN / P * K3 * 1. 0 -> K3PREDIV = 3
1176:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   fPLL2 = N * fIN / P * K3 * 1. 4 -> K3PREDIV = 4
1177:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   fPLL2 = N * fIN / P * K3 * 1. 0 -> K3PREDIV = 5
1178:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   fPLL2 = N * fIN / P * K3 * 1. 6 -> K3PREDIV = 6
1179:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   fPLL2 = N * fIN / P * K3 * 1. 7 -> K3PREDIV = 7
1180:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   fPLL2 = N * fIN / P * K3 * 1. 0 -> K3PREDIV = 8
1181:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   fPLL2 = N * fIN / P * K3 * 1. 0 -> K3PREDIV = 9
1182:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   fPLL2 = N * fIN / P * K3 * 2. 0 -> K3PREDIV = 10
1183:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   fPLL2 = N * fIN / P * K3 * 1. 0 -> K3PREDIV = 11
1184:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   fPLL2 = N * fIN / P * K3 * 1. 0 -> K3PREDIV = 12
1185:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   fPLL2 = N * fIN / P * K3 * 1. 0 -> K3PREDIV = 13
1186:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   fPLL2 = N * fIN / P * K3 * 1. 0 -> K3PREDIV = 14
1187:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   fPLL2 = N * fIN / P * K3 * 1. 0 -> K3PREDIV = 15
1188:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
1189:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   fPLL3 = N * fIN / P * K4 * 1. 0 -> K4PREDIV = 0
1190:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   fPLL3 = N * fIN / P * K4 * 2. 0 -> K4PREDIV = 1
1191:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   fPLL3 = N * fIN / P * K4 * 1. 2 -> K4PREDIV = 2
1192:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   fPLL3 = N * fIN / P * K4 * 1. 6 -> K4PREDIV = 3
1193:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  */
