 746:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     Ifx_CPU_STM_CMP *cmp1 = (Ifx_CPU_STM_CMP *)((uint32)cpu + (uint32)(IFXSTM_CMP1_OFFSET));
