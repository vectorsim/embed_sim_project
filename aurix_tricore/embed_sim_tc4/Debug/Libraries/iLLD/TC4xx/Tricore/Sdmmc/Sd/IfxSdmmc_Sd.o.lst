 829:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 830:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** IFX_INLINE void IfxStm_waitTicks(Ifx_CPU *cpu, uint64 ticks)
 831:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** {
 832:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     uint64 beginTime;
 833:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 834:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     beginTime = (uint64)IfxStm_get(cpu);
 835:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 836:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     /*below code will work because of unsigned 32 bit calculation even at timer wrapping condition
 837:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****      * As an example if beginTime = 0xFFFFFFFE and current time = 2 (after overflow), unsigned calc
 838:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****      * 2 - 0xFFFFFFFE will be 4*/
 839:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     while ((IfxStm_get(cpu) - beginTime) < ticks)
 840:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     {}
 841:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** }
 842:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 843:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 844:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** IFX_INLINE sint64 IfxStm_now(void)
 845:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** {
 846:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     sint64  stmNow;
 847:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     boolean interruptState;
 848:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 849:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     interruptState = IfxCpu_disableInterrupts();
 850:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     stmNow         = (Ifx_TickTime)IfxStm_get(IFXSTM_DEFAULT_TIMER) & TIME_INFINITE;
 851:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     IfxCpu_restoreInterrupts(interruptState);
 852:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 853:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     return stmNow;
 854:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** }
 855:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 856:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 857:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** IFX_INLINE sint64 IfxStm_getDeadLine(sint64 timeout)
 858:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** {
 859:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     sint64 deadLine;
 860:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 861:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     if (timeout == TIME_INFINITE)
 862:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     {
 863:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****         deadLine = TIME_INFINITE;
 864:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     }
 865:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     else
 866:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     {
 867:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****         deadLine = IfxStm_now() + timeout;
 868:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     }
 869:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 870:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     return deadLine;
 871:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** }
 872:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 873:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 874:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** IFX_INLINE boolean IfxStm_isDeadLine(sint64 deadLine)
 875:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** {
 876:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     boolean result;
 877:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 878:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     if (deadLine == TIME_INFINITE)
 879:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     {
 880:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****         result = FALSE;
 881:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     }
 882:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     else
 883:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     {
 884:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****         result = IfxStm_now() >= deadLine;
 885:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     }
