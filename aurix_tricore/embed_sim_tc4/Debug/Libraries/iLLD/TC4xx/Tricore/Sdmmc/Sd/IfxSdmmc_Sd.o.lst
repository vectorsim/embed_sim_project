 785:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 786:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** IFX_INLINE void IfxStm_setSuspendMode(Ifx_CPU *cpu, IfxStm_SuspendMode mode)
 787:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** {
 788:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     /* TODO  : Update with PROT */
