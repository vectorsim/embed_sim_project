 799:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** IFX_INLINE void IfxStm_updateCompare(Ifx_CPU *cpu, IfxStm_Comparator comparator, uint32 ticks)
 800:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** {
