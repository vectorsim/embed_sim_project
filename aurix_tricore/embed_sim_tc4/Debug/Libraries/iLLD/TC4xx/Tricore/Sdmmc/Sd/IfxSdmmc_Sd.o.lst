 668:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** IFX_INLINE uint64 IfxStm_get(Ifx_CPU *cpu)
 669:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** {
 670:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     uint64 result;
 671:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 672:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     result = (uint64)cpu->STM.ABS.U;
 673:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 674:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     return result;
