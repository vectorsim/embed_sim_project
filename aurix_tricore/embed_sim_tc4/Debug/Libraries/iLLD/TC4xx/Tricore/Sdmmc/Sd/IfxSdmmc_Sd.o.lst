 754:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     Ifx_CPU_STM_CMP *cmp1 = (Ifx_CPU_STM_CMP *)(&cpu->STM.CMP[1]);
 755:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** #endif /* #if (IFXSTM_IS_STMHV_AVAILABLE) */
