 273:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h ****  */
 274:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Std/IfxSdmmc.h **** #define IFXSDMMC_ACMD42_SET_CLR_CARD_DETECT        (0x1A)
