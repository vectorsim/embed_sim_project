 760:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****         cmp0->B.CMPVAL = cmp0->B.CMPVAL + ticks;
 761:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     }
 762:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     else if (comparator == IfxStm_Comparator_1)
 763:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     {
