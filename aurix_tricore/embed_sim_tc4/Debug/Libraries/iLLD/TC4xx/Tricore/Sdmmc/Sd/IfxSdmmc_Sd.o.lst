 456:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         .hostConfig = {
 457:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             .timeoutValue    = IfxSdmmc_DataLineTimeout_2Power27,
 458:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             .usePresetValues = TRUE,
 459:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             .frequency       = 10000000,
 460:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             .supportedModes  = IfxSdmmc_SdModes_memOnly
 461:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         },
 462:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         .interruptConfig                     = {
 463:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             .commandCompleteInterruptEnable  = FALSE,
 464:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             .transferCompleteInterruptEnable = FALSE,
 465:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             .dmaInterruptEnable              = FALSE,
 466:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             .commandTimeoutInterruptEnable   = FALSE,
 467:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             .dataTimeoutInterruptEnable      = FALSE,
 468:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             .priority                        = 0,
 469:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             .provider                        = IfxSrc_Tos_cpu0,
 470:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             .vmId                            = IfxSrc_VmId_0
 471:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         },
 472:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         .dmaInterruptConfig                  = {
 473:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             .priority                        = 0,
 474:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             .provider                        = IfxSrc_Tos_cpu0,
 475:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             .vmId                            = IfxSrc_VmId_0
 476:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         },
 477:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         .pins       = NULL_PTR,
 478:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         .cardConfig = {
 479:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             .dataWidth = IfxSdmmc_SdDataTransferWidth_1Bit,
 480:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             .speedMode = IfxSdmmc_SdSpeedMode_normal
 481:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         },
 482:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         .useDma    = FALSE,
 483:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         .dmaConfig = {
 484:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             .dmaType                         = IfxSdmmc_DmaType_sdma
 485:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         }
 486:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     };
 487:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 488:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     /* Default Configuration */
 489:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     *config = defaultConfig;
 490:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 491:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     /* take over module pointer */
