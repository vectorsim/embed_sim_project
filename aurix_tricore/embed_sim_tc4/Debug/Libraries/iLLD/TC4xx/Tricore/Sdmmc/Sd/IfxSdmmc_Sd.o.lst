 678:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** IFX_INLINE uint32 IfxStm_getCompare(Ifx_CPU *cpu, IfxStm_Comparator comparator)
 679:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** {
 680:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** #if (IFX_CFG_STM_MORPHING_ENABLE)
 681:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     Ifx_CPU_STM_CMP *cmp0 = (Ifx_CPU_STM_CMP *)((uint32)cpu + (uint32)(IFXSTM_CMP0_OFFSET));
 682:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     Ifx_CPU_STM_CMP *cmp1 = (Ifx_CPU_STM_CMP *)((uint32)cpu + (uint32)(IFXSTM_CMP1_OFFSET));
 683:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** #else
 684:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** #if (IFXSTM_IS_STMHV_AVAILABLE)
 685:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     uint32           vmId = (uint32)IfxCpu_getVirtualMachine();
 686:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     Ifx_CPU_STM_CMP *cmp0 = (Ifx_CPU_STM_CMP *)(&cpu->STMHV.VM[vmId].CMP[0]);
 687:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     Ifx_CPU_STM_CMP *cmp1 = (Ifx_CPU_STM_CMP *)(&cpu->STMHV.VM[vmId].CMP[1]);
 688:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** #else
 689:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     Ifx_CPU_STM_CMP *cmp0 = (Ifx_CPU_STM_CMP *)(&cpu->STM.CMP[0]);
 690:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     Ifx_CPU_STM_CMP *cmp1 = (Ifx_CPU_STM_CMP *)(&cpu->STM.CMP[1]);
 691:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** #endif /* #if (IFXSTM_IS_STMHV_AVAILABLE) */
 692:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** #endif /* #if (IFX_CFG_STM_MORPHING_ENABLE) */
 693:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     if (comparator == IfxStm_Comparator_0)
 694:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     {
 695:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****         return cmp0->B.CMPVAL;
 696:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     }
 697:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     else if (comparator == IfxStm_Comparator_1)
 698:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     {
 699:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****         return cmp1->B.CMPVAL;
 700:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     }
 701:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     else
 702:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     {
 703:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****         return 0U;
 704:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     }
 705:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** }
