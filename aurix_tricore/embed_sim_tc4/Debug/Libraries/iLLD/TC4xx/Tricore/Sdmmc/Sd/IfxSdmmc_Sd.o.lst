  78:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** IFX_STATIC uint32 IfxSdmmc_Sd_FuncBlockSize[8] = {0};
  79:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
  80:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** /******************************************************************************/
  81:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** /*-------------------------Function Implementations---------------------------*/
  82:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** /******************************************************************************/
  83:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
  84:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** IfxSdmmc_Status IfxSdmmc_Sd_getLockStatus(IfxSdmmc_Sd *sd, IfxSdmmc_CardLockStatus *lockStatus)
  85:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** {
  86:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     IfxSdmmc_Status   status   = IfxSdmmc_Status_failure;
  87:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     IfxSdmmc_Response response;
  88:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     uint32            argument = 0UL;
  89:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
  90:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     argument |= (sd->cardInfo.rca << 16);
  91:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
  92:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     /* Send CMD13 to read card status  */
  93:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     status = IfxSdmmc_sendCommand(sd->sdmmcSFR, IfxSdmmc_Command_sendStatus, argument, IfxSdmmc_Res
  94:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
  95:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     if (status == IfxSdmmc_Status_success)
  96:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     {
  97:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         /* Lock/unlock status bit in the CSR register */
  98:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         if (response.cardStatus.B.locked != 0)
  99:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         {
 100:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             *lockStatus    = IfxSdmmc_CardLockStatus_locked;
 101:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             sd->cardState |= (uint8)IfxSdmmc_CardState_locked;
 102:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         }
 103:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         else
 104:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         {
 105:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             *lockStatus    = IfxSdmmc_CardLockStatus_unlocked;
 106:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             sd->cardState &= (uint8)~(uint8)(IfxSdmmc_CardState_locked);
 107:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         }
 108:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     }
 109:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 110:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     return status;
 111:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** }
 112:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 113:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 114:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** IfxSdmmc_Status IfxSdmmc_Sd_initCard(IfxSdmmc_Sd *sd, IfxSdmmc_Sd_CardConfig *cardConfig)
 115:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** {
 116:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     IfxSdmmc_Status         status     = IfxSdmmc_Status_success;
 117:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     IfxSdmmc_CardLockStatus lockStatus = IfxSdmmc_CardLockStatus_unlocked;
 118:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     IfxSdmmc_Response       response;
 119:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     IfxSdmmc_Sd_Flags      *sdflags    = &(sd->flags);
 120:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 121:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     /* set up the SD card interface, power up the card */
 122:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     /* power on bus */
 123:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     IfxSdmmc_setBusPowerOn(sd->sdmmcSFR);
 124:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 125:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     /* Enable the SD clock */
 126:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     IfxSdmmc_enableCardClock(sd->sdmmcSFR);
 127:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 128:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     /* according to SD Card spec we've to wait for 74 cycles with CMD and DAT high */
 129:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     {
 130:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         uint32 loopCount = (IFXSDMMC_DELAY_74CYCLE_US * 1000) / IFXSDMMC_1KLOOPDELAY_US;
 131:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         uint32 index;
 132:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 133:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         for (index = 0; index < loopCount; ++index)
 134:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         {
 135:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             //do nothing
 136:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             __nop();
 137:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         }
 138:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     }
 139:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 140:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     /* Initialize and identify the SD card */
 141:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     /* reset all flags first */
 142:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     sd->flags.f2      = FALSE;
 143:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     sd->flags.f8      = FALSE;
 144:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     sd->flags.ioInit  = FALSE;
 145:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     sd->flags.memInit = FALSE;
 146:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 147:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     /* Reset the card (CMD0) */
 148:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     status = IfxSdmmc_sendCommand(sd->sdmmcSFR, IfxSdmmc_Command_goIdleState, IFXSDMMC_ARG_NONE, If
 149:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 150:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     if (status == IfxSdmmc_Status_success)
 151:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     {
 152:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         /* validate Interface condition (CMD8) */
 153:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         status = IfxSdmmc_Sd_validateInterfaceCondition(sd);
 154:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     }
 155:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 156:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     if (status == IfxSdmmc_Status_success)
 157:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     {
 158:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         if (sdflags->supportIO)           /* Check if IO mode is supported */
 159:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         {
 160:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             if (sdflags->ioInit == FALSE) /* IO is not initialized */
 161:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             {
 162:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                 /* Validate Operating Condition for SDIO (CMD5)*/
 163:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                 status = IfxSdmmc_Sd_ioValidateOperatingCondition(sd);
 164:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 165:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                 if (status == IfxSdmmc_Status_success)
 166:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                 {
 167:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                     sdflags->ioInit = TRUE; /* IO is now initialized */
 168:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 169:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                     /* update memory present status */
 170:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                     sdflags->memoryPresent = (sd->cardInfo.io.ioInfo.bits.mp != 0);
 171:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                 }
 172:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                 else
 173:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                 {
 174:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                     sdflags->ioInit = FALSE;    /* IO is NOT initialized */
 175:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                 }
 176:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             }
 177:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         }
 178:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 179:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         if (sdflags->supportMEM && sdflags->memoryPresent)
 180:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         {
 181:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             /* validate operating condition (ACMD41) */
 182:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             status = IfxSdmmc_Sd_validateOperatingCondition(sd);
 183:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 184:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             if (status == IfxSdmmc_Status_success)
 185:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             {
 186:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                 // Update mem flag here.
 187:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                 sdflags->memInit = TRUE;
 188:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             }
 189:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         }
 190:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 191:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         /* we skip voltage switch sequences (CMD11 based on S18A) */
 192:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         /* This is because our controller does not support 1.8V */
 193:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 194:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         if (status == IfxSdmmc_Status_success)
 195:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         {
 196:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             if ((sdflags->f2 == FALSE) && (sdflags->memInit))   /* CMD2 not completed */
 197:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             {
 198:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                 /* Read CID (CMD2)*/
 199:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                 status = IfxSdmmc_Sd_readCid(sd);
 200:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             }
 201:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 202:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             if (status == IfxSdmmc_Status_success)
 203:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             {
 204:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                 // set F2 flag here.
 205:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                 sdflags->f2 = TRUE;
 206:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 207:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                 /* Read RCA (CMD3)*/
 208:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                 status = IfxSdmmc_Sd_readRca(sd);
 209:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 210:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                 if (status == IfxSdmmc_Status_success)
 211:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                 {
 212:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                     // now based on MEM / IO flags:
 213:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                     // populate the SD card type
 214:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                     // Capacity of card is initialized during ACMD41 test
 215:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                     sd->cardType = (IfxSdmmc_SdCardType)((uint8)(sdflags->ioInit) | ((uint8)(sdflag
 216:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 217:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                     /* Check card lock/unlock status */
 218:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                     if (sd->cardType != IfxSdmmc_SdCardType_io)
 219:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                     {
 220:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                         status = IfxSdmmc_Sd_getLockStatus(sd, &lockStatus);
 221:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                     }
 222:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 223:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                     if (status == IfxSdmmc_Status_success)
 224:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                     {
 225:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                         if (lockStatus == IfxSdmmc_CardLockStatus_locked)
 226:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                         {
 227:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                             status = IfxSdmmc_Status_initialisedButLocked;
 228:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                         }
 229:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 230:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                         /* Update card initialization status */
 231:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                         sd->cardState &= (uint8)~((uint8)IfxSdmmc_CardState_notInitialised | (uint8
 232:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                     }
 233:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                 }
 234:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             }
 235:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         }
 236:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     }
 237:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 238:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     /* switch speed and bus width */
 239:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     if (status == IfxSdmmc_Status_success)
 240:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     {
 241:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         if (sd->cardType != IfxSdmmc_SdCardType_io)
 242:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         {
 243:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             /* Switch to transfer state (CMD7) */
 244:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             status = IfxSdmmc_Sd_switchToTransferState(sd);
 245:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         }
 246:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         else
 247:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         {
 248:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             status = IfxSdmmc_Sd_ioSwitchToTransferState(sd);
 249:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         }
 250:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 251:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         if (status == IfxSdmmc_Status_success)
 252:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         {
 253:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             /* switch card clock to desired frequency now */
 254:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             if (sd->presetMode == TRUE)
 255:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             {
 256:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                 IfxSdmmc_disableCardClock(sd->sdmmcSFR);
 257:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 258:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                 /*Clock needs to be disabled completely before reconfiguration.
 259:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                  * So delay is needed here.*/
 260:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                 IfxStm_wait(IFXSDMMC_SD_CLOCK_DISABLE_DELAY); //6us
 261:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 262:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                 IfxSdmmc_enablePresetValues(sd->sdmmcSFR);
 263:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                 IfxSdmmc_enableCardClock(sd->sdmmcSFR);
 264:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             }
 265:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             else
 266:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             {
 267:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                 IfxSdmmc_switchClockFrequency(sd->sdmmcSFR, sd->userFrequency);
 268:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             }
 269:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         }
 270:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 271:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         if (sd->cardType != IfxSdmmc_SdCardType_io)
 272:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         {
 273:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             /* read SCR register contents */
 274:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             status = IfxSdmmc_Sd_readScr(sd);
 275:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         }
 276:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 277:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         if (status == IfxSdmmc_Status_success)
 278:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         {
 279:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             /* support SDIO switches also here */
 280:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             /* switch Bus Width if selected */
 281:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             if (cardConfig->dataWidth == IfxSdmmc_SdDataTransferWidth_4Bit)
 282:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             {
 283:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                 status = IfxSdmmc_Sd_switchToBusWidth4(sd);
 284:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             }
 285:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 286:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             /* Switch Speed if selected */
 287:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             if (cardConfig->speedMode == IfxSdmmc_SdSpeedMode_high)
 288:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             {
 289:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                 status = IfxSdmmc_Sd_switchToHighSpeed(sd);
 290:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             }
 291:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         }
 292:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     }
 293:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 294:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     if (status == IfxSdmmc_Status_success)
 295:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     {
 296:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         if (sd->cardType != IfxSdmmc_SdCardType_io)
 297:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         {
 298:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             /* Explicitly set block size as 512 */
 299:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             status = IfxSdmmc_sendCommand(sd->sdmmcSFR, IfxSdmmc_Command_setBlockLength, 512, IfxSd
 300:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         }
 301:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 302:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         if (sd->cardType != IfxSdmmc_SdCardType_mem)
 303:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         {
 304:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             /* Initialize the block sizes for all functions internally */
 305:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             uint8 func = 0;
 306:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 307:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             while (func < (uint8)8)
 308:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             {
 309:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                 IfxSdmmc_Sd_FuncBlockSize[func] = (uint32)0;
 310:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****                 func++;
 311:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             }
 312:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         }
 313:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     }
 314:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 315:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     return status;
 316:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** }
 317:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 318:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 319:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** IfxSdmmc_Status IfxSdmmc_Sd_initHostController(IfxSdmmc_Sd *sd, IfxSdmmc_Sd_HostConfig *hostConfig)
 320:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** {
 321:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     IfxSdmmc_Status status = IfxSdmmc_Status_success;
 322:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     /* set the bus voltage */
 323:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     IfxSdmmc_setBusVoltage(sd->sdmmcSFR);
 324:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 325:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     /* set the data line timeout value */
 326:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     IfxSdmmc_setDataLineTimeoutValue(sd->sdmmcSFR, hostConfig->timeoutValue);
 327:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 328:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     /* read and set Host Support Flags */
 329:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     IfxSdmmc_SdModes mode = hostConfig->supportedModes;
 330:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     sd->flags.supportIO  = (mode == IfxSdmmc_SdModes_combo) || (mode == IfxSdmmc_SdModes_ioOnly);
 331:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     sd->flags.supportMEM = (mode == IfxSdmmc_SdModes_combo) || (mode == IfxSdmmc_SdModes_memOnly);
 332:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 333:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     /* update memory present flag by default */
 334:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     sd->flags.memoryPresent = TRUE;
 335:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 336:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     /* version is above 4 no need to check version register */
 337:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 338:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     /* set up clock for 400KHz now; we will change later */
 339:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     IfxSdmmc_configureClock(sd->sdmmcSFR, IFXSDMMC_INIT_FREQUENCY);
 340:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 341:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     if (hostConfig->usePresetValues == TRUE)
 342:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     {
 343:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         sd->presetMode = TRUE;
 344:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     }
 345:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     else
 346:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     {
 347:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         sd->presetMode    = FALSE;
 348:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         sd->userFrequency = hostConfig->frequency;
 349:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     }
 350:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 351:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     /* enable internal clock */
 352:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     status = IfxSdmmc_setUpInternalClock(sd->sdmmcSFR);
 353:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 354:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     /* enable Host version 4 */
 355:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     IfxSdmmc_enableHostControllerVersion4(sd->sdmmcSFR);
 356:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 357:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     return status;
 358:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** }
 359:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 360:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 361:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** IfxSdmmc_Status IfxSdmmc_Sd_initModule(IfxSdmmc_Sd *sd, IfxSdmmc_Sd_Config *config)
 362:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** {
 363:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     IfxSdmmc_Status status   = IfxSdmmc_Status_success;
 364:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 365:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     Ifx_SDMMC      *sdmmcSFR = config->sdmmcSFR;
 366:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     sd->sdmmcSFR = sdmmcSFR;
 367:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     sd->dmaUsed  = config->useDma;
 368:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     sd->dmaType  = config->dmaConfig.dmaType;
 369:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 370:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     /* enable module */
 371:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     IfxSdmmc_enableModule(config->sdmmcSFR);
 372:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     //IfxSdmmc_resetmodule(config->sdmmcSFR);
 373:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     IfxSdmmc_applySoftwareReset(config->sdmmcSFR);
 374:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 375:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     /* initialise the host controller for the card type */
 376:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     IfxSdmmc_Sd_initHostController(sd, &config->hostConfig);
 377:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 378:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     /* set DMA type if DMA is used for transfers */
 379:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     if (config->useDma)
 380:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     {
 381:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         IfxSdmmc_setDmaType(sd->sdmmcSFR, config->dmaConfig.dmaType);
 382:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     }
 383:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 384:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     /* enable the necessary normal inteerupt status flags*/
 385:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     IfxSdmmc_enableNormalInterruptStatus(sdmmcSFR, IfxSdmmc_NormalInterrupt_commandComplete);
 386:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     IfxSdmmc_enableNormalInterruptStatus(sdmmcSFR, IfxSdmmc_NormalInterrupt_transferComplete);
 387:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     IfxSdmmc_enableNormalInterruptStatus(sdmmcSFR, IfxSdmmc_NormalInterrupt_dma);
 388:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     IfxSdmmc_enableNormalInterruptStatus(sdmmcSFR, IfxSdmmc_NormalInterrupt_bufferWriteReady);
 389:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     IfxSdmmc_enableNormalInterruptStatus(sdmmcSFR, IfxSdmmc_NormalInterrupt_bufferReadReady);
 390:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 391:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     /* enable all the error interrupt status flags */
 392:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     IfxSdmmc_enableAllErrorInterruptStatus(sdmmcSFR);
 393:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 394:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     /* initilaise the normal interrupts */
 395:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     if (config->interruptConfig.priority > 0)
 396:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     {
 397:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         if (config->interruptConfig.commandCompleteInterruptEnable)
 398:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         {
 399:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             IfxSdmmc_enableNormalInterrupt(sdmmcSFR, IfxSdmmc_NormalInterrupt_commandComplete);
 400:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         }
 401:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 402:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         if (config->interruptConfig.transferCompleteInterruptEnable)
 403:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         {
 404:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             IfxSdmmc_enableNormalInterrupt(sdmmcSFR, IfxSdmmc_NormalInterrupt_transferComplete);
 405:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         }
 406:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 407:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         if (config->interruptConfig.dmaInterruptEnable)
 408:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         {
 409:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             IfxSdmmc_enableNormalInterrupt(sdmmcSFR, IfxSdmmc_NormalInterrupt_dma);
 410:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         }
 411:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 412:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         if (config->interruptConfig.commandTimeoutInterruptEnable)
 413:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         {
 414:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             IfxSdmmc_enableErrorInterrupt(sdmmcSFR, IfxSdmmc_ErrorInterrupt_commandTimeout);
 415:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         }
 416:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 417:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         if (config->interruptConfig.dataTimeoutInterruptEnable)
 418:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         {
 419:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****             IfxSdmmc_enableErrorInterrupt(sdmmcSFR, IfxSdmmc_ErrorInterrupt_dataTimeout);
 420:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         }
 421:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 422:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         /* initialise service request node */
 423:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         volatile Ifx_SRC_SRCR *srcSFR;
 424:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         srcSFR = IfxSdmmc_getSrcPointer(sdmmcSFR, IfxSdmmc_InterruptType_normal);
 425:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         IfxSrc_init(srcSFR, config->interruptConfig.provider, config->interruptConfig.priority, con
 426:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         IfxSrc_enable(srcSFR);
 427:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     }
 428:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 429:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     /* initilaise the wakeup card detection interrupt */
 430:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     if (config->dmaInterruptConfig.priority > 0)
 431:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     {
 432:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         /* initialise service request node */
 433:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         volatile Ifx_SRC_SRCR *srcSFR;
 434:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         srcSFR = IfxSdmmc_getSrcPointer(sdmmcSFR, IfxSdmmc_InterruptType_dma);
 435:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         IfxSrc_init(srcSFR, config->dmaInterruptConfig.provider, config->dmaInterruptConfig.priorit
 436:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         IfxSrc_enable(srcSFR);
 437:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     }
 438:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 439:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     /* setup pins */
 440:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     if (config->pins != NULL_PTR)
 441:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     {
 442:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****         IfxSdmmc_Sd_setupPins(sd, config->pins);
 443:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     }
 444:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 445:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     /* set up, initialise and identify the card  */
 446:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     status = IfxSdmmc_Sd_initCard(sd, &config->cardConfig);
 447:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
 448:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c ****     return status;
 449:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** }
 450:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** 
