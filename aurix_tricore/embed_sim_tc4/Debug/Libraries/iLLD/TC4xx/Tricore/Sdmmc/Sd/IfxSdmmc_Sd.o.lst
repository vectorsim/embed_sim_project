 452:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** void IfxSdmmc_Sd_initModuleConfig(IfxSdmmc_Sd_Config *config, Ifx_SDMMC *sdmmcSFR)
 453:../Libraries/iLLD/TC4xx/Tricore/Sdmmc/Sd/IfxSdmmc_Sd.c **** {
