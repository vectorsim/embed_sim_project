 806:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     uint32           vmId = (uint32)IfxCpu_getVirtualMachine();
 807:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     Ifx_CPU_STM_CMP *cmp0 = (Ifx_CPU_STM_CMP *)(&cpu->STMHV.VM[vmId].CMP[0]);
 808:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     Ifx_CPU_STM_CMP *cmp1 = (Ifx_CPU_STM_CMP *)(&cpu->STMHV.VM[vmId].CMP[1]);
 809:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** #else
 810:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     Ifx_CPU_STM_CMP *cmp0 = (Ifx_CPU_STM_CMP *)(&cpu->STM.CMP[0]);
 811:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     Ifx_CPU_STM_CMP *cmp1 = (Ifx_CPU_STM_CMP *)(&cpu->STM.CMP[1]);
 812:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** #endif /* #if (IFXSTM_IS_STMHV_AVAILABLE) */
 813:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** #endif /* #if (IFX_CFG_STM_MORPHING_ENABLE) */
 814:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 815:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     if (comparator == IfxStm_Comparator_0)
 816:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     {
 817:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****         cmp0->B.CMPVAL = ticks;
 818:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     }
 819:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     else if (comparator == IfxStm_Comparator_1)
 820:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     {
 821:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****         cmp1->B.CMPVAL = ticks;
 822:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     }
 823:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     else
 824:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     {
