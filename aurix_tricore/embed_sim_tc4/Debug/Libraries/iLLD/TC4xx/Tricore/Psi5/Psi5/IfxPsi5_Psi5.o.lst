 276:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****     IfxPort_BandgapTrimConfig_1P302V = 10,  /**< \brief The trimming value is ten. */
 277:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****     IfxPort_BandgapTrimConfig_1P283V = 11,  /**< \brief The trimming value is eleven. */
 278:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****     IfxPort_BandgapTrimConfig_1P266V = 12,  /**< \brief The trimming value is twelve. */
