 787:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * IfxPort_setGroupModeOutput(&MODULE_P33, 0, 0xff, IfxPort_OutputMode_pushPull, IfxPort_OutputIdx_
