 270:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****     IfxPort_BandgapTrimConfig_1P139V = 4,   /**< \brief The trimming value is four. */
 271:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****     IfxPort_BandgapTrimConfig_1P125V = 5,   /**< \brief The trimming value is five. */
 272:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****     IfxPort_BandgapTrimConfig_1P112V = 6,   /**< \brief The trimming value is six. */
