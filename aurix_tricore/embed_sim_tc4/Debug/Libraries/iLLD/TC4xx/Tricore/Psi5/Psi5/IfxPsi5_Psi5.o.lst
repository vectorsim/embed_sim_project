 726:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** /** \brief Resets the pin controller selection to its default state.
 727:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 728:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[inout] port     Pointer to the base of specified port's SFRs.
 729:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[in]    pinIndex Specifies the pin for which the mode has to be set. Range: 0 to 15.
 730:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 731:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \retval None
