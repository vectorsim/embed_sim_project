 734:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** 
 735:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** /** \brief Modifies the Pin Controller Selection.
 736:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 737:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[inout] port     Pointer to the base of specified port's SFRs.
 738:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[in]    pinIndex Specifies the pin for which the mode has to be set. Range: 0 to 15.
 739:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[in]    mode     Selects the controller for the port pin(Tricore,EVADC,GETH,SCR,HRPWM etc)
 740:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 741:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * 0-> normal function
 742:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * 1-> Alternate functionality(SCR pin,EVADC PDD,GETH RGMII/MII,HRPWM etc)
 743:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * Note:It is the Users responsibility to pass correct port, pin and mode inputs.
 744:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 745:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \retval None
