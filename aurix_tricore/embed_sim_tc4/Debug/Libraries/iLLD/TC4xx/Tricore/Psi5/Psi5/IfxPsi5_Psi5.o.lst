 768:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * // read the current value of P33[7:0]
 769:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * uint16 value = IfxPort_getGroupState(&MODULE_P33, 0, 0xff);
