 789:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * // set initial value
 790:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * IfxPort_setGroupState(&MODULE_P33, 0, 0xff, 0x42);
 791:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \endcode
 792:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 793:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  */
