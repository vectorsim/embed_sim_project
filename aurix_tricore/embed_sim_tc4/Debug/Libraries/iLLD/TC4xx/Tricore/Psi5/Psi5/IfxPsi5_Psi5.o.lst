  27:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
  28:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \defgroup IfxLld_Port_Prot_Usage How to use the PORT driver along with PROT?
  29:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \ingroup IfxLld_Port
  30:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
  31:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * As per the current POR, each PORT module will have a set/group of APU registers. And each pin in
  32:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
  33:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * The way to use the APIs to configure the APU for PORT is as follows:
  34:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
  35:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * 1. Configure the PROT_SE Owner.
  36:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * 2. Configure the PADCFG.ACCEN.GRP bit field to map the pin to the APU group.
  37:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * 3. Configure the APU registers to enable the Access Protection.
  38:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
  39:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * In your application you can do the following to enable the PROT and configure the APU for the PO
  40:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
  41:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \code
  42:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * IfxPort_ProtConfig protConfig;
  43:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * IfxPort_ApuConfig apuConfig;
  44:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
  45:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * IfxPort_initProtConfig(&protConfig);
  46:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * IfxPort_initApuConfig(&apuConfig);
  47:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
  48:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * //Which APU group needs to be initialised
  49:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * apuConfig.grpNum = 1U;
  50:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
  51:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * //Initialize the PROT with the Owner
  52:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * IfxPort_initProt(&MODULE_P00, &protConfig);
  53:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
  54:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * //Configure the specific pin to map to a APU group "1", for example pin "2" of P00
  55:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * IfxPort_setApuGroupSelection(&MODULE_P00, 2, 1);
  56:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
  57:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * //Configure the APU and initialize it
  58:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * IfxPort_initApu(&MODULE_P00, &apuConfig);
  59:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \endcode
  60:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
  61:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * In case you want to configure multiple pins of the same PORT, this can be done using the API Ifx
  62:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
