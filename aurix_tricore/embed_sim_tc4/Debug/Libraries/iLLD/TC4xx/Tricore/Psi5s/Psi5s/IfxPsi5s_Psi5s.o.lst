 635:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** /** \brief Enable the emergency stop function.
 636:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * This function enables the emergency stop function. A check is done on port functionality.
 637:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 638:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[inout] port     Pointer to the port which should be accessed.
 639:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[in]    pinIndex Specifies the pin for which the emergency stop function should be enabled
 640:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 641:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \retval TRUE If emergency stop function was successfully enabled.
 642:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *         FALSE If failed to enable the emergency stop function.
 643:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 644:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * Coding example:
 645:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \code
 646:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *     if( !IfxPort_enableEmergencyStop(&MODULE_P33, 0) ) {
 647:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *       // failed to enable emergency stop for P33.0
 648:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *     }
 649:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \endcode
 650:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 651:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \see IfxPort_disableEmergencyStop(), IfxPort_setESR()
 652:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 653:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  */
 654:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** IFX_EXTERN boolean IfxPort_enableEmergencyStop(Ifx_P *port, uint8 pinIndex);
 655:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** 
 656:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** /** \brief Disable the emergency stop function.
 657:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * This function disables the emergency stop function. No check is done on port functionality.
 658:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 659:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[inout] port     Pointer to the port which should be accessed.
 660:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[in]    pinIndex Specifies the pin for which the emergency stop function should be disable
 661:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 662:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \retval None
 663:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 664:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \see IfxPort_disableEmergencyStop()
 665:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 666:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  */
 667:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** IFX_EXTERN void IfxPort_resetESR(Ifx_P *port, uint8 pinIndex);
 668:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** 
 669:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** /** \brief Enable the emergency stop function.
 670:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * This function enables the emergency stop function. No check is done on port functionality.
 671:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 672:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[inout] port     Pointer to the port which should be accessed.
 673:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[in]    pinIndex Specifies the pin for which the emergency stop function should be enabled
 674:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 675:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \retval None
 676:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 677:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \see IfxPort_enableEmergencyStop()
 678:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 679:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  */
 680:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** IFX_EXTERN void IfxPort_setESR(Ifx_P *port, uint8 pinIndex);
 681:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** 
 682:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** /** \brief Configure the port input / output mode.
 683:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * Also Configures the P40/P41 Port for digital functionality.
 684:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * which by default support analog functionality.
 685:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 686:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[inout] port     Pointer to the port which should be accessed.
 687:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[in]    pinIndex Specifies the pin to be configured. Range: 0 to 15.
 688:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[in]    mode     Specifies the port pin mode. Range: \ref IfxPort_Mode.
 689:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 690:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \retval None
 691:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 692:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * Coding example:
 693:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \code
 694:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *     IfxPort_setPinMode(&MODULE_P33, 0, IfxPort_Mode_outputPushPullGeneral);
 695:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \endcode
 696:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 697:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  */
