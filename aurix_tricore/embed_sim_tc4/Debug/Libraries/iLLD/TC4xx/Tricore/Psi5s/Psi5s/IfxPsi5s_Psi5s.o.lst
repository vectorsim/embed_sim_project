 135:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****     channel->module    = (IfxPsi5s_Psi5s *)config->module;
 136:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****     channel->channelId = config->channelId;
 137:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c **** 
 138:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****     Ifx_PSI5S_PGC tempPGC;
 139:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****     tempPGC.U         = psi5s->PGC[config->channelId].U;
 140:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****     tempPGC.B.TXCMD   = config->pulseGeneration.codeforZero;
 141:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****     tempPGC.B.ATXCMD  = config->pulseGeneration.codeforOne;
 142:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****     tempPGC.B.TBS     = config->pulseGeneration.timeBaseSelect;
 143:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****     tempPGC.B.ETB     = config->pulseGeneration.externalTimeBaseSelect;
 144:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****     tempPGC.B.ETS     = config->pulseGeneration.externalTriggerSelect;
 145:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****     tempPGC.B.TRIGSEL = config->pulseGeneration.triggersource;
 146:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c **** 
 147:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****     switch (config->pulseGeneration.periodicOrExternal)
 148:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****     {
 149:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****     case IfxPsi5s_TriggerType_periodic:
 150:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****         tempPGC.B.PTE = IfxPsi5s_PeriodicTrigger_enabled;
 151:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****         tempPGC.B.ETE = IfxPsi5s_ExternalTriggerLine_disabled;
 152:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****         break;
