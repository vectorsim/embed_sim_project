 100:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c **** IFX_STATIC uint32 IfxPsi5s_Psi5s_getFracDivClock(Ifx_PSI5S *psi5s)
 101:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c **** {
 102:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****     uint32 result;
 103:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****     uint32 fPsi5s = IfxClock_getSpbFrequency();
 104:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c **** 
 105:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****     switch (psi5s->FDR.B.DM)
 106:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****     {
 107:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****     case IfxPsi5s_DividerMode_spb:
 108:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****         result = fPsi5s;
 109:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****         break;
 110:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****     case IfxPsi5s_DividerMode_normal:
 111:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****         result = fPsi5s / (IFXPSI5S_STEP_RANGE - psi5s->FDR.B.STEP);
 112:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****         break;
 113:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****     case IfxPsi5s_DividerMode_fractional:
 114:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****         result = (fPsi5s * IFXPSI5S_STEP_RANGE) / psi5s->FDR.B.STEP;
 115:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****         break;
 116:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****     case IfxPsi5s_DividerMode_off:
 117:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****         result = 0;
 118:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****         break;
 119:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****     default:
 120:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****         result = 0;
 121:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****     }
 122:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c **** 
 123:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c ****     return result;
 124:../Libraries/iLLD/TC4xx/Tricore/Psi5s/Psi5s/IfxPsi5s_Psi5s.c **** }
