 909:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** /** \brief selects the clock source that is used for the clock generation of fsrc1 and fsource2/3
 910:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * Register : CCUCON.B.CLKSELP ;
 911:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * 0: PLL / fsrc1 = fPLL1; fsource2 = fPLL2; fsource3 = fPLL3
 912:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * 1: BACK / fBACK is used as clock source for fsrc1, fsource2, and fsource3
 913:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  */
 914:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** typedef enum
 915:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** {
 916:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     IfxClock_PerClockSourceSelect_pll  = 0, /**< \brief Peripheral Clock Source select : pll */
 917:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     IfxClock_PerClockSourceSelect_back = 1  /**< \brief Peripheral Clock Source select : Backup clo
 918:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** } IfxClock_PerClockSourceSelect;
 919:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
 920:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** /** \brief selects the primary clock source for the System PLL
 921:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * Register : CCUCON.B.INSEL ;
 922:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * 0: BACK / back-up clock is used as clock source
 923:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * 1: OSC0 / fOSC0 is used as clock source
