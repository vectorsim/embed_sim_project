 374:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     IfxHssl_enableHsctInterruptFlag(hsct, IfxHssl_Hsct_InterruptSource_headerError);
 375:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     IfxHssl_enableHsctInterruptFlag(hsct, IfxHssl_Hsct_InterruptSource_payloadError);
 376:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     IfxHssl_enableHsctInterruptFlag(hsct, IfxHssl_Hsct_InterruptSource_commandError);
 377:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     IfxHssl_enableHsctInterruptFlag(hsct, IfxHssl_Hsct_InterruptSource_speedModeSwitchError);
 378:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 379:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // enable the HSCT interrupt
 380:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     IfxHssl_enableHsctInterrupt(hsct, IfxSrc_Tos_cpu0, 4);
 381:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \endcode
 382:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 383:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * Using HSSl interrupts
