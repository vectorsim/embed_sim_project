  29:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \defgroup IfxLld_Hssl_Hssl_Usage How to use the HSSL Interface driver?
  30:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \ingroup IfxLld_Hssl
  31:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
  32:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * The HSSL interface driver provides a default HSSL/HSCT configuration for point to point communic
  33:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * It also supports streaming transfers of data a memory block at both low and high speeds.
  34:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
  35:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * In the following sections it will be described, how to integrate the driver into the application
  36:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
  37:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \section IfxLld_Hssl_Hssl_Preparation Preparation
  38:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \subsection IfxLld_Hssl_Hssl_Include Include Files
  39:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
  40:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * Include following header file into your C code:
  41:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \code
  42:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     #include <Hssl/Hssl/IfxHssl_Hssl.h>
  43:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \endcode
  44:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
  45:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \subsection IfxLld_Hssl_Hssl_Variables Variables
  46:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
  47:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * Declare the HSSL handle, HSCT handle and channel array as global variables in your C code:
  48:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
  49:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \code
  50:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // used globally
  51:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     static IfxHssl_Hssl hssl;
  52:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     static IfxHssl_Hsct hsct;
  53:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     IfxHssl_Hssl_Channel hsslChannel[4];
  54:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     __attribute__ ((aligned(256))) uint32 txData[80]; // needs to be declared globally in case o
  55:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \endcode
  56:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
  57:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \subsection IfxLld_Hssl_Hssl_InitModule Module Initialisation
  58:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
  59:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * The module initialisation can be done as follows:
  60:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
  61:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \code
  62:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // create module config
  63:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     IfxHssl_Hsct_Config hsctConfig;
  64:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     IfxHssl_Hssl_initHsctModuleConfig(&hsctConfig, &MODULE_HSCT);
  65:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
  66:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // select the interface mode (in case of slave)
  67:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     hsctConfig.interfaceMode = IfxHssl_InterfaceMode_slave;
