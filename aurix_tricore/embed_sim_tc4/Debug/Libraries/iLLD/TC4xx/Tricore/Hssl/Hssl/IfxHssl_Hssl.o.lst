 395:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     IfxHssl_enableHsslGlobalErrorInterruptFlag(hssl, IfxHssl_Hssl_EXIInterruptSource_dataLengthE
 396:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     IfxHssl_enableHsslGlobalErrorInterruptFlag(hssl, IfxHssl_Hssl_EXIInterruptSource_crcError);
 397:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
