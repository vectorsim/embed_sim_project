 613:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** /** \brief Disable the emergency stop function.
 614:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * This function disables the emergency stop function. A check is done on port functionality.
 615:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 616:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[inout] port     Pointer to the port which should be accessed.
 617:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[in]    pinIndex Specifies the pin for which the emergency stop function should be disable
 618:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 619:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \retval TRUE If the emergency stop function has been disabled.
 620:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *         FALSE If the emergency stop function could not be disabled.
 621:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 622:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * Coding example:
 623:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * /code
 624:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *     if( !IfxPort_disableEmergencyStop(&MODULE_P33, 0) )
 625:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *     {
 626:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *         // failed to disable emergency stop for P33.0
 627:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *     }
 628:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * /endcode
 629:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 630:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \see IfxPort_disableEmergencyStop(), IfxPort_resetESR()
 631:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 632:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  */
 633:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** IFX_EXTERN boolean IfxPort_disableEmergencyStop(Ifx_P *port, uint8 pinIndex);
 634:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** 
 635:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** /** \brief Enable the emergency stop function.
 636:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * This function enables the emergency stop function. A check is done on port functionality.
 637:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 638:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[inout] port     Pointer to the port which should be accessed.
 639:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[in]    pinIndex Specifies the pin for which the emergency stop function should be enabled
 640:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 641:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \retval TRUE If emergency stop function was successfully enabled.
 642:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *         FALSE If failed to enable the emergency stop function.
 643:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 644:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * Coding example:
 645:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \code
 646:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *     if( !IfxPort_enableEmergencyStop(&MODULE_P33, 0) ) {
 647:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *       // failed to enable emergency stop for P33.0
 648:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *     }
 649:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \endcode
 650:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 651:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \see IfxPort_disableEmergencyStop(), IfxPort_setESR()
 652:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 653:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  */
 654:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** IFX_EXTERN boolean IfxPort_enableEmergencyStop(Ifx_P *port, uint8 pinIndex);
 655:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** 
 656:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** /** \brief Disable the emergency stop function.
 657:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * This function disables the emergency stop function. No check is done on port functionality.
 658:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 659:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[inout] port     Pointer to the port which should be accessed.
 660:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[in]    pinIndex Specifies the pin for which the emergency stop function should be disable
 661:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 662:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \retval None
 663:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 664:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \see IfxPort_disableEmergencyStop()
