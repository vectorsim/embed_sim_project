 128:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \subsection IfxLld_Hssl_Hssl_LinkSpeed Changing HSCT link speed
 129:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 130:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * The link speed change can be done as follows
 131:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 132:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * As per the above settings the HSCT master is in High speed reception and transmission.
 133:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 134:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * The pseudo code for setting the target to High speed is as below
 135:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 136:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \code
 137:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 138:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *      // Set the Tx link speed of the master to Low speed
 139:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *      IfxHssl_setHsctTxLinkSpeed(&hsct , IfxHssl_MasterModeTxSpeed_lowSpeed);
 140:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 141:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *      // Enable reception at the Slave
 142:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *      IfxHssl_Hssl_sendControlCommand(&hsct,IfxHssl_ControlCommand_enableReception);
 143:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 144:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *      // Send interface commmand to change Rx to High speed at the target
 145:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *      IfxHssl_Hssl_sendControlCommand(&hsct,IfxHssl_ControlCommand_highSpeedReception);
 146:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 147:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *      // Send interface commmand to change Tx to High speed at the target
 148:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *      IfxHssl_Hssl_sendControlCommand(&hsct,IfxHssl_ControlCommand_highSpeedTransmission);
 149:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 150:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *      // Set the Tx link speed of the master to High speed
 151:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *      IfxHssl_setHsctTxLinkSpeed(&hsct , IfxHssl_MasterModeTxSpeed_highSpeed);
 152:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 153:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \endcode
 154:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 155:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * The pseudo code for setitng the target to Low speed from High speed (ie. if hsctConfig.highSpeed
 156:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 157:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \code
 158:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 159:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *      // Set the Tx link speed of master to Low speed
 160:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *      IfxHssl_setHsctTxLinkSpeed(&hsct , IfxHssl_MasterModeTxSpeed_lowSpeed);
 161:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 162:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *      // Send interface command to change Rx to low speed at the target
 163:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *      IfxHssl_Hssl_sendControlCommand(&hsct,IfxHssl_ControlCommand_lowSpeedReception);
 164:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 165:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *      // Set the Rx link speed of master to Low speed
 166:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *      IfxHssl_setHsctRxLinkSpeed(&hsct, IfxHssl_MasterModeRxSpeed_lowSpeed);
 167:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 168:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *      // Send interface command to change Tx to low speed at the target
 169:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *      IfxHssl_Hssl_sendControlCommand(&hsct,IfxHssl_ControlCommand_lowSpeedTransmission);
 170:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 171:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \endcode
