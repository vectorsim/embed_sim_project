 173:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * The HSSL is ready for use now!
 174:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 175:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 176:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \section IfxLld_Hssl_Hssl_DataTransfers Data Transfers
 177:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \subsection IfxLld_Hssl_Hssl_SimpleTransfers Simple Transfers
 178:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 179:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * The HSSL driver provides simple to use data transfer functions,
 180:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 181:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * It supports direct writing of 8/16/32 bit data from the initiator into a target's register, as w
 182:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 183:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \code
 184:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // write some data to remote location:
 185:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     IfxHssl_Hssl_write(&hsslChannel[0], 0x70000000, 0x12345678, IfxHssl_DataLength_32bit);
 186:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 187:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // wait for the acknowledgement
 188:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     while( IfxHssl_Hssl_waitAcknowledge(&hsslChannel[0]) != IfxHssl_Hssl_Status_ok )
 189:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     {
 190:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *         if( IfxHssl_Hssl_waitAcknowledge(&hsslChannel[0]) == IfxHssl_Hssl_Status_error )
 191:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *           {
 192:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *               IfxHssl_Hssl_checkErrors(&hssl);
 193:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *               break;
 194:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *           }
 195:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     }
 196:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \endcode
 197:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 198:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * A simple to use receive function is available as well.
 199:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 200:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \code
 201:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // read some data from remote location:
 202:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     IfxHssl_Hssl_read(&hsslChannel[0], 0x70000000, IfxHssl_DataLength_32bit);
 203:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 204:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // wait for the acknowledgement
 205:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     while( IfxHssl_Hssl_waitAcknowledge(&hsslChannel[0]) != IfxHssl_Hssl_Status_ok )
 206:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     {
 207:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *         if( IfxHssl_Hssl_waitAcknowledge(&hsslChannel[0]) == IfxHssl_Hssl_Status_error )
 208:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *           {
 209:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *               IfxHssl_Hssl_checkErrors(&hssl);
 210:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *               break;
 211:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *           }
 212:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     }
 213:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 214:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // read data from the register
 215:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     uint32 dataL = IfxHssl_Hssl_getReadData(&hsslChannel[0]);
 216:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \endcode
 217:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 218:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \subsection IfxLld_Hssl_Hssl_StreamingTransfers Streaming Transfers
 219:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 220:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * HSSL driver also supports streaming transfers of data as a memory block at both low and high spe
 221:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 222:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * Preparing the target for streaming with the desired memory location where the data needs to be t
 223:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 224:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \code
 225:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // choose a channel other than channel2 for register access
 226:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // prepare streaming of single memory block
 227:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     IfxHssl_Hssl_prepareStream(&hsslChannel[0], 0x70000000, 10);
 228:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \endcode
 229:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 230:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * Stream the memory block
 231:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 232:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * Usage Example:
 233:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \code
 234:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // __attribute__ ((aligned(256))) uint32 txData[80];  expected to be declared globally
 235:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 236:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // for single block streaming transfer
 237:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // change the txData address to global address before passing it to the API
 238:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 239:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // IfxHssl_Hssl_writeStream(&hssl, (uint32 *)IFXCPU_GLB_ADDR_DSPR(IfxCpu_getCoreId(), (uint3
 240:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 241:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     IfxHssl_Hssl_writeStream(&hssl, txData, 10);
 242:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 243:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // wait until the streaming is finished
 244:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     while( IfxHssl_Hssl_waitAcknowledge(&hsslChannel[2]) != IfxHssl_Hssl_Status_ok )
 245:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     {}
 246:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \endcode
 247:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 248:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \subsection IfxLld_Hssl_Hssl_DMAOperatedCommandQueues DMA Operated Command Queues
 249:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 250:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * It makes sense to do this from outside the driver, by initialising the DMA after HSSL, and send 
 251:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * here is an example of how to use DMA operated command queues.
 252:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 253:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 254:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * Include following header files into your C code:
 255:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \code
 256:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     #include <Hssl/Hssl/IfxHssl_Hssl.h>
 257:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     #include <Dma/Dma/IfxDma_Dma.h>
 258:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     #include <Scu/Std/IfxScuWdt.h>
 259:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \endcode
 260:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 261:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * Declare the HSSL handle, HSCT handle, HSSL channel handle and DMA channel handle as global varia
 262:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 263:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \code
 264:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // used globally
 265:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     static IfxHssl_Hssl hssl;
 266:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     static IfxHssl_Hsct hsct;
 267:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     IfxHssl_Hssl_Channel hsslChannel;
 268:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // DMA channel handle
 269:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     IfxDma_Dma_Channel chn;
 270:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 271:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // Linked List storage
 272:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // IMPORTANT: it has to be aligned to an 64bit address, otherwise DMA can't read it
 273:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     #define NUM_LINKED_LIST_ITEMS 3
 274:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     __attribute__ ((aligned(64))) Ifx_DMA_CH linkedList[NUM_LINKED_LIST_ITEMS] ;
 275:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // transfer these values to channel 0 : HSSL_IWD0, HSSL_ICON0, HSSL_IRWA0 registers via link
 276:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     #define NUM_TRANSFERED_WORDS 3
 277:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // three write command queues with different data and to different addresses on slave
 278:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     uint32 sourceBuffer[NUM_LINKED_LIST_ITEMS][NUM_TRANSFERED_WORDS] = {
 279:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *         {0xC0CAC01A, 0xFF0A0000, 0x70000000},
 280:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *         {0xBA5EBA11, 0xFF0A0000, 0x70000010},
 281:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *         {0xDEADBEEF, 0xFF0A0000, 0x70000020}
 282:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     };
 283:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 284:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // three command queues to the same channel 0
 285:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     const uint32 destinationAddresses[NUM_LINKED_LIST_ITEMS] = {
 286:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *         (uint32)&HSSL_I0_IWD,
 287:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *         (uint32)&HSSL_I0_IWD,
 288:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *         (uint32)&HSSL_I0_IWD
 289:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     };
 290:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \endcode
 291:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 292:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * Initialise the hssl module, see \ref IfxLld_Hssl_Hssl_InitModule
 293:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 294:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * Initialise the hssl channel
 295:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 296:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \code
 297:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // create HSSL channel config
 298:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     IfxHssl_Hssl_ChannelConfig hsslChannelConfig;
 299:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     IfxHssl_Hssl_initChannelConfig(&hsslChannelConfig, &hssl, &hsct);
 300:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 301:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // initialize the channel 0
 302:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // IfxHssl_Hssl_Channel hsslChannel;  defined globally
 303:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     hsslChannelConfig.channelId = 0;
 304:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     IfxHssl_Hssl_initChannel(&hsslChannel, &hsslChannelConfig);
 305:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \endcode
 306:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 307:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * Build a linked list
 308:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 309:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \code
 310:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // create module config
 311:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     IfxDma_Dma_Config dmaConfig;
 312:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     IfxDma_Dma_initModuleConfig(&dmaConfig, &MODULE_DMA);
 313:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // initialize module
 314:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     IfxDma_Dma dma;
 315:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     IfxDma_Dma_initModule(&dma, &dmaConfig);
 316:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // initial channel configuration
 317:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     IfxDma_Dma_ChannelConfig cfg;
 318:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     IfxDma_Dma_initChannelConfig(&cfg, &dma);
 319:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // following settings are used by all transactions
 320:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     cfg.transferCount = NUM_TRANSFERED_WORDS;
 321:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     cfg.requestMode = IfxDma_ChannelRequestMode_completeTransactionPerRequest;
 322:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     cfg.moveSize = IfxDma_ChannelMoveSize_32bit;
 323:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     cfg.shadowControl = IfxDma_ChannelShadow_linkedList;
 324:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // generate linked list items
 325:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     for(int i=0; i<NUM_LINKED_LIST_ITEMS; ++i) {
 326:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *         cfg.sourceAddress = IFXCPU_GLB_ADDR_DSPR(IfxCpu_getCoreId(), &sourceBuffer[i]);
 327:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *         cfg.destinationAddress = destinationAddresses[i];
 328:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *         // address to next transaction set
 329:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *         cfg.shadowAddress = IFXCPU_GLB_ADDR_DSPR(IfxCpu_getCoreId(), (uint32)&linkedList[(i + 1)
 330:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *         // transfer first transaction set into DMA channel
 331:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *         if( i == 0 ) {
 332:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *             IfxDma_Dma_initChannel(&chn, &cfg);
 333:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *         }
 334:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *         // transfer into linked list storage
 335:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *         IfxDma_Dma_initLinkedListEntry((void *)&linkedList[i], &cfg);
 336:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *         if( i == 0 ) {
 337:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *             // - trigger channel interrupt once the first transaction set has been loaded (again
 338:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *             linkedList[i].CHCSR.B.SIT = 1;
 339:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *         } else {
 340:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *          // - activate SCH (transaction request) for each entry, expect for the first one (linke
 341:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *             linkedList[i].CHCSR.B.SCH = 1;
 342:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *         }
 343:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     }
 344:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \endcode
 345:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 346:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * The transfer can be started via software with:
 347:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *
 348:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \code
 349:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // clear service request flag
 350:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     (IfxDma_Dma_getSrcPointer(&chn))->B.CLRR = 1;
 351:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // start linked list transaction
 352:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     IfxDma_Dma_startChannelTransaction(&chn);
 353:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     // wait for service request which is triggered at the end of linked list transfers
 354:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  *     while( !(IfxDma_Dma_getSrcPointer(&chn))->B.SRR );
 355:../Libraries/iLLD/TC4xx/Tricore/Hssl/Hssl/IfxHssl_Hssl.h ****  * \endcode
