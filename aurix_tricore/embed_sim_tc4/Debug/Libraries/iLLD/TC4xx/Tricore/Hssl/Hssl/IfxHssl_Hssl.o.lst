 458:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** /** \brief Return the port state.
 459:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 460:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[in] port     Pointer to the port which should be accessed.
 461:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[in] pinIndex Specifies the pin for which the state should be returned. Range: 0 to 15.
 462:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 463:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \retval TRUE If the pin is high.
 464:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *         FALSE If the pin is low.
 465:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 466:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * Coding example:
 467:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \code
