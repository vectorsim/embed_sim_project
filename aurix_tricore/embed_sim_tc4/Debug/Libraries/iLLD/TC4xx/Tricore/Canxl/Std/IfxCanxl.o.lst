  73:../Libraries/iLLD/TC4xx/Tricore/Canxl/Std/IfxCanxl.h **** #define IFXCANXL_CHECK_INPUT_BYTE_SIZE(x)                      (((x & (uint32)(4 - 1)) == (uint32)0
