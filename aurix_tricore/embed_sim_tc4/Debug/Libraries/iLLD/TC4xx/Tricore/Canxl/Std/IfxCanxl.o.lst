 104:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** 
 105:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** /** \brief Ifx_P output modification modes definition.
 106:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  */
 107:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** typedef enum
 108:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** {
 109:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****     IfxPort_InputMode_undefined    = -1,
