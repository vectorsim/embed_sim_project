 350:../Libraries/iLLD/TC4xx/Tricore/Canxl/Can/IfxCanxl_Can.c ****         IfxCanxl_Node_setOperationMode(nodeSFR, config->mode);
 351:../Libraries/iLLD/TC4xx/Tricore/Canxl/Can/IfxCanxl_Can.c **** 
 352:../Libraries/iLLD/TC4xx/Tricore/Canxl/Can/IfxCanxl_Can.c ****         /* Configure Message handler configuration structure */
 353:../Libraries/iLLD/TC4xx/Tricore/Canxl/Can/IfxCanxl_Can.c ****         Ifx_CANXL_N_MH_CFG mhCfgReg;
 354:../Libraries/iLLD/TC4xx/Tricore/Canxl/Can/IfxCanxl_Can.c ****         mhCfgReg.B.RX_CONT_DC  = config->rxDataContainerMode;
 355:../Libraries/iLLD/TC4xx/Tricore/Canxl/Can/IfxCanxl_Can.c ****         mhCfgReg.B.MAX_RETRANS = config->maxRetransmissions;
 356:../Libraries/iLLD/TC4xx/Tricore/Canxl/Can/IfxCanxl_Can.c ****         mhCfgReg.B.INST_NUM    = config->instanceNumber;
 357:../Libraries/iLLD/TC4xx/Tricore/Canxl/Can/IfxCanxl_Can.c ****         nodeSFR->MH_CFG.U      = mhCfgReg.U;
 358:../Libraries/iLLD/TC4xx/Tricore/Canxl/Can/IfxCanxl_Can.c **** 
 359:../Libraries/iLLD/TC4xx/Tricore/Canxl/Can/IfxCanxl_Can.c ****         /* Configure AXI Params */
 360:../Libraries/iLLD/TC4xx/Tricore/Canxl/Can/IfxCanxl_Can.c ****         IfxCanxl_Node_configureAxiParams(nodeSFR, config->axiParams.read, config->axiParams.write);
 361:../Libraries/iLLD/TC4xx/Tricore/Canxl/Can/IfxCanxl_Can.c **** 
 362:../Libraries/iLLD/TC4xx/Tricore/Canxl/Can/IfxCanxl_Can.c ****         /* Store offsets in registers */
 363:../Libraries/iLLD/TC4xx/Tricore/Canxl/Can/IfxCanxl_Can.c ****         nodeSFR->RX_FILTER_MEM_ADD.U            = config->ramAddresses.rxFilterStartAddress & 0x000
