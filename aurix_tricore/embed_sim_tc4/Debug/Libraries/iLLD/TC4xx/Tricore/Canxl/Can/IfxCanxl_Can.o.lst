 197:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  */
 198:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** IFX_INLINE void IfxSrc_clearOverrun(volatile Ifx_SRC_SRCR *src);
 199:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
