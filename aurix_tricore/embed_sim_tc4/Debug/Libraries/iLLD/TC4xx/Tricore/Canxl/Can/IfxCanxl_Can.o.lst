 342:../Libraries/iLLD/TC4xx/Tricore/Canxl/Can/IfxCanxl_Can.c ****     node->node                = nodeSFR;
 343:../Libraries/iLLD/TC4xx/Tricore/Canxl/Can/IfxCanxl_Can.c ****     node->rxDataContainerMode = config->rxDataContainerMode;
