 345:../Libraries/iLLD/TC4xx/Tricore/Canxl/Can/IfxCanxl_Can.c ****     node->instanceNumber      = config->instanceNumber;
 346:../Libraries/iLLD/TC4xx/Tricore/Canxl/Can/IfxCanxl_Can.c ****     node->numRxFilterElements = config->rxFilterConfig.numRxFilterElements;
