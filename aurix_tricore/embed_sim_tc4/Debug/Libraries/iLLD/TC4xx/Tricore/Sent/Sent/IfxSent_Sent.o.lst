 185:../Libraries/iLLD/TC4xx/Tricore/Sent/Sent/IfxSent_Sent.c ****     {
 186:../Libraries/iLLD/TC4xx/Tricore/Sent/Sent/IfxSent_Sent.c ****         uint16 timeOut = IFXSENT_CFG_TIMEOUT_VALUE;
 187:../Libraries/iLLD/TC4xx/Tricore/Sent/Sent/IfxSent_Sent.c ****         uint8  error   = 0;
 188:../Libraries/iLLD/TC4xx/Tricore/Sent/Sent/IfxSent_Sent.c **** 
 189:../Libraries/iLLD/TC4xx/Tricore/Sent/Sent/IfxSent_Sent.c ****         /* check if Transaction is in progress, before proceeding !!! */
 190:../Libraries/iLLD/TC4xx/Tricore/Sent/Sent/IfxSent_Sent.c ****         while ((sentCh->SCR.B.TRQ == 1) && (timeOut > 0))
 191:../Libraries/iLLD/TC4xx/Tricore/Sent/Sent/IfxSent_Sent.c ****         {
 192:../Libraries/iLLD/TC4xx/Tricore/Sent/Sent/IfxSent_Sent.c ****             /* Wait for Transaction to be completed */
 193:../Libraries/iLLD/TC4xx/Tricore/Sent/Sent/IfxSent_Sent.c ****             timeOut--;
 194:../Libraries/iLLD/TC4xx/Tricore/Sent/Sent/IfxSent_Sent.c ****         }
 195:../Libraries/iLLD/TC4xx/Tricore/Sent/Sent/IfxSent_Sent.c **** 
 196:../Libraries/iLLD/TC4xx/Tricore/Sent/Sent/IfxSent_Sent.c ****         if (timeOut == 0U)
 197:../Libraries/iLLD/TC4xx/Tricore/Sent/Sent/IfxSent_Sent.c ****         {
 198:../Libraries/iLLD/TC4xx/Tricore/Sent/Sent/IfxSent_Sent.c ****             error = 1U;
 199:../Libraries/iLLD/TC4xx/Tricore/Sent/Sent/IfxSent_Sent.c ****         }
 200:../Libraries/iLLD/TC4xx/Tricore/Sent/Sent/IfxSent_Sent.c **** 
 201:../Libraries/iLLD/TC4xx/Tricore/Sent/Sent/IfxSent_Sent.c ****         if (error == 0U)
 202:../Libraries/iLLD/TC4xx/Tricore/Sent/Sent/IfxSent_Sent.c ****         {
 203:../Libraries/iLLD/TC4xx/Tricore/Sent/Sent/IfxSent_Sent.c ****             Ifx_SENT_CH_SCR tempSCR;
 204:../Libraries/iLLD/TC4xx/Tricore/Sent/Sent/IfxSent_Sent.c ****             tempSCR.U      = 0;
 205:../Libraries/iLLD/TC4xx/Tricore/Sent/Sent/IfxSent_Sent.c ****             tempSCR.B.PLEN = config->transmitControl.pulseLength;
 206:../Libraries/iLLD/TC4xx/Tricore/Sent/Sent/IfxSent_Sent.c ****             tempSCR.B.TRIG = config->transmitControl.triggerSource;
 207:../Libraries/iLLD/TC4xx/Tricore/Sent/Sent/IfxSent_Sent.c ****             tempSCR.B.DEL  = config->transmitControl.pulseDelayLength;
 208:../Libraries/iLLD/TC4xx/Tricore/Sent/Sent/IfxSent_Sent.c ****             tempSCR.B.BASE = config->transmitControl.timeBase;
 209:../Libraries/iLLD/TC4xx/Tricore/Sent/Sent/IfxSent_Sent.c ****             sentCh->SCR.U  = tempSCR.U;
 210:../Libraries/iLLD/TC4xx/Tricore/Sent/Sent/IfxSent_Sent.c ****         }
 211:../Libraries/iLLD/TC4xx/Tricore/Sent/Sent/IfxSent_Sent.c ****     }
