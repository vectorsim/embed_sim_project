  74:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief Macro to identify Whether Platform VP 
  75:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  */
