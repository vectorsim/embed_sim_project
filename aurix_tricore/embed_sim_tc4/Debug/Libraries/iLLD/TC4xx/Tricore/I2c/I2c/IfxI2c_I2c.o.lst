 723:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h **** /**
 724:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h ****  * \brief Writes a packet (4 bytes) into the Fifo
 725:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h ****  *
 726:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h ****  * \param[inout] i2c 	Pointer to the i2c registers.
 727:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h ****  * \param[in]    packet Specifies the byte to be transfer.
 728:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h ****  *						A 32-bit value containing the 4 bytes to be written into the FIFO. The bytes are written in
 729:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h ****  * 					    - Byte 0: Most significant byte of the packet
 730:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h ****  * 					    - Byte 1: Next most significant byte of the packet
 731:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h ****  * 					    - Byte 2: Next least significant byte of the packet
 732:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h ****  * 					    - Byte 3: Least significant byte of the packet
 733:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h ****  * 					    Range: 0x8000H to 0xBFFCH
 734:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h ****  * \retval None
 735:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h ****  */
 736:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h **** IFX_INLINE void IfxI2c_writeFifo(Ifx_I2C *i2c, uint32 packet);
