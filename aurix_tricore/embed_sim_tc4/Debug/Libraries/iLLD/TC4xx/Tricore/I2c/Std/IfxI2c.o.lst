  26:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *
  27:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *
  28:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * \defgroup IfxLld_Src SRC
  29:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * \addtogroup IfxLld_Src
  30:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * \{
  31:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * \defgroup IfxLld_Src_Usage How to use Service Request Mechanism?
  32:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * \addtogroup IfxLld_Src_Usage
  33:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * \{
  34:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *
  35:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * For Aurix controller peripherals that can generate service requests is connected to one
  36:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * or more Service Request Nodes (SRNs) in the central Interrupt Router(IR) module. Refer to Contro
  37:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *
  38:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * IfxSrc driver provides the APIs to configure and control service requests. Refer \ref IfxLld_Src
  39:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * details of these APIs.
  40:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *
  41:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *
  42:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * \section Ifx_Src_UsageInit Initialize the Service Request Node
  43:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *
  44:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * Service request node is initialized to configure the following,\n
  45:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * 1) Route the interrupt trigger to service provider, which are:\n
  46:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *  __a. One of the available CPUs or\n
  47:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *  __b. DMA controller\n
  48:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *  __c. CSRM controller\n
  49:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *  __d. PPU\n
  50:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *
  51:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * 2) Priority of CPU Interrupt or DMA Trigger.
  52:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *
  53:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * For Interrupt or DMA to be correctly triggered, following steps are to be done in the user code:
  54:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *
  55:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * \subsection Ifx_Src_UsageInitStep1 Step1: Configure the Node
  56:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *
  57:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * User must configure the service request node in the application / driver files.
  58:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *
  59:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * \subsection Ifx_Src_UsageInitStep2 Step2: Enable the Trigger
  60:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *
  61:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * Enable the service request node to connect the trigger event from the hardware to service provid
  62:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *
  63:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * Example:
  64:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * Following example show the configuration for STM0 Service request 0 trigger configured to trigge
  65:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * CPU1 with the priority specified by IFX_INTPRIO_STM0 (from the example at IfxCpu_Irq)
  66:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *
  67:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * \code
  68:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * //file: myApplication.c
  69:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *
  70:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * #include "Ifx_IntPrioDef.h" // to get the priority numbers
  71:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *
  72:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * void myDriverInitFunction(void)
  73:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * {
  74:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *    // driver init code
  75:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *
  76:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *    // Step1: Call the function to route the trigger from for SRC_STM0_SR0 to CPU1
  77:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *    // and priority specified at Ifx_IntPrioDef.h globally
  78:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *    IfxSrc_init(&MODULE_SRC.STM[0].SR[0], IfxSrc_Tos_cpu1, IFX_INTPRIO_STM0, IfxSrc_VmId_0);
  79:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *
  80:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *    // Step2: Enable the service request node
  81:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *    IfxSrc_enable(&MODULE_SRC.STM.STM[0].SR[0]);
  82:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * }
  83:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * \endcode
  84:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *
  85:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * \}
  86:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * \}
  87:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  *
  88:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * \defgroup IfxLld_Src_Std_Service_Request Service Request Functions
  89:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * \ingroup IfxLld_Src_Std
  90:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * \defgroup IfxLld_Src_Std_Module Module Functions
  91:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * \ingroup IfxLld_Src_Std
  92:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  */
  93:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
