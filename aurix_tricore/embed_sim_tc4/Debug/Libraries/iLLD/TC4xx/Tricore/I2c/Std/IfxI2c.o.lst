 994:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 995:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_INLINE boolean IfxCpu_areInterruptsEnabled(void)
 996:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** {
 997:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     Ifx_CPU_ICR reg;
 998:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     reg.U = __mfcr(CPU_ICR);
 999:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     return reg.B.IE != 0;
1000:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** }
1001:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1002:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1003:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_INLINE boolean IfxCpu_disableInterrupts(void)
1004:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** {
1005:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     boolean enabled;
1006:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     enabled = IfxCpu_areInterruptsEnabled();
1007:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     __disable();
1008:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     __nop();
1009:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     return enabled;
1010:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** }
1011:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1012:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1013:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_INLINE void IfxCpu_enableInterrupts(void)
1014:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** {
