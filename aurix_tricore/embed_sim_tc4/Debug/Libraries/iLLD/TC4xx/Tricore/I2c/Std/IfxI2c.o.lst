 700:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* check if there is an unexpected RX_UFL error */
 701:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 	if (IfxI2c_getErrorInterruptSourceStatus(i2c, IfxI2c_ErrorInterruptSource_rxFifoUnderflow) == TRUE
 702:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 	{
 703:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         /* we have a FIFO underflow, jump back to caller */
 704:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         /* clear the FIFO underflow interrupt bit */
 705:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         IfxI2c_clearErrorInterruptSource(i2c, IfxI2c_ErrorInterruptSource_rxFifoUnderflow);
 706:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 707:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         /* return that we have an error */
 708:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         status = IfxI2c_Status_error;
 709:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         /* wait for TX_END */
 710:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 	}
 711:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 712:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     if ((i2cDevice->speedMode == IfxI2c_Mode_HighSpeed) && (IfxI2c_getProtocolInterruptSourceStatus
 713:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     {
 714:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         /* the address was setting the MC bit, clear it */
 715:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         IfxI2c_clearProtocolInterruptSource(i2c, IfxI2c_ProtocolInterruptSource_masterCode);
 716:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     }
 717:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 718:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* we wait until TX_END is set */
 719:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* go to state LISTENING via transition M20 if SOPE=1 and not high-speed */
 720:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* go to state MASTER RESTART via transition M19 if SOPE=0 or high-speed */
 721:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     while (IfxI2c_getProtocolInterruptSourceStatus(i2c, IfxI2c_ProtocolInterruptSource_transmission
 722:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     {}
 723:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 724:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* TX_END is set and need to be cleared */
 725:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     IfxI2c_clearProtocolInterruptSource(i2c, IfxI2c_ProtocolInterruptSource_transmissionEnd);
 726:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* return that everything is ok, we received all bytes */
 727:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     i2cDevice->i2c->busStatus = IfxI2c_getBusStatus(i2c);
 728:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     i2cDevice->i2c->status    = status;
 729:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     return status;
 730:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** }
 731:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 732:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 733:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** IfxI2c_Status IfxI2c_write(IfxI2c_I2cStdDevice *i2cDevice, volatile uint8 *data, Ifx_SizeT size)
 734:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** {
 735:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     Ifx_I2C         *i2c;                     /* pointer to I2C module */
 736:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     IfxI2c_Status    status;                  /* status of I2C and driver */
 737:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     IfxI2c_BusStatus busStatus;               /* status of I2C bus */
 738:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     uint32           uiWordsInFifo;           /* value how many words in FIFO available */
 739:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     uint32           uiDataIncrement;         /* value how to increment data in FIFO (byte, halfwor
 740:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     uint32           uiAddressBytes2Write;    /* value how many bytes are used for device address *
 741:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     uint32           uiCnt1, uiCnt2;          /* counters */
 742:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     union data
 743:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     {
 744:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         uint32 packet;
 745:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         uint8  packetbyte[4];
 746:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     } uiTxData;                                /* data array for transfer to FIFO */
 747:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 748:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* check the size parameter */
 749:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     if (size < 0)
 750:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     {
 751:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         return IfxI2c_Status_error;
 752:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     }
 753:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 754:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* increase size with the length of our address */
 755:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     size++;
 756:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 757:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     if (i2cDevice->addressMode == IfxI2c_AddressMode_10Bit)
 758:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     {
 759:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         size++;
 760:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     }
 761:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 762:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* check that the size parameter is not too big for TPS */
 763:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     if (size > 16383)
 764:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     {
 765:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         return IfxI2c_Status_error;
 766:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     }
 767:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 768:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* set the number of address bytes to write dependent of address setting */
 769:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     if (i2cDevice->addressMode == IfxI2c_AddressMode_10Bit)
 770:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     {
 771:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         uiAddressBytes2Write = 2;
 772:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     }
 773:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     else
 774:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     {
 775:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         uiAddressBytes2Write = 1;
 776:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     }
 777:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 778:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* set pointer to i2c module */
 779:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     i2c             = i2cDevice->i2c->i2c;
 780:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* set uiWordsInFifo dependent of setting */
 781:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     uiWordsInFifo   = 0x1 << i2c->FIFOCFG.B.TXBS;
 782:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* set uiDataIncrement dependent of setting */
 783:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     uiDataIncrement = 0x1 << i2c->FIFOCFG.B.TXFA;
 784:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* set the actual status to OK */
 785:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     status          = IfxI2c_Status_ok;
 786:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 787:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* get the actual bus status */
 788:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     busStatus = IfxI2c_getBusStatus(i2c);
 789:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 790:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     if ((busStatus != IfxI2c_BusStatus_idle) && (busStatus != IfxI2c_BusStatus_busyMaster))
 791:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     {
 792:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         /* bus is not free or not own by us, go back to caller */
 793:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         status                    = IfxI2c_Status_busNotFree;
 794:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         i2cDevice->i2c->busStatus = busStatus;
 795:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         i2cDevice->i2c->status    = status;
 796:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         return status;
 797:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     }
 798:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 799:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* here we are in state LISTENING or MASTER RESTART */
 800:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* if we are in LISTENING then maybe switch to high-speed mode if requested */
 801:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     if ((i2cDevice->speedMode == IfxI2c_Mode_HighSpeed) && (busStatus == IfxI2c_BusStatus_idle))
 802:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     {
 803:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         /* switch to high speed mode */
 804:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         status = IfxI2c_switch_to_highspeed(i2c);
 805:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 806:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         if (status != IfxI2c_Status_ok)
 807:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         {
 808:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****             /* switch to high speed was not possible because of arbitration lost, FIFO error or mas
 809:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****             i2cDevice->i2c->busStatus = IfxI2c_getBusStatus(i2c);
 810:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****             i2cDevice->i2c->status    = status;
 811:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****             return status;
 812:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         }
 813:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     }
 814:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 815:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* set the number of bytes to writes to bus, transition M9 or */
 816:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* set the number of bytes to writes to bus, transition M1 if IfxI2c_BusStatus_idle or M15 if I
 817:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     IfxI2c_setTransmitPacketSize(i2c, size);
 818:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 819:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     while (size)
 820:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     {
 821:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         /* wait until any interrupt flag is set */
 822:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         while ((i2c->RIS.U) == 0)
 823:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         {}
 824:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 825:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         if (IfxI2c_isFifoRequest(i2c) == TRUE)
 826:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         {
 827:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****             /* a request is set, now write to FIFO */
 828:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****             if ((IfxI2c_getDtrinterruptSourceStatus(i2c, IfxI2c_DtrInterruptSource_burstRequest) ==
 829:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                 (IfxI2c_getDtrinterruptSourceStatus(i2c, IfxI2c_DtrInterruptSource_lastBurstRequest
 830:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****             {
 831:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                 /* this is a burst request, we make a burst write to FIFO dependent on burst length
 832:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                 for (uiCnt1 = 0; uiCnt1 < uiWordsInFifo; uiCnt1++)
 833:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                 {
 834:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                     /* max. 4 bytes in the word, increment dependent of TX FIFO alignment */
 835:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                     for (uiCnt2 = 0; uiCnt2 < 4; uiCnt2 += uiDataIncrement)
 836:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                     {
 837:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                         if (uiAddressBytes2Write == 0)
 838:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                         {
 839:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                             /* address was set, set data now if not finished */
 840:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                             if (size)
 841:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                             {
 842:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                                 uiTxData.packetbyte[uiCnt2] = *data++;
 843:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                             }
 844:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                         }
 845:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                         else
 846:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                         {
 847:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                             if (uiAddressBytes2Write == 2)
 848:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                             {
 849:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                                 /* address has 10 bit, set first part of 10 bit address with RnW=0 
 850:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                                 uiTxData.packetbyte[uiCnt2] = 0xF0 | ((i2cDevice->deviceAddress & 0
 851:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                             }
 852:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                             else
 853:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                             {
 854:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                                 /* if address has 10 bit, set second part of 10 bit address otherwi
 855:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                                 if (i2cDevice->addressMode == IfxI2c_AddressMode_10Bit)
 856:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                                 {
 857:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                                     uiTxData.packetbyte[uiCnt2] = (uint8)i2cDevice->deviceAddress;
 858:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                                 }
 859:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                                 else
 860:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                                 {
 861:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                                     uiTxData.packetbyte[uiCnt2] = i2cDevice->deviceAddress & 0xFE;
 862:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                                 }
 863:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                             }
 864:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 865:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                             uiAddressBytes2Write--;
 866:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                         }
 867:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 868:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                         if (size)
 869:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                         {
 870:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                             size--;
 871:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                         }
 872:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                     }
 873:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 874:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                     IfxI2c_writeFifo(i2c, uiTxData.packet);
 875:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                 }
 876:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****             }
 877:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****             else
 878:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****             {
