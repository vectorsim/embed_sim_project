 384:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 385:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** IfxI2c_Status IfxI2c_read(IfxI2c_I2cStdDevice *i2cDevice, volatile uint8 *data, Ifx_SizeT size)
 386:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** {
 387:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     Ifx_I2C         *i2c;                     /* pointer to I2C module */
 388:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     IfxI2c_Status    status;                  /* status of I2C and driver */
 389:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     IfxI2c_BusStatus busStatus;               /* status of I2C bus */
 390:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     uint32           uiWordsInFifo;           /* value how many words in FIFO available (1. 2 or 4 
 391:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     uint32           uiDataIncrement;         /* value how to increment data in FIFO (byte, halfwor
 392:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     uint32           uiCnt1, uiCnt2;          /* counters */
 393:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     union data
 394:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     {
 395:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         uint32 packet;
 396:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         uint8  packetbyte[4];
 397:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     } uiRxData;                               /* data array for transfer from FIFO */
 398:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 399:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* check the size parameter */
 400:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     if (size < 0)
 401:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     {
 402:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         return IfxI2c_Status_error;
 403:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     }
 404:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 405:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* check that the size parameter is not too big for MRPS */
 406:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     if (size > 16383)
 407:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     {
 408:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         return IfxI2c_Status_error;
 409:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     }
 410:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 411:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* set pointer to i2c module */
 412:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     i2c             = i2cDevice->i2c->i2c;
 413:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* set uiWordsInFifo dependent of setting */
 414:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     uiWordsInFifo   = 0x1 << i2c->FIFOCFG.B.RXBS;
 415:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* set uiDataIncrement dependent of setting */
 416:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     uiDataIncrement = 0x1 << i2c->FIFOCFG.B.RXFA;
 417:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* set the actual status to OK */
 418:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     status          = IfxI2c_Status_ok;
 419:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 420:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* get the actual bus status */
 421:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     busStatus = IfxI2c_getBusStatus(i2c);
 422:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 423:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     if ((busStatus != IfxI2c_BusStatus_idle) && (busStatus != IfxI2c_BusStatus_busyMaster))
 424:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     {
 425:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         /* bus is not free or not own by us, go back to caller */
 426:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         status                    = IfxI2c_Status_busNotFree;
 427:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         i2cDevice->i2c->busStatus = busStatus;
 428:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         i2cDevice->i2c->status    = status;
 429:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         return status;
 430:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     }
 431:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 432:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     if (i2cDevice->addressMode == IfxI2c_AddressMode_10Bit)
 433:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     {
 434:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         /* for 10 bit addressing we send out the address without any data */
 435:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         /* this is only possible when SOPE=0 or in high-speed mode because restart needed */
 436:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         /* if high-speed is needed then the function will do this for us */
 437:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         status = IfxI2c_write(i2cDevice, (uint8 *)0, 0);
 438:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 439:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         if (status != IfxI2c_Status_ok)
 440:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         {
 441:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****             return status;
 442:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         }
 443:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 444:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         /* write the first device address byte again */
 445:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     }
 446:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     else
 447:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     {
 448:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         /* here we are in state LISTENING or MASTER RESTART */
 449:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         /* if we are in LISTENING then maybe switch to high-speed mode if requested */
 450:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         if ((i2cDevice->speedMode == IfxI2c_Mode_HighSpeed) && (busStatus == IfxI2c_BusStatus_idle)
 451:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         {
 452:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****             /* switch to high speed mode */
 453:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****             status = IfxI2c_switch_to_highspeed(i2c);
 454:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 455:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****             if (status != IfxI2c_Status_ok)
 456:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****             {
 457:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                 /* switch to high speed was not possible because of arbitration lost, FIFO error or
 458:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                 i2cDevice->i2c->busStatus = IfxI2c_getBusStatus(i2c);
 459:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                 i2cDevice->i2c->status    = status;
 460:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                 return status;
 461:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****             }
 462:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 463:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****             /* write the 7 bit device address, transition M9 */
 464:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         }
 465:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 466:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         /* write the 7 bit device address */
 467:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     }
 468:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 469:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* write the first device address byte again or */
 470:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* write the 7 bit device address, transition M9 or */
 471:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* write the 7 bit device address */
 472:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     IfxI2c_setTransmitPacketSize(i2c, 1);
 473:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* set the size of bytes which should be read */
 474:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     IfxI2c_setReceivePacketSize(i2c, size);
 475:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 476:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* wait until any interrupt flag is set */
 477:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     while ((i2c->RIS.U) == 0)
 478:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     {}
 479:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 480:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     if (IfxI2c_isFifoRequest(i2c) == TRUE)
 481:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     {
 482:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         /* write address to FIFO dependent of the addressing mode with RnW=1 */
 483:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         if (i2cDevice->addressMode == IfxI2c_AddressMode_10Bit)
 484:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         {
 485:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****             IfxI2c_writeFifo(i2c, 0xF1 | ((i2cDevice->deviceAddress & 0x30) >> 7));
 486:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         }
 487:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         else
 488:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         {
 489:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****             IfxI2c_writeFifo(i2c, i2cDevice->deviceAddress | 0x1);
 490:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         }
 491:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 492:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         /* clear the request flag after FIFO write */
 493:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         IfxI2c_clearAllDtrInterruptSources(i2c);
 494:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     }
 495:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 496:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* wait until any interrupt flag is set */
 497:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     while ((i2c->RIS.U) == 0)
 498:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     {}
 499:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 500:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* check if we lost arbitration */
 501:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     if (IfxI2c_getProtocolInterruptSourceStatus(i2c, IfxI2c_ProtocolInterruptSource_arbitrationLost
 502:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     {
 503:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         /* we have lost arbitration, jump back to caller */
 504:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         /* clear the arbitration lost interrupt bit */
 505:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         IfxI2c_clearProtocolInterruptSource(i2c, IfxI2c_ProtocolInterruptSource_arbitrationLost);
 506:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         /* go to state LISTENING via transition M5 */
 507:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         /* return information that we lost arbitration */
 508:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         status                    = IfxI2c_Status_al;
 509:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         i2cDevice->i2c->busStatus = IfxI2c_getBusStatus(i2c);
 510:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         i2cDevice->i2c->status    = status;
 511:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         return status;
 512:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     }
 513:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 514:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     /* check if there is an unexpected TX_OFL or TX_UFL  error */
 515:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     if ((IfxI2c_getErrorInterruptSourceStatus(i2c, IfxI2c_ErrorInterruptSource_txFifoOverflow) == T
 516:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     		(IfxI2c_getErrorInterruptSourceStatus(i2c, IfxI2c_ErrorInterruptSource_txFifoUnderflow) == TR
 517:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     {
 518:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         /* we have a FIFO overflow, jump back to caller */
 519:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         /* clear the FIFO overflow interrupt bit */
 520:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****     	if (IfxI2c_getErrorInterruptSourceStatus(i2c, IfxI2c_ErrorInterruptSource_txFifoOverflow) == T
