 923:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****             /* clear the request flag after FIFO write */
 924:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****             IfxI2c_clearAllDtrInterruptSources(i2c);
 925:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         }
