 911:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                         uiAddressBytes2Write--;
 912:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                     }
 913:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c **** 
 914:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                     if (size)
