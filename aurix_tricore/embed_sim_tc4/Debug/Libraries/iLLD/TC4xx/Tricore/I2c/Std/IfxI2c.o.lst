 307:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
 308:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** /** \brief MODCFG shift value for SYSPLLCON2
