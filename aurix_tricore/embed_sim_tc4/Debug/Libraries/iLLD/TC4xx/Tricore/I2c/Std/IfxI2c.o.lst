 846:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 847:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  */
 848:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_EXTERN void IfxCpu_emitEvent(IfxCpu_syncEvent *event);
