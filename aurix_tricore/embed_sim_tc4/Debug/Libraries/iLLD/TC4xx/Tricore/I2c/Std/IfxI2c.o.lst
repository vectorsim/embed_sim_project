 927:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****         {
 928:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****             /* we have an interrupt but it is not a FIFO request, there is an error */
