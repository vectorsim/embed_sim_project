 902:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                             {
 903:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                                 uiTxData.packetbyte[uiCnt2] = (uint8)i2cDevice->deviceAddress;
 904:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                             }
 905:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                             else
 906:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                             {
 907:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                                 uiTxData.packetbyte[uiCnt2] = i2cDevice->deviceAddress & 0xFE;
 908:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                             }
 909:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                         }
