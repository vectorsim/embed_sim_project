 714:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h **** /**
 715:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h ****  * \brief Waits until the I2C bus becomes free.
 716:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h ****  *
 717:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h ****  * \param[in] i2c Pointer to the i2c registers.
 718:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h ****  *
 719:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h ****  * \retval None
 720:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h ****  */
