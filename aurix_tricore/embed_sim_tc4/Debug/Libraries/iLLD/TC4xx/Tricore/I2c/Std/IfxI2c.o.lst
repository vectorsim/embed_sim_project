1097:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     {
1098:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****         module = (Ifx_CPU *)IfxCpu_cfg_indexMap[cpu].module;
