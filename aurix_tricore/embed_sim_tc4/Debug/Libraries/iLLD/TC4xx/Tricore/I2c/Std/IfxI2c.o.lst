 694:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *     IfxPort_setPinMode(&MODULE_P33, 0, IfxPort_Mode_outputPushPullGeneral);
 695:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \endcode
 696:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
