 667:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h ****  * \retval None
 668:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h ****  */
 669:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h **** IFX_INLINE void IfxI2c_setReceivePacketSize(Ifx_I2C *i2c, Ifx_SizeT size);
 670:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h **** 
 671:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h **** /**
 672:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h ****  * \brief Configures the slave device address for I2C communication.
 673:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h ****  *
 674:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h ****  * \param[inout] i2c     Pointer to the i2c registers.
 675:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h ****  * \param[in]	 address Device address.
 676:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h ****  * 						 Depending on setting of TBAM(Ten bit Address Mode),
 677:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h ****  *            	         this is either a 7-bit address (bits [7:1]) or a 10-bit address (bits [9:0]
 678:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h ****  *            	         Range: 0x1 to 0x7F (7-bit address), 0x00 to 0x3FF (10-bit address).
 679:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h ****  *
 680:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h ****  * \retval None
 681:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h ****  */
 682:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.h **** IFX_INLINE void IfxI2c_setSlaveDeviceAddress(Ifx_I2C *i2c, uint16 address);
