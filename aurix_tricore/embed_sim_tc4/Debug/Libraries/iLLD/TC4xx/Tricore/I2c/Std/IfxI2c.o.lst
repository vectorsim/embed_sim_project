 880:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                 /* max. 4 bytes in the word, increment dependent of TX FIFO alignment */
 881:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                 for (uiCnt2 = 0; uiCnt2 < 4; uiCnt2 += uiDataIncrement)
 882:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                 {
 883:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                     if (uiAddressBytes2Write == 0)
 884:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                     {
 885:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                         /* address was set, set data now if not finished */
 886:../Libraries/iLLD/TC4xx/Tricore/I2c/Std/IfxI2c.c ****                         if (size)
