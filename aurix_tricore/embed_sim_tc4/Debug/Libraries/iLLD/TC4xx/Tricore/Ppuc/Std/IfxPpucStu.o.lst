  28:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  * Streaming transfer unit
  29:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *
  30:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  * \defgroup IfxLld_Ppuc_Usage How to use the Ppuc driver?
  31:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  * \ingroup IfxLld_Ppuc
  32:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *
  33:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  * The Ppuc driver provides a default configuration for data moves
  34:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *
  35:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  * In the following sections it will be described, how to integrate the driver into the application
  36:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *
  37:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  * \section IfxLld_Ppuc_Preparation Preparation
  38:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  * \subsection IfxLld_Ppuc_Include Include Files
  39:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *
  40:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  * Include following header file into your C code:
  41:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *
  42:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  * \code
  43:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *      #include <Ppuc/Std/IfxPpucStu.h>
  44:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *      #define IFXPPUCSTU_TRANSFER_SIZE_BYTES	128U
  45:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *      #define LMU_START	0x30000000U
  46:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *      #define CSM_START	0xA0000000U
  47:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  * \endcode
  48:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *
  49:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *
  50:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  * \subsection IfxLld_Ppuc_STU	STU initialization
  51:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *
  52:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  * Initialize the number of entries in FIFO with following code:
  53:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  * \code
  54:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *  // Configure the number of entries in FIFO
  55:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *  IfxPpucStu_setMaxChannels(&MODULE_PPUC,16U);
  56:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  * \endcode
  57:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *
  58:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  * The above has to be only done once in the application.
  59:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *
  60:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  * \subsection IfxLld_Ppuc_Simple LMU-to-CSM Transfers
  61:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *
  62:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  * Channel configuration and handling for the data move:
  63:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  * \code
  64:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *      // construct the channel configuration
  65:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *      uint8 channelNum = 0U;
  66:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *      IfxPpucStu_channelConfig chnCfg;
  67:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *      IfxPpucStu_initChannelConfig(&chnCfg);
  68:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *
  69:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *      // Get the next free channel which should be used
  70:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *      channelNum = IfxPpucStu_getNextFreeChannel(&MODULE_PPUC);
  71:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *
  72:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *      // source and destination address
  73:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *      chnCfg.sourceAddress       = (uint32)LMU_START; // Provide src address
  74:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *      chnCfg.destinationAddress  = (uint32)CSM_START; // Provide dst address
  75:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *
  76:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *      // Configure the transfer size
  77:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *      chnCfg.transferSize		   =  IFXPPUCSTU_TRANSFER_SIZE_BYTES;
  78:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *
  79:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *      // Configure the start of descriptor area
  80:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *      IfxPpucStu_setDescriptorBaseAddress(&MODULE_PPUC, CSM_START + IFXPPUCSTU_TRANSFER_SIZE_BYTE
  81:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *
  82:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *
  83:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *      // transfer configuration into STU registers
  84:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *      IfxPpucStu_initChannel(&MODULE_PPUC, channelNum, (CSM_START + IFXPPUCSTU_TRANSFER_SIZE_BYTE
  85:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *
  86:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *      // start transfer and wait until it's finished
  87:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *      IfxPpucStu_startTransfer(&MODULE_PPUC,1U);
  88:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *
  89:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *      while(IfxPpucStu_getChannelEvent(&MODULE_PPUC, channelNum) != 1U)
  90:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *      {
  91:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *
  92:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *      }
  93:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *
  94:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *      // Clear the event flag
  95:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *      IfxPpucStu_clearAllEvents(&MODULE_PPUC);
  96:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *
  97:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  * \endcode
  98:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  *
  99:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  * \defgroup IfxLld_Ppuc_Std_Stu Stu Basic Functionality
 100:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  * \ingroup IfxLld_Ppuc_Std
 101:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  * \defgroup IfxLld_Ppuc_Std_Stu_Enum Stu_Enums
 102:../Libraries/iLLD/TC4xx/Tricore/Ppuc/Std/IfxPpucStu.h ****  * \ingroup IfxLld_Ppuc_Std_Stu
