  79:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c **** void IfxEray_Eray_Node_init(IfxEray_Eray *eray, const IfxEray_Eray_NodeConfig *config)
  80:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c **** {
  81:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****     Ifx_ERAY *eraySFR = eray->eray;
  82:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****     // clear all the flags
  83:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****     IfxEray_clearAllFlags(eraySFR);
  84:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c **** 
  85:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****     // set Communication Controller to config state
  86:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****     if (IfxEray_getPocState(eraySFR) != IfxEray_PocState_config)
  87:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****     {
  88:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****         IfxEray_changePocState(eraySFR, IfxEray_PocCommand_freeze);
  89:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****         IfxEray_waitForPocState(eraySFR, IfxEray_PocState_halt);
  90:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****         IfxEray_changePocState(eraySFR, IfxEray_PocCommand_config);
  91:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****         IfxEray_waitForPocState(eraySFR, IfxEray_PocState_defaultConfig);
  92:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****         IfxEray_changePocState(eraySFR, IfxEray_PocCommand_config);
  93:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****         IfxEray_waitForPocState(eraySFR, IfxEray_PocState_config);
  94:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****     }
  95:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c **** 
  96:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****     // enable interrupt lines
  97:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****     IfxEray_enableInterruptLines(eraySFR);
  98:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****     IfxEray_setAutoDelayBuffers(eraySFR);
  99:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****     //configure message RAM ( slots and slot buffers )
 100:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****     IfxEray_Eray_Node_initMessageRAM(eray, &config->messageRAMConfig);
 101:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****     //configure communication controller for clock corrections
 102:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****     IfxEray_Eray_Node_initCommunicationController(eray, &config->controllerConfig);
 103:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****     // initialise the Node pins.
 104:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****     const IfxEray_Eray_Pins *pins = config->pins;
 105:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c **** 
 106:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****     if (pins != NULL_PTR)
 107:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****     {
 108:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****         const IfxEray_Eray_NodeA *nodeAPins = pins->nodeAPins;
 109:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c **** 
 110:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****         if (nodeAPins != NULL_PTR)
 111:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****         {
 112:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****             const IfxEray_Rxd_In *rx = nodeAPins->rxIn;
 113:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c **** 
 114:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****             if (rx != NULL_PTR)
 115:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****             {
 116:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****                 IfxEray_initRxPinWithPadLevel(rx, nodeAPins->rxInMode, nodeAPins->pinDriver);
 117:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****             }
 118:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c **** 
 119:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****             const IfxEray_Txd_Out *tx = nodeAPins->txOut;
 120:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c **** 
 121:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****             if (tx != NULL_PTR)
 122:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****             {
 123:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****                 IfxEray_initTxPin(tx, nodeAPins->txOutMode, nodeAPins->pinDriver);
 124:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****             }
 125:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c **** 
 126:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****             const IfxEray_Txen_Out *txEn = nodeAPins->txEnOut;
 127:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c **** 
 128:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****             if (txEn != NULL_PTR)
 129:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****             {
 130:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****                 IfxEray_initTxEnPin(txEn, nodeAPins->txEnOutMode, nodeAPins->pinDriver);
 131:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****             }
 132:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****         }
 133:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c **** 
 134:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****         const IfxEray_Eray_NodeB *nodeBPins = pins->nodeBPins;
 135:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c **** 
 136:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****         if (nodeBPins != NULL_PTR)
 137:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****         {
 138:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****             const IfxEray_Rxd_In *rx = nodeBPins->rxIn;
 139:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c **** 
 140:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****             if (rx != NULL_PTR)
 141:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****             {
 142:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****                 IfxEray_initRxPinWithPadLevel(rx, nodeBPins->rxInMode, nodeBPins->pinDriver);
 143:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****             }
 144:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c **** 
 145:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****             const IfxEray_Txd_Out *tx = nodeBPins->txOut;
 146:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c **** 
 147:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****             if (tx != NULL_PTR)
 148:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****             {
 149:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****                 IfxEray_initTxPin(tx, nodeBPins->txOutMode, nodeBPins->pinDriver);
 150:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****             }
 151:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c **** 
 152:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****             const IfxEray_Txen_Out *txEn = nodeBPins->txEnOut;
 153:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c **** 
 154:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****             if (txEn != NULL_PTR)
 155:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****             {
 156:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****                 IfxEray_initTxEnPin(txEn, nodeBPins->txEnOutMode, nodeBPins->pinDriver);
 157:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****             }
 158:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****         }
 159:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****     }
 160:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c **** 
 161:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****     if (config->loopbackMode == FALSE)
 162:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****     {
 163:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****         /* set the Communication Controller to ready state*/
 164:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****         IfxEray_setPocReady(eraySFR);
 165:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****     }
 166:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c **** }
 167:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c **** 
 168:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c **** 
 169:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c **** IFX_STATIC void IfxEray_Eray_Node_initCommunicationController(IfxEray_Eray *eray, const IfxEray_Era
 170:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c **** {
 171:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****     Ifx_ERAY *eraySFR = eray->eray;
 172:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****     //SUCC1
 173:../Libraries/iLLD/TC4xx/Tricore/Eray/Eray/IfxEray_Eray.c ****     IfxEray_setTransmittedFrames(eraySFR, config->succ1Config.startupFrameTransmitted, config->succ
