 378:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * //get the service request
 379:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * volatile Ifx_SRC_SRCR *src = IfxAsclin_getSrcPointerRx( &MODULE_ASCLIN0 );
 380:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * //initlaise the service request
 381:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  * IfxSrc_init( src, IfxSrc_Tos_cpu0, IFXASCLIN0_TX_INTPRIO, IfxSrc_VmId_0);
