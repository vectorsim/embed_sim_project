 738:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** /** \brief Returns the tracked SRAM error addresses and memory blocks which are stored in the MBIST
 739:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * Note: The function should be called with adequate PROT and APU handling (PROTE/PROTCSE).
 740:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \param mbistSel Memory Selection
 741:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \param trackedSramAddresses will contain the tracked error addresses in trackedSramAdresses[x].B
 742:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 743:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * The array size shall be IFXVMT_MAX_TRACKED_ADDRESSES
 744:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \return number of tracked errors (0..IFXVMT_MAX_TRACKED_ADDRESSES)
 745:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 746:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * Example usage to print out tracked errors of a given memory:
 747:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 748:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * We assume that the VMT clock has already been enabled, and that the MBIST instance has been sele
 749:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \code
 750:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     uint16 password = IfxScuWdt_getCpuWatchdogPassword();
 751:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     IfxScuWdt_clearCpuEndinit(password);
 752:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 753:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     IfxVmt_enableModule();
 754:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 755:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     IfxVmt_MbistSel mbistSel = IfxVmt_MbistSel_lmu;
 756:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 757:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     IfxVmt_enableMbistShell(mbistSel);
 758:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 759:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     // for auto-init memories: wait for the end of the clear operation
 760:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     while (IfxVmt_isAutoInitRunning(mbistSel))
 761:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *         {}
 762:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \endcode
 763:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 764:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * Now the tracking information can be retrieved with:
 765:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 766:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \code
 767:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     {
 768:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *         Ifx_MC_ETRR trackedSramAddresses[IFXVMT_MAX_TRACKED_ADDRESSES];
 769:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *         uint8  numTrackedAddresses = IfxVmt_getTrackedSramAddresses(mbistSel, trackedSramAddress
 770:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 771:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *         for(int i=0; i<numTrackedAddresses; ++i) {
 772:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *             clib_ver_printf("%d: A:0x%04x MBI:%d -> SystemAddress: 0x%08x\n",
 773:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *                             i,
 774:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *                             trackedSramAddresses[i].B.ADDR,
 775:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *                             trackedSramAddresses[i].B.MBI,
 776:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *                             IfxVmt_getSystemAddress(mbistSel, trackedSramAddresses[i]));
 777:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *         }
 778:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *     }
 779:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \endcode
 780:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *
 781:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  */
 782:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** IFX_EXTERN uint8 IfxVmt_getTrackedSramAddresses(IfxVmt_MbistSel mbistSel, Ifx_VMT_MC_ETRR *trackedS
 783:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
 784:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** /** \} */
