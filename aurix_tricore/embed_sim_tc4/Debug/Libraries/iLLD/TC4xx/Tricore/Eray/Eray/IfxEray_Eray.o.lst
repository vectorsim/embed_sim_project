 827:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
 828:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** #if IFXVMT_K1_CHECK
 829:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** /** \brief This function will:
 830:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * 1. Check the last valid entry in the flash
 831:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * 2. If last valid entry is found, move the failid from NVM to RAM (PSPR if first time)
 832:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * 3. Check SAL, VFLAG, number of SBE and BLE count
 833:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \param k1Check structure consisting of FAILID information, Working RAM address and last FAILID e
 834:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \return 0 if k1 check passes else return 1
 835:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  */
 836:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** IFX_EXTERN sint8 IfxVmt_K1Check(IfxVmt_K1CheckFailIdInfo *k1Check);
 837:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** #endif /* #if IFXVMT_K1_CHECK */
 838:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
 839:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** #if IFXVMT_KX_TEST
 840:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** /** \brief This function will:
 841:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * 1. Enables the mbist controller for selected Gx (G1/G2) groups of SRAM's
 842:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * 2. Configure the test pattern in CONFIG0/1 registers for all SSHs as part of G1/G2 of SRAM memor
 843:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * 3. Start MEMTEST
 844:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * 4. Wait for MEMTEST to be done (MEMDONE)
 845:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * 5. Loop through all SSHs in G1/G2, check for UCE error.
 846:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * 5.1 If UCE error, first time increment q and restart.
 847:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * 5.2 If any UCERR and if ucerrCount != 0, user has to configure to safe state.
 848:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * 5.3 If no UCE error go next step
 849:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * 6. Loop through all SSHs in G1/G2, check for CE error. If CE error, log the VMT and SSH info in 
 850:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * 7. Store the total count of CERR into failIdLength
 851:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \param mbistConfig structure consisting of SRAM group list G1/G2
 852:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \param numOfSshConfig consists number of SSH in each group G1/G2
 853:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \param failIdAddr consists of FAILID address
 854:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \param failIdLength consists of FAILID length
 855:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \param ucerrCount consists of number of UCERR count
 856:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \return 1 if Kx Test fails, 0 if pass
 857:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  */
 858:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** IFX_EXTERN sint8 IfxVmt_KxTest(const IfxVmt_SshSelectionConfig *mbistConfig, uint8 numOfSshConfig, 
 859:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** #endif /* #if IFXVMT_KX_TEST */
 860:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
 861:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** #if IFXVMT_KX_INIT
 862:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** /** \brief This function will loop through all SSHs in G1/G2 and performs the SRAM Initialization
 863:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \param mbistConfig structure consists of SRAM group list G1/G2
 864:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \param numOfSshConfig consists number of ssh in each group G1/G2
 865:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \return None
 866:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  */
 867:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** IFX_EXTERN void IfxVmt_KxInit(const IfxVmt_SshSelectionConfig *mbistConfig, uint8 numOfSshConfig);
 868:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** #endif /* #if IFXVMT_KX_INIT */
 869:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
 870:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** #if IFXVMT_K3_PREPARE_EXTRACT_STORE
 871:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** /** \brief This function will
 872:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * 1. Initially checks if failIdLength = 0 (i.e No CERR is recorded in the FAILID), if YES, return 
 873:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * 2. Enable mbist controller via MEMTEST
 874:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * 3. K3 Extract: Configure the march test via registers CONFIG0 = 0x400AH and CONFIG1 = 0x0003H
 875:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * 4. Enable FAILIDDMP bit to 1 and start test MCONTROL = 0x201H
 876:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * 5. Check for MSTATUS.DONE == 0
 877:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * 6. Set MCONTROL = 0x200H and initialize fail bit counter failBitCounter = 0
 878:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * 7. While MSTATUS.DONE is not equal to 1
 879:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *    7.1 Check if MSTATUS.FDA = 1, If yes, get error address from ETRR and increment failBitCounte
 880:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *    7.2 Calculate fail postion and assign fail marker with SBEs on concerned locations
 881:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  *    7.3 If failBitCounter < Msbe resume the test by setting MCONTROL = 0x202H, else run the test 
 882:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * 8. If more or equal than 3 fails within one bitline oriented position, count those as BLE
 883:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * 9. K3 Store: count the total number of SBE and BLE errors by checking the error address entries 
 884:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * 10. Disable the mbist controller via MEMTEST register
 885:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \param sramInfo double pointer containing SRAM information for each SRAM (no.of RDBFL registers,
 886:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \param k3PhaseInputs structure contains information for the K3 Phase
 887:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  */
 888:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** IFX_EXTERN uint32 IfxVmt_K3PrepareExtractStore(const IfxVmt_SramInfo **sramInfo, IfxVmt_K3PhaseInpu
 889:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** #endif /* #if IFXVMT_K3_PREPARE_EXTRACT_STORE */
 890:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
 891:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** #if !defined(DEVICE_TC4DX) && !defined(DEVICE_TC49XN) && !defined(DEVICE_TC49XNAA) && !defined(DEVI
 892:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** /******************************************************************************/
 893:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** /*-------------------Global Exported Variables/Constants----------------------*/
