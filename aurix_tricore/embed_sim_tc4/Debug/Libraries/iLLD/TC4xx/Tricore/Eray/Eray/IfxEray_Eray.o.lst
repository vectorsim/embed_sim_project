 659:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** /** \brief This function runs the Non-Destructive Inversion test algorithm.
 660:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * Non-Destructive Inversion test can be considered as a simple linear test that is able to find al
 661:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * Test Steps:
 662:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * 1. Read data Word including check bits
 663:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * 2. write back all bits inverted
 664:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * 3. Read data Word including check bits
 665:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * 4. Write back all bits inverted
 666:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * At the end of this procedure the user data remains unchanged and every bit has been set to 0 and
 667:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * Note: The function should be called with adequate PROT and APU handling (PROTE/PROTCSE).
 668:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * The Error flags need to be cleared to enable further tracking after the test
 669:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \param mbistSel Memory Selection
 670:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \param rangeSel enable/disable range Selection (0 - disable, 1- enable)
 671:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \param rangeAddrUp when range mode is enabled, it specifies the upper logical block address limi
 672:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \param rangeAddrLow when range mode is enabled, it specifies the lower logical block address lim
 673:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \param errorAddr If the test fails, it contains the error address (bit0 - bit12) and memory bloc
 674:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \return Test Status (0-PASS, 1- FAIL)
 675:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  */
 676:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** IFX_EXTERN uint8 IfxVmt_runNonDestructiveInversionTest(IfxVmt_MbistSel mbistSel, uint8 rangeSel, ui
 677:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** 
 678:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h **** /**
 679:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \param mbistSel Memory Selection
 680:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \param sramAddress SRAM address which should be written
 681:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * Note: The function should be called with adequate PROT and APU handling (PROTE/PROTCSE).
 682:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  * \return None
 683:../Libraries/iLLD/TC4xx/Tricore/Vmt/Std/IfxVmt.h ****  */
