1469:../Libraries/iLLD/TC4xx/Tricore/Eray/Std/IfxEray.h **** 
1470:../Libraries/iLLD/TC4xx/Tricore/Eray/Std/IfxEray.h ****     return messageBufferInterrupt;
1471:../Libraries/iLLD/TC4xx/Tricore/Eray/Std/IfxEray.h **** }
