 270:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         dsc.B.TM      = config->downstreamConfig.transmissionMode;
 271:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         /* Alternative Input Timer Selection */
 272:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         dsc.B.ALTSEL  = config->downstreamConfig.timerSelection;
