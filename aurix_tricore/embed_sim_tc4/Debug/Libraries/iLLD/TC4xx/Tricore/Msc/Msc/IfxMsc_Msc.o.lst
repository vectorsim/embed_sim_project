  92:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         fdr.B.DM      = config->clockConfig.dividerMode;
  93:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         /* Select the source of clock for MSC output */
  94:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         fdr.B.ACS     = config->clockConfig.clockSource;
  95:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         mscSfr->FDR.U = fdr.U;
  96:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****     }
  97:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c **** 
  98:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****     /* Configure Upstream Channel Data Format  */
  99:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****     {
 100:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         Ifx_MSC_USR usr;
 101:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c **** 
 102:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         /* Read the USR register content */
 103:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         usr.U         = mscSfr->USR.U;
 104:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         /* Service Request Delay Control */
 105:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         usr.B.SRDC    = config->upstreamConfig.serviceRequestDelay;
 106:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         /* Select parity control Even - 0, Odd - 1 */
 107:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         usr.B.PCTR    = config->upstreamConfig.parity;
 108:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         /* Select upstream baud rate fMSC/xx */
 109:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         usr.B.URR     = config->upstreamConfig.upstreamChannelReceivingRate;
 110:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         /* Select 12 bit or 16 bit frame */
 111:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         usr.B.UFT     = config->upstreamConfig.upstreamChannelFrameType;
 112:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c **** 
 113:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         mscSfr->USR.U = usr.U;
 114:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****     }
 115:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c **** 
 116:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****     if (config->streamMode == IfxMsc_StreamMode_up) /*Upstream Baudrate Configuration*/
