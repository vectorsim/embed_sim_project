 326:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****             usce.B.USTOIP = config->interruptConfig.upstreamTimeoutInterruptNode;
 327:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****             usce.B.UTASR  = 0;
