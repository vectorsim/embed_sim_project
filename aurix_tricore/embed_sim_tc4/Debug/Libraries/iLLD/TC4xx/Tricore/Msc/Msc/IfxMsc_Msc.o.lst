 412:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         dsce.B.INJENP0  = config->downstreamConfig.externalSignalInjectionPin0;
 413:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         /* Data Frame over Command Frame Prioritization */
 414:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         dsce.B.DFP      = config->downstreamConfig.dataFramePriority;
 415:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         mscSfr->DSCE.U  = dsce.U;
 416:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****     }
