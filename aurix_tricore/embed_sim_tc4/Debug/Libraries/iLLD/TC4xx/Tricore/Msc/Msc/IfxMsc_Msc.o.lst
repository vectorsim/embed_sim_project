 233:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****     /* Configure the control of upstream channel timeout feature */
 234:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****     {
 235:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         Ifx_MSC_USCE usce;
 236:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c **** 
 237:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         /* Read the USCE register content */
 238:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         usce.U         = mscSfr->USCE.U;
 239:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         /* Upstream Timeout Value */
 240:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         usce.B.USTOVAL = config->upstreamConfig.upstreamTimeoutValue;
 241:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         /* Upstream Timeout Prescaler */
 242:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         usce.B.USTOPRE = config->upstreamConfig.upstreamTimeoutPrescaler;
 243:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         /* Upstream Timeout Interrupt */
 244:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         usce.B.USTOIP  = config->interruptConfig.upstreamTimeoutInterruptNode,
 245:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         usce.B.USTOEN  = config->interruptConfig.upstreamTimeoutInterrupt,
 246:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c **** 
 247:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         mscSfr->USCE.U = usce.U;
 248:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****     }
 249:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c **** 
 250:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****     /* Control the operation mode and frame layout of the downstream channel transmission */
 251:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****     {
 252:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         Ifx_MSC_DSC dsc;
 253:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c **** 
 254:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         /* Read the DSC register content */
 255:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         dsc.U = mscSfr->DSC.U;
 256:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c **** 
 257:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         /* Passive Phase Length */
 258:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         dsc.B.PPD     = config->downstreamConfig.dataFramePassivePhaseLength;
 259:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         /* Number of command bits transmitted */
 260:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         dsc.B.NBC     = config->downstreamConfig.commandFrameLength;
 261:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         /* SRH Selection Bit */
 262:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         dsc.B.ENSELH  = config->downstreamConfig.srhActivePhaseSelection;
 263:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         /* SRL Selection Bit */
 264:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         dsc.B.ENSELL  = config->downstreamConfig.srlActivePhaseSelection;
 265:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         /* Number of SRH Bits transmitted */
 266:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         dsc.B.NDBH    = config->downstreamConfig.srhDataFrameLength;
 267:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         /* Number of SRL Bits transmitted */
