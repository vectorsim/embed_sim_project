 376:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         ocr.B.CLKCTRL = config->outputControlConfig.fclClockControl;
 377:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         /* SDI Line Polarity - SDI and SI */
 378:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         ocr.B.ILP     = config->outputControlConfig.sdiLinePolarity;
 379:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         /* Chip Selection Lines Polarity - EN[0:3, ENL, ENH and ENC */
 380:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         ocr.B.CSLP    = config->outputControlConfig.cslpPolarity;
 381:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         /* SOP Line Polarity - SOP, SON, SO */
 382:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         ocr.B.SLP     = config->outputControlConfig.sopPolarity;
 383:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         /* FCLP Line Polarity - FCLP, FCLN and FCL */
 384:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         ocr.B.CLP     = config->outputControlConfig.fclpPolarity;
 385:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c **** 
 386:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         mscSfr->OCR.U = ocr.U;
 387:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****     }
 388:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****     /* Chip Enable Selection for ENL */
 389:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****     IfxMsc_setDataLowTarget(mscSfr, config->target[0]);
