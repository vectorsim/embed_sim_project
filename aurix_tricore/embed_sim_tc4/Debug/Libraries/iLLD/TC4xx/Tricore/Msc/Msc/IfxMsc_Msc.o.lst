 397:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****     /* Configure the Injection Enable and number of SRHE, SRLE Bits transmitted and Extension Enabl
 398:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****     {
 399:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         Ifx_MSC_DSCE dsce;
 400:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c **** 
 401:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         /* Read the DSCE register content */
 402:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         dsce.U          = mscSfr->DSCE.U;
 403:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         /* Command-Data-Command in Data Repetition Mode */
 404:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         dsce.B.CDCM     = config->downstreamConfig.commandDataCommandReceptionMode;
 405:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         /* Injection Position of the Pin 1 Signal */
 406:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         dsce.B.INJPOSP1 = config->downstreamConfig.injectionPositionPin1;
 407:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         /* Injection Enable of the Pin 1 Signal */
 408:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         dsce.B.INJENP1  = config->downstreamConfig.externalSignalInjectionPin1;
 409:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         /* Injection Position of the Pin 0 Signal */
 410:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         dsce.B.INJPOSP0 = config->downstreamConfig.injectionPositionPin0;
