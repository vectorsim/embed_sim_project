 370:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****     {
 371:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         Ifx_MSC_OCR ocr;
