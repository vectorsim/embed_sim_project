 143:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****             mscSfr->FDR.B.STEP = IfxMsc_downstreamFractionalBaudCalculator(mscSfr, config->clockCon
 144:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         }
 145:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****     }
