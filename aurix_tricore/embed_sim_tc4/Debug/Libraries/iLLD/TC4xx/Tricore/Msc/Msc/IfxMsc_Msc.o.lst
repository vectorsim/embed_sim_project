 431:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****     if (config->commandExtensionConfig.extension == IfxMsc_Extension_enabled)
 432:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****     {
 433:../Libraries/iLLD/TC4xx/Tricore/Msc/Msc/IfxMsc_Msc.c ****         IfxMsc_Msc_initializeCommandExtension(msc, config);
