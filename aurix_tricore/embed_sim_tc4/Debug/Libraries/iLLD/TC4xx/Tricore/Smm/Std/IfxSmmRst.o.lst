  39:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c **** /** \brief Function to get counter and divider value from time period
  40:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****  * \param timeInNs Time duration in Nanoseconds
  41:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****  * \param clockDivider Address to store calculated clock divider value
  42:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****  * \param counter Address to store calculated counter
  43:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****  * \return None
  44:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****  */
  45:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c **** IFX_INLINE void IfxSmmRst_calculateDivAndCntValue(uint32 timeInNs, uint8 *clockDivider, uint16 *cou
  46:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c **** 
  47:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c **** /******************************************************************************/
  48:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c **** /*---------------------Inline Function Implementations------------------------*/
  49:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c **** /******************************************************************************/
  50:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c **** 
  51:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c **** IFX_INLINE void IfxSmmRst_calculateDivAndCntValue(uint32 timeInNs, uint8 *clockDivider, uint16 *cou
  52:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c **** {
  53:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****     uint32  power = 1U;
  54:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****     uint8   index, powIndex;
  55:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****     float32 minCalTime, maxCalTime;
  56:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c **** 
  57:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****     /* Loop through possible divider to check if required time could be achieved with the divider s
  58:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****     for (index = 0; index < 16U; index++)
  59:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****     {
  60:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****         powIndex = index;
  61:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c **** 
  62:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****         while (powIndex != 0)
  63:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****         {
  64:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****             power *= 2U;
  65:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****             powIndex--;
  66:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****         }
  67:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c **** 
  68:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****         minCalTime = ((power / IFXSMMRST_RESET_COUNTER_BASE_CLOCK) * IFXSMMRST_TIME_IN_NS);
  69:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****         maxCalTime = (minCalTime * IFXSMMRST_RESET_COUNTER_MAX_VALUE);
  70:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c **** 
  71:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****         /* Break if the requested time could be achieved with the divider settings */
  72:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****         if ((timeInNs > (uint32)minCalTime) && (timeInNs < (uint32)maxCalTime))
  73:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****         {
  74:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****             break;
  75:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****         }
  76:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****         else
  77:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****         {
  78:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****             power = 1U;
  79:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****         }
  80:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****     }
  81:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c **** 
  82:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****     /* Store calculated value */
  83:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****     *counter      = (uint16)(timeInNs / minCalTime);
  84:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c ****     *clockDivider = index;
  85:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c **** }
  86:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c **** 
  87:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmRst.c **** 
