  42:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * Include following header file into your C code:
  43:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * \code
  44:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * #include <Smm/Std/IfxSmmSysMode.h>
  45:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * \endcode
  46:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *
  47:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * \subsection IfxLld_SmmSysMode_Idle IDLE mode transition
  48:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * \code
  49:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * {
  50:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *   //IDLE mode is selected by each individual CPU
  51:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *   IfxSmmSysMode_sysModeConfig(IfxSmmSysMode_RqPwMd_idle, 0x00); //Entry to the respective Idle m
  52:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *
  53:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *   // Set CPU1 to idle mode
  54:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *   IfxSmmSysMode_setCoreIdle(IfxCpu_ResourceCpu_1);
  55:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *
  56:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *   if(TRUE == IfxSmmSysMode_isCoreIdle(IfxCpu_ResourceCpu_1))
  57:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *   {
  58:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *
  59:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *   }
  60:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *
  61:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *   //Application could bring CPU1 to run mode using IfxSmmSysMode_setCoreRun API.
  62:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *   IfxSmmSysMode_setCoreRun(IfxCpu_ResourceCpu_1);
  63:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *
  64:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *   //Exit from idle mode can also happen via interrupt request etc
  65:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * }
  66:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *
  67:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * {
  68:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *    //Application could select if a single CPU could send the idle request to other CPU or respec
  69:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *    IfxSmmSysMode_sysModeConfig(IfxSmmSysMode_RqPwMd_idle, 0x01); //CPU0 Idle request will send a
  70:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *    IfxSmmSysMode_setCoreIdle(IfxCpu_ResourceCpu_0);
  71:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *
  72:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *    //Exiting idle mode : Interrupt request, NMI, reset event etc
  73:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *  }
  74:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * \endcode
