  96:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *   CLOCK_SYSPLLCON0.B.PLLPWR = 0u;\
  97:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *  CLOCK_PERPLLCON0.B.PLLPWR = 0u;\
  98:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *  CLOCK_PERCCUCON0.U = 0x00000000;\
  99:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *  CLOCK_PERCCUCON1.U = 0x00000000;\
 100:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  *  IfxClock_switchToLowPowerMode(IfxClock_LowPowerDivRatio_divBy1);\
 101:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * })
