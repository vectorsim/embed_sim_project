 726:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /* CPU Overlay is not supported for all TC4XX derivatives.*/
 727:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** #if defined(CPU_OVERLAY_SUPPORTED) 
 728:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief Disables a specific overlay block on the given CPU resource.
 729:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 730:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in] cpu          Core no of the CPU. Range: 0 to max number of CPU's supported for the va
 731:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in] overlayBlock The identifier of the overlay block to be disabled. Range: 0 to 31.
 732:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 733:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \retval uint32 Range: Enable successful, 0xdeadbeef: Enable un-successful.
 734:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  */
 735:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_EXTERN uint32 IfxCpu_disableOverlayBlock(uint32 cpu, uint32 ovcBlock);
 736:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 737:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief This function configures and enables the overlay memory.
 738:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * Note:
 739:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * The data overlay provides the capability to redirect selected data accesses to the Overlay memor
 740:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 741:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * How the overlay Memory works?
 742:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * Any data access to segment 8 or segment A is checked against all the activated overlay blocks. F
 743:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * The address for redirection is constructed as follows:
 744:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * 1. Address bits 31..22 are set according to the overlay memory selection and the cache-ability o
 745:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * 2. For address bits 21..5:
 746:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * - If the corresponding address mask bit is set, the address bit value is taken from overlay base
 747:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * - If the corresponding address mask bit is cleared, the address bit value is taken from the orig
 748:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * 3. Address bits 4..0 are always taken directly from the original address.
 749:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * If there is no redirection, the original address is used to perform the access.
 750:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * Target address ranges for activated overlay blocks should not overlap or an exception may occur.
 751:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 752:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in] cpu                 Core no of the CPU. Range: 0 to max number of CPU's supported for
 753:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in] overlayBlock        Overlay Block. Range: 0 to 31.
 754:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in] overlayMemorySelect Overlay Memory Select. Range. 0 to 0xFFFFFFFF.
 755:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in] overlayAddressMask  Overlay Address Mask. Range: \ref IfxCpu_OverlayAddressMask.
 756:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in] targetBaseAddress   Target Base address (i.e Source address to be re-directed). Range
 757:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in] overlayBaseAddress  Overlay or Re-directed Base address (Bits 21..5 of the base addre
 758:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 759:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \retval uint32 Range: Enable successful, 0xdeadbeef: Enable un-successful.
 760:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  */
 761:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_EXTERN uint32 IfxCpu_enableOverlayBlock(uint32 cpu, uint32 ovcBlock, uint32 ovcMemory, uint32 o
 762:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 763:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** #endif /* CPU_OVERLAY_SUPPORTED */
 764:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 765:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 766:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief API to get random value.
 767:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 768:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[inout] seed Pointer to seed value.
 769:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 770:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \retval uint32 random value.
 771:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  */
 772:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_EXTERN uint32 IfxCpu_getRandomValue(uint32 *seed);
 773:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 774:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief Generates a random value within a specified range using the provided seed.
 775:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 776:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[inout] seed Pointer to the seed value used for random number generation. The seed is upda
 777:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in]    min  The minimum value (inclusive) of the range from which the random number will 
 778:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in]    max  The maximum value (exclusive) of the range from which the random number will 
 779:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 780:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \retval uint32 A random value within the range [min, max].
 781:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  */
 782:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_EXTERN uint32 IfxCpu_getRandomValueWithinRange(uint32 *seed, uint32 min, uint32 max);
 783:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 784:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief This function waits till all the cores have set their corresponding bits in the event. T
 785:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * IfxCpu_emitEvent() are used to achieve the synchronisation between the configured cores. 
 786:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * The IfxCpu_emitEvent() is to be used in the Main functions of the Cores where the user wants to 
 787:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 788:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 789:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * Note: 
 790:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * The user has to explicitly set the constant core's mask value to check the synchronisation betwe
 791:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * Core id values read from CORE_ID register will be as shown below. 
 792:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * The value indicates the position of the bit needs to be set for the core mask parameter expected
 793:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * 
 794:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * Core 0: 0
 795:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * Core 1: 1
 796:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * Core 2: 2
 797:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * Core 3: 3
 798:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * Core 4: 4
 799:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * Core 5: 6
 800:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  
 801:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * e.g:
 802:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * 1. Check for synchronisation between core 0 and core 5
 803:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * expectedCoreMask = 0x21U
 804:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 805:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * 2. Check for synchronisation between core 0 to core 5
 806:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * expectedCoreMask = 0x3FU
 807:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 808:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * 3. Check for synchronisation between core 2 and core 4
 809:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * expectedCoreMask = 0x14U
 810:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 811:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * 4. Check for synchronisation between core 2 to core 4
