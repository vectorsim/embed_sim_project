 263:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h **** /** \brief Sleep sequence in Flash memory
 264:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  * \return None
 265:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h ****  */
 266:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h **** IFX_EXTERN void IfxSmmSysMode_startSleepSequenceinFlash(void);
 267:../Libraries/iLLD/TC4xx/Tricore/Smm/Std/IfxSmmSysMode.h **** 
