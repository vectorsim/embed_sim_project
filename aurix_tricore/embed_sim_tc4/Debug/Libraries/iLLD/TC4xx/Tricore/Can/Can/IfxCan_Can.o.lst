 489:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 490:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * wait for the nodes to be synchronized, before sending and receiving, please refer to Nodes Synch
 491:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 492:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * data can be sent and received similarly as standard data transfers except the FIFO configuration
 493:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * choose the FIFO related configuration accordingly in the message structure before sending and re
 494:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 495:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * transmit and receive example
 496:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 497:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * \code
 498:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     //data that needs to be transmitted
 499:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     txData[0] = 0x55555555;
 500:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     txData[1] = 0xAAAAAAAA;
 501:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 502:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     // will be replaced by the received values
 503:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     rxData[0] = 0xdeaddead;
 504:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     rxData[1] = 0xdeaddead;
 505:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 506:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     // Initialise the tx message structure with default values
 507:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     IfxCan_Message txMsg;
 508:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     IfxCan_Can_initMessage(&txMsg);
 509:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 510:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     // change the relevant members of transmit message structure
 511:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     txMsg.messageId = 0x0;     // since the tx mode is configured as FIFO the ID should be const
 512:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *                             // if the tx mode is configured as Queue then the ID can be changed 
 513:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     txMsg.storeInTxFifoQueue = TRUE;    // enable writing the data into FIFO/Queue,
 514:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *                                          // this will enable the sendMessage API to get the next
 515:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 516:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     // Initialise the rx message structure with default values
 517:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     IfxCan_Message rxMsg;
 518:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     IfxCan_Can_initMessage(&rxMsg);
 519:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 520:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     // change the relevant members of receive message structure
 521:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     rxMsg.readFromRxFifo0 = TRUE;    // enable reading the data from Rx FIFO 0
 522:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *                                      // this will enable the readMessage API to get the next Rx 
 523:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 524:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     // send and receive through FIFO
 525:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     uint32 i = 0;
 526:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 527:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     // #define FIFO_LENGTH 20 // define globally
 528:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     for (i = 0; i < FIFO_LENGTH; ++i)
 529:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     {
 530:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         // Transmit Data
 531:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         if (IfxCan_Can_isTxFifoQueueFull(&canNode[1]) != TRUE)
 532:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         {
 533:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *                 while( IfxCan_Can_sendMessage(&canNode[1], &txMsg, txData) == IfxCan_Status_notS
 534:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         }
 535:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 536:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         // Receive Data
 537:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         // wait until RX FIFO 0 receives new data
 538:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         while(IfxCan_Can_getRxFifo0FillLevel(&canNode[0]) == 0);
 539:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 540:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         if (IfxCan_Can_getRxFifo0FillLevel(&canNode[0]) > 0)
 541:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         {
 542:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *             // read message
 543:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *             IfxCan_Can_readMessage(&canNode[0], &rxMsg, rxData);
 544:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         }
 545:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 546:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         // data is now available at rxData[0] and rxData[1]
 547:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         result |= clib_trace(rxData[0], txData[0]);
 548:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         result |= clib_trace(rxData[1], txData[1]);
 549:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 550:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         txData[0]++;
 551:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         txData[1]++;
 552:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     }
 553:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * \endcode
 554:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
