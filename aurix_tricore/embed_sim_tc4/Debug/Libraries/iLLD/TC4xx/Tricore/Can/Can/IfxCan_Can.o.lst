  27:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
  28:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * \defgroup IfxLld_Can_Can_Usage How to use the CAN Interface driver?
  29:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * \ingroup IfxLld_Can
  30:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
  31:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * The CAN interface driver provides a default configuration for various modes.
  32:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
  33:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * In the following sections it will be described, how to integrate the driver into the application
  34:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
  35:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * \section IfxLld_Can_Can_Preparation Preparation
  36:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * \subsection IfxLld_Can_Can_Include Include Files
  37:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
  38:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * Include following header file into your C code:
  39:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * \code
  40:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     #include <Can/Can/IfxCan_Can.h>
  41:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * \endcode
  42:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
  43:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * \subsection IfxLld_Can_Can_Variables Variables
  44:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
  45:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * Declare the CAN handles as global variables in your C code:
  46:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * \code
  47:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
  48:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * #define TESTED_NODES 2
  49:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * #define NODE0_RAM_OFFSET 0x0
  50:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * #define NODE1_RAM_OFFSET 0x1000
  51:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
  52:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     // CAN handle
  53:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     IfxCan_Can can;
  54:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
  55:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     // CAN Node handles
  56:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     IfxCan_Can_Node canNode[TESTED_NODES];
  57:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
  58:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     // data buffers
  59:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     uint32 txData[2];
  60:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     uint32 rxData[2];
  61:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
  62:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * \endcode
  63:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
  64:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * \subsection IfxLld_Can_Can_Init Module Initialisation
  65:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
  66:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * The module initialisation can be done as followed:
  67:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * \code
  68:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     // create module configuration
  69:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     IfxCan_Can_Config canConfig;
  70:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     IfxCan_Can_initModuleConfig(&canConfig, &MODULE_CAN0);
  71:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
  72:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     // choose the interrupt groups configuration
  73:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     // Tx interrupts
  74:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     canConfig.traco.priority = 10;
  75:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     canConfig.traco.typeOfService = IfxSrc_Tos_cpu0;
  76:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     canConfig.traco.interruptLine = IfxCan_InterruptLine_0;
  77:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
  78:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     // Rx interrupts
  79:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     canConfig.reint.priority = 11;
  80:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     canConfig.reint.typeOfService = IfxSrc_Tos_cpu0;
  81:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     canConfig.reint.interruptLine = IfxCan_InterruptLine_1;
  82:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
  83:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     // initialize module
  84:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     // IfxCan_Can can; // defined globally
  85:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     IfxCan_Can_initModule(&can, &canConfig);
  86:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * \endcode
  87:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
  88:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * Note: Application should explicitly configure the system DMA, if system DMA is selected as the s
  89:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
  90:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * \subsection IfxLld_Can_Can_Init_Node Node Initialisation
  91:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
  92:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * The Node initialisation can be done as followed:
  93:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * \code
  94:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     // create node configuration
  95:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     //Regarding messageRAM address offsets:
  96:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     //1. The baseAddress will point to module's start address from the handle.
  97:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     //.baseAddress                    =(uint32)(can->can),
  98:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     //2. All Other offsets in messageRAM must be uniquely calculated for each node based on numb
  99:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 100:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     // Node 0 as receive node
 101:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     {
 102:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         IfxCan_Can_NodeConfig nodeConfig;
 103:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         IfxCan_Can_initNodeConfig(&nodeConfig, &can);
 104:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 105:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         // initialize Node 0
 106:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         nodeConfig.nodeId = IfxCan_NodeId_0;
 107:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         nodeConfig.clockSource = IfxCan_ClockSource_both;
 108:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 109:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         nodeConfig.frame.type = IfxCan_FrameType_receive;
 110:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 111:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         nodeConfig.filterConfig.standardListSize = 2;
 112:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 113:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         nodeConfig.messageRAM.standardFilterListStartAddress = 0x100 + NODE0_RAM_OFFSET;
 114:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         nodeConfig.messageRAM.rxBuffersStartAddress          = 0x200 + NODE0_RAM_OFFSET;
 115:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         //nodeConfig.messageRAM.baseAddress                    = MODULE_CAN0_RAM;// No longer ne
 116:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 117:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         // enable the required interrupts with respective to group interrupts configuration at m
 118:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         nodeConfig.interruptConfig.messageStoredToDedicatedRxBufferEnabled = TRUE;
 119:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 120:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         // Exercising the Internal Loopback mode (LBK) and LoopbackMode Out (LOUT) features:
 121:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         //Enable the Internal Loopback mode if the internal CAN bus has to be used for the loopb
 122:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         nodeConfig.busLoopbackEnabled = TRUE;
 123:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *      
 124:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         //Enable the LoopbackMode Out mode if the external CAN bus system ( i.e CAN_H and CAN_L)
 125:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         nodeConfig.busLoopbackOutEnabled = TRUE;
 126:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *      
 127:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         //Note: Both loopback modes can not be enabled at the same time. This particular configu
 128:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *      
 129:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         // initialize Node 0
 130:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         IfxCan_Can_initNode(&canNode[0], &nodeConfig);
 131:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     }
 132:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 133:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     // Node 1 as transmit node
 134:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     {
 135:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         IfxCan_Can_NodeConfig nodeConfig;
 136:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         IfxCan_Can_initNodeConfig(&nodeConfig, &can);
 137:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 138:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         nodeConfig.nodeId = IfxCan_NodeId_1;
 139:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         nodeConfig.clockSource = IfxCan_ClockSource_both;
 140:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 141:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         nodeConfig.frame.type = IfxCan_FrameType_transmit;
 142:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 143:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         nodeConfig.txConfig.dedicatedTxBuffersNumber = 2;
 144:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 145:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         nodeConfig.messageRAM.txBuffersStartAddress = 0x400 + NODE1_RAM_OFFSET;
 146:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         //nodeConfig.messageRAM.baseAddress           = MODULE_CAN0_RAM ; // No longer needed, d
 147:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 148:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *      // enable the required interrupts with respective to group interrupts configuration at modu
 149:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *      nodeConfig.interruptConfig.transmissionCompletedEnabled = TRUE;
 150:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 151:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         // initialize Node 1;
 152:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         IfxCan_Can_initNode(&canNode[1], &nodeConfig);
 153:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     }
 154:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * \endcode
 155:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 156:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * \subsection IfxLld_Can_Can_filter Filter Initialisation
 157:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 158:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * The filters can be set as following, number of filters can be chosen from nodeConfig.filterConfi
 159:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * based on the type of filter in the receive node configuration.
 160:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 161:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * For standard filters, configure the `stdType` field with the desired filter type from the `IfxCa
 162:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * For extended filters, configure the `xtdType` field with the desired filter type from the `IfxCa
 163:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * When configuring an extended filter, the `stdType` field is ignored and can be set to 0.
 164:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 165:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * \code
 166:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     // set filters
 167:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 168:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     // set filter for Rx Buffer 0
 169:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     {
 170:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         // Initialize the filter structure
 171:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         IfxCan_Filter filter;
 172:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 173:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         filter.number = 0;
 174:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         filter.elementConfiguration = IfxCan_FilterElementConfiguration_storeInRxBuffer;
 175:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         filter.stdType = IfxCan_StdFilterType_dualId; // Set filter type as needed
 176:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         filter.xtdType = 0; // Not used for standard filter
 177:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         filter.id1 = 0x00;
 178:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         filter.id2 = 0x00; // Set as needed for filter type
 179:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         filter.rxBufferOffset = IfxCan_RxBufferId_0;
 180:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         filter.txTimeStampEnabled = FALSE;
 181:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 182:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         IfxCan_Can_setStandardFilter(&canNode[0], &filter);
 183:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     }
 184:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 185:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     // set filter for rxBuffer 1
 186:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     {
 187:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         IfxCan_Filter filter;
 188:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 189:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         filter.number = 1;
 190:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         filter.elementConfiguration = IfxCan_FilterElementConfiguration_storeInRxBuffer;
 191:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         filter.stdType = IfxCan_StdFilterType_dualId; // Set filter type as needed
 192:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         filter.xtdType = 0; // Not used for standard filter
 193:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         filter.id1 = 0x7ff;
 194:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         filter.id2 = 0x7ff; // Set as needed for filter type
 195:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         filter.rxBufferOffset = IfxCan_RxBufferId_1;
 196:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         filter.txTimeStampEnabled = FALSE;
 197:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 198:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         IfxCan_Can_setStandardFilter(&canNode[0], &filter);
 199:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     }
 200:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * 
 201:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     // set extended filters
 202:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 203:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     // set filter for Extended ID
 204:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     {
 205:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         // Initialize the filter structure
 206:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         IfxCan_Filter filter;
 207:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 208:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         filter.number = 0;
 209:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         filter.elementConfiguration = IfxCan_FilterElementConfiguration_storeInRxFifo0; // Store
 210:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         filter.stdType = 0; // Not used for extended filter
 211:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         filter.xtdType = IfxCan_XtdFilterType_dualId; // Set filter type as needed
 212:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         filter.id1 = 0x1FFABCDE; // First extended ID to match
 213:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         filter.id2 = 0x1FFABCDE; // Second extended ID to match (set as needed for filter type)
 214:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         filter.rxBufferOffset = 0; // Not used for FIFO
 215:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         filter.txTimeStampEnabled = FALSE;
 216:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 217:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *         IfxCan_Can_setExtendedFilter(&canNode[0], &filter);
 218:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     }
 219:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * \endcode
 220:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 221:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * \subsection IfxLld_Can_Can_Synch Nodes Synchronization
 222:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * wait until the Node (M_CAN) is synchronised
 223:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 224:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * \code
 225:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     while (IfxCan_Can_isNodeSynchronized(&canNode[0]) != TRUE);
 226:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     while (IfxCan_Can_isNodeSynchronized(&canNode[1]) != TRUE);
 227:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * \endcode
 228:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 229:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * The CAN is ready for use now!
 230:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 231:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * \section IfxLld_Can_Can_StandardDataTransfers Standard Data Transfers
 232:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 233:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * The CAN driver provides simple to use transfer functions
 234:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 235:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * Data can be sent by the following way:
 236:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * \code
 237:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 238:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     //data that needs to be transmitted
 239:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     txData[0] = 0xC0CAC01A;
 240:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     txData[1] = 0xBA5EBA11;
 241:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 242:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     // Initialise the message structure with default values
 243:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     IfxCan_Message txMsg;
 244:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     IfxCan_Can_initMessage(&txMsg);
 245:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 246:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     // change the relevant members of message structure
 247:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     txMsg.bufferNumber = 0;
 248:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     txMsg.messageId = 0x0;
 249:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 250:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     // Transmit Data
 251:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     while( IfxCan_Can_sendMessage(&canNode[1], &txMsg, txData) == IfxCan_Status_notSentBusy );
 252:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * \endcode
 253:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 254:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * Data can be received by the following way:
 255:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  * \code
 256:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     // Receiving Data
 257:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 258:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     // Initial Rx values. It should be replaced by the received values
 259:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     rxData[0] = 0xdeaddead;
 260:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     rxData[1] = 0xdeaddead;
 261:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
 262:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     // Initialise the message structure with default values, will be replaced by the received va
 263:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     IfxCan_Message rxMsg;
 264:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *     IfxCan_Can_initMessage(&rxMsg);
 265:../Libraries/iLLD/TC4xx/Tricore/Can/Can/IfxCan_Can.h ****  *
