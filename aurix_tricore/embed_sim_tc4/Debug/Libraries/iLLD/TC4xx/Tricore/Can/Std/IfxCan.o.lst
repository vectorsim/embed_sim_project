 322:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.c ****     /*
 323:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.c ****      * Bit timing & sampling
 324:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.c ****      * Tq = (BRP+1)/Fcan if DIV8 = 0
 325:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.c ****      * Tq = 8*(BRP+1)/Fcan if DIV8 = 1
 326:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.c ****      * TSync = 1.Tq
 327:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.c ****      * TSeg1 = (TSEG1+1)*Tq                >= 3Tq
 328:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.c ****      * TSeg2 = (TSEG2+1)*Tq                >= 2Tq
 329:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.c ****      * Bit Time = TSync + TSeg1 + TSeg2    >= 8Tq
 330:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.c ****      *
