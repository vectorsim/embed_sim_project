 564:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * IfxPort_setPinState(&MODULE_P33, 0, IfxPort_State_toggled);
 565:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * IfxPort_setPinState(&MODULE_P33, 0, IfxPort_State_toggled);
 566:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \endcode
 567:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 568:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  */
 569:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** IFX_INLINE void IfxPort_setPinState(Ifx_P *port, uint8 pinIndex, IfxPort_State action);
