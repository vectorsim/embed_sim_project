 612:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** 
 613:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** /** \brief Disable the emergency stop function.
 614:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * This function disables the emergency stop function. A check is done on port functionality.
 615:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 616:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[inout] port     Pointer to the port which should be accessed.
 617:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[in]    pinIndex Specifies the pin for which the emergency stop function should be disable
 618:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 619:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \retval TRUE If the emergency stop function has been disabled.
 620:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *         FALSE If the emergency stop function could not be disabled.
 621:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 622:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * Coding example:
 623:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * /code
 624:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *     if( !IfxPort_disableEmergencyStop(&MODULE_P33, 0) )
 625:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *     {
 626:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *         // failed to disable emergency stop for P33.0
 627:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *     }
 628:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * /endcode
 629:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 630:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \see IfxPort_disableEmergencyStop(), IfxPort_resetESR()
 631:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 632:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  */
 633:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** IFX_EXTERN boolean IfxPort_disableEmergencyStop(Ifx_P *port, uint8 pinIndex);
 634:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** 
 635:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** /** \brief Enable the emergency stop function.
 636:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * This function enables the emergency stop function. A check is done on port functionality.
 637:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 638:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[inout] port     Pointer to the port which should be accessed.
 639:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[in]    pinIndex Specifies the pin for which the emergency stop function should be enabled
 640:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 641:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \retval TRUE If emergency stop function was successfully enabled.
 642:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *         FALSE If failed to enable the emergency stop function.
 643:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 644:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * Coding example:
 645:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \code
 646:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *     if( !IfxPort_enableEmergencyStop(&MODULE_P33, 0) ) {
 647:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *       // failed to enable emergency stop for P33.0
 648:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *     }
 649:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \endcode
 650:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 651:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \see IfxPort_disableEmergencyStop(), IfxPort_setESR()
 652:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 653:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  */
 654:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** IFX_EXTERN boolean IfxPort_enableEmergencyStop(Ifx_P *port, uint8 pinIndex);
 655:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** 
 656:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** /** \brief Disable the emergency stop function.
 657:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * This function disables the emergency stop function. No check is done on port functionality.
 658:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 659:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[inout] port     Pointer to the port which should be accessed.
 660:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[in]    pinIndex Specifies the pin for which the emergency stop function should be disable
 661:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 662:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \retval None
 663:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 664:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \see IfxPort_disableEmergencyStop()
 665:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 666:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  */
 667:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** IFX_EXTERN void IfxPort_resetESR(Ifx_P *port, uint8 pinIndex);
 668:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** 
 669:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** /** \brief Enable the emergency stop function.
 670:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * This function enables the emergency stop function. No check is done on port functionality.
 671:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 672:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[inout] port     Pointer to the port which should be accessed.
 673:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[in]    pinIndex Specifies the pin for which the emergency stop function should be enabled
 674:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 675:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \retval None
 676:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 677:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \see IfxPort_enableEmergencyStop()
 678:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 679:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  */
 680:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** IFX_EXTERN void IfxPort_setESR(Ifx_P *port, uint8 pinIndex);
 681:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** 
 682:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** /** \brief Configure the port input / output mode.
 683:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * Also Configures the P40/P41 Port for digital functionality.
 684:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * which by default support analog functionality.
 685:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 686:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[inout] port     Pointer to the port which should be accessed.
 687:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[in]    pinIndex Specifies the pin to be configured. Range: 0 to 15.
 688:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[in]    mode     Specifies the port pin mode. Range: \ref IfxPort_Mode.
 689:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 690:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \retval None
 691:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 692:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * Coding example:
 693:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \code
 694:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *     IfxPort_setPinMode(&MODULE_P33, 0, IfxPort_Mode_outputPushPullGeneral);
 695:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \endcode
 696:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 697:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  */
 698:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** IFX_EXTERN void IfxPort_setPinMode(Ifx_P *port, uint8 pinIndex, IfxPort_Mode mode);
 699:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** 
 700:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** /** \brief Configure the pad driver mode.
 701:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 702:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[inout] port      Pointer to the port which should be accessed.
 703:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[in]    pinIndex  Specifies the pin for which the mode will be set. Range: 0 to 15.
 704:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[in]    padDriver Specifies the driver mode. Range: \ref IfxPort_PadDriver.
 705:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 706:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \retval None
 707:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 708:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * Coding example:
 709:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \code
 710:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * // enable strong 3.3V driver
 711:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * IfxPort_setPinPadDriver(&MODULE_P33, 0, IfxPort_PadDriver_cmosAutomotiveSpeed1);
 712:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \endcode
 713:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 714:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  */
 715:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** IFX_EXTERN void IfxPort_setPinPadDriver(Ifx_P *port, uint8 pinIndex, IfxPort_PadDriver padDriver);
 716:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** 
 717:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** /** \brief Enable the Pin Controller Selection.
 718:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 719:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[inout] port     Pointer to the base of specified port's SFRs.
 720:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[in]    pinIndex Specifies the pin for which the mode has to be set. Range: 0 to 15.
 721:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 722:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \retval None
 723:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  */
 724:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** IFX_EXTERN void IfxPort_setPinControllerSelection(Ifx_P *port, uint8 pinIndex);
 725:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** 
 726:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** /** \brief Resets the pin controller selection to its default state.
 727:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 728:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[inout] port     Pointer to the base of specified port's SFRs.
 729:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[in]    pinIndex Specifies the pin for which the mode has to be set. Range: 0 to 15.
 730:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 731:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \retval None
 732:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  */
 733:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** IFX_EXTERN void IfxPort_resetPinControllerSelection(Ifx_P *port, uint8 pinIndex);
 734:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** 
 735:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** /** \brief Modifies the Pin Controller Selection.
 736:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 737:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[inout] port     Pointer to the base of specified port's SFRs.
 738:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[in]    pinIndex Specifies the pin for which the mode has to be set. Range: 0 to 15.
 739:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \param[in]    mode     Selects the controller for the port pin(Tricore,EVADC,GETH,SCR,HRPWM etc)
 740:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 741:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * 0-> normal function
 742:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * 1-> Alternate functionality(SCR pin,EVADC PDD,GETH RGMII/MII,HRPWM etc)
 743:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * Note:It is the Users responsibility to pass correct port, pin and mode inputs.
 744:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  *
 745:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * \retval None
 746:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  */
 747:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** IFX_EXTERN void IfxPort_modifyPinControllerSelection(Ifx_P *port, uint8 pinIndex, boolean mode);
 748:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** 
 749:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h **** /** \} */
