3752:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.h ****  *                     FALSE: Default value.
3753:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.h ****  *
3754:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.h ****  * \retval None
3755:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.h ****  */
3756:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.h **** IFX_EXTERN void IfxCan_Node_setStartExternalTimer(Ifx_CAN_N *node, boolean start);
