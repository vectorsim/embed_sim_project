 256:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * 9H corresponds to a value of 1.321V
 257:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * AH corresponds to a value of 1.302V
 258:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * BH corresponds to a value of 1.283V
 259:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * CH corresponds to a value of 1.266V
 260:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * DH corresponds to a value of 1.248V
 261:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * EH corresponds to a value of 1.231V
 262:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  * FH corresponds to a value of 1.215V
 263:../Libraries/iLLD/TC4xx/CpuGeneric/Port/Std/IfxPort.h ****  */
