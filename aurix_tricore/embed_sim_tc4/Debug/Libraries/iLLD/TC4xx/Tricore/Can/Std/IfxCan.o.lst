4013:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.h **** {
4014:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.h ****     uint32 code;
4015:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.h **** 
4016:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.h ****     if (dataLength <= 8)
4017:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.h ****     {
4018:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.h ****         code = dataLength;
4019:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.h ****     }
4020:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.h ****     else if (dataLength <= 24)
4021:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.h ****     {
4022:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.h ****         code = (dataLength >> 2) + 6;
4023:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.h ****     }
4024:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.h ****     else
4025:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.h ****     {
4026:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.h ****         code = (dataLength >> 4) + 11;
4027:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.h ****     }
4028:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.h **** 
4029:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.h ****     return (IfxCan_DataLengthCode)code;
4030:../Libraries/iLLD/TC4xx/Tricore/Can/Std/IfxCan.h **** }
