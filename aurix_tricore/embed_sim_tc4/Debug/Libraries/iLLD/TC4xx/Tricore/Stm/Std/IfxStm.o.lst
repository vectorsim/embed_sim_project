1280:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     __mtcr(CPU_CCTRL, cctrl.U);
1281:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** }
