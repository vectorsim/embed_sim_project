  30:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *
  31:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * The Stm Standard driver provides APIs to initialize, configure and control the Stm.
  32:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *
  33:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * In the following sections it will be described, how to integrate the driver into the application
  34:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *
  35:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * \section IfxLld_Stm_Preparation Preparation
  36:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * \subsection IfxLld_Stm_Include Include Files
  37:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *
  38:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * Include following header file into your C code:
  39:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * \code
  40:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * #include <Stm/Std/IfxStm.h>
  41:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * \endcode
  42:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *
  43:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * \subsection IfxLld_Stm_Variables Variables
  44:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *
  45:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * Declare STM variables :
  46:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * \code
  47:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * Ifx_CPU *stmSfr;
  48:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * IfxStm_CompareConfig stmConfig;
  49:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * \endcode
  50:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *
  51:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * \subsection IfxLld_Stm_Interrupt Interrupt Handler Installation
  52:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *
  53:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * See also \ref IfxLld_Cpu_Irq_Usage
  54:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *
  55:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * Define priorities for the Interrrupt handlers. This is normally done in the Ifx_IntPrioDef.h fil
  56:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * \code
  57:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * // priorities are normally defined in Ifx_IntPrioDef.h
  58:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * #define IFX_INTPRIO_STM0_SR0  10
  59:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * \endcode
  60:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *
  61:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * Add the interrupt service routines to your C code. They have to call the Stm interrupt handlers:
  62:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * please take care in choosing number of ticks, the below example code will raise an interrupt
  63:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * evry time the specified number of ticks have been elapsed.
  64:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * \code
  65:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * IFX_INTERRUPT(stm0Sr0ISR, 0, IFX_INTPRIO_STM0_SR0)
  66:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * {
  67:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *     IfxStm_clearCompareFlag(stmSfr, stmConfig.comparator);
  68:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *     IfxStm_increaseCompare(stmSfr, stmConfig.comparator, stmConfig.ticks);
  69:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * }
  70:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * \endcode
  71:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *
  72:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * Finally install the interrupt handlers in your initialisation function:
  73:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * \code
  74:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *     // install interrupt handlers
  75:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *     IfxCpu_Irq_installInterruptHandler(&stm0Sr0ISR, IFX_INTPRIO_STM0_SR0);
  76:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *     IfxCpu_enableInterrupts();
  77:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * \endcode
  78:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *
  79:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * \subsection IfxLld_Stm_Init Module Initialisation
  80:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *
  81:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * The STM module can be configured to generate an interrupt at every compare match of the selected
  82:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *
  83:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * The module initialisation can be done as followed.
  84:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *
  85:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * \code
  86:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *     stmSfr = &MODULE_STM0;
  87:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *
  88:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *     IfxStm_initCompareConfig(&stmConfig);
  89:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *
  90:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *     // configure to generate interrupt every 10 us
  91:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *     sint32 ticks = IfxStm_getTicksFromMicroseconds(10);
  92:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *
  93:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *     stmConfig.ticks = ticks;
  94:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *
  95:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *     stmConfig.triggerPriority = IFX_INTPRIO_STM0_SR0;
  96:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *     stmConfig.typeOfService = IfxSrc_Tos_cpu0;
  97:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *
  98:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *     IfxStm_initCompare(stmSfr, &stmConfig);
  99:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *
 100:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * \endcode
 101:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *
 102:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  * Now the Stm shall generate interrupts regularly based on the configured time !
 103:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****  *
