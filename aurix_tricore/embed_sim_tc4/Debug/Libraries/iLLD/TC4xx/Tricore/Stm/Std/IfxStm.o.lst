  79:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
  80:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief Convert local DSPR address to global DSPR address which can be accessed from the SRI bus
  81:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * Use this macro to convert a local DSPR address (in segment 0xd00.....) to
  82:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * a global DSPR address (in segment 0x700....., 0x600....., 0x500..... downwards) depending on
  83:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * the CPU number.
  84:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * Example usage:
  85:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *  \code
  86:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *     dmaChConfig.sourceAddress      = IFXCPU_GLB_ADDR_DSPR(IfxCpu_getCoreId(), &sourceBuffer[i][0
  87:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *     dmaChConfig.destinationAddress = IFXCPU_GLB_ADDR_DSPR(IfxCpu_getCoreId(), &destinationBuffer
  88:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *  \endcode
  89:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  */
  90:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** #define IFXCPU_GLB_ADDR_DSPR(cpu, address) ((((((unsigned)(address) & 0xF0000000) == 0xD0000000) ? 
  91:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
  92:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief Convert local PSPR address to global PSPR address which can be accessed from the SRI bus
  93:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * Use this macro to convert a local PSPR address (in segment 0xc......) to
  94:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * a global PSPR address (in segment 0x701....., 0x601....., 0x501..... downwards) depending on
  95:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * the CPU number.
  96:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
  97:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *   Example usage:
  98:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *   \code
  99:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *     dmaChConfig.sourceAddress      = IFXCPU_GLB_ADDR_PSPR(IfxCpu_getCoreId(), &sourceBufferInPsp
 100:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *     dmaChConfig.destinationAddress = IFXCPU_GLB_ADDR_PSPR(IfxCpu_getCoreId(), &destinationBuffer
 101:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *   \endcode
 102:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  */
 103:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** #define IFXCPU_GLB_ADDR_PSPR(cpu, address) ((((unsigned)(address) & 0x000fffff) | 0x70100000) - ((c
 104:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 105:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief Disable the all interrputs except master
 106:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  */
 107:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** #define IFXCPU_DISABLE_INTERRPUTS_OF_CPU(cpunum) \
 108:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     {                                            \
 109:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****         CPU##cpunum##_HRA_ICR.B.IE = 0;          \
 110:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****         while (CPU##cpunum##_HRA_ICR.B.IE)       \
 111:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****         {}                                       \
 112:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     }
 113:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
