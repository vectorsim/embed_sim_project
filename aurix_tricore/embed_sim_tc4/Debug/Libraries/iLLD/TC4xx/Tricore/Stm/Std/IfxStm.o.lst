1277:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     /*Enable the counters, set the counter mode */
1278:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     cctrl.B.CE = 1;
