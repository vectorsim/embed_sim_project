1096:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     else if (cpu > IfxCpu_ResourceCpu_none)
1097:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     {
1098:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****         module = (Ifx_CPU *)IfxCpu_cfg_indexMap[cpu].module;
1099:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     }
1100:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     else
1101:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     {
