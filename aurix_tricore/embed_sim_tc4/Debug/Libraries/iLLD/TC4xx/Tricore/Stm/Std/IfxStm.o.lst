1103:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     }
1104:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1105:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     return module;
