1207:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_INLINE void IfxCpu_initCSA(uint32 *csaBegin, uint32 *csaEnd)
1208:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** {
1209:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     uint32  k;
1210:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     uint32  nxt_cxi_val = 0;
1211:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     uint32 *prvCsa      = 0U;
1212:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     uint32 *nxtCsa      = csaBegin;
1213:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     uint32  numOfCsa    = (((uint32)csaEnd - (uint32)csaBegin) / 64U);
1214:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1215:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     for (k = 0; k < numOfCsa; k++)
1216:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     {
1217:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****         nxt_cxi_val = ((uint32)nxtCsa & (0XFU << 28)) >> 12 | ((uint32)nxtCsa & (0XFFFFU << 6)) >> 
1218:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1219:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****         if (k == 0)
1220:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****         {
1221:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****             __mtcr(CPU_FCX, nxt_cxi_val);   /* store the new pcxi value to LCX */
1222:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****         }
1223:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****         else
1224:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****         {
1225:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****             *prvCsa = nxt_cxi_val;  /* Store null pointer in last CSA (= very first time!) */
1226:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****         }
1227:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1228:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****         if (k == (numOfCsa - 3U))
1229:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****         {
1230:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****             __mtcr(CPU_LCX, nxt_cxi_val);   /* Last but 2 context save area is pointed in LCX to kn
1231:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****         }
1232:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1233:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****         prvCsa  = (uint32 *)nxtCsa;
1234:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****         nxtCsa += 16;           /* next CSA */
1235:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     }
1236:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1237:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     *prvCsa = 0;
1238:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** }
