1091:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1092:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     if (cpu == IfxCpu_ResourceCpu_6)
1093:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     {
1094:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****         module = &MODULE_CPUCS;
