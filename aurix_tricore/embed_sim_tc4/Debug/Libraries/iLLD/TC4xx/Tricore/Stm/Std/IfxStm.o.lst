 119:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
 120:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** /** \brief OCDS Trigger Bus Interface Selection
 121:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  */
 122:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** typedef enum
 123:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** {
 124:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     IfxSrc_OtgbBusSel_otgb0 = 0,  /**< \brief TriggerSet is output on OTGB0 */
 125:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     IfxSrc_OtgbBusSel_otgb1 = 1   /**< \brief TriggerSet is output on OTGB1 */
 126:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** } IfxSrc_OtgbBusSel;
 127:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
 128:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** /** \brief SRN index for interrupt triggers
 129:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****  */
 130:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** typedef enum
 131:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** {
 132:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     IfxSrc_OtgbSrnIndex_srnIndex0 = 0,  /**< \brief SRN index for interrupt trigger-0 */
 133:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     IfxSrc_OtgbSrnIndex_srnIndex1 = 1,  /**< \brief SRN index for interrupt trigger-1 */
 134:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     IfxSrc_OtgbSrnIndex_srnIndex2 = 2,  /**< \brief SRN index for interrupt trigger-2 */
 135:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h ****     IfxSrc_OtgbSrnIndex_srnIndex3 = 3   /**< \brief SRN index for interrupt trigger-3 */
 136:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** } IfxSrc_OtgbSrnIndex;
 137:../Libraries/iLLD/TC4xx/CpuGeneric/Src/Std/IfxSrc.h **** 
