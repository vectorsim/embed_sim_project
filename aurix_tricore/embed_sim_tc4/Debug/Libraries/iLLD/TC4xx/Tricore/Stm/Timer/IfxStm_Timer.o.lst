 787:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** {
 788:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     /* TODO  : Update with PROT */
 789:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     Ifx_CPU_STM_OCS  ocs;
 790:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     Ifx_CPU_STM_OCS *stmOcs = (Ifx_CPU_STM_OCS *)((uint32)cpu + (uint32)(IFXSTM_OCS_OFFSET));
 791:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 792:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     // remove protection and configure the suspend mode.
 793:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     ocs.B.SUS_P = 1;
 794:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     ocs.B.SUS   = mode;
 795:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     stmOcs->U   = ocs.U;
 796:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** }
