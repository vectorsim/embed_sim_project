 371:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief API to Check whether global interrupts are enabled on the CPU.
 372:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 373:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * This API provides the status of CPU where this API is called.
 374:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 375:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \return Status of global interrupt enable bit.
 376:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 377:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \retval TRUE:  Global interrupts enabled.
 378:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *		   FALSE: Global interrupts disabled.
 379:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  */
 380:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_INLINE boolean IfxCpu_areInterruptsEnabled(void);
 381:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 382:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief API to disable global interrupt and return the previous status.
 383:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 384:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * This API can be used only to disable the global interrupts of caller CPU. It cannot be
 385:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * used for this activity towards other CPUs.
 386:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 387:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \return Previous status of global interrupt enable bit.
 388:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 389:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \retval TRUE:  Previously, global interrupts enabled.
 390:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *		   FALSE: Previously, global interrupts disabled.
 391:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  */
 392:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_INLINE boolean IfxCpu_disableInterrupts(void);
 393:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 394:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief API to enable global interrupt.
 395:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * This API simply enables the global interrupt.
 396:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 397:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \retval None
 398:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  */
 399:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_INLINE void IfxCpu_enableInterrupts(void);
 400:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 401:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief API to Disable the Global Interrupts.
 402:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 403:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \retval None
