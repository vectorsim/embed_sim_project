 678:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     IfxClock_K3PreDivider_divBy1_0 = 0,  /**< \brief The 1.0 pre-divider between DCO and K3-Divider
 679:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     IfxClock_K3PreDivider_divBy1_1 = 1,  /**< \brief The 1.1 pre-divider between DCO and K3-Divider
 680:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     IfxClock_K3PreDivider_divBy1_2 = 2,  /**< \brief The 1.2 pre-divider between DCO and K3-Divider
 681:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     IfxClock_K3PreDivider_divBy1_4 = 4,  /**< \brief The 1.4 pre-divider between DCO and K3-Divider
 682:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     IfxClock_K3PreDivider_divBy1_6 = 6,  /**< \brief The 1.6 pre-divider between DCO and K3-Divider
