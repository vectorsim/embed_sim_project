  26:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *
  27:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *
  28:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  * The timer driver enables the generation of a periodical interrupt based on the STM module.
  29:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *
  30:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *    The driver is initialized with \ref IfxStm_Timer_init(). After initialization, the
  31:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *    timer is started with \ref IfxStm_Timer_run() and stopped with \ref IfxStm_Timer_stop().
  32:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *    Single shot can be set with \ref IfxStm_Timer_setSingleMode(), in case the timer is
  33:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *    already running it will stop after the next event, else the timer event will occur only once.
  34:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *
  35:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *    The timer interrupt must call the \ref IfxStm_Timer_acknowledgeTimerIrq() function which
  36:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *    clears the interrupt flag and set the next compare value.
  37:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *
  38:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *    Changing the period with \ref IfxStm_Timer_setPeriod() or \ref IfxStm_Timer_setFrequency() wi
  39:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *    take effect only after the next timer event.
  40:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *
  41:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *
  42:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *    This driver implements a subset of the functionalities defined by \ref library_srvsw_stdif_ti
  43:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *    It supports the timer with interrupt but not the trigger signal.
  44:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *
  45:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *    The user is free to use either the driver specific APIs below or to use the \ref library_srvs
  46:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *
  47:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *  \section Specific Specific implementation
  48:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *   For a detailed configuration of the microcontroller, see \ref IfxStm_Timer_init().
  49:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *
  50:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *  \section Example Usage example
  51:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *    Initialization and interrupt:
  52:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *  \code
  53:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *  #define ISR_PRIORITY_TIMER_1MS (2)
  54:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *  #define ISR_PROVIDER_TIMER_1MS IfxSrc_Tos_cpu0
  55:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *  #define INTERRUPT_TIMER_1MS    ISR_ASSIGN(ISR_PRIORITY_TIMER_1MS, ISR_PROVIDER_TIMER_1MS)
  56:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *
  57:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *  IfxStm_Timer myTimer;
  58:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *
  59:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *  boolean AppInit_1ms(void)
  60:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *  {
  61:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *      boolean                  result = TRUE;
  62:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *      Ifx_CPU *cpu;
  63:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *      cpu =  IfxCpu_getAddress(IfxCpu_getCoreIndex());
  64:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *      IfxStm_Timer_Config timerConfig;
  65:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *      IfxStm_Timer_initConfig(&timerConfig, cpu);
  66:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *      timerConfig.base.frequency       = 1000;
  67:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *      timerConfig.base.isrPriority     = ISR_PRIORITY(INTERRUPT_TIMER_1MS);
  68:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *      timerConfig.base.isrProvider     = ISR_PROVIDER(INTERRUPT_TIMER_1MS);
  69:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *      timerConfig.base.minResolution   = (1.0f / timerConfig.base.frequency) / 1000;
  70:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *      timerConfig.comparator           = IfxStm_Comparator_0;
  71:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *      result                           = IfxStm_Timer_init(&myTimer, &timerConfig);
  72:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *
  73:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *      return result;
  74:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *  }
  75:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *
  76:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *  IFX_INTERRUPT(ISR_TIMER_1ms, 0, ISR_PRIORITY_TIMER_1MS)
  77:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *  {
  78:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *      __enable();
  79:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *      IfxStm_Timer_acknowledgeTimerIrq(&myTimer);
  80:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *  }
  81:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *  \endcode
  82:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *
  83:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *    During run-time, the timer can be started / stopped as follow:
  84:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *  \code
  85:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *      IfxStm_Timer_run(&myTimer);
  86:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *      IfxStm_Timer_stop(&myTimer);
  87:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *  \endcode
  88:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *
  89:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  * \defgroup IfxLld_Stm_Timer STM Timer Interface
  90:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  * \ingroup IfxLld_Stm
