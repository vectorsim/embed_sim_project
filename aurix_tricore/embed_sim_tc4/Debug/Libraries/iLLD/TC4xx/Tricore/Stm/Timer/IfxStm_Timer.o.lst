   4:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  * \ingroup IfxLld_Stm
   5:../Libraries/iLLD/TC4xx/Tricore/Stm/Timer/IfxStm_Timer.h ****  *
