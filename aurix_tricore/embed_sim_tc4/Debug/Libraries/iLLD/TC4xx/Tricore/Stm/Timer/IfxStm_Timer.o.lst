1418:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** {
1419:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     Ifx_CPU_CCTRL cctrl;
1420:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     boolean       enableBit;
1421:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     /*Disable the counters */
1422:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     cctrl.U    = __mfcr(CPU_CCTRL);
1423:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     enableBit  = cctrl.B.CE;
1424:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     cctrl.B.CE = 0;
1425:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     __mtcr(CPU_CCTRL, cctrl.U);
1426:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1427:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     /*Update the counter value */
1428:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     count &= ~(1U << 31);       /*clear sticky overflow bit if set */
1429:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     __mtcr(address, count);
1430:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
1431:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     /*restore the enable bit */
1432:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     cctrl.B.CE = enableBit;
1433:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     __mtcr(CPU_CCTRL, cctrl.U);
1434:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** }
