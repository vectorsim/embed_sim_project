 718:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** IFX_INLINE uint64 IfxStm_getOffsetTimer(Ifx_CPU *cpu, uint8 offset)
 719:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** {
 720:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     uint64 now;
 721:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 722:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     now = IfxStm_get(cpu);
 723:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 724:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     return now >> offset;
 725:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** }
 726:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 727:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 728:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** IFX_INLINE uint64 IfxStm_getTicksFromMicroseconds(uint32 microSeconds)
 729:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** {
 730:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     uint64 freq = IfxStm_getFrequency();
 731:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     return (freq / (1000000)) * microSeconds;
 732:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** }
