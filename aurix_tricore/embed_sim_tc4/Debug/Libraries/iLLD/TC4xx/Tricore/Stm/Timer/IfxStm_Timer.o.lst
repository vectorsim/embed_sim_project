1255:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_INLINE boolean IfxCpu_isAddressCachable(void *address)
1256:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** {
