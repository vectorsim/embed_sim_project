 773:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** IFX_INLINE boolean IfxStm_isModuleSuspended(Ifx_CPU *cpu)
 774:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** {
 775:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     Ifx_CPU_STM_OCS  ocs;
 776:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     Ifx_CPU_STM_OCS *stmOcs = (Ifx_CPU_STM_OCS *)((uint32)cpu + (uint32)(IFXSTM_OCS_OFFSET));
 777:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 778:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     // read the status
 779:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     ocs.U = stmOcs->U;
 780:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 781:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     // return the status
 782:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     return ocs.B.SUSSTA;
 783:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** }
