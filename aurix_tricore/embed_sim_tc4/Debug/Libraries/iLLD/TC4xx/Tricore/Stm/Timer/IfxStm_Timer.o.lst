1199:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     {
1200:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****         ccnt.U = __mfcr(CPU_M3CNT);
1201:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****     }
1202:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
