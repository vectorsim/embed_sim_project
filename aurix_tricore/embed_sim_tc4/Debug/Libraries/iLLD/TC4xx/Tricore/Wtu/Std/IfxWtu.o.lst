  89:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h **** /** \brief WTU API to initialize WDT configuration structure - Constructor
  90:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  *   This API initialize the Wtu configuration structure to default values, these default
  91:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  *   values are for software specific, not necessarily hardware reset values.
  92:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  *   User must use this API call before IfxWtu_Init API call
  93:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  * \param config Wtu configuration structure to be initialized
  94:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  * \return None
  95:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  */
  96:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h **** IFX_EXTERN void IfxWtu_initConfig(IfxWtu_Config *config);
  97:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h **** 
  98:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h **** /** \brief WTU API to Initialize the CTRLA register based on the config structure pointer initialis
  99:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  * \param wtu_ctrla Pointer to the watchdog config0 register.
 100:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  * \param config Pointer to the WTU configuration structure containing initialization parameters.
 101:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  * \return None
 102:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  */
 103:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h **** IFX_EXTERN void IfxWtu_initConfig0Register(Ifx_WTU_CTRLA *wtu_ctrla, IfxWtu_Config *config);
 104:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h **** 
 105:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h **** /** \brief WTU API to Initialize the CTRLB register based on the config structure pointer initialis
 106:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  * \param wtu_ctrlb Pointer to the watchdog config1 register.
 107:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  * \param config Pointer to the WTU configuration structure containing initialization parameters.
 108:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  * \return None
 109:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  */
 110:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h **** IFX_EXTERN void IfxWtu_initConfig1Register(Ifx_WTU_CTRLB *wtu_ctrlb, IfxWtu_Config *config);
 111:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h **** 
 112:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h **** /** \brief WTU API to Initialize the CPU watchdog with the specified configuration.
 113:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  *
 114:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  *   This API initialize the Wtu software driver and corresponding CPU WDT hardware module.
 115:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  *   User can configure project specific Watchdog password, Watchdog timer period and other setting
 116:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  *   with this interface.
 117:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  *   API corresponds to one instance of the hardware module.
 118:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  *   User must use this API call for each instance of the WDT hardware module used.
 119:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  * \param wtu Reference to register map of CPU WTU hardware instance.
 120:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  * \param config Wtu configuration structure for initialisation.
 121:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  * \return None
 122:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  */
 123:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h **** IFX_EXTERN void IfxWtu_initCpuWatchdog(Ifx_WTU_WDTCPU *wtu, IfxWtu_Config *config);
 124:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h **** 
 125:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h **** /** \brief Initializes the security watchdog with the specified configuration.
 126:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  *
 127:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  *   This API initialize the Wtu software driver and corresponding security WDT hardware module.
 128:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  *   User can configure project specific Watchdog password, Watchdog timer period and other setting
 129:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  *   with this interface.
 130:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  *   API corresponds to one instance of the hardware module.
 131:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  *   User must use this API call for each instance of the WDT hardware module used.
 132:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  * \param wtu Pointer to the WTU instance to be initialized.
 133:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  * \param config WTU Config Structure for initialisation.
 134:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  * \return None
 135:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  */
 136:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h **** IFX_EXTERN void IfxWtu_initSecurityWatchdog(Ifx_WTU_WDTSEC *wtu, IfxWtu_Config *config);
 137:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h **** 
 138:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h **** /** \brief Initializes the system watchdog with the specified configuration.
 139:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  *
 140:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  *   This API initialize the Wdt software driver and corresponding system WDT hardware module.
 141:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  *   User can configure project specific Watchdog password, Watchdog timer period and other setting
 142:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  *   with this interface.
 143:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  *   API corresponds to one instance of the hardware module.
 144:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  *   User must use this API call for each instance of the WDT hardware module used.
 145:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  * \param wtu Pointer to the WTU instance to be initialized.
 146:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  * \param config WTU Config Structure for initialisation.
