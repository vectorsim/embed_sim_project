  64:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h **** /** \brief Configuration structure for Watchdog Timer Uint.
  65:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  * IfxWtu_Config is a type describing configuration structure of Safety WTU registers defined in If
  66:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****  */
  67:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h **** typedef struct
  68:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h **** {
  69:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****     uint16      password;                            /**< \brief password for access to WTUxCTRLA r
  70:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****     uint16      reload;                              /**< \brief WTU reload value */
  71:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****     IfxWtu_IFSR inputFrequency;                      /**< \brief input frequency of the WTU */
  72:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****     boolean     disableWatchdog;                     /**< \brief Disable Request Control Bit */
  73:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****     boolean     enableSmuRestriction;                /**< \brief Unlock Restriction Request Control
  74:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****     boolean     enableAutomaticPasswordChange;       /**< \brief Password Auto-sequence Request Bit
  75:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****     boolean     enableTimerCheck;                    /**< \brief Counter Check Request Bit */
  76:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****     boolean     enableTimerCheckTolerance;           /**< \brief Timer Check Tolerance Request */
  77:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****     uint8       TimerCheckToleranceValue;            /**< \brief Timer Check Tolerance Value */
  78:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****     boolean     clrInternalResetFlag;                /**< \brief Clear Internal Reset Flag */
  79:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h ****     uint16      TCVI;                                /**< \brief watchdog virtual timer guess value
  80:../Libraries/iLLD/TC4xx/Tricore/Wtu/Std/IfxWtu.h **** } IfxWtu_Config;
