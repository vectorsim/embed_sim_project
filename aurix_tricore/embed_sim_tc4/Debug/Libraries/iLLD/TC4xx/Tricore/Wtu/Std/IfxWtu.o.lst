  80:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief Convert local DSPR address to global DSPR address which can be accessed from the SRI bus
  81:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * Use this macro to convert a local DSPR address (in segment 0xd00.....) to
  82:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * a global DSPR address (in segment 0x700....., 0x600....., 0x500..... downwards) depending on
  83:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * the CPU number.
  84:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * Example usage:
  85:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *  \code
  86:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *     dmaChConfig.sourceAddress      = IFXCPU_GLB_ADDR_DSPR(IfxCpu_getCoreId(), &sourceBuffer[i][0
  87:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *     dmaChConfig.destinationAddress = IFXCPU_GLB_ADDR_DSPR(IfxCpu_getCoreId(), &destinationBuffer
  88:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *  \endcode
  89:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  */
  90:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** #define IFXCPU_GLB_ADDR_DSPR(cpu, address) ((((((unsigned)(address) & 0xF0000000) == 0xD0000000) ? 
  91:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
  92:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief Convert local PSPR address to global PSPR address which can be accessed from the SRI bus
