 333:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** /** \brief Fetch current password of CPU Watchdog module.
 334:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****  *
 335:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****  * This API will fetch current Watchdog password for CPU WDT Hardware module.
 336:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****  * password is needed to be passed with most of the WDT APIs.
 337:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****  * \param watchdog pointer to the watchdog register map of CPU WDT hardware instance
 338:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****  * \return password Existing (Application specific) password for the Watchdog module.
 339:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****  */
 340:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** extern unsigned short Ifx_Ssw_getCpuWatchdogPassword(Ifx_WTU_WDTCPU *watchdog);
 341:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** 
 342:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** /** \brief Fetch current password of Safety Watchdog module.
 343:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****  *
 344:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****  * This API will fetch current Watchdog password for Safety WDT Hardware module.
 345:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****  * password is needed to be passed with most of the WDT APIs.
 346:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****  * \return password Existing (Application specific) password for the Watchdog module.
 347:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****  */
 348:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** extern unsigned short Ifx_Ssw_getSafetyWatchdogPassword(void);
 349:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** 
 350:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** /** \brief Fetch current password of Security(CSRM) Watchdog module.
 351:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****  *
 352:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****  * This API will fetch current Watchdog password for Security WDT Hardware module.
 353:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****  * password is needed to be passed with most of the WDT APIs.
 354:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****  * \return password Existing (Application specific) password for the Watchdog module.
 355:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****  */
 356:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** extern unsigned short Ifx_Ssw_getSecurityWatchdogPassword(void);
 357:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** 
 358:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** /** \brief Disable CPU Watchdog functionality.
 359:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****  *
 360:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****  * This API will disable Watchdog functionality of CPU WDT Hardware module. The Watchdog timers wil
 361:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****  * after this API call.
 362:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****  * \param watchdog pointer to the watchdog register map of CPU WDT hardware instance
 363:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****  * \param password Existing (Application specific) password for the Watchdog module.
