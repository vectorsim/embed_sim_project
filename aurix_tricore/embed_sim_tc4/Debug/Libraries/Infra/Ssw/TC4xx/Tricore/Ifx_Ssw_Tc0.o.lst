 145:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c **** 
 146:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c **** #if defined(__TASKING__)
 147:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c **** __asm("\t .extern core0_main");
 148:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c **** #endif
 149:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c **** 
 150:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c **** static void __StartUpSoftware(void)
 151:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c **** {
 152:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c ****     /* By default mapped to empty, skip only if configured */
 153:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c ****     IFX_CFG_SSW_SKIP_STARTUP_ROUTINE(0);
 154:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c **** 
 155:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c ****     /* Trap vector table initialization is necessary if it is not same as default value */
 156:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c ****     Ifx_Ssw_MTCR(CPU_BTV, (unsigned int)__TRAPTAB(0));
 157:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c **** 
 158:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c **** #ifndef DEVICE_TC45X
 159:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c ****     /* Point the FCX to PSPR needed for disabling virtualization */
 160:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c ****     Ifx_Ssw_MTCR(CPU_FCX, IFX_CFG_SSW_CSA_PTR(IFX_CFG_SSW_CSA_BOOT_PTR_START));
 161:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c **** 
 162:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c ****     Ifx_Ssw_disableVirtualization_Cpu0();
 163:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c **** 
 164:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c ****     /* Re-Initialize the BTV to the HRA context post disabling virtualization */
 165:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c ****     Ifx_Ssw_MTCR(CPU_BTV, (unsigned int)__TRAPTAB(0));
 166:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c **** #endif /* #ifndef DEVICE_TC45X */
 167:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c **** 
 168:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c ****     /*Initialize the context save area for CPU0. Function Calls Possible */
 169:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c ****     /* Setup the context save area linked list to PSPR */
 170:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c ****     Ifx_Ssw_initCSA((unsigned int *)IFX_CFG_SSW_CSA_BOOT_PTR_START, (unsigned int *)IFX_CFG_SSW_CSA
 171:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c **** 
 172:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c ****     /* Set the PSW to its reset value in case of a warm start,clear PSW.IS */
 173:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c ****     Ifx_Ssw_MTCR(CPU_PSW, IFX_CFG_SSW_PSW_DEFAULT);
 174:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c **** 
 175:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c ****     /* Initialize A1 pointer to use the global constants with small data addressing */
 176:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c ****     Ifx_Ssw_setAddressReg(a1, __SDATA2(0));
 177:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c ****     /* Set A0 Pointer to access global variables with small data addressing */
 178:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c ****     Ifx_Ssw_setAddressReg(a0, __SDATA1(0));
 179:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c ****     /* These to be un commented if A8 and A9 are required to be initialized */
 180:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c ****     Ifx_Ssw_setAddressReg(a8, __SDATA3(0));
 181:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c ****     Ifx_Ssw_setAddressReg(a9, __SDATA4(0));
