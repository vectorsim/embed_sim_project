 109:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** typedef volatile union
 110:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** {
 111:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h ****     unsigned char      *ucPtr;
 112:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h ****     unsigned short     *usPtr;
 113:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h ****     unsigned int       *uiPtr;
 114:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h ****     unsigned long long *ullPtr;
 115:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h **** } Ifx_Ssw_CTablePtr;
