 176:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc3.c ****         int status= core3_main();        /* Call main function of CPU3 */
 177:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc3.c ****         volatile unsigned int tempVar = ((unsigned int)&__ENABLE_INDIVIDUAL_C_INIT_CPU3);
 178:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc3.c ****         if (tempVar != 0U)
 179:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc3.c ****         {
 180:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc3.c ****           Ifx_Ssw_doCppExit(status);
 181:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc3.c ****         }
 182:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc3.c ****         else
 183:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc3.c ****         {
 184:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc3.c ****           (void)status;	/* Added to avoid "Unused parameter warning" */
 185:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc3.c ****         }
 186:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc3.c ****     }
 187:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc3.c **** #else /* IFX_CFG_SSW_RETURN_FROM_MAIN */
 188:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc3.c ****     extern void core3_main(void);
 189:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc3.c ****     Ifx_Ssw_jumpToFunction(core3_main);  /* Jump to main function of CPU2 */
 190:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc3.c **** #endif /* IFX_CFG_SSW_RETURN_FROM_MAIN */
 191:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc3.c **** 
 192:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc3.c ****     /* Go into infinite loop, normally the code shall not reach here */
 193:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc3.c ****     Ifx_Ssw_infiniteLoop();
 194:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc3.c **** }
