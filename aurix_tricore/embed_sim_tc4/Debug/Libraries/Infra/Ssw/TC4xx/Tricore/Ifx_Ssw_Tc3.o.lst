 591:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** #if (IFX_PROT_ENABLED == 1U)
 592:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** /** \brief Get the state for the corresponding PROT. 
 593:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** */
 594:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** IFX_SSW_INLINE IfxSswProt_State IfxSswProt_getState(volatile Ifx_PROT_PROT *protReg)
 595:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** {
 596:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     return (IfxSswProt_State)(protReg->B.STATE);
