 663:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****         break;
 664:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     default:
 665:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****         status = IfxSswProt_Status_inValidStateTransition;
 666:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****         break;
 667:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     }
