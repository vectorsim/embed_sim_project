 599:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** /** \brief Configure the state for the corresponding PROT. 
 600:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** */
 601:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** IFX_SSW_INLINE IfxSswProt_Status IfxSswProt_setState(volatile Ifx_PROT_PROT *protReg, IfxSswProt_St
 602:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** {
 603:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     IfxSswProt_Status status       = IfxSswProt_Status_success;
 604:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     IfxSswProt_State  currentState = IfxSswProt_getState(protReg);
 605:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     Ifx_PROT_PROT    prot;
 606:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     prot.U = protReg->U;
 607:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** 
 608:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     /* TODO Owner check to be implemented */
 609:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     switch (currentState)
 610:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     {
 611:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     case IfxSswProt_State_init:
 612:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** 
 613:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****         if (((state == IfxSswProt_State_run) || (state == IfxSswProt_State_runLock)) && !(protReg->
 614:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****         {
 615:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****             status = IfxSswProt_Status_initState;
 616:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****         }
 617:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****         else if ((state == IfxSswProt_State_config) || (state == IfxSswProt_State_configSec) || (st
 618:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****         {
 619:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****             status = IfxSswProt_Status_inValidStateTransition;
 620:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****         }
 621:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** 
 622:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****         break;
 623:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     case IfxSswProt_State_config:
 624:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** 
 625:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****         if (state != IfxSswProt_State_run)
 626:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****         {
 627:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****             status = IfxSswProt_Status_inValidStateTransition;
 628:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****         }
 629:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** 
 630:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****         break;
 631:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     case IfxSswProt_State_configSec:
 632:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** 
 633:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****         if (state != IfxSswProt_State_checkSec)
 634:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****         {
 635:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****             status = IfxSswProt_Status_inValidStateTransition;
 636:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****         }
 637:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** 
 638:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****         break;
 639:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     case IfxSswProt_State_checkSec:
 640:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****         status = IfxSswProt_Status_inValidStateTransition;
 641:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****         break;
 642:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     case IfxSswProt_State_run:
 643:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** 
 644:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****         if ((state != IfxSswProt_State_config) && (state != IfxSswProt_State_runLock))
 645:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****         {
 646:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****             status = IfxSswProt_Status_inValidStateTransition;
 647:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****         }
 648:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** 
 649:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****         break;
 650:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     case IfxSswProt_State_runSec:
