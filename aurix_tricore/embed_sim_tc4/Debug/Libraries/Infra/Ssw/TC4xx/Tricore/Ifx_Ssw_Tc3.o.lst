 659:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****         status = IfxSswProt_Status_inValidStateTransition;
 660:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****         break;
