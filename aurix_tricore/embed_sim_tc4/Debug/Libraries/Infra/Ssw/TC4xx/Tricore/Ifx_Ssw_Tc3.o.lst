 510:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** IFX_SSW_INLINE unsigned short Ifx_Ssw_getCpuWatchdogPasswordInline(Ifx_WTU_WDTCPU *watchdog)
 511:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** {
 512:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     unsigned short password = 0;
 513:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     /* Read Password from CTRLA register
 514:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****      * When read bottom six bit of password are inverted so we have
 515:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****      * to toggle them before returning password */
 516:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     password  = watchdog->CTRLA.B.PW;
 517:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     password ^= IFX_SSW_WDT_PASSWORD_INVERT_MSK;
 518:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     return password;
 519:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** }
 520:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** 
 521:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** 
 522:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** IFX_SSW_INLINE unsigned short Ifx_Ssw_getSystemWatchdogPasswordInline(void)
 523:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** {
 524:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     unsigned short  password = 0;
 525:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     Ifx_WTU_WDTSYS *watchdog = &MODULE_WTU.WDTSYS;
 526:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** 
 527:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     /* Read Password from Safety WDT CTRLA register
 528:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****      * When read bottom six bit of password are inverted so we have
 529:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****      * to toggle them before returning password */
 530:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     password  = watchdog->CTRLA.B.PW;
 531:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     password ^= IFX_SSW_WDT_PASSWORD_INVERT_MSK;
 532:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     return password;
 533:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** }
 534:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** 
 535:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** 
 536:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** IFX_SSW_INLINE unsigned short Ifx_Ssw_getSecurityWatchdogPasswordInline(void)
 537:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** {
 538:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     unsigned short password = 0;
 539:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     Ifx_WTU_WDTSEC *watchdog = &MODULE_WTU.WDTSEC;
 540:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** 
 541:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     /* Read Password from Safety WDT CTRLA register
 542:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****      * !!! NOTE: !!! when read bottom six bit of password are inverted so we have
 543:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****      * to toggle them before returning password */
 544:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     password  = watchdog->CTRLA.B.PW;
 545:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     password ^= IFX_SSW_WDT_PASSWORD_INVERT_MSK;
 546:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** 
 547:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     return password;
 548:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** }
 549:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** 
 550:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** 
 551:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** IFX_SSW_INLINE unsigned char Ifx_Ssw_isApplicationReset(void)
 552:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** {
 553:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     unsigned char status = 0U;
 554:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** 
 555:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     status = SMM_RSTSTATH.B.APPRST;
 556:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** 
 557:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     return status;
 558:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h **** }
