 669:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     if (status != IfxSswProt_Status_inValidStateTransition)
 670:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****     {
 671:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****         prot.B.SWEN  = 1U;
 672:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****         prot.B.STATE = state;
