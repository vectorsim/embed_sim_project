 653:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****         {
 654:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****             status = IfxSswProt_Status_inValidStateTransition;
 655:../Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.h ****         }
