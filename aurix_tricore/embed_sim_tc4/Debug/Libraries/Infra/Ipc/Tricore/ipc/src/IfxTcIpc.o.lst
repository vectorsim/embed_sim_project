 118:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 
 119:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** /*
 120:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c ****  * Request execution of an OpenCL kernel on PPU.
 121:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c ****  * Return 0 for success, 1 and above otherwise
 122:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c ****  */
 123:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** IfxMailbox_Status IfxTcIpc_Rpc(unsigned int id, unsigned int num_args, int *args[])
 124:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** {
 125:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 	int coreid = IfxCpu_getCoreId();
 126:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 	unsigned int status = 0U;
 127:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 	volatile IfxMailbox *mbx = (IfxMailbox *)(mailbox_pointers[coreid]);
 128:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 
 129:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 	status = IfxCpu_acquireMutex(&resourceLock);
 130:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 	if(status)
 131:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 	{
 132:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** #if (IFX_VP_DEBUG_PRINT == 1U)
 133:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 		   printfTri ("\n Tricore log: Lock acquired by Tricore%d\n",coreid);
 134:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** #endif
 135:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 		   /* Submit a command if the mailbox is empty */
 136:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 		   if(mbx->command == IfxMailbox_Command_none)
 137:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 		   {
 138:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			   mbx->id = id;
 139:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			   mbx->num_args = num_args;
 140:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 
 141:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			   for(int i=0;i<num_args;i++)
 142:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			   {
 143:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 				   mbx->args[i] = (args[i]);
 144:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			   }
 145:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 
 146:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    /* Signal the PPU */
 147:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    mbx->command = IfxMailbox_Command_new;
 148:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 
 149:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			#if !defined(S2C_INTERRUPT_NOTIFICATION)
 150:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    /* POLL until PPU confirms that the request has been completed */
 151:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    while( ((mbx->status) != IfxMailbox_Status_successful) && ((mbx->status) != IfxMailbox_Statu
 152:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    {
 153:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			      /* NOP */
 154:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    }
 155:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			#endif
 156:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 
 157:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			#if defined(S2C_INTERRUPT_NOTIFICATION)
 158:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 				unsigned int * krnl_execution_complete = NULL_PTR;
 159:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    switch(coreid)
 160:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    {
 161:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    	case 0:
 162:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    		krnl_execution_complete = &krnl_execution_complete0;
 163:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    		break;
 164:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** #if (IFXCPU_NUM_SAFE_MODULES >= 2U)
 165:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    	case 1:
 166:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    		krnl_execution_complete = &krnl_execution_complete1;
 167:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    		break;
 168:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** #endif
 169:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** #if (IFXCPU_NUM_SAFE_MODULES >= 3U)
 170:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    	case 2:
 171:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    		krnl_execution_complete = &krnl_execution_complete2;
 172:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    		break;
 173:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** #endif
 174:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** #if (IFXCPU_NUM_SAFE_MODULES >= 4U)
 175:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    	case 3:
 176:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    		krnl_execution_complete = &krnl_execution_complete3;
 177:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    		break;
 178:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** #endif
 179:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** #if (IFXCPU_NUM_SAFE_MODULES >= 5U)
 180:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    	case 4:
 181:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    		krnl_execution_complete = &krnl_execution_complete4;
 182:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    		break;
 183:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** #endif
 184:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** #if (IFXCPU_NUM_SAFE_MODULES >= 6U)
 185:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    	case 5:
 186:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    		krnl_execution_complete = &krnl_execution_complete5;
 187:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    		break;
 188:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** #endif
 189:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    	default:
 190:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    		break;
 191:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    }
 192:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 
 193:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    while(*krnl_execution_complete == 0U)
 194:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    {
 195:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    	__nop();
 196:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    }
 197:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			    *krnl_execution_complete = 0U;
 198:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			#endif
 199:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 
 200:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			   /* Clear the command and return the status of execution */
 201:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			   status = mbx->status;
 202:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			   mbx->status = IfxMailbox_Status_requestDone;
 203:../Libraries/Infra/Ipc/Tricore/ipc/src/IfxTcIpc.c **** 			   mbx->command = IfxMailbox_Command_none;
