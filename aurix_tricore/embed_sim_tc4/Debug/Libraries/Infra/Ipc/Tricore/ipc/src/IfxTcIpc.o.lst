1003:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_INLINE boolean IfxCpu_disableInterrupts(void)
1004:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** {
