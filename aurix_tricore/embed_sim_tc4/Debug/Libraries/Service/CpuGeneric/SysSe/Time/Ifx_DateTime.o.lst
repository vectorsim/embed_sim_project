 774:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief Generates a random value within a specified range using the provided seed.
 775:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 776:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[inout] seed Pointer to the seed value used for random number generation. The seed is upda
 777:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in]    min  The minimum value (inclusive) of the range from which the random number will 
 778:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in]    max  The maximum value (exclusive) of the range from which the random number will 
 779:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 780:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \retval uint32 A random value within the range [min, max].
 781:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  */
 782:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_EXTERN uint32 IfxCpu_getRandomValueWithinRange(uint32 *seed, uint32 min, uint32 max);
 783:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 784:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief This function waits till all the cores have set their corresponding bits in the event. T
 785:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * IfxCpu_emitEvent() are used to achieve the synchronisation between the configured cores. 
 786:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * The IfxCpu_emitEvent() is to be used in the Main functions of the Cores where the user wants to 
 787:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 788:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 789:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * Note: 
 790:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * The user has to explicitly set the constant core's mask value to check the synchronisation betwe
 791:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * Core id values read from CORE_ID register will be as shown below. 
 792:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * The value indicates the position of the bit needs to be set for the core mask parameter expected
 793:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * 
 794:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * Core 0: 0
 795:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * Core 1: 1
 796:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * Core 2: 2
 797:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * Core 3: 3
 798:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * Core 4: 4
 799:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * Core 5: 6
 800:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  
 801:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * e.g:
 802:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * 1. Check for synchronisation between core 0 and core 5
 803:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * expectedCoreMask = 0x21U
 804:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 805:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * 2. Check for synchronisation between core 0 to core 5
 806:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * expectedCoreMask = 0x3FU
 807:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 808:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * 3. Check for synchronisation between core 2 and core 4
 809:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * expectedCoreMask = 0x14U
 810:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 811:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * 4. Check for synchronisation between core 2 to core 4
 812:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * expectedCoreMask = 0x1CU
 813:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 814:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in] event           Synchronous Event
 815:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in] timeoutMilliSec Timeout in millisec. Range: 0 to 0xFFFFFFFF.
 816:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in] expectedCoreMask Core Mask values. Range: 0 to 0x3F
 817:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 818:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \retval Error condition.
 819:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 820:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * The functions IfxCpu_waitEvent and IfxCpu_emitEvent are used to achieve synchronisation between 
 821:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 822:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \code
 823:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * // Global variable. preferably located in  shared memory.
 824:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * IfxCpu_syncEvent event;
 825:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * boolean errorVal;
 826:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 827:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * // Below code should be repeated in Each core
 828:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 829:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * // Upon reaching Synchonisation point
 830:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * const uint8 expectedCoreMask = 0x3FU;
 831:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * IfxCpu_emitEvent(&event);
 832:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * errorVal = IfxCpu_waitEvent(&event, timeoutMilliSec, expectedCoreMask); // timeoutMilliSec is ti
 833:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 834:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \endcode
 835:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 836:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  */
 837:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_EXTERN boolean IfxCpu_waitEvent(IfxCpu_syncEvent *event, uint32 timeoutMilliSec, const uint8 ex
 838:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 839:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief This function sets a bit corresponding to the core in the event.
 840:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 841:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in] event Synchronous Event.
