 131:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** /******************************************************************************/
 132:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** /*-----------------------------------Macros-----------------------------------*/
 133:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** /******************************************************************************/
 134:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 135:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** #ifndef IFXSTM_DEFAULT_TIMER
 136:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** #define IFXSTM_DEFAULT_TIMER       (&MODULE_CPU0)
 137:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** #endif
 138:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 139:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** #ifndef ON_AURIX_VP
 140:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** #define ON_AURIX_VP       0
