 142:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 143:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** #define IFXSTM_RELTIMER_OFFSET     (0x0138U)
 144:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 145:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** #define IFXSTM_CMP0_OFFSET         (0x0120U)
 146:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 147:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** #define IFXSTM_CMP1_OFFSET         (0x0124U)
 148:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 149:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** #define IFXSTM_CMCON_OFFSET        (0x0128U)
 150:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 151:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** #define IFXSTM_ICR_OFFSET          (0x012CU)
 152:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
 153:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** #define IFXSTM_ISCR_OFFSET         (0x0130U)
 154:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** 
