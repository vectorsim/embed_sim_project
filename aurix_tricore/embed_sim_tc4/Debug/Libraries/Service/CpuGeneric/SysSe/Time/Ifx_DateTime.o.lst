 542:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief API to Check if the instruction counter has a sticky overflow.
 543:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 544:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * This API can be used to get sticky overflow bit of Instruction counter of only the caller CPU.
 545:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * It cannot be used for this activity towards other CPUs.
 546:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * This API also clears the sticky overflow after the read. While reading the sticky bit this API d
 547:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * the counter for short time. (otherwise sticky bit cannot be cleared). This API shall be used aft
 548:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 549:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \return Status of sticky overflow bit.
 550:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 551:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \retval TRUE:  Sticky overflow bit is set.
 552:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *         FALSE: Sticky overflow bit is reset.
 553:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  */
 554:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_INLINE boolean IfxCpu_getInstructionCounterStickyOverflow(void);
 555:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 556:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief API to read the current value of a performance counter.
 557:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 558:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in] address The address or identifier of the performance counter to be read. Range: 0 to 
 559:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 560:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \retval uint32 Counter value. Range: 0 to 0x7FFFFFFF.
 561:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  */
 562:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** IFX_INLINE uint32 IfxCpu_getPerformanceCounter(uint16 address);
 563:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** 
 564:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h **** /** \brief API to get sticky overflow bit of performance counter for the CPU, which calls this API.
 565:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * This is generic function to get sticky overflow bit of any performance counters.
 566:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  *
 567:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu.h ****  * \param[in] address The address of the performance counter to check. Range: 0 to 0xFFFF
