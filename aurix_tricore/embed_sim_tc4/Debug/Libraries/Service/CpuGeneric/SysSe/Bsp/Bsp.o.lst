 547:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu_IntrinsicsGcc.h **** #if (__TRICORE_CORE__ == 0x162)
 548:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu_IntrinsicsGcc.h **** #define Ifx__hvcall(hvcno) \
 549:../Libraries/iLLD/TC4xx/Tricore/Cpu/Std/IfxCpu_IntrinsicsGcc.h **** switch (hvcno) \
