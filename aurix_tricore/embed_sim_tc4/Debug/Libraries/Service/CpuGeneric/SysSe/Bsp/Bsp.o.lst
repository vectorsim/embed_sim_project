 132:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
 133:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *       //
 134:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *       // fPLL3 = N * fIN / P * K4 * 1. 0 -> K4PREDIV = 0
 135:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *       // fPLL3 = N * fIN / P * K4 * 2. 0 -> K4PREDIV = 1
 136:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *       // fPLL3 = N * fIN / P * K4 * 1. 2 -> K4PREDIV = 2
