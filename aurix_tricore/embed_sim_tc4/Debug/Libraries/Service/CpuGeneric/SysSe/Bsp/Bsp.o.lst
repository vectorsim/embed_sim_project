 283:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
 284:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** #define IFXCLOCK_LOOP_TIMEOUT_CHECK(tVar, tErr) \
 285:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     {                                           \
 286:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****         if (((sint32)--tVar) <= 0)              \
 287:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****         {                                       \
 288:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****             tErr = (uint8)1;                    \
 289:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****             break;                              \
 290:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****         }                                       \
 291:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****         else                                    \
 292:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****         {                                       \
 293:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****         }                                       \
 294:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     }
