 125:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** /** \brief Restore the state of the global interrupts.
 126:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 127:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \param enabled if TRUE, re-enable the global interrupts, else do nothing.
 128:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 129:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \return None.
 130:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 131:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \see areInterruptsEnabled(), disableInterrupts()
 132:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  */
 133:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** IFX_INLINE void restoreInterrupts(boolean enabled)
 134:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** {
 135:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     IfxCpu_restoreInterrupts(enabled);
 136:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** }
 137:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** #endif
