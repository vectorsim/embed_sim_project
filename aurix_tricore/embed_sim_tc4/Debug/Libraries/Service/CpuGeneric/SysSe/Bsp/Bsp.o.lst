 972:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     IfxClock_RampSeqCmd_stop     = 3,  /**< \brief Stop/pause ramping, actual frequency is kept con
 973:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****     IfxClock_RampSeqCmd_train    = 4   /**< \brief Execute training sequence */
 974:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** } IfxClock_RampSeqCmd;
 975:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
 976:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** /** \brief Status bits to reflect the current state of the ramping sequencer
 977:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * Register : RAMPSTAT.B.SSTAT ;
 978:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * 00B Idle / Frequency constant, not changing
 979:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * 01B RampUp / Frequency increasing
 980:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * 10B RampDown / Frequency decreasing
 981:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  */
 982:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** typedef enum
 983:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** {
