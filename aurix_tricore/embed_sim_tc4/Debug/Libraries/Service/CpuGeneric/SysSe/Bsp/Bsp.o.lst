 691:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** #endif /* #if (IFXSTM_IS_STMHV_AVAILABLE) */
 692:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** #endif /* #if (IFX_CFG_STM_MORPHING_ENABLE) */
 693:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     if (comparator == IfxStm_Comparator_0)
 694:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     {
 695:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****         return cmp0->B.CMPVAL;
 696:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     }
 697:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     else if (comparator == IfxStm_Comparator_1)
 698:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     {
 699:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****         return cmp1->B.CMPVAL;
 700:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     }
 701:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     else
 702:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     {
 703:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****         return 0U;
 704:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h ****     }
 705:../Libraries/iLLD/TC4xx/Tricore/Stm/Std/IfxStm.h **** }
