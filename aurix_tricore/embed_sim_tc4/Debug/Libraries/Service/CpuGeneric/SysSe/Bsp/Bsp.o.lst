 155:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *       // fPLL0 = N * fIN / P * K2 * 1. 6 -> K2PREDIV = 2
 156:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *       // fPLL0 = N * fIN / P * K2 * 1. 2 -> K2PREDIV = 3
 157:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *    IfxClock_sampleClockConfig.sysPllConfig.pDivider = IfxClock_Pdivider_2;
 158:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *    IfxClock_sampleClockConfig.sysPllConfig.nDivider = IfxClock_Ndivider_45;
 159:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *    IfxClock_sampleClockConfig.sysPllConfig.k2Divider = IfxClock_K2divider_1;
 160:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *    IfxClock_sampleClockConfig.sysPllConfig.k2PreDivider =IfxClock_K2PreDivider_divBy1_0;
 161:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *    // Configure PPU (Applicable for device TC4Dx)
 162:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *    IfxClock_sampleClockConfig.sysPllConfig.k3Divider = IfxClock_K3divider_1;   // Applicable for
 163:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *    IfxClock_sampleClockConfig.sysPllConfig.k3PreDividerPpu = IfxClock_K3PreDividerPpu_divBy1_0; 
 164:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *    //Clock Distribution
 165:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *    IfxClock_sampleClockConfig.clockDistribution.sysccucon0.value = IFXCLOCK_CFG_SYSCCUCON0;
 166:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *    IfxClock_sampleClockConfig.clockDistribution.sysccucon0.mask = IFXCLOCK_CFG_SYSCCUCON0_MASK;
 167:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *    IfxClock_sampleClockConfig.clockDistribution.sysccucon1.value = IFXCLOCK_CFG_SYSCCUCON1;
 168:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *    IfxClock_sampleClockConfig.clockDistribution.sysccucon1.mask = IFXCLOCK_CFG_SYSCCUCON1_MASK;
 169:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     // update CCUCON Config use mask and value as below
 170:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *    IfxClock_sampleClockConfig.clockDistribution.perccucon0.value = IFXCLOCK_CFG_PERCCUCON0;
 171:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *    IfxClock_sampleClockConfig.clockDistribution.perccucon0.mask = IFXCLOCK_CFG_PERCCUCON0_MASK;
 172:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *    IfxClock_sampleClockConfig.clockDistribution.perccucon1.value = IFXCLOCK_CFG_PERCCUCON1;
 173:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   IfxClock_sampleClockConfig.clockDistribution.perccucon1.mask = IFXCLOCK_CFG_PERCCUCON1_MASK;
