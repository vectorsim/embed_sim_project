1552:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
1553:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \param[in] lpDiv Low Power Division Ratio. Range: \ref IfxClock_LowPowerDivRatio.
1554:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
1555:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \retval None
1556:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  */
1557:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** IFX_INLINE void IfxClock_switchToLowPowerMode(IfxClock_LowPowerDivRatio lpDiv);
1558:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
1559:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** /** \brief API to switch back to normal mode from low power mode.
1560:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
1561:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * Caution:
1562:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * The original CCUCON0 setting has to be saved by user prior to entering Low Power mode.
1563:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * Pass the original CCUCON0 register as a whole word to this function to restore the normal settin
1564:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
1565:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * Ramp back to normal mode is done in steps to avoid sudden jump in frequency and power usage.
1566:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
1567:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \param[in] ccucon0 CCUCON0 values at normal mode. Range: 0 to 0x7F1FFFFF.
1568:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
1569:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \retval None
1570:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
1571:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * Switch to low power mode and back using iLLD functions as below
1572:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \code
1573:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     uint32 ccucon0 = CLOCK_SYSCCUCON0.U;
1574:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     IfxClock_LowPowerDivRatio lpDiv = IfxClock_LowPowerDivRatio_divBy120;
1575:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     IfxClock_switchToLowPowerMode(lpDiv);
1576:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \endcode
1577:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
1578:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * Switch back to normal mode  with the saved ccucon0 value
1579:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \code
1580:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     IfxClock_switchToNormalMode(ccucon0);
1581:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \endcode
1582:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
1583:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  */
1584:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** IFX_INLINE void IfxClock_switchToNormalMode(const uint32 ccucon0);
1585:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** #if defined(IFX_CLOCK_DISABLE_RAMPCON)
1586:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** /**
1587:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \retval None
1588:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  */
1589:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** IFX_INLINE void IfxClock_throttleSysPllClockInline(const IfxClock_PllThrottleConfig *pllThrottleCon
1590:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** #endif
