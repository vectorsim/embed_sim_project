 299:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
 300:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** /** \brief x-correlation lower limit is set to 150
 301:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  */
 302:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** #define IFXCLOCK_XCORR_LOWER_LIMIT                ((uint32)150)
 303:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
 304:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** /** \brief higher limit for XCORR is set to 350
 305:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  */
 306:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** #define IFXCLOCK_XCORR_HIGHER_LIMIT               ((uint32)350)
 307:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
 308:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** /** \brief MODCFG shift value for SYSPLLCON2
 309:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  */
 310:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** #define IFXCLOCK_MODCFG_DEFAULT_SHIFT             (10)
 311:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
 312:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** /** \brief MODCFG default value - for SYSPLLCON2[15:10]
 313:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  */
 314:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** #define IFXCLOCK_MODCFG_DEFAULT_VAL               ((uint32)0x1D)
 315:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
 316:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** /** \brief get Rgain from MA and FDco
 317:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  */
 318:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** #define IFXCLOCK_GET_RGAIN_NOM(MA, FDco)           ((2 * (MA / 100) * (FDco / IFXCLOCK_MODULATION_F
 319:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
 320:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** /** \brief Get RGAin HEX from RGain Nominal value
 321:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  */
 322:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** #define IFXCLOCK_GET_RGAIN_HEX(RGain_Nom)          ((uint16)((RGain_Nom * 32) + 0.5f))
 323:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
 324:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** /** \brief Get MODCFG from RGAIN_HEX
 325:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  */
 326:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** #define IFXCLOCK_GET_MODCFG(RGain_Hex)             ((uint16)(IFXCLOCK_MODCFG_DEFAULT_VAL << IFXCLOC
 327:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
 328:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** /** \brief Get the Delta RnD Value
 329:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  */
 330:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** #define IFXCLOCK_GET_DELTA_RANDD(RGain_Hex)        ((uint32)((RGain_Hex / 10) > 2 ? (RGain_Hex / 10
 331:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
 332:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** /** \brief Get XCorr Nom value from FOsc and from the XGain
 333:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  */
 334:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** #define IFXCLOCK_GET_XCORR_NOM(FOsc, RGain, XGain) ((1184.0f / FOsc) * RGain * XGain)
 335:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
 336:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** /** \brief Get XCorr hex value from XCORR nominal
 337:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  */
 338:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** #define IFXCLOCK_GET_XCORR_HEX(XCorr_Nom)          ((uint32)(XCorr_Nom + 0.5f))
 339:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
 340:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** /** \brief Get XTOL value from the XCORR
 341:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  */
 342:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** #define IFXCLOCK_GET_XTOL(XCorr)                   ((uint32)((XCorr / 20) > 10 ? (XCorr / 20) : 10)
 343:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** 
 344:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h **** /** \brief
 345:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  */
