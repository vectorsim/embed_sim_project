 209:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 210:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** /** \brief Return system timer value (critical section).
 211:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 212:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * The function IfxStm_get() is called in a critical section, disabling
 213:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * the interrupts. The system timer value is limited to TIME_INFINITE.
 214:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 215:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \return Returns system timer value.
 216:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  */
 217:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** IFX_INLINE Ifx_TickTime now(void)
 218:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** {
 219:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     Ifx_TickTime stmNow;
 220:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** #if !defined(IFX_ILLD_PPU_USAGE)
 221:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     boolean      interruptState;
 222:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 223:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     interruptState = disableInterrupts();
 224:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     stmNow         = (Ifx_TickTime)IfxStm_get(BSP_DEFAULT_TIMER) & TIME_INFINITE;
 225:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** #else
 226:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     stmNow         = (Ifx_TickTime)IfxPpu_Timer_readTimer0() & TIME_INFINITE;
 227:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** #endif
 228:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 229:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** #if !defined(IFX_ILLD_PPU_USAGE)
 230:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     restoreInterrupts(interruptState);
 231:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** #endif
 232:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     return stmNow;
 233:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** }
 234:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 235:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** #if !defined(IFX_ILLD_PPU_USAGE)
 236:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** /** \brief Return system timer value (without critical section).
 237:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 238:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * The function IfxStm_get() is called. The system timer value is limited to TIME_INFINITE.
 239:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 240:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \return Returns system timer value.
 241:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  */
 242:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** IFX_INLINE Ifx_TickTime nowWithoutCriticalSection(void)
 243:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** {
 244:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     Ifx_TickTime stmNow;
 245:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 246:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     stmNow = (Ifx_TickTime)IfxStm_get(BSP_DEFAULT_TIMER) & TIME_INFINITE;
 247:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 248:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     return stmNow;
 249:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** }
 250:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** #endif
 251:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 252:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** /** \brief Add 2 Ifx_TickTime values and return the result
 253:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 254:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \param a parameter a
 255:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \param b parameter b
 256:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 257:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \return a + b. If either a or b is TIME_INFINITE, the result is TIME_INFINITE
 258:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  */
 259:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** IFX_INLINE Ifx_TickTime addTTime(Ifx_TickTime a, Ifx_TickTime b)
 260:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** {
 261:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     Ifx_TickTime result;
 262:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 263:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     if ((a == TIME_INFINITE) || (b == TIME_INFINITE))
 264:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     {
 265:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****         result = TIME_INFINITE;
 266:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     }
 267:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     else
 268:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     {
 269:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****         result = a + b;         /* FIXME check for overflow */
 270:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     }
 271:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 272:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     return result;
 273:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** }
 274:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 275:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 276:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** /** \brief Return the elapsed time in ticks.
 277:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 278:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * Return the elapsed time between the current time and the time passed as parameter
 279:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 280:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \return Returns the elapsed time.
 281:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  */
 282:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** IFX_INLINE Ifx_TickTime elapsed(Ifx_TickTime since)
 283:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** {
 284:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     return now() - since;
 285:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** }
 286:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 287:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 288:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** /** \brief Return the time dead line.
 289:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 290:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \param timeout Specifies the dead line from now: Deadline = Now + Timeout
 291:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 292:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \return Return the time dead line.
 293:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  */
 294:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** IFX_INLINE Ifx_TickTime getDeadLine(Ifx_TickTime timeout)
 295:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** {
 296:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     Ifx_TickTime deadLine;
 297:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 298:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     if (timeout == TIME_INFINITE)
 299:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     {
 300:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****         deadLine = TIME_INFINITE;
 301:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     }
 302:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     else
 303:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     {
 304:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****         deadLine = now() + timeout;
 305:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     }
 306:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 307:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     return deadLine;
 308:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** }
 309:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 310:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 311:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** /** \brief Return the time until the dead line.
 312:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 313:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \param deadline Specifies the dead line from now: Deadline = Now + Timeout
 314:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 315:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \return Return the time until the dead line.
 316:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  */
 317:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** IFX_INLINE Ifx_TickTime getTimeout(Ifx_TickTime deadline)
 318:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** {
 319:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     Ifx_TickTime timeout;
 320:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 321:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     if (deadline == TIME_INFINITE)
 322:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     {
 323:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****         timeout = TIME_INFINITE;
 324:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     }
 325:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     else
 326:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     {
 327:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****         timeout = deadline - now();
 328:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     }
 329:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 330:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     return timeout;
 331:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** }
 332:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 333:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 334:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** /** \brief Return TRUE if the dead line is over.
 335:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 336:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \param deadLine Specifies the dead line.
 337:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 338:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \retval TRUE Returns TRUE if the dead line is over
 339:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \retval FALSE Returns FALSE if the dead line is not yet over
 340:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  */
 341:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** IFX_INLINE boolean isDeadLine(Ifx_TickTime deadLine)
 342:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** {
 343:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     boolean result;
 344:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 345:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     if (deadLine == TIME_INFINITE)
 346:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     {
 347:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****         result = FALSE;
 348:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     }
 349:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     else
 350:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     {
 351:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****         result = now() >= deadLine;
 352:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     }
 353:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 354:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     return result;
 355:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** }
 356:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 357:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 358:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** /** \brief Poll a variable for a time.
 359:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 360:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \param test Specifies the variable to test.
 361:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \param timeout Specifies the maximal time the variable will be tested
 362:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 363:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \retval TRUE Returns TRUE if the variable gets TRUE before the timeout elapse
 364:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \retval FALSE Returns FALSE if the variable is FALSE as the timeout elapse
 365:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  */
 366:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** IFX_INLINE boolean poll(volatile boolean *test, Ifx_TickTime timeout)
 367:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** {
 368:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     Ifx_TickTime deadLine = getDeadLine(timeout);
 369:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 370:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     while ((*test == FALSE) && (isDeadLine(deadLine) == FALSE))
 371:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     {}
 372:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 373:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     return *test;
 374:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** }
 375:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 376:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** #if !defined(IFX_ILLD_PPU_USAGE)
 377:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** /** \brief Return the elapsed time in system timer ticks, and enable the interrupts.
 378:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 379:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * The interrupts are enabled by the function
 380:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 381:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \param since time returned by timingNoInterruptStart()
 382:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \param interruptEnabled If TRUE, the interrupts will be enabled before the function exit. This p
 383:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 384:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \return Returns the elapsed time.
 385:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 386:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \see timingNoInterruptStart()
 387:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  */
 388:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** IFX_INLINE Ifx_TickTime timingNoInterruptEnd(Ifx_TickTime since, boolean interruptEnabled)
 389:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** {
 390:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     Ifx_TickTime stmNow;
 391:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 392:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     stmNow = nowWithoutCriticalSection();
 393:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     restoreInterrupts(interruptEnabled);
 394:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 395:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     return stmNow - since;
 396:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** }
 397:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 398:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 399:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** /** \brief Disable the interrupt and return system timer value.
 400:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 401:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * The interrupt remains disabled after the function call
 402:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 403:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \return Returns system timer value.
 404:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 405:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \see timingNoInterruptEnd()
 406:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  */
 407:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** IFX_INLINE Ifx_TickTime timingNoInterruptStart(boolean *interruptEnabled)
 408:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** {
 409:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     *interruptEnabled = disableInterrupts();
 410:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 411:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     return nowWithoutCriticalSection();
 412:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** }
 413:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** #endif
 414:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** 
 415:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** /** \brief Wait for a while.
 416:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 417:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \param timeout Specifies the waiting time
 418:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  *
 419:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  * \return None.
 420:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****  */
 421:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** IFX_INLINE void wait(Ifx_TickTime timeout)
 422:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h **** {
 423:../Libraries/Service/CpuGeneric/SysSe/Bsp/Bsp.h ****     Ifx_TickTime deadLine = getDeadLine(timeout);
