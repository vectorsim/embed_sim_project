 175:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
 176:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     // standard PLL & clock initialisation
 177:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *     IfxClock_init(&IfxClock_sampleClockConfig);
 178:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
 179:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \endcode
 180:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
 181:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * ** Modulation Configuration **
 182:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * The CLOCK CCU module also provides an option to Frequency Modulate the clock.
 183:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * The Modulation configuration can be done as follows:
 184:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
 185:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \code
 186:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
 187:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * //define your modulation configuration structure:
 188:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
 189:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *  IFX_CONST IfxClock_Mod_Config IfxClock_SampleModConfig = {
 190:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *          IfxClock_ModEn_disabled,          // disable is default //enable / disable modulation
 191:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *          IfxClock_ModulationAmplitude_0p5, // default 0 value  // specify the modulation amplitu
 192:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
 193:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   // calibration configs
 194:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *      IfxClock_CalEn_enabled,           // enable cal_en  // enable or disable calibration of mod
 195:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *       IfxClock_CalEn_enabled,           // enable ab_cal_en
 196:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *      0,
 197:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
 198:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *   // delays and xcorr avg config
 199:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *       0,                                 /// 0 sys emc delay
 200:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *      3,                                 // xcorr delay defaults to 3
 201:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *      3,                                 // xcorr avg sel defaults to 3
 202:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *       0                                  // Per EMC Delay
 203:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
 204:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *  }
 205:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *  // put this as part of the CCU configuration:
 206:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *  IfxClock_sampleClockConfig.modulationConfig = &IfxClock_SampleModConfig;
 207:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
 208:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *  // now initialize the CCU PLL and clock with the init function
 209:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *  IfxClock_init(&IfxClock_sampleClockConfig)
 210:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \endcode
 211:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
 212:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \}
 213:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \}
 214:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  *
 215:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \defgroup IfxLld_Clock_Std_Ccu Clock Control Functions
 216:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \ingroup IfxLld_Clock_Std
 217:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \defgroup IfxLld_Clock_Std_Ccu_Operative Clock Control Operative Functions
 218:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \ingroup IfxLld_Clock_Std
 219:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \defgroup IfxLld_Clock_Std_Ccu_Configuration Clock Control Configuration Functions
 220:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \ingroup IfxLld_Clock_Std
 221:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \defgroup IfxLld_Clock_Std_Enum Enumerations
 222:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \ingroup IfxLld_Clock_Std
 223:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \defgroup IfxLld_Clock_Std_Ccu_Configuration Clock Control Configuration Structures
 224:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  * \ingroup IfxLld_Clock_Std
 225:../Libraries/iLLD/TC4xx/CpuGeneric/Clock/Std/IfxClock.h ****  */
