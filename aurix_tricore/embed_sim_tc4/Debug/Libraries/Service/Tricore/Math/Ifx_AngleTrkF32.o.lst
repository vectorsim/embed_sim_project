 263:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** void Ifx_AngleTrkF32_updateStatus(Ifx_AngleTrkF32 *aObsv, sint16 sinIn, sint16 cosIn)
 264:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** {
 265:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     Ifx_AngleTrkF32_PosIf *base    = &aObsv->base;
 266:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     sint32                  sqrAmpl = ((sint32)sinIn * (sint32)sinIn) + ((sint32)cosIn * (sint32)co
 267:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     base->status.B.signalLoss        = (sqrAmpl < aObsv->cfgData.sqrAmplMin);
 268:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     base->status.B.signalDegradation = (sqrAmpl > aObsv->cfgData.sqrAmplMax);
 269:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     base->status.B.trackingLoss      = __absf(aObsv->angleErr) > aObsv->cfgData.errorThreshold;
 270:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** }
