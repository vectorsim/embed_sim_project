  55:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
  56:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** IFX_INLINE float32 Ifx_AngleTrkF32_bound(float32 angle, float32 periodPerRotation)
  57:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** {
  58:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     float32 fullPeriod = 2 * IFX_PI;
  59:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
  60:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     if (angle >= (fullPeriod / 2))
  61:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     {
  62:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****         angle = angle - fullPeriod;
  63:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     }
  64:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     else if (angle < (-fullPeriod / 2))
  65:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     {
  66:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****         angle = angle + fullPeriod;
  67:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     }
  68:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     else
  69:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     {}
  70:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
  71:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     return angle;
  72:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** }
  73:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
  74:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
  75:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** IFX_INLINE float32 Ifx_AngleTrkF32_boundInput(float32 input)
  76:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** {
  77:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     return Ifx_AngleTrkF32_bound(input, 1);
  78:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** }
  79:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
  80:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
  81:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** __attribute__((used)) IFX_INLINE float32 round_f(float32 val)
  82:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** {
  83:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     /*lint -e632 -e633 -e524*/
  84:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     sint32 val_i = (sint32)val;
  85:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
  86:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     /*lint +e632 +e633 +e524*/
  87:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     if ((val - (float32)val_i) > 0.5)
  88:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     {
  89:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****         val = (float32)(val_i + 1);
  90:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     }
  91:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     else
  92:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     {
  93:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****         val = (float32)val_i;
  94:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     }
  95:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
  96:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     return val;
  97:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** }
  98:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
  99:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
 100:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** //________________________________________________________________________________________
 101:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** // PUBLIC FUNCTION IMPLEMENTATIONS
 102:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** #define ATO_T   (15e-3f)
 103:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** #define ATO_K   (39.05f)
 104:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** #define ATO_PSI (1.5f * IFX_PI)
 105:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
 106:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** void Ifx_AngleTrkF32_setControlGains(Ifx_AngleTrkF32_CfgData *cfgData, float32 K, float32 T, float3
 107:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** {
 108:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     cfgData->kp = ((2 * K) + (psi * psi) + 1) / (T * T);
 109:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     cfgData->ki = K * ((psi * psi) + 1) / (T * T * T);
 110:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     cfgData->kd = (K + 2) / T;
 111:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** }
 112:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
 113:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
 114:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** /** \brief Fill config with default values */
 115:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** void Ifx_AngleTrkF32_initConfig(Ifx_AngleTrkF32_Config *config, sint16 *sinIn, sint16 *cosIn)
 116:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** {
 117:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     Ifx_AngleTrkF32_CfgData cfgData;
 118:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     Ifx_AngleTrkF32_setControlGains(&cfgData, ATO_K, ATO_T, ATO_PSI);
 119:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     config->kp                = cfgData.kp;
 120:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     config->ki                = cfgData.ki;
 121:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     config->kd                = cfgData.kd;
 122:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     config->sinIn             = sinIn;
 123:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     config->cosIn             = cosIn;
 124:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     config->errorThreshold    = 5.0f / 180 * IFX_PI;
 125:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     config->sqrAmplMax        = (sint32)((1.01f * 1.01f) * 2048);
 126:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     config->sqrAmplMin        = (sint32)((0.99f * 0.99f) * 2048);
 127:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     config->speedLpfFc        = 100;
 128:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     config->periodPerRotation = 1;
 129:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     config->reversed          = FALSE;
 130:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     config->offset            = 0;
 131:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     config->resolution        = (1UL << 12);/** \brief 12-bit default resolution */
 132:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** }
 133:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
 134:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
 135:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** void Ifx_AngleTrkF32_setUserSampling(Ifx_AngleTrkF32 *aObsv, float32 Ts)
 136:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** {
 137:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->base.Ts = Ts;
 138:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->halfTs  = aObsv->base.Ts / 2.0F;
 139:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** }
 140:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
 141:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
 142:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** /** \brief Initialize the Angle Tracking object
 143:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****  * \param aObsv Pointer to the Ifx_AngleTrkF32 object
 144:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****  * \param config Pointer to the configuration data
 145:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****  * \param Ts sampling period in seconds
 146:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****  */
 147:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** void Ifx_AngleTrkF32_init(Ifx_AngleTrkF32 *aObsv, const Ifx_AngleTrkF32_Config *config, float32 Ts)
 148:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** {
 149:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->base.offset            = config->offset;
 150:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->base.resolution        = config->resolution;
 151:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->base.reversed          = config->reversed;
 152:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->base.Ts                = Ts;
 153:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->base.rawPosition       = 0;
 154:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->base.direction         = IfxStdIf_Pos_Dir_unknown;
 155:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->base.turn              = 0;
 156:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->base.status.status     = 0;
 157:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->base.periodPerRotation = config->periodPerRotation;
 158:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->base.positionConst     = 1.0 / (float32)aObsv->base.resolution * 2.0 * IFX_PI;
 159:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
 160:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->cfgData.kd             = config->kd;
 161:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->cfgData.ki             = config->ki;
 162:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->cfgData.kp             = config->kp;
 163:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->cfgData.errorThreshold = config->errorThreshold;
 164:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->cfgData.sqrAmplMax     = config->sqrAmplMax;
 165:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->cfgData.sqrAmplMin     = config->sqrAmplMin;
 166:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->sinIn                  = config->sinIn;
 167:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->cosIn                  = config->cosIn;
 168:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
 169:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     Ifx_AngleTrkF32_setUserSampling(aObsv, Ts);
 170:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->angleErr  = 0.0F;
 171:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->angleEst  = 0.0F;
 172:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->accelEst  = 0.0F;
 173:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->speedEstA = 0.0F;
 174:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->speedEstB = 0.0F;
 175:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->angleRef  = 0.0F;
 176:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     {
 177:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** #if IFX_CFG_ANGLETRKF32_SPEED_FILTER
 178:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****         Ifx_LowPassPt1F32_Config lpfConfig;
 179:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****         lpfConfig.gain            = 1.0F;
 180:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****         lpfConfig.cutOffFrequency = (2 * IFX_PI * config->speedLpfFc);
 181:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****         lpfConfig.samplingTime    = Ts;
 182:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****         Ifx_LowPassPt1F32_init(&aObsv->speedLpf, &lpfConfig);
 183:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** #endif
 184:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     }
 185:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** }
 186:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
 187:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
 188:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** /** \brief Step function of Ifx_AngleTrkF32 should be called at every sampling period provided
 189:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****  * during initialisation (call to Ifx_AngleTrkF32_init()).
 190:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****  *
 191:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****  * \note This function is automatically called by Ifx_AngleTrkF32_update()
 192:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****  * \param aObsv Pointer to the Ifx_AngleTrkF32 object
 193:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****  * \param sinIn sine input signal. The offset shall be zero.
 194:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****  * \param cosIn cosine input signal. The offset shall be zero.
 195:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****  * \param phase phase of input signal.
 196:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****  * \note This function returns the angular position in radians
 197:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****  * \note The amplitude of both sinIn and cosIn signal shall be the same.
 198:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****  */
 199:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** float32 Ifx_AngleTrkF32_step(Ifx_AngleTrkF32 *aObsv, sint16 sinIn, sint16 cosIn, float32 phase)
 200:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** {
 201:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     float32 angleRef, angleEst, dAccel, dSpeed, dAngle;
 202:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
 203:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     if (aObsv->base.reversed != FALSE)
 204:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     {
 205:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****         angleRef = IFX_ANGLETRKF32_ATAN2F((float32)cosIn, (float32)sinIn);
 206:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     }
 207:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     else
 208:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     {
 209:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****         angleRef = IFX_ANGLETRKF32_ATAN2F((float32)sinIn, (float32)cosIn);
 210:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     }
 211:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
 212:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->angleAtan = angleRef;
 213:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     angleRef         = angleRef + phase;
 214:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
 215:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->angleRef  = angleRef;
 216:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
 217:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     // Acceleration, zero-order-hold integrator:
 218:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     dAccel          = aObsv->cfgData.ki * aObsv->angleErr;
 219:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->accelEst = aObsv->accelEst + (dAccel * aObsv->base.Ts);
 220:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
 221:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     // Speed, zero-order-hold integrator:
 222:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     dSpeed           = ((aObsv->cfgData.kp * aObsv->angleErr) + aObsv->accelEst);
 223:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->speedEstA = aObsv->speedEstA + (dSpeed * aObsv->base.Ts);
 224:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
 225:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     // Angle, first-order-hold integrator:
 226:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     dAngle           = ((aObsv->cfgData.kd * aObsv->angleErr) + aObsv->speedEstA);
 227:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     angleEst         = aObsv->angleEst + ((dAngle + aObsv->speedEstB) * aObsv->halfTs);
 228:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->speedEstB = dAngle;
 229:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
 230:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->angleEst  = Ifx_AngleTrkF32_boundInput(angleEst);
 231:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
 232:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     // Error, is calculated here to compensate one period delay
 233:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->angleErr       = Ifx_AngleTrkF32_boundInput(aObsv->angleRef - aObsv->angleEst);
 234:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
 235:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     aObsv->base.direction = aObsv->speedEstB > 0 ? IfxStdIf_Pos_Dir_forward : IfxStdIf_Pos_Dir_back
 236:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
 237:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** #if IFX_CFG_ANGLETRKF32_SPEED_FILTER
 238:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     // Filter speed:
 239:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     Ifx_LowPassPt1F32_do(&aObsv->speedLpf, aObsv->speedEstB);
 240:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** #endif
 241:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** 
 242:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c ****     return aObsv->angleEst;
 243:../Libraries/Service/Tricore/Math/Ifx_AngleTrkF32.c **** }
