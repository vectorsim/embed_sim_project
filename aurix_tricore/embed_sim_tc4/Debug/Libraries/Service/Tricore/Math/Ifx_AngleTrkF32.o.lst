  46:../Libraries/Service/Tricore/Math/Ifx_LowPassPt1F32.h ****  */
  47:../Libraries/Service/Tricore/Math/Ifx_LowPassPt1F32.h **** typedef struct
  48:../Libraries/Service/Tricore/Math/Ifx_LowPassPt1F32.h **** {
  49:../Libraries/Service/Tricore/Math/Ifx_LowPassPt1F32.h ****     float32 a;              /**< \brief a parameter */
  50:../Libraries/Service/Tricore/Math/Ifx_LowPassPt1F32.h ****     float32 b;              /**< \brief b parameter */
  51:../Libraries/Service/Tricore/Math/Ifx_LowPassPt1F32.h ****     float32 out;            /**< \brief last output */
  52:../Libraries/Service/Tricore/Math/Ifx_LowPassPt1F32.h **** } Ifx_LowPassPt1F32;
  53:../Libraries/Service/Tricore/Math/Ifx_LowPassPt1F32.h **** 
  54:../Libraries/Service/Tricore/Math/Ifx_LowPassPt1F32.h **** /** \brief PT1 configuration */
  55:../Libraries/Service/Tricore/Math/Ifx_LowPassPt1F32.h **** typedef struct
  56:../Libraries/Service/Tricore/Math/Ifx_LowPassPt1F32.h **** {
  57:../Libraries/Service/Tricore/Math/Ifx_LowPassPt1F32.h ****     float32 cutOffFrequency; /**< \brief Cut off frequency */
  58:../Libraries/Service/Tricore/Math/Ifx_LowPassPt1F32.h ****     float32 gain;            /**< \brief Gain */
  59:../Libraries/Service/Tricore/Math/Ifx_LowPassPt1F32.h ****     float32 samplingTime;    /**< \brief Sampling time */
  60:../Libraries/Service/Tricore/Math/Ifx_LowPassPt1F32.h **** } Ifx_LowPassPt1F32_Config;
  61:../Libraries/Service/Tricore/Math/Ifx_LowPassPt1F32.h **** 
