 101:../Libraries/Service/Tricore/Math/Ifx_Crc.c **** 
 102:../Libraries/Service/Tricore/Math/Ifx_Crc.c **** 
 103:../Libraries/Service/Tricore/Math/Ifx_Crc.c **** boolean Ifx_Crc_createTable(Ifc_Crc_Table *table, sint32 order, uint32 polynom, sint32 refin)
 104:../Libraries/Service/Tricore/Math/Ifx_Crc.c **** {
 105:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****     uint32 crcmask;
 106:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****     // at first, compute constant bit masks for whole CRC and CRC high bit
 107:../Libraries/Service/Tricore/Math/Ifx_Crc.c **** 
 108:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****     crcmask = ((((uint32)1 << (order - 1)) - 1) << 1) | 1;
 109:../Libraries/Service/Tricore/Math/Ifx_Crc.c **** 
 110:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****     // check parameters
 111:../Libraries/Service/Tricore/Math/Ifx_Crc.c **** 
 112:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****     if ((order < 1) || (order > 32))
 113:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****     {
 114:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****         //IfxStdIf_DPipe_print(io,"ERROR, invalid order, it must be between 1..32."ENDL);
 115:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****         return FALSE;
 116:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****     }
 117:../Libraries/Service/Tricore/Math/Ifx_Crc.c **** 
 118:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****     if (polynom != (polynom & crcmask))
 119:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****     {
 120:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****         //IfxStdIf_DPipe_print(io,"ERROR, invalid polynom."ENDL);
 121:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****         return FALSE;
 122:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****     }
 123:../Libraries/Service/Tricore/Math/Ifx_Crc.c **** 
 124:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****     table->order      = order;
 125:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****     table->polynom    = polynom;
 126:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****     table->refin      = refin;
 127:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****     table->crchighbit = (uint32)1 << (order - 1);
 128:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****     table->crcmask    = crcmask;
 129:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****     // generate lookup table
 130:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****     // make CRC lookup table used by table algorithms
 131:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****     {
 132:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****         sint32 i, j;
 133:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****         uint32 bit, crc;
 134:../Libraries/Service/Tricore/Math/Ifx_Crc.c **** 
 135:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****         for (i = 0; i < 256; i++)
 136:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****         {
 137:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****             crc = (uint32)i;
 138:../Libraries/Service/Tricore/Math/Ifx_Crc.c **** 
 139:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****             if (refin)
 140:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****             {
 141:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****                 crc = Ifx_Crc_reflect(crc, 8);
 142:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****             }
 143:../Libraries/Service/Tricore/Math/Ifx_Crc.c **** 
 144:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****             crc <<= order - 8;
 145:../Libraries/Service/Tricore/Math/Ifx_Crc.c **** 
 146:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****             for (j = 0; j < 8; j++)
 147:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****             {
 148:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****                 bit   = crc & table->crchighbit;
 149:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****                 crc <<= 1;
 150:../Libraries/Service/Tricore/Math/Ifx_Crc.c **** 
 151:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****                 if (bit)
 152:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****                 {
 153:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****                     crc ^= polynom;
 154:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****                 }
 155:../Libraries/Service/Tricore/Math/Ifx_Crc.c ****             }
