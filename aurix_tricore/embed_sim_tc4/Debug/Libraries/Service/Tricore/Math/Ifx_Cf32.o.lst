  42:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** 
  43:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** /* Complex Arithmetic --------------------------------------------------------*/
  44:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** IFX_INLINE cfloat32 IFX_Cf32_exp(const cfloat32 *c)
  45:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** {
  46:../Libraries/Service/Tricore/Math/Ifx_Cf32.h ****     float32  f = (float32)expf(c->real);
  47:../Libraries/Service/Tricore/Math/Ifx_Cf32.h ****     cfloat32 R;
  48:../Libraries/Service/Tricore/Math/Ifx_Cf32.h ****     R.real = f * (float32)cosf(c->imag);
  49:../Libraries/Service/Tricore/Math/Ifx_Cf32.h ****     R.imag = f * (float32)sinf(c->imag);
  50:../Libraries/Service/Tricore/Math/Ifx_Cf32.h ****     return R;
  51:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** }
  52:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** 
  53:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** 
  54:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** IFX_INLINE cfloat32 IFX_Cf32_mul(const cfloat32 *a, const cfloat32 *b)
  55:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** {
  56:../Libraries/Service/Tricore/Math/Ifx_Cf32.h ****     cfloat32 R;
  57:../Libraries/Service/Tricore/Math/Ifx_Cf32.h ****     R.real = (a->real * b->real) - (a->imag * b->imag);
  58:../Libraries/Service/Tricore/Math/Ifx_Cf32.h ****     R.imag = (a->imag * b->real) + (a->real * b->imag);
  59:../Libraries/Service/Tricore/Math/Ifx_Cf32.h ****     return R;
  60:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** }
  61:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** 
  62:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** 
  63:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** IFX_INLINE cfloat32 IFX_Cf32_amp(const cfloat32 *a, float32 gain)
  64:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** {
  65:../Libraries/Service/Tricore/Math/Ifx_Cf32.h ****     cfloat32 R;
  66:../Libraries/Service/Tricore/Math/Ifx_Cf32.h ****     R.real = a->real * gain;
  67:../Libraries/Service/Tricore/Math/Ifx_Cf32.h ****     R.imag = a->imag * gain;
  68:../Libraries/Service/Tricore/Math/Ifx_Cf32.h ****     return R;
  69:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** }
