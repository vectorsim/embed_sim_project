  40:../Libraries/Service/Tricore/Math/Ifx_FftF32.h **** /** \brief Maximum FFT resolution (bits).
  41:../Libraries/Service/Tricore/Math/Ifx_FftF32.h ****  * If redefined, then \ref Ifx_g_FftF32_bitReverseTable and \ref Ifx_g_FftF32_twiddleTable shall be
  42:../Libraries/Service/Tricore/Math/Ifx_FftF32.h **** #define IFX_FFTF32_MAX_RESOLUTION (14)
  43:../Libraries/Service/Tricore/Math/Ifx_FftF32.h **** 
  44:../Libraries/Service/Tricore/Math/Ifx_FftF32.h **** /** \brief Maximum FFT length.
  45:../Libraries/Service/Tricore/Math/Ifx_FftF32.h ****  * If redefined, then \ref Ifx_g_FftF32_bitReverseTable and \ref Ifx_g_FftF32_twiddleTable shall be
  46:../Libraries/Service/Tricore/Math/Ifx_FftF32.h **** #define IFX_FFTF32_MAX_LENGTH     (1U << IFX_FFTF32_MAX_RESOLUTION)
  47:../Libraries/Service/Tricore/Math/Ifx_FftF32.h **** 
  48:../Libraries/Service/Tricore/Math/Ifx_FftF32.h **** /** \brief Bit reversal table */
  49:../Libraries/Service/Tricore/Math/Ifx_FftF32.h **** IFX_EXTERN IFX_CONST uint16   Ifx_g_FftF32_bitReverseTable[IFX_FFTF32_MAX_LENGTH];
  50:../Libraries/Service/Tricore/Math/Ifx_FftF32.h **** 
  51:../Libraries/Service/Tricore/Math/Ifx_FftF32.h **** /** \brief Twiddle factor table */
  52:../Libraries/Service/Tricore/Math/Ifx_FftF32.h **** IFX_EXTERN IFX_CONST cfloat32 Ifx_g_FftF32_twiddleTable[IFX_FFTF32_MAX_LENGTH / 2];
  53:../Libraries/Service/Tricore/Math/Ifx_FftF32.h **** 
  54:../Libraries/Service/Tricore/Math/Ifx_FftF32.h **** //----------------------------------------------------------------------------------------
