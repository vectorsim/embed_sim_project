  75:../Libraries/Service/Tricore/Math/Ifx_FftF32.h **** /** \brief Lookup from \ref Ifx_g_FftF32_bitReverseTable the bit-reversed \<n\> with \<bits\> as nu
  76:../Libraries/Service/Tricore/Math/Ifx_FftF32.h **** IFX_INLINE uint16 Ifx_FftF32_lookUpReversedBits(uint16 n, unsigned bits)
  77:../Libraries/Service/Tricore/Math/Ifx_FftF32.h **** {
  78:../Libraries/Service/Tricore/Math/Ifx_FftF32.h ****     unsigned shift = IFX_FFTF32_MAX_RESOLUTION - bits;
  79:../Libraries/Service/Tricore/Math/Ifx_FftF32.h ****     uint16   index = Ifx_g_FftF32_bitReverseTable[n];
  80:../Libraries/Service/Tricore/Math/Ifx_FftF32.h ****     return index >> shift;
  81:../Libraries/Service/Tricore/Math/Ifx_FftF32.h **** }
