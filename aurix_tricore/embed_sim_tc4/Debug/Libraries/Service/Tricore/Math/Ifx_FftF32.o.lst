  63:../Libraries/Service/Tricore/Math/Ifx_FftF32.h **** 
  64:../Libraries/Service/Tricore/Math/Ifx_FftF32.h **** /** \brief Radix-2 Fast-Fourier Transform */
  65:../Libraries/Service/Tricore/Math/Ifx_FftF32.h **** IFX_EXTERN cfloat32 *Ifx_FftF32_radix2(cfloat32 *R, const cfloat32 *X, uint16 nX);
  66:../Libraries/Service/Tricore/Math/Ifx_FftF32.h **** 
  67:../Libraries/Service/Tricore/Math/Ifx_FftF32.h **** /** \brief Radix-2 Inverse Fast-Fourier Transform */
  68:../Libraries/Service/Tricore/Math/Ifx_FftF32.h **** IFX_EXTERN cfloat32 *Ifx_FftF32_radix2I(cfloat32 *R, const cfloat32 *X, uint16 nX);
  69:../Libraries/Service/Tricore/Math/Ifx_FftF32.h **** 
  70:../Libraries/Service/Tricore/Math/Ifx_FftF32.h **** /** \} */
