  63:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** IFX_INLINE cfloat32 IFX_Cf32_amp(const cfloat32 *a, float32 gain)
  64:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** {
  65:../Libraries/Service/Tricore/Math/Ifx_Cf32.h ****     cfloat32 R;
  66:../Libraries/Service/Tricore/Math/Ifx_Cf32.h ****     R.real = a->real * gain;
  67:../Libraries/Service/Tricore/Math/Ifx_Cf32.h ****     R.imag = a->imag * gain;
  68:../Libraries/Service/Tricore/Math/Ifx_Cf32.h ****     return R;
  69:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** }
  70:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** 
  71:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** 
  72:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** IFX_INLINE float32 IFX_Cf32_dot(const cfloat32 *b)
  73:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** {
  74:../Libraries/Service/Tricore/Math/Ifx_Cf32.h ****     return (b->real * b->real) + (b->imag * b->imag);
  75:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** }
  76:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** 
  77:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** 
  78:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** IFX_INLINE float32 IFX_Cf32_mag(const cfloat32 *c)
  79:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** {
  80:../Libraries/Service/Tricore/Math/Ifx_Cf32.h ****     return (float32)sqrtf(IFX_Cf32_dot(c));
  81:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** }
  82:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** 
  83:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** 
  84:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** IFX_INLINE cfloat32 IFX_Cf32_div(const cfloat32 *a, const cfloat32 *b)
  85:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** {
  86:../Libraries/Service/Tricore/Math/Ifx_Cf32.h ****     float32  denom = IFX_Cf32_dot(b);
  87:../Libraries/Service/Tricore/Math/Ifx_Cf32.h ****     cfloat32 R;
  88:../Libraries/Service/Tricore/Math/Ifx_Cf32.h ****     R.real = ((a->real * b->real) + (a->imag * b->imag)) / denom;
  89:../Libraries/Service/Tricore/Math/Ifx_Cf32.h ****     R.imag = ((a->imag * b->real) - (a->real * b->imag)) / denom;
  90:../Libraries/Service/Tricore/Math/Ifx_Cf32.h ****     return R;
  91:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** }
