  43:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** /* Complex Arithmetic --------------------------------------------------------*/
  44:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** IFX_INLINE cfloat32 IFX_Cf32_exp(const cfloat32 *c)
  45:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** {
  46:../Libraries/Service/Tricore/Math/Ifx_Cf32.h ****     float32  f = (float32)expf(c->real);
  47:../Libraries/Service/Tricore/Math/Ifx_Cf32.h ****     cfloat32 R;
  48:../Libraries/Service/Tricore/Math/Ifx_Cf32.h ****     R.real = f * (float32)cosf(c->imag);
  49:../Libraries/Service/Tricore/Math/Ifx_Cf32.h ****     R.imag = f * (float32)sinf(c->imag);
  50:../Libraries/Service/Tricore/Math/Ifx_Cf32.h ****     return R;
  51:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** }
  52:../Libraries/Service/Tricore/Math/Ifx_Cf32.h **** 
