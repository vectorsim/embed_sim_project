 376:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 377:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 378:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** void Ifx_Shell_process(Ifx_Shell *shell)
 379:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** {
 380:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     Ifx_SizeT          i, j;           /* Loop variables */
 381:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     Ifx_SizeT          count;
 382:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     Ifx_SizeT          readCount;
 383:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     boolean            NormalKeyPress; /* Indicates if this is a normal keypress, i.e. not part of 
 384:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 385:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     Ifx_Shell_CmdLine *Cmd         = &shell->cmd;
 386:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     char              *inputbuffer = shell->locals.inputbuffer;
 387:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     char              *cmdStr      = shell->locals.cmdStr;
 388:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     char             **CmdHistory  = shell->cmdHistory;
 389:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 390:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     if (shell->control.enabled == 0)
 391:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     {
 392:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         return;
 393:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     }
 394:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 395:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     if ((shell->protocol.object != NULL_PTR) && (shell->protocol.started != FALSE))
 396:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     {
 397:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         shell->protocol.execute(shell->protocol.object);
 398:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     }
 399:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     else
 400:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     {
 401:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         /**** NORMAL MODE ****/
 402:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 403:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         /********************************************************************************/
 404:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         /* Read all characters until enter inclusive.                                   */
 405:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         /* If the command is bigger than IFX_SHELL_CMD_SIZE, the command is ignored.    */
 406:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         /*                                                                              */
 407:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         /* Escape sequences are handled by a state machine.                             */
 408:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         /* The following escape sequences (prefix "ESC [") are supported:               */
 409:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         /*                                                                              */
 410:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         /* A  - up      B - down       C - right     D - left                           */
 411:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         /* 1~ - HOME   2~ - INSERT    3~ - DELETE   5~ - END                            */
 412:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         /*                                                                              */
 413:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         /* Backspace ('\b') is also supported.                                          */
 414:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         /********************************************************************************/
 415:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 416:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         count     = 0;
 417:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         readCount = IFX_CFG_SHELL_CMD_LINE_SIZE - count;
 418:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         IfxStdIf_DPipe_read(shell->io, &inputbuffer[count], &readCount, TIME_NULL);
 419:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         count    += readCount;
 420:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 421:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         for (i = 0; i < count; i++)
 422:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         {
 423:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             /* By default, we assume character is part of escape sequence */
 424:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             NormalKeyPress = FALSE;
 425:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 426:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             /* Process key pressed */
 427:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             switch (inputbuffer[i])
 428:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             {
 429:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             /* New line (ENTER) */
 430:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             case '\n':
 431:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             case '\r':
 432:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 /* Print new line to terminal if requested */
 433:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 IFX_SHELL_IF_ECHO(IfxStdIf_DPipe_print(shell->io, ENDL))
 434:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 435:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 /* Execute command if length is valid - i.e. not an over-full buffer
 436:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                  * (prevents attempted execution of junk) */
 437:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 if (Cmd->length < IFX_CFG_SHELL_CMD_LINE_SIZE)
 438:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 {
 439:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     cmdStr[Cmd->length] = IFX_SHELL_NULL_CHAR;  /* Terminate cmdStr */
 440:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 441:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     if (Cmd->historyAdd != FALSE)
 442:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     {
 443:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                         /* Shuffle history up */
 444:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                         for (j = IFX_CFG_SHELL_CMD_HISTORY_SIZE - 1; j > 0; j--)
 445:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                         {
 446:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                             /* Copy text */
 447:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                             strncpy(CmdHistory[j], CmdHistory[j - 1], IFX_CFG_SHELL_CMD_LINE_SIZE);
 448:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                         }
 449:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 450:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                         /* Copy in new entry */
 451:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                         strncpy(CmdHistory[0], cmdStr, IFX_CFG_SHELL_CMD_LINE_SIZE);
 452:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     }
 453:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 454:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     /* Execute command */
 455:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     Ifx_Shell_execute(shell, cmdStr);
 456:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 }
 457:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 458:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 /* Show prompt if in main shell */
 459:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 if (shell->control.showPrompt != 0)
 460:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 {
 461:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     IfxStdIf_DPipe_print(shell->io, IFX_CFG_SHELL_PROMPT);
 462:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 }
 463:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 464:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 /* Reset command line buffer length */
 465:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 Cmd->length = 0;
 466:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 467:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 /* Reset command line buffer cursor position */
 468:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 Cmd->cursor = 0;
 469:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 470:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 /* Clear flag */
 471:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 Cmd->historyAdd = FALSE;
 472:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 473:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 /* Ensure we're not in command history list */
 474:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 Cmd->historyItem = IFX_SHELL_CMD_HISTORY_NO_ITEM;
 475:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 break;
 476:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 477:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             /* Backspace (may occur in middle of text if cursor location is not at end) */
 478:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             case '\b':
 479:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 480:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 if (Cmd->cursor > 0)
 481:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 {
 482:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     /* Update on screen */
 483:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     if (shell->control.echo != 0)
 484:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     {
 485:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                         /* Move left one character */
 486:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                         IfxStdIf_DPipe_print(shell->io, "\b");
 487:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 488:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                         /* Update line with new characters */
 489:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                         for (j = Cmd->cursor; j < Cmd->length; j++)
 490:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                         {
 491:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                             IfxStdIf_DPipe_print(shell->io, "%c", cmdStr[j]);
 492:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                         }
 493:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 494:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                         /* Write over duplicated character at end */
 495:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                         IfxStdIf_DPipe_print(shell->io, " ");
 496:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                         IFX_SHELL_WRITE_BACKSPACES((Cmd->length - Cmd->cursor) + 1)
 497:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     }
 498:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 499:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     /* Update in command line variable. Shuffle text left */
 500:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     strncpy(&cmdStr[Cmd->cursor - 1], &cmdStr[Cmd->cursor], Cmd->length - Cmd->curs
 501:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 502:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     /* Terminate string at end of shorter string */
 503:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     cmdStr[Cmd->length - 1] = IFX_SHELL_NULL_CHAR;
 504:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 505:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     Cmd->length--;
 506:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     Cmd->cursor--;
 507:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 508:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     /* Command line has been modified */
 509:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     Cmd->historyAdd = TRUE;
 510:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 }
 511:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 512:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 break;
 513:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 514:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             /* Escape character */
 515:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             case '\x1B':       /*'\x1B': */
 516:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 shell->locals.cmdState = IFX_SHELL_CMD_STATE_ESCAPE;
 517:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 break;
 518:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 519:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             /* '[' - check to see if this is second part of an escape sequence */
 520:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             case '[':
 521:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 522:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 if (shell->locals.cmdState == IFX_SHELL_CMD_STATE_ESCAPE)
 523:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 {
 524:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     /* ESC [ pressed */
 525:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     shell->locals.cmdState = IFX_SHELL_CMD_STATE_ESCAPE_BRACKET;
 526:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 }
 527:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 else
 528:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 {
 529:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     NormalKeyPress = TRUE;
 530:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 }
 531:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 532:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 break;
 533:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 534:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             /* Check for supported characters in escape sequences ( ESC [ A/B/C/D ) */
 535:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             case 'A':
 536:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             case 'B':
 537:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             case 'C':
 538:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             case 'D':
 539:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 540:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 if (shell->locals.cmdState == IFX_SHELL_CMD_STATE_ESCAPE_BRACKET)
 541:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 {
 542:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     /* Process arrow keys */
 543:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     Ifx_Shell_cmdEscapeProcess(shell, inputbuffer[i], 0);
 544:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 545:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     /* End of escape sequence */
 546:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     shell->locals.cmdState = IFX_SHELL_CMD_STATE_NORMAL;
 547:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 }
 548:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 else
 549:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 {
 550:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     NormalKeyPress = TRUE;
 551:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 }
 552:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 553:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 break;
 554:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 555:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             /* Check for supported characters in escape sequences (ESC [ 2/4/5 ~) */
 556:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             case '1':
 557:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             case '2':
 558:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             case '3':
 559:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             case '4':
 560:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 561:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 if (shell->locals.cmdState == IFX_SHELL_CMD_STATE_ESCAPE_BRACKET)
 562:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 {
 563:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     /* Store number for use once complete escape sequence is confirmed (below) */
 564:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     shell->locals.escBracketNum = inputbuffer[i];
 565:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     shell->locals.cmdState      = IFX_SHELL_CMD_STATE_ESCAPE_BRACKET_NUMBER;
 566:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 }
 567:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 else
 568:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 {
 569:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     NormalKeyPress = TRUE;
 570:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 }
 571:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 572:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 break;
 573:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 574:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             /* Check for supported characters in escape sequences (ESC [ 2/4/5 ~) */
 575:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             case '~':
 576:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 577:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 if (shell->locals.cmdState == IFX_SHELL_CMD_STATE_ESCAPE_BRACKET_NUMBER)
 578:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 {
 579:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     /* Process home/delete/end */
 580:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     Ifx_Shell_cmdEscapeProcess(shell, shell->locals.escBracketNum, '~');
 581:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 582:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     /* End of escape sequence */
 583:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     shell->locals.cmdState = IFX_SHELL_CMD_STATE_NORMAL;
 584:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 }
 585:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 else
 586:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 {
 587:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     NormalKeyPress = TRUE;
 588:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 }
 589:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 590:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 break;
 591:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 592:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             /* Normal character - add to command string */
 593:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             default:
 594:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 NormalKeyPress = TRUE;
 595:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 break;
 596:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             }
 597:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 598:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             IFX_ASSERT(IFX_VERBOSE_LEVEL_ERROR, Cmd->length >= Cmd->cursor);    /* Sanity check */
 599:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 600:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             /* If this was a normal key press (not part of an escape sequence),
 601:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****              * add it to the command string */
 602:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             if (NormalKeyPress != FALSE)
 603:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             {
 604:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 /* Ensure state machine is reset */
 605:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 shell->locals.cmdState = IFX_SHELL_CMD_STATE_NORMAL;
 606:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 607:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 /* If not filled buffer, add in this character */
 608:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 if (Cmd->length < (IFX_CFG_SHELL_CMD_LINE_SIZE - 1))
 609:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 {
 610:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     /* Command line has been modified */
 611:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     Cmd->historyAdd = TRUE;
 612:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 613:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     /* Copy into command line */
 614:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     cmdStr[Cmd->cursor] = inputbuffer[i];
 615:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     Cmd->cursor++;
 616:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 617:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     /* Update length of buffer */
 618:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     Cmd->length = __max(Cmd->length, Cmd->cursor);
 619:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 620:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     if (shell->control.echo != 0)
 621:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     {
 622:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                         /* echo character to shell output if requested */
 623:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                         shell->locals.echo[0] = inputbuffer[i];
 624:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                         IfxStdIf_DPipe_print(shell->io, shell->locals.echo);
 625:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     }
 626:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 }
 627:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 else
 628:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 {
 629:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     /* Line too long - ignore further characters */
 630:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     Cmd->historyAdd = FALSE;    /* Invalid command line */
 631:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 }
 632:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             }
 633:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         }
 634:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     }
 635:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** }
