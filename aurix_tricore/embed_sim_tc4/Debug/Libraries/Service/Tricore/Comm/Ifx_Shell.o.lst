 659:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** boolean Ifx_Shell_matchToken(pchar *argsPtr, pchar token)
 660:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** {
 661:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     pchar   savedArguments = *argsPtr;
 662:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     char    buffer[256];
 663:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     boolean result         = FALSE;
 664:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 665:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     if (Ifx_Shell_parseToken(argsPtr, buffer, Ifx_COUNTOF(buffer)) != FALSE)
 666:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     {
 667:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         if (strcmp(token, buffer) == 0)
 668:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         {
 669:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             result = TRUE;
 670:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         }
 671:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     }
 672:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 673:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     if (result == FALSE)
 674:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     {
 675:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         // No match: don't advance pointer
 676:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         *argsPtr = savedArguments;
 677:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     }
 678:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 679:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     return result;
 680:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** }
 681:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 682:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 683:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** static boolean Ifx_Shell_matchCommand(pchar *argsPtr, pchar *match)
 684:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** {
 685:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     boolean result         = FALSE;
 686:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     pchar   savedArguments = *argsPtr;
 687:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     pchar   savedMatch     = *match;
 688:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     char    buffer0[256];
 689:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     char    buffer1[256];
 690:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 691:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     if ((Ifx_Shell_parseToken(argsPtr, buffer0, Ifx_COUNTOF(buffer0)) != FALSE)
 692:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         && (Ifx_Shell_parseToken(match, buffer1, Ifx_COUNTOF(buffer1)) != FALSE))
 693:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     {
 694:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         if (strcmp(buffer1, buffer0) == 0)
 695:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         {
 696:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             result = TRUE;
 697:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         }
 698:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     }
 699:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 700:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     if (result == FALSE)
 701:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     {
 702:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         // No match: don't advance pointer
 703:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         *argsPtr = savedArguments;
 704:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         *match   = savedMatch;
 705:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     }
 706:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 707:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     return result;
 708:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** }
