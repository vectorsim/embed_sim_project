  49:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** /* Macro to detect space character */
  50:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** #define ISSPACE(c)           (((c) == ' ') || ((c) == '\t'))
  51:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
  52:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** /* Macro to only execute parameter if echo is enabled for this shell */
  53:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** #define IFX_SHELL_IF_ECHO(X) {if (shell->control.echo) {X; }}
  54:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
  55:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** /* Macro to write lots of spaces */
  56:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** #define IFX_SHELL_WRITE_SPACES(X) \
  57:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     {int ii; for (ii = 0; ii < (X); ii++) {IfxStdIf_DPipe_print(shell->io, " "); }}
  58:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
  59:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** /* Macro to write lots of backspaces */
  60:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** #define IFX_SHELL_WRITE_BACKSPACES(X) \
  61:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     {int ii; for (ii = 0; ii < (X); ii++) {IfxStdIf_DPipe_print(shell->io, "\b"); }}
