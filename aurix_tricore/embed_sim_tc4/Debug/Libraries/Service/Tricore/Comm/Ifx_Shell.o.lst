1077:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** /*      EscapeChar2 - Second character following ESC [ , if applicable                  */
1078:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** /*                                                                                      */
