 131:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 { /* Show param details*/
 132:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     spaceParam = "        ";
 133:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 }
 134:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 else if (isSyntax)
 135:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 {   /* Show param details*/
 136:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     spaceParam = "            ";
 137:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 }
 138:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             }
 139:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 140:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             /* Split print by ENDL */
 141:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             chunk = strstr(help, ENDL);
 142:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 143:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             if (chunk == NULL_PTR)
 144:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             {
 145:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 chunk = help + strlen(help);
 146:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             }
 147:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             else
 148:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             {
 149:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 if (!briefOnly)
 150:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 {
 151:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                     chunk += strlen(ENDL);
 152:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 }
 153:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             }
 154:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 155:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             count = chunk - help;
 156:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             IfxStdIf_DPipe_print(io, "%s%s", space, spaceParam);
 157:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             IfxStdIf_DPipe_write(io, (void *)help, &count, TIME_INFINITE);
 158:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 159:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             help += count;
 160:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 161:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             if (briefOnly)
 162:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             {   /* Print Brief only */
 163:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 break;
 164:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             }
 165:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         }
 166:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 167:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         IfxStdIf_DPipe_print(io, ENDL);
 168:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 169:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         if ((command->call == NULL_PTR) && (index == 0))
 170:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         {
 171:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             index = 1;
 172:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             space = "  ";
 173:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         }
 174:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 175:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         command = &command[1];
 176:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 177:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         if (singleCommand)
 178:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         {
 179:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             break;
 180:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         }
 181:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     }
 182:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 183:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     return TRUE;
 184:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** }
 185:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 186:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 187:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** boolean Ifx_Shell_showHelpSingleCommand(pchar args, void *shellPtr, IfxStdIf_DPipe *io)
 188:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** {
 189:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     Ifx_Shell_CommandListConst commandList;
 190:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     const Ifx_Shell_Command   *shellCommand = Ifx_Shell_commandListFind(shellPtr, args, &args, &com
 191:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 192:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     if (shellCommand != NULL_PTR)
 193:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     {
 194:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         if (shellCommand->call == NULL_PTR)
 195:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         {
 196:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             Ifx_Shell_showHelpSingle(commandList, io, FALSE, FALSE);
 197:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         }
 198:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         else
 199:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         {
 200:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             if (commandList->call == NULL_PTR)
 201:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             {
 202:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 IfxStdIf_DPipe_print(io, "%s ", commandList->commandLine);
 203:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             }
 204:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 205:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             Ifx_Shell_showHelpSingle(shellCommand, io, FALSE, TRUE);
 206:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         }
 207:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 208:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         return TRUE;
 209:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     }
 210:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     else
 211:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     {
 212:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         IfxStdIf_DPipe_print(io, "unknown command");
 213:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         return FALSE;
 214:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     }
 215:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** }
 216:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 217:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 218:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** boolean Ifx_Shell_showHelp(pchar args, void *shellPtr, IfxStdIf_DPipe *io)
 219:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** {
 220:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     sint32     i;
 221:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     Ifx_Shell *shell  = shellPtr;
 222:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     boolean    result = TRUE;
 223:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 224:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     if (*args == IFX_SHELL_NULL_CHAR)
 225:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     {
 226:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         for (i = 0; i < IFX_CFG_SHELL_COMMAND_LISTS; i++)
 227:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         {
 228:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             if (shell->commandList[i] != NULL_PTR)
 229:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             {
 230:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 Ifx_Shell_showHelpSingle(shell->commandList[i], io, TRUE, FALSE);
 231:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             }
 232:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         }
 233:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     }
 234:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     else
 235:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     {
 236:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         result = Ifx_Shell_showHelpSingleCommand(args, shellPtr, io);
 237:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     }
 238:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 239:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     return result;
 240:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** }
 241:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 242:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 243:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** boolean Ifx_Shell_protocolStart(pchar args, void *data, IfxStdIf_DPipe *io)
 244:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** {
 245:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     Ifx_Shell *shell  = data;
 246:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     boolean    Result = TRUE;
 247:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 248:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     if (Ifx_Shell_matchToken(&args, "?") != FALSE)
 249:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     {
 250:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         IfxStdIf_DPipe_print(io, "Syntax     : protocol start" ENDL);
 251:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         IfxStdIf_DPipe_print(io, "           > start a protocol" ENDL);
 252:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     }
 253:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     else if (Ifx_Shell_matchToken(&args, "start") != FALSE)
 254:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     {
 255:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         if ((shell->protocol.start != NULL_PTR) && (shell->protocol.object != NULL_PTR))
 256:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         {
 257:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             Result                  = shell->protocol.start(shell->protocol.object, io);
 258:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             shell->protocol.started = (Result != FALSE);
 259:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 260:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             if (shell->protocol.onStart != NULL_PTR)
 261:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             {
 262:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****                 shell->protocol.onStart(shell->protocol.object, shell->protocol.onStartData);
 263:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             }
 264:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         }
 265:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         else
 266:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         {
 267:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****             Result = FALSE;
 268:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         }
 269:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     }
 270:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     else
 271:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     {}
 272:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 273:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     return Result;
 274:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** }
 275:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 276:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 277:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** boolean Ifx_Shell_bbProtocolStart(pchar args, void *data, IfxStdIf_DPipe *io)
 278:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** {
 279:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     boolean result = TRUE;
 280:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 281:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     if (Ifx_Shell_matchToken(&args, "?") != FALSE)
 282:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     {
 283:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         IfxStdIf_DPipe_print(io, "Syntax     : protocol start" ENDL);
 284:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         IfxStdIf_DPipe_print(io, "           > start a protocol" ENDL);
 285:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     }
 286:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     else if (Ifx_Shell_matchToken(&args, "protocol") != FALSE)
 287:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     {
 288:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****         result = Ifx_Shell_protocolStart(args, data, io);
 289:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     }
 290:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     else
 291:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     {}
 292:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** 
 293:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     return result;
 294:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** }
