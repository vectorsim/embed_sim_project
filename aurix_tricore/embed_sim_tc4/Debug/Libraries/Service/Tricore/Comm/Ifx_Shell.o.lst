  63:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h **** /** \brief Write binary data into the \ref IfxStdIf_DPipe.
  64:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  *
  65:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  * Initially the parameter 'count' specifies count of data to write.
  66:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  * After execution the data pointed by 'count' specifies the data actually written
  67:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  *
  68:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  * \param stdif Pointer to the interface driver object
  69:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  * \param data Pointer to the start of data
  70:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  * \param count Pointer to the count of data (in bytes).
  71:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  * \param timeout in system timer ticks
  72:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  *
  73:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  * \retval TRUE Returns TRUE if all items could be written
  74:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  * \retval FALSE Returns FALSE if not all the items could be written
  75:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  */
  76:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h **** typedef boolean (*IfxStdIf_DPipe_Write)(IfxStdIf_InterfaceDriver stdif, void *data, Ifx_SizeT *coun
  77:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h **** 
  78:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h **** /** \brief Read data from the \ref IfxStdIf_DPipe object
  79:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  *
  80:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  * Initially the parameter 'count' specifies count of data to read.
  81:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  * After execution the data pointed by 'count' specifies the data actually read.
  82:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  *
  83:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  * \param stdif Pointer to the interface driver object
  84:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  * \param data Pointer to the start of data
  85:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  * \param count Pointer to the count of data (in bytes).
  86:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  * \param timeout in system timer ticks
  87:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  *
  88:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  * \retval TRUE Returns TRUE if all items could be read
  89:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  * \retval FALSE Returns FALSE if not all the items could be read
  90:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  */
  91:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h **** typedef boolean (*IfxStdIf_DPipe_Read)(IfxStdIf_InterfaceDriver stdif, void *data, Ifx_SizeT *count
  92:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h **** 
  93:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h **** /** \brief Returns the number of bytes in the rx buffer
