  75:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****  */
  76:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** boolean Ifx_Shell_isEndOfLine(pchar args)
  77:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** {
  78:../Libraries/Service/Tricore/Comm/Ifx_Shell.c ****     return ((args == NULL_PTR) || (*args == IFX_SHELL_NULL_CHAR)) ? TRUE : FALSE;
