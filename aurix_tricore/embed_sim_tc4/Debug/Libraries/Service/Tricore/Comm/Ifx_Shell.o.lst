1072:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** /* A - up     B - down      C - right     D - left                                      */
1073:../Libraries/Service/Tricore/Comm/Ifx_Shell.c **** /* 1~ - HOME  2~ - INSERT   3~ - DELETE   4~ - END                                      */
