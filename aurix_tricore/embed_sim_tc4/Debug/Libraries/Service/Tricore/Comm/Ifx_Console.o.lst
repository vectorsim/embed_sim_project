  75:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  */
  76:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h **** typedef boolean (*IfxStdIf_DPipe_Write)(IfxStdIf_InterfaceDriver stdif, void *data, Ifx_SizeT *coun
  77:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h **** 
  78:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h **** /** \brief Read data from the \ref IfxStdIf_DPipe object
