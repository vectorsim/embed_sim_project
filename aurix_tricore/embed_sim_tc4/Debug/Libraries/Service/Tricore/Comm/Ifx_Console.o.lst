  89:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  * \retval FALSE Returns FALSE if not all the items could be read
  90:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  */
  91:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h **** typedef boolean (*IfxStdIf_DPipe_Read)(IfxStdIf_InterfaceDriver stdif, void *data, Ifx_SizeT *count
  92:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h **** 
  93:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h **** /** \brief Returns the number of bytes in the rx buffer
