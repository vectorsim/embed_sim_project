  27:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  *
  28:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  * \defgroup library_srvsw_stdif_dpipe Standard interface: Data Pipe
  29:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  * \ingroup library_srvsw_stdif
  30:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  *
  31:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  * The standard interafce data pipe (DPipe) abstract the hardware used for data transfer. It provid
  32:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  * and read data to/from as communciation channel.
  33:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  *
  34:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  * \par Porting StandardIo to DPipe
  35:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  * replace all
  36:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  *  - StandardIo type with IfxStdIf_DPipe
  37:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  *  - StandardIo_print with IfxStdIf_DPipe_print
  38:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  * delete StandardIo.c and StandardIo.h
  39:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  * Include "StdIf/IfxStdIf_DPipe.h" instead of "SysSe/Bsp/StandardIo.h"
  40:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  *
  41:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  * The following files are already ported: Ifx_Console, Ifx_Shell
  42:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  *
  43:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h ****  */
  44:../Libraries/Service/CpuGeneric/StdIf/IfxStdIf_DPipe.h **** #ifndef IFXSTDIF_DPIPE_H
