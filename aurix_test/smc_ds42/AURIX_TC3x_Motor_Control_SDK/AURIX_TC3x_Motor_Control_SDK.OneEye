        <var name="ecu" type="group" offset="0" access="read-write">
            <var name="run" type="bit" offset="0" access="read-write" default="0"/>
            <var name="cal" type="bit" offset="0" access="read-write" default="0"/>
        </var>
    </signals>
    <layout>
        <pushButton>
            <item-configuration>
                <title><![CDATA[Setup Connection]]></title>
                <on-click><![CDATA[{show.connection.ui}]]></on-click>
            </item-configuration>
        </pushButton>
        <group layout-item="false">
            <group layout="horizontal" layout-item="false">
                <item-configuration>
                    <title><![CDATA[Visualization]]></title>
                </item-configuration>
                <tab>
                    <tabPage layout="horizontal">
                        <item-configuration>
                            <title><![CDATA[Graph]]></title>
                        </item-configuration>
                        <graph buffer-depth="6000" multi-channel="false" legend-pos="top" division-x="10" division-y="10" offset-y="5" time-per-division-x="1" unit-x="s" x-axis-visible="false" control-visible="false">
                            <channel auto-connect="elf.g_motorControl.pmsmFoc.speedControl.refSpeed" enabled="defined-by-connection" offset-x="0" offset-y="0" unit-per-division-y="2000" pen-width="1" color="black" y-axis-visible="false">
                                <item-configuration>
                                    <title><![CDATA[SpeedRef [rpm]]]></title>
                                </item-configuration>
                            </channel>
                            <channel auto-connect="elf.g_motorControl.pmsmFoc.speedControl.measSpeed" enabled="defined-by-connection" offset-x="0" offset-y="0" unit-per-division-y="2000" pen-width="1" color="magenta" y-axis-visible="false">
                                <item-configuration>
                                    <title><![CDATA[SpeedMeas [rpm]]]></title>
                                </item-configuration>
                            </channel>
                            <channel auto-connect="elf.g_motorControl.pmsmFoc.idqMeas.real" enabled="defined-by-connection" offset-x="0" offset-y="0" unit-per-division-y="1" pen-width="1" color="green" y-axis-visible="false">
                                <item-configuration>
                                    <title><![CDATA[IdMeas [A]]]></title>
                                </item-configuration>
                            </channel>
                            <channel auto-connect="elf.g_motorControl.pmsmFoc.idqRef.real" enabled="defined-by-connection" offset-x="0" offset-y="0" unit-per-division-y="1" pen-width="1" color="black" y-axis-visible="false">
                                <item-configuration>
                                    <title><![CDATA[IdRef [A]]]></title>
                                </item-configuration>
                            </channel>
                            <channel auto-connect="elf.g_motorControl.pmsmFoc.idqMeas.imag" enabled="defined-by-connection" offset-x="0" offset-y="0" unit-per-division-y="1" pen-width="1" color="red" y-axis-visible="false">
                                <item-configuration>
                                    <title><![CDATA[IqMeas [A]]]></title>
                                </item-configuration>
                            </channel>
                            <channel auto-connect="elf.g_motorControl.pmsmFoc.idqRef.imag" enabled="defined-by-connection" offset-x="0" offset-y="0" unit-per-division-y="1" pen-width="1" color="blue" y-axis-visible="false">
                                <item-configuration>
                                    <title><![CDATA[IqRef [A]]]></title>
                                </item-configuration>
                            </channel>
                        </graph>
                    </tabPage>
                    <tabPage layout="horizontal">
                        <item-configuration>
                            <title><![CDATA[Osciloscope]]></title>
                        </item-configuration>
                        <oscilloscope data-in="elf.g_dasOsci" data-out="elf.g_dasOsci" legend-pos="top" division-x="10" protocol-type="ProtocolDma" dma-refresh-period="100" division-y="10" offset-y="5" time-per-division-x="0.0010000000474974513" unit-x="s" x-axis-visible="false" control-visible="false">
                            <oscilloscopeChannel enabled="defined-by-connection" offset-x="0" offset-y="0" unit-per-division-y="0.5" pen-width="1" color="gray" y-axis-visible="false"/>
                            <oscilloscopeChannel enabled="defined-by-connection" offset-x="0" offset-y="0" unit-per-division-y="0.5" pen-width="1" color="red" y-axis-visible="false"/>
                            <oscilloscopeChannel enabled="defined-by-connection" offset-x="0" offset-y="0" unit-per-division-y="0.25" pen-width="1" color="blue" y-axis-visible="false"/>
                            <oscilloscopeChannel enabled="defined-by-connection" offset-x="0" offset-y="0" unit-per-division-y="0.25" pen-width="1" color="black" y-axis-visible="false"/>
                            <oscilloscopeChannel enabled="defined-by-connection" offset-x="0" offset-y="0" unit-per-division-y="1024" pen-width="1" color="black" y-axis-visible="false"/>
                            <oscilloscopeChannel enabled="defined-by-connection" offset-x="0" offset-y="0" unit-per-division-y="0.25" pen-width="1" color="red" y-axis-visible="false"/>
                            <oscilloscopeChannel enabled="defined-by-connection" offset-x="0" offset-y="0" unit-per-division-y="0.25" pen-width="1" color="green" y-axis-visible="false"/>
                            <oscilloscopeChannel enabled="defined-by-connection" offset-x="0" offset-y="0" unit-per-division-y="0.25" pen-width="1" color="blue" y-axis-visible="false"/>
                            <oscilloscopeChannel enabled="defined-by-connection" visible="no" offset-x="0" offset-y="0" unit-per-division-y="1" pen-width="1" color="blue" y-axis-visible="false"/>
                            <oscilloscopeChannel enabled="defined-by-connection" visible="no" offset-x="0" offset-y="0" unit-per-division-y="1" pen-width="1" color="blue" y-axis-visible="false"/>
                        </oscilloscope>
                    </tabPage>
                </tab>
                <group layout-item="false">
                    <item-configuration>
                        <id><![CDATA[right]]></id>
                        <title><![CDATA[Commands]]></title>
                        <style-sheet><![CDATA[#right{
max-width:300;
}]]></style-sheet>
                    </item-configuration>
                    <group layout-item="false">
                        <item-configuration>
                            <title><![CDATA[Shell Commands]]></title>
                        </item-configuration>
                        <pushButton auto-connect="ecu.run" checkable="true">
                            <item-configuration>
                                <title><![CDATA[Stop]]></title>
                                <title-off><![CDATA[Start]]></title-off>
                            </item-configuration>
                        </pushButton>
                        <pushButton auto-connect="ecu.cal" checkable="true">
                            <item-configuration>
                                <title><![CDATA[Calibration OFF]]></title>
                                <title-off><![CDATA[Calibration ON]]></title-off>
                            </item-configuration>
                        </pushButton>
                    </group>
                    <group layout-item="false">
                        <item-configuration>
                            <title><![CDATA[Speed Commands]]></title>
                        </item-configuration>
                        <lineEdit auto-connect="elf.g_motorControl.interface.motorTargetSpeed">
                            <item-configuration>
                                <title><![CDATA[TargetSpeed [rpm]]]></title>
                            </item-configuration>
                        </lineEdit>
                        <slider auto-connect="elf.g_motorControl.interface.motorTargetSpeed" min="-6000" max="6000">
                            <item-configuration>
                                <title><![CDATA[TargetSpeed [rpm]]]></title>
                            </item-configuration>
                        </slider>
                        <spacer/>
                        <dial auto-connect="elf.g_motorControl.interface.motorTargetSpeed" min="-6000" max="6000" tick-count="500" page-size="20"/>
                        <spacer/>
                    </group>
                    <group layout-item="false">
                        <item-configuration>
                            <title><![CDATA[Current Commands]]></title>
                        </item-configuration>
                        <lineEdit auto-connect="elf.g_motorControl.pmsmFoc.idqRefExternal.real" min="-1">
                            <item-configuration>
                                <title><![CDATA[IdRef_External  [A]]]></title>
                            </item-configuration>
                        </lineEdit>
                        <lineEdit auto-connect="elf.g_motorControl.pmsmFoc.idqRefExternal.imag" min="-1" max="1">
                            <item-configuration>
                                <title><![CDATA[IqRef_External  [A]]]></title>
                            </item-configuration>
                        </lineEdit>
                        <comboBox auto-connect="elf.g_motorControl.controlParameters.controlScheme"/>
                    </group>
                    <group layout-item="false">
                        <item-configuration>
                            <title><![CDATA[Monitoring]]></title>
                        </item-configuration>
                        <lineEdit auto-connect="elf.g_motorControl.pmsmFoc.speedControl.measSpeed">
                            <item-configuration>
                                <title><![CDATA[SpeedMeas [rpm] ]]></title>
                            </item-configuration>
                        </lineEdit>
                        <lineEdit auto-connect="elf.g_motorControl.pmsmFoc.speedControl.refSpeed">
                            <item-configuration>
                                <title><![CDATA[SpeedRef [rpm]     ]]></title>
                            </item-configuration>
                        </lineEdit>
                        <lineEdit auto-connect="elf.g_motorControl.pmsmFoc.iPhaseMeas.u">
                            <item-configuration>
                                <title><![CDATA[Iu [A]                                ]]></title>
                            </item-configuration>
                        </lineEdit>
                        <lineEdit auto-connect="elf.g_motorControl.pmsmFoc.iPhaseMeas.v">
                            <item-configuration>
                                <title><![CDATA[Iv [A]                                ]]></title>
                            </item-configuration>
                        </lineEdit>
                        <lineEdit auto-connect="elf.g_motorControl.pmsmFoc.iPhaseMeas.w">
                            <item-configuration>
                                <title><![CDATA[Iw [A]                               ]]></title>
                            </item-configuration>
                        </lineEdit>
                    </group>
                    <spacer/>
                </group>
            </group>
        </group>
    </layout>
    <interface>
        <item-configuration>
            <id><![CDATA[das-itf]]></id>
        </item-configuration>
        <port plugin="PCom_DAS::DAS" connect="true" system-key="{ADS}"/>
    </interface>
    <protocolEngine>
        <protocol name="shell-extended" plugin="PProtocol_Core::generic" eol="\r" default-receive="Console.rx" data-in="elf.g_oneEyeDasPipe.FromTarget" data-out="elf.g_oneEyeDasPipe.ToTarget">
            <target apply-to="{bit:ecu\..+}">
                <set send="set ecu {bit.name} {:value}\r" send-parent-value="false"/>
            </target>
        </protocol>
    </protocolEngine>
    <config update-timer-period="33"/>
    <debugBox elf-path="TriCore Debug (TASKING)/AURIX_TC3x_Motor_Control_SDK.elf" watches="g_motorControl;!g_oneEyeDasPipe;$g_dasOsci;ulIdleCycleCount;g_shell" com-interface-id="das-itf" title="" id="elf"/>
</root>
