                <var name="controlParameters" type="group" offset="0" access="read-write">
                    <item-configuration>
                        <title><![CDATA[controlParameters]]></title>
                    </item-configuration>
                    <var name="controlScheme" type="bit" data-size="8" offset="0" access="read-write" default="0" enum="true">
                        <item-configuration>
                            <title><![CDATA[controlScheme]]></title>
                        </item-configuration>
                        <option data="0">
                            <item-configuration>
                                <value><![CDATA[ControlScheme_speed]]></value>
                                <title><![CDATA[ControlScheme_speed]]></title>
                            </item-configuration>
                        </option>
                        <option data="1">
                            <item-configuration>
                                <value><![CDATA[ControlScheme_current]]></value>
                                <title><![CDATA[ControlScheme_current]]></title>
                            </item-configuration>
                        </option>
                        <option data="2">
                            <item-configuration>
                                <value><![CDATA[ControlScheme_torque]]></value>
                                <title><![CDATA[ControlScheme_torque]]></title>
                            </item-configuration>
                        </option>
                        <option data="3">
                            <item-configuration>
                                <value><![CDATA[ControlScheme_voltage]]></value>
                                <title><![CDATA[ControlScheme_voltage]]></title>
                            </item-configuration>
                        </option>
