            <var name="g_oneEyeDasPipe" type="group" offset="0" access="read-write">
                <var name="FromTarget" type="char" offset="0" access="read-write">
                    <item-configuration>
                        <title><![CDATA[FromTarget]]></title>
                    </item-configuration>
