                        </item-configuration>
                        <var name="imag" type="float" offset="0" access="read-write" default="0">
                            <item-configuration>
                                <title><![CDATA[imag]]></title>
                            </item-configuration>
                        </var>
                        <var name="real" type="float" offset="0" access="read-write" default="0">
                            <item-configuration>
                                <title><![CDATA[real]]></title>
                            </item-configuration>
                        </var>
                    </var>
                    <var name="speedControl" type="group" offset="0" access="read-write">
                        <item-configuration>
                            <title><![CDATA[speedControl]]></title>
                        </item-configuration>
                        <var name="measSpeed" type="float" offset="0" access="read-write" default="0">
                            <item-configuration>
                                <title><![CDATA[measSpeed]]></title>
                            </item-configuration>
                        </var>
                        <var name="refSpeed" type="float" offset="0" access="read-write" default="0">
                            <item-configuration>
                                <title><![CDATA[refSpeed]]></title>
                            </item-configuration>
                        </var>
                    </var>
                    <var name="idqRef" type="group" offset="0" access="read-write">
                        <item-configuration>
                            <title><![CDATA[idqRef]]></title>
                        </item-configuration>
                        <var name="real" type="float" offset="0" access="read-write" default="0">
                            <item-configuration>
                                <title><![CDATA[real]]></title>
                            </item-configuration>
                        </var>
                        <var name="imag" type="float" offset="0" access="read-write" default="0">
                            <item-configuration>
                                <title><![CDATA[imag]]></title>
                            </item-configuration>
                        </var>
                    </var>
                    <var name="iPhaseMeas" type="group" offset="0" access="read-write">
                        <item-configuration>
                            <title><![CDATA[iPhaseMeas]]></title>
                        </item-configuration>
                        <var name="u" type="float" offset="0" access="read-write" default="0">
                            <item-configuration>
                                <title><![CDATA[u]]></title>
                            </item-configuration>
                        </var>
                        <var name="v" type="float" offset="0" access="read-write" default="0">
                            <item-configuration>
                                <title><![CDATA[v]]></title>
                            </item-configuration>
                        </var>
                        <var name="w" type="float" offset="0" access="read-write" default="0">
                            <item-configuration>
                                <title><![CDATA[w]]></title>
                            </item-configuration>
                        </var>
                    </var>
